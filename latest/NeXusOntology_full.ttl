    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-ranging-checksum-field> ;
