            owl:onClass :nxspm-entry-instrument-hardware-model-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-hardware-vendor-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxinstrument-fabrication-group .

