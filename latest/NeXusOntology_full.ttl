    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-phase-positioner-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-phase-positioner-group> ;
    rdfs:subClassOf :NXpositioner,
        :NeXusGroup .

