    rdfs:comment """
                    The end value of the bias scan voltage.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-end-bias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-end-bias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        :NeXusField,
        :nxspm-scan-region-scan-endn-field .

:nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-offset-bias-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/scan_region/scan_offset_bias"^^xsd:string ;
    rdfs:comment """
                    The starting voltage of the bias sweep. The range of voltages for the sweep can
                    be defined with scan voltage offset and scan voltage range (difference between
                    minimum and maximum voltage values in a sweep)
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-offset-bias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-offset-bias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-range-bias-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/scan_region/scan_range_bias"^^xsd:string ;
    rdfs:comment """
                    The range of voltages for the sweep can be defined with scan voltage offset and
                    scan voltage range (difference between minimum and maximum voltage values in a
                    sweep)
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-range-bias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-range-bias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField,
        :nxspm-scan-region-scan-rangen-field .

:nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-start-bias-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/scan_region/scan_start_bias"^^xsd:string ;
    rdfs:comment """
                    The start of the bias scan voltage.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-start-bias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-region-scan-start-bias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxspm-scan-region-scan-startn-field .

:nxspm-bias-spectroscopy-bias-sweep-scan-type-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/scan_type"^^xsd:string ;
    rdfs:comment """
                This combines not only how the voltages are changed, but how the voltage values are
                correlated to a position across the sample surface, measuring sweeps are each spatial
                coordinate or mapping the response at constant voltage, etc.
                For STS experiment, the scan type is usually a single-point scan (trajectory scan).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxspm-bias-spectroscopy-bias-sweep-scan-type-linear-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField,
        :nxspm-scan-control-scan-type-field .

:nxspm-bias-spectroscopy-measurement-type-variadic-spacing-enum a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/measurement_type/variadic_spacing"^^xsd:string ;
    rdfs:comment "Enumeration item for NXspm_bias_spectroscopy/measurement_type: variadic_spacing"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "variadic_spacing"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxspm-bias-spectroscopy-spm-positioner-group a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/SPM_POSITIONER"^^xsd:string ;
    rdfs:comment """
            Information about the positioner PID (proportional, integral, differential feedback system),
            offset values, setpoint values and so on, while running bias voltage-tunneling current measurement.
            
            These components position the probe relative to the sample, thus help obtaining maps of the data
            across the sample surface.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-spm-positioner-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-spm-positioner-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-spm-positioner-z-controller-group ;
            owl:onProperty :has ],
        :NXspm_positioner,
        :NeXusGroup .

:nxspm-bias-spectroscopy-spm-positioner-z-controller-group a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/SPM_POSITIONER/z_controller"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-spm-positioner-z-controller-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-spm-positioner-z-controller-group> ;
    rdfs:subClassOf :NeXusGroup ;
    owl:equivalentClass :nxspm-positioner-z-controller-group .

:nxspm-cantilever-amplitude-positioner-group a owl:Class ;
    rdfs:label "NXspm_cantilever/amplitude_positioner"^^xsd:string ;
    rdfs:comment """
            The amplitude positioner of the cantilever.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-amplitude-positioner-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-amplitude-positioner-group> ;
    rdfs:subClassOf :NXpositioner,
        :NeXusGroup .

:nxspm-cantilever-cantilever-oscillator-group a owl:Class ;
    rdfs:label "NXspm_cantilever/cantilever_oscillator"^^xsd:string ;
    rdfs:comment """
            The oscillator of the cantilever.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-cantilever-oscillator-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-cantilever-oscillator-group> ;
    rdfs:subClassOf :NXspm_cantilever_oscillator,
        :NeXusGroup .

:nxspm-cantilever-oscillator-reference-amplitude-field a owl:Class ;
    rdfs:label "NXspm_cantilever_oscillator/reference_amplitude"^^xsd:string ;
    rdfs:comment """
            The reference amplitude (also called drive amplitude) of the cantilever.
            This is the amplitude of the cantilever oscillation when no external forces are acting on it.
            
            Note: At least one from reference_amplitude, reference_frequency, or reference_phase is expected.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-amplitude-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-amplitude-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-cantilever-oscillator-reference-frequency-field a owl:Class ;
    rdfs:label "NXspm_cantilever_oscillator/reference_frequency"^^xsd:string ;
    rdfs:comment """
            The reference frequency (also called drive frequency or resonance frequency) of
            the cantilever.
            
            Note: At least one from reference_amplitude, reference_frequency, or reference_phase is expected.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-cantilever-oscillator-reference-phase-field a owl:Class ;
    rdfs:label "NXspm_cantilever_oscillator/reference_phase"^^xsd:string ;
    rdfs:comment """
            The reference phase of the cantilever oscillator.
                
            Note: At least one from reference_amplitude, reference_frequency, or reference_phase is expected.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-phase-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-phase-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-cantilever-phase-positioner-group a owl:Class ;
    rdfs:label "NXspm_cantilever/phase_positioner"^^xsd:string ;
    rdfs:comment """
