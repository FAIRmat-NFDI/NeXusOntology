:nxspm-entry-instrument-hardware-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/hardware"^^xsd:string ;
    rdfs:comment """
                    The hardware description of core instrument setup of experiment.
                    Usually, the entire instrument is supplied by a single manufacturer.
                    To describe the hardware from any sub-components, use the ``hardware`` group of that
                    sub-component (child group of the NXinstrument group) group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-hardware-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-hardware-group> ;
