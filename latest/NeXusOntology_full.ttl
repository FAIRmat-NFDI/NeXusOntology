        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxmpes-entry-transmission-correction-transmission-function-relative-intensity-field a owl:Class ;
    rdfs:label "NXmpes/ENTRY/transmission_correction/transmission_function/relative_intensity"^^xsd:string ;
    rdfs:comment """
                        Relative transmission efficiency for the given kinetic energies
                    """^^xsd:string ;
