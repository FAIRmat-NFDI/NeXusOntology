    rdfs:comment """
                        The parameter :math:`t_0`, CAnalysis.CCalibMass.fT0Estimate
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-voltage-and-bowl-tof-zero-estimate-field> ;
