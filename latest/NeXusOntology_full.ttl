:nxcg-primitive-dimensionality-3-enum a owl:Class ;
    rdfs:label "NXcg_primitive/dimensionality/3"^^xsd:string ;
    rdfs:comment "Enumeration item for NXcg_primitive/dimensionality: 3"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXcg_primitive.html#nxcg-primitive-dimensionality-field> ;
