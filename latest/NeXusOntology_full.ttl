            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "SASprocess"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxcansas-entry-process-collection-cansas-class-attribute a owl:Class ;
    rdfs:label "NXcanSAS/ENTRY/PROCESS/COLLECTION/canSAS_class"^^xsd:string ;
    rdfs:comment """
            Official canSAS group: :index:`NXcanSAS (applications); SASprocessnote`
          """^^xsd:string ;
