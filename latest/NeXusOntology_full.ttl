            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-ion-query-nuclide-vector-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxapm-paraprobe-tool-config-entry-taskconfig-group .

:nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-hdbscan-alpha-field a owl:Class ;
    rdfs:label "NXapm_paraprobe_clusterer_config/ENTRY/cluster_analysisID/hdbscan/alpha"^^xsd:string ;
