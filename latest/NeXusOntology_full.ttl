    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_config.html#nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-dbscan-min-pts-field> ;
