            owl:onClass :nxstress-entry-instrument-detector-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstress-entry-instrument-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstress-entry-instrument-beam-intensity-profile-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-instrument-group .

:nxstress-entry-instrument-name-field a owl:Class ;
    rdfs:label "NXstress/ENTRY/instrument/name"^^xsd:string ;
