:nxxpcs-entry-instrument-detector-count-time-field a owl:Class ;
    rdfs:label "NXxpcs/ENTRY/instrument/DETECTOR/count_time"^^xsd:string ;
    rdfs:comment "Exposure time of frames, s."^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-instrument-detector-count-time-field> ;
