:nxoptical-spectroscopy-entry-instrument-instrument-calibration-device-device-path-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/INSTRUMENT/instrument_calibration_DEVICE/device_path"^^xsd:string ;
    rdfs:comment """
                        Path to the device, which was calibrated.
                        Example: entry/instrument/DEVICE
                    """^^xsd:string ;
