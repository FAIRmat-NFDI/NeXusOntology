                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-positioner-actuator-feedback-group a owl:Class ;
    rdfs:label "NXspm_positioner/actuator/feedback"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-actuator-feedback-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-actuator-feedback-group> ;
