            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxbending-magnet-divergence-y-plus-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxbending-magnet-critical-energy-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
