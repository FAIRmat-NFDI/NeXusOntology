            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-reference-phase-field a owl:Class ;
    rdfs:label "NXlockin/reference_phase"^^xsd:string ;
    rdfs:comment """
            Phase of the reference signal set in the lock-in amplifier.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-reference-phase-field> ;
