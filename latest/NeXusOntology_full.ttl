:nxspm-positioner-actuator-group a owl:Class ;
    rdfs:label "NXspm_positioner/actuator"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-actuator-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-actuator-group> ;
