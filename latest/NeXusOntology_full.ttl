            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstress-entry-sample-description-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
