:nxoptical-spectroscopy-entry-instrument-beam-type-incident-wavelength-spread-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/INSTRUMENT/beam_TYPE/incident_wavelength_spread"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
