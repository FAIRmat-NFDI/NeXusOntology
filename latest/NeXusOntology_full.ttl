            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxmpes-entry-user-affiliation-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-user-group .

