:nxstress-entry-measurement-direction-field a owl:Class ;
    rdfs:label "NXstress/ENTRY/measurement_direction"^^xsd:string ;
    rdfs:comment """
                Describes the specific measurement direction covered by the data in this file.
            """^^xsd:string ;
