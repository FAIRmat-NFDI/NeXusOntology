            owl:onClass :nxstm-entry-instrument-bias-spectroscopy-environment-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-instrument-group .

:nxstm-entry-instrument-lockin-amplifier-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/lockin_amplifier"^^xsd:string ;
    rdfs:comment """
                    The lock-in amplifier information. The device is being used to extract
                    the very weak signal buried in noisy signals.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-lockin-amplifier-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-lockin-amplifier-group> ;
