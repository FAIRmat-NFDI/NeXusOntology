        :NeXusGroup .

:nxspm-entry-instrument-voltage-sensortag-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG"^^xsd:string ;
    rdfs:comment """
                    The sensor information for the voltage device. Any voltage sensor involved in the
                    experiment or in any special measurement or in any specialized experiment component
                    can be registered under this group.
                    
                    For this purpose, replace the TAG with the specific name or ID of the voltage sensor.
                    
                    Do not register this group for sample bias voltage (DC), for that we have :ref:`sample_bias_voltage </NXspm/entry/instrument/sample_bias_voltage-group>` group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-calibration-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-amplifier-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-offset-value-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-voltage-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-namevoltage-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxinstrument-sensor-group .

:nxspm-entry-instrument-voltage-sensortag-namevoltage-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG/NAMEvoltage"^^xsd:string ;
    rdfs:comment """
                        The name of the voltage according to the purpose of the measurement.
                        E.g., the field can be named as x_source_drain_bias_voltage defining
                        the applied bias along the x-axis as source-drain channel, while current
                        (tip current) will be measured along the z-axis.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-namevoltage-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-namevoltage-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-entry-instrument-voltage-sensortag-offset-value-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG/offset_value"^^xsd:string ;
    rdfs:comment """
                        The offset voltage. The real voltage is the sum of the voltage and the offset
                        voltage.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-offset-value-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-offset-value-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-entry-instrument-voltage-sensortag-voltage-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG/voltage"^^xsd:string ;
    rdfs:comment """
                        Voltage measured by sensor.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-voltage-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-voltage-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_VOLTAGE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-entry-instrument-xyzpiezo-sensor-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/XYZpiezo_sensor"^^xsd:string ;
    rdfs:comment """
                    For separate piezo sensors along X-, Y-, and Z-axis register this group, e.g., x_piezo_sensor
                    or height_piezo_sensor.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-xyzpiezo-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-xyzpiezo-sensor-group> ;
    rdfs:subClassOf :NXspm_piezo_sensor,
        :NeXusGroup .

:nxspm-entry-process-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/PROCESS"^^xsd:string ;
    rdfs:comment """
                Define data processing (e.g., data analysis, image processing) program and
                associated workflow, software and store results.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-process-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-process-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxsensor-scan-entry-process-group .

:nxspm-entry-reproducibility-indicators-link-to-group-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/reproducibility_indicators/LINK_TO_GROUP"^^xsd:string ;
    rdfs:comment """
                    A place holder to create link to any group relevant considered as
                    reproducibility indicators (defined by laboratory).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-link-to-group-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-link-to-group-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxobject-collection-group .

:nxspm-entry-resolution-indicators-link-to-group-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/resolution_indicators/LINK_TO_GROUP"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-link-to-group-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-link-to-group-group> ;
    rdfs:subClassOf :NeXusGroup ;
    owl:equivalentClass :nxobject-collection-group .

:nxspm-entry-sample-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE"^^xsd:string ;
    rdfs:comment """
                The sample information.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-history-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-sample-environment-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-scan-entry-sample-group .

:nxspm-entry-sample-history-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE/history"^^xsd:string ;
    rdfs:comment """
                    A set of physical processes that occurred to the sample prior/during experiment.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-history-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-history-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxsensor-scan-entry-sample-history-group .

:nxspm-entry-sample-sample-environment-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE/sample_environment"^^xsd:string ;
    rdfs:comment """
                    Information of environment around the sample.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-sample-environment-temperature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-sample-environment-sample-bias-voltage-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-sample-environment-sample-temperature-sensor-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsample-environment-group .

:nxspm-entry-sample-sample-environment-sample-bias-voltage-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE/sample_environment/sample_bias_voltage"^^xsd:string ;
    rdfs:comment """
                        This should be a link to
                        
                        /entry/instrument/sample_bias_voltage sensor under instrument.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-sample-bias-voltage-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-sample-bias-voltage-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxenvironment-sensor-group .

:nxspm-entry-sample-sample-environment-sample-temperature-sensor-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE/sample_environment/sample_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                        This should be a link to
                        
                        /entry/instrument/sample_temperature_sensor under instrument.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-sample-temperature-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-sample-temperature-sensor-group> ;
    rdfs:subClassOf :NXspm_temperature_sensor,
        :NeXusGroup .

:nxspm-entry-sample-sample-environment-temperature-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/SAMPLE/sample_environment/temperature"^^xsd:string ;
    rdfs:comment """
                        The single-valued temperature of the sample, also referred to as the tip temperature
                        (not head temperature), since the tip and sample are in contact or in close proximity.
                        For array like temperature data use sample_temperature_sensor group.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-temperature-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-sample-sample-environment-temperature-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TEMPERATURE ],
        :NeXusField .

:nxspm-entry-scan-type-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/scan_type"^^xsd:string ;
    rdfs:comment """
                The type of the scan. It mainly describes how scan probe moves in the scan region, e.g.
                forward, backward, or both (if scan is repeated). Any lab defined scan type
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-scan-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-scan-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibratedaxis-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibratedAXIS"^^xsd:string ;
    rdfs:comment """
                The AXIS (substring) denotes X, Y or Z, e.g., calibrated_x. There are three directions X, Y, and Z for calibration,
                along with three available parameters each: Calibration (m/V), Range (m), and HV gain. Only
                two of these parameters are required to define the calibration. Consequently, when any
                value is changed, one of the other values will be automatically updated.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibratedaxis-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibratedaxis-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibration-date-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_date"^^xsd:string ;
    rdfs:comment """
                The date of the calibration.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-date-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-date-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibration-name-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_name"^^xsd:string ;
    rdfs:comment """
                A specific name of the calibration (e.g. active type with name 'LHe').
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-name-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-name-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibration-parameters-coefficientn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_parameters/coefficientN"^^xsd:string ;
    rdfs:comment """
                    The calibration coefficient is the ratio of the actual distance moved by the piezo due to
                    the voltage or external force applied to the piezo. It is also called first-order correction.
                    The N (substring) denotes X and Y directions (e.g., coefficient_x).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-coefficientn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-coefficientn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibration-parameters-group a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_parameters"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-parameters-coefficientn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-parameters-second-order-correctionn-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxcalibration-calibration-parameters-group .

:nxspm-piezo-config-calibration-calibration-parameters-second-order-correctionn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_parameters/second_order_correctionN"^^xsd:string ;
    rdfs:comment """
                    The N (substring) denotes X and Y directions (e.g., second_order_correction_x). If you know them, you can enter the 2nd order piezo
                    characteristics to compensate the error for that axis.
                    The following equation shows the
                    interpretation of the 2nd order correction parameters, For the X-piezo: :math:`U_x = \\frac{1}{c_x} \\cdot X + c_{xx} \\cdot X^2`
                    with units: :math:`[V] = \\frac{[V]}{[m]} \\cdot [m] + \\frac{[V]}{[m^2]} \\cdot [m^2]`
                    where cx is the calibration of the piezo X and cxx is the 2nd order correction. The unit for
                    the second-order correction is (:math:`\\frac{V}{m^2}`).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-second-order-correctionn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-parameters-second-order-correctionn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezo-config-calibration-calibration-type-active-enum a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_type/active"^^xsd:string ;
    rdfs:comment "Enumeration item for NXspm_piezo_config/calibration/calibration_type: active"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "active"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations ;
    owl:disjointWith :nxspm-piezo-config-calibration-calibration-type-passive-enum .

:nxspm-piezo-config-calibration-calibration-type-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/calibration_type"^^xsd:string ;
    rdfs:comment """
                The name of the calibration type, sometimes it is called
                `active calibration`.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-calibration-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxspm-piezo-config-calibration-calibration-type-active-enum :nxspm-piezo-config-calibration-calibration-type-passive-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxspm-piezo-config-calibration-drift-correction-status-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/drift_correction_status"^^xsd:string ;
    rdfs:comment """
                The drift correction status (true / false) in calibration step of piezo.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-drift-correction-status-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-drift-correction-status-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezo-config-calibration-driftn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/driftN"^^xsd:string ;
    rdfs:comment """
                The N (substring) denotes X, Y and Z directions (e.g., drift_x). Define the
                drift speed [m/s] for all three axes. When the compensation is on, the piezo will start to
                move at that speed.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-driftn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-driftn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezo-config-calibration-group a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-drift-correction-status-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-hv-gainn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-date-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibratedaxis-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-rangen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-driftn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-tiltn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-calibration-parameters-group ;
            owl:onProperty :has ],
        :NXcalibration,
        :NeXusGroup .

:nxspm-piezo-config-calibration-hv-gainn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/hv_gainN"^^xsd:string ;
    rdfs:comment """
                The N (substring) denotes X or Y or Z, e.g., hv_gain_x. In some systems, there is an HV gain readout feature. For
                these systems, the HV gain should be automatically adjusted whenever the gain is
                changed at the high voltage amplifier.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-hv-gainn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-hv-gainn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezo-config-calibration-rangen-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/rangeN"^^xsd:string ;
    rdfs:comment """
                The N (substring) denotes X or Y or Z, e.g., range_x. There are 3 parameters in X, Y and Z directions. The range
                is the maximum distance the piezo can move.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-rangen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-rangen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        :NeXusField .

:nxspm-piezo-config-calibration-tiltn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/calibration/tiltN"^^xsd:string ;
    rdfs:comment """
                The N (substring) denotes X and Y directions (e.g., tilt_x), and for both directions tilt needs to be adjusted according
                to the actual surface.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-tiltn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-calibration-tiltn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezo-config-piezo-material-curvature-radiusn-field a owl:Class ;
    rdfs:label "NXspm_piezo_config/piezo_material/curvature_radiusN"^^xsd:string ;
    rdfs:comment """
                The N (substring) denotes X or Y. There are 2 parameters in X and Y directions. It can be set
                approximately to the length of the piezo tube along X and Y axis.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-piezo-material-curvature-radiusn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-piezo-material-curvature-radiusn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezo-config-piezo-material-group a owl:Class ;
    rdfs:label "NXspm_piezo_config/piezo_material"^^xsd:string ;
    rdfs:comment """
            The material description and properties of the piezoelectric scanner materials.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-piezo-material-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html#nxspm-piezo-config-piezo-material-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-piezo-material-curvature-radiusn-field ;
            owl:onProperty :has ],
        :NXspm_piezoelectric_material,
        :NeXusGroup .

:nxspm-piezo-sensor-axisoffset-value-field a owl:Class ;
    rdfs:label "NXspm_piezo_sensor/AXISoffset_value"^^xsd:string ;
    rdfs:comment """
            The offset value for the piezo axis (X, Y, or Z) that will be added
            to the measured value.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-axisoffset-value-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-axisoffset-value-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezo-sensor-piezo-configuration-group a owl:Class ;
    rdfs:label "NXspm_piezo_sensor/piezo_configuration"^^xsd:string ;
    rdfs:comment """
            The piezo configuration information like piezoelectric calibration and material
            properties.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-piezo-configuration-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-piezo-configuration-group> ;
    rdfs:subClassOf :NXspm_piezo_config,
        :NeXusGroup .

:nxspm-piezo-sensor-piezo-material-group a owl:Class ;
    rdfs:label "NXspm_piezo_sensor/piezo_material"^^xsd:string ;
    rdfs:comment """
            The material description and properties of the piezoelectric scanner materials.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-piezo-material-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-piezo-material-group> ;
    rdfs:subClassOf :NXspm_piezoelectric_material,
        :NeXusGroup .

:nxspm-piezo-sensor-spm-positioner-group a owl:Class ;
    rdfs:label "NXspm_piezo_sensor/SPM_POSITIONER"^^xsd:string ;
    rdfs:comment """
            The positioner information like the position of the tip, the position of the
            sample, PID controller etc.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-spm-positioner-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-spm-positioner-group> ;
    rdfs:subClassOf :NXspm_positioner,
        :NeXusGroup .

:nxspm-piezoelectric-material-acoustic-impedance-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/acoustic_impedance"^^xsd:string ;
    rdfs:comment """
            The acoustic impedance of the piezo material.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-acoustic-impedance-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-acoustic-impedance-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezoelectric-material-chemical-formula-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/chemical_formula"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-chemical-formula-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-chemical-formula-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField ;
    owl:equivalentClass :nxcrystal-chemical-formula-field .

:nxspm-piezoelectric-material-d-piezoelectric-constant-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/D_piezoelectric_constant"^^xsd:string ;
    rdfs:comment """
            The D_piezoelectric_constant (with substitutable part D) piezoelectric charge coefficients of the material. The coefficients describe the electric
            polarization generated by the applied stress on the material. Different coefficients correspond to different
            relative directions of the polarization and the stress (e.g., d33, d31).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-d-piezoelectric-constant-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-d-piezoelectric-constant-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezoelectric-material-density-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/density"^^xsd:string ;
    rdfs:comment """
            The density of the piezo material.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-density-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-density-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxcrystal-density-field .

:nxspm-piezoelectric-material-g-voltage-constant-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/G_voltage_constant"^^xsd:string ;
    rdfs:comment """
            The constants (with substitutable part G) define the electric field produced by the external mechanical strain. Different coefficients
            correspond to different relative directions of the electric field and the strain (e.g., g33, g31).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-g-voltage-constant-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-g-voltage-constant-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezoelectric-material-glass-transition-temperature-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/glass_transition_temperature"^^xsd:string ;
    rdfs:comment """
            The range of temperature where a piezoelectric hard material transforms into the
            viscous state.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-glass-transition-temperature-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-glass-transition-temperature-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TEMPERATURE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezoelectric-material-identifier-piezo-material-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/identifier_piezo_material"^^xsd:string ;
    rdfs:comment """
            The identifier of the piezo material.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-identifier-piezo-material-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-identifier-piezo-material-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxobject-identifiername-field .

:nxspm-piezoelectric-material-k-electromechanical-constant-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/K_electromechanical_constant"^^xsd:string ;
    rdfs:comment """
            The electromechanical constant measures the efficiency of the conversion of mechanical energy
            into electrical energy.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-k-electromechanical-constant-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-k-electromechanical-constant-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezoelectric-material-name-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/name"^^xsd:string ;
    rdfs:comment """
            The name of the material of the piezo scanner such as Lead Zirconate Titanates
            (PZTs).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-name-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-name-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxcomponent-name-field .

:nxspm-piezoelectric-material-p-pyroelectric-constant-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/P_pyroelectric_constant"^^xsd:string ;
    rdfs:comment """
            The pyroelectric constant defines the change of the polarization vector of the piezoelectric material
            per unit change in temperature.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-p-pyroelectric-constant-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-p-pyroelectric-constant-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezoelectric-material-relative-permittivity-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/relative_permittivity"^^xsd:string ;
    rdfs:comment """
            The relative permittivity (dielectric constant) of the piezo material.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-relative-permittivity-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-relative-permittivity-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-piezoelectric-material-surface-resistivity-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/surface_resistivity"^^xsd:string ;
    rdfs:comment """
            The surface resistivity of the piezo material.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-surface-resistivity-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-surface-resistivity-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-piezoelectric-material-temperature-range-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/temperature_range"^^xsd:string ;
    rdfs:comment """
            The temperature range of the piezo material. This field is expecting a range
            of temperatures in an array [min temperature, max temperature].
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-temperature-range-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-temperature-range-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TEMPERATURE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-piezoelectric-material-type-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/type"^^xsd:string ;
    rdfs:comment """
            The type of the material of the piezo scanner (e.g. piezoelectric ceramics,
            polymer-film piezoelectrics).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezoelectric_material.html#nxspm-piezoelectric-material-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxcrystal-type-field .

:nxspm-piezoelectric-material-young-modulus-field a owl:Class ;
    rdfs:label "NXspm_piezoelectric_material/young_modulus"^^xsd:string ;
    rdfs:comment """
            The Young's modulus of the piezo material.
        """^^xsd:string ;
