:nxoptical-spectroscopy-entry-instrument-phi-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/INSTRUMENT/phi"^^xsd:string ;
    rdfs:comment """
                    Inplane rotation of the sample, with rotation axis along sample normal.
                """^^xsd:string ;
