        :NeXusEnumerations .

:nxem-ebsd-indexing-matching-phase-descriptor-mean-angular-deviation-enum a owl:Class ;
    rdfs:label "NXem_ebsd/indexing/matching_phase_descriptor/mean_angular_deviation"^^xsd:string ;
