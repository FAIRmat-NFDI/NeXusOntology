            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxpcs-entry-instrument-incident-beam-incident-energy-spread-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
