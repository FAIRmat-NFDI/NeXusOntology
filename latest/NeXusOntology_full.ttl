    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlauetof-entry-instrument-detector-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-instrument-group .

:nxlauetof-entry-name-group a owl:Class ;
    rdfs:label "NXlauetof/ENTRY/name"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-name-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-name-group> ;
    rdfs:subClassOf :NeXusGroup ;
    owl:equivalentClass :nxentry-data-group .

:nxlauetof-entry-sample-group a owl:Class ;
    rdfs:label "NXlauetof/ENTRY/sample"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlauetof-entry-sample-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlauetof-entry-sample-orientation-matrix-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlauetof-entry-sample-unit-cell-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-sample-group .

:nxlauetof-entry-sample-name-field a owl:Class ;
    rdfs:label "NXlauetof/ENTRY/sample/name"^^xsd:string ;
    rdfs:comment "Descriptive name of sample"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-name-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-name-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxsample-name-field .

:nxlauetof-entry-sample-orientation-matrix-field a owl:Class ;
    rdfs:label "NXlauetof/ENTRY/sample/orientation_matrix"^^xsd:string ;
    rdfs:comment """
            The orientation matrix according to Busing and
            Levy conventions. This is not strictly necessary as
            the UB can always be derived from the data.  But
            let us bow to common usage which includes the
            UB nearly always.
	  """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-orientation-matrix-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-orientation-matrix-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxsample-orientation-matrix-field .

:nxlauetof-entry-sample-unit-cell-field a owl:Class ;
    rdfs:label "NXlauetof/ENTRY/sample/unit_cell"^^xsd:string ;
    rdfs:comment """
            The unit cell, a, b, c, alpha, beta, gamma.
            Again, not strictly necessary, but normally written.
          """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-unit-cell-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXlauetof.html#nxlauetof-entry-sample-unit-cell-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxsample-unit-cell-field .

:nxlockin-amplitude-modulation-bandwidth-field a owl:Class ;
    rdfs:label "NXlockin/amplitude_modulation_bandwidth"^^xsd:string ;
    rdfs:comment """
            The bandwidth of the modulating signal over which modulated signal spreads.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-amplitude-modulation-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-amplitude-modulation-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxlockin-bias-divider-field a owl:Class ;
    rdfs:label "NXlockin/bias_divider"^^xsd:string ;
    rdfs:comment """
            Bias divider for lock-in channel.
            math: `Bias divider $= \\frac{V_{\\mathrm{ref}}}{V_{\\mathrm{ref}} + V_{\\mathrm{input}}}$`
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-bias-divider-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-bias-divider-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-dc-offset-valuen-field a owl:Class ;
    rdfs:label "NXlockin/dc_offset_valueN"^^xsd:string ;
    rdfs:comment """
            The DC offset of the demodulated signal.
            This is used to remove the DC component from the demodulated signal.
            
            The same DC offset might be applied to the input signal in the modulation process.
            N is envisioned to represent the channel number e.g., dc_offset_value1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-dc-offset-valuen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-dc-offset-valuen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-demodulated-amplitude-field a owl:Class ;
    rdfs:label "NXlockin/demodulated_amplitude"^^xsd:string ;
    rdfs:comment """
            The amplitude of the demodulated signal.
            Unit could be NX_VOLTAGE or NX_CURRENT depending on the type of the demodulated signal.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-amplitude-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-amplitude-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-demodulated-frequency-field a owl:Class ;
    rdfs:label "NXlockin/demodulated_frequency"^^xsd:string ;
    rdfs:comment """
            The frequency of the demodulated signal.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-demodulated-phase-field a owl:Class ;
    rdfs:label "NXlockin/demodulated_phase"^^xsd:string ;
    rdfs:comment """
            The phase of the demodulated signal.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-phase-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-phase-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-demodulated-signal-field a owl:Class ;
    rdfs:label "NXlockin/demodulated_signal"^^xsd:string ;
    rdfs:comment """
            Type of the demodulated signal,  current | voltage | bias.
            The name of the current or voltage signal can be also specified
            according to their purpose (e.g., `bias` voltage).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-signal-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-signal-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-demodulator-channels-field a owl:Class ;
    rdfs:label "NXlockin/demodulator_channels"^^xsd:string ;
    rdfs:comment """
            Comma separated list of the demodulator channels.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulator-channels-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulator-channels-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxlockin-frequency-modulation-bandwidth-field a owl:Class ;
    rdfs:label "NXlockin/frequency_modulation_bandwidth"^^xsd:string ;
    rdfs:comment """
            The bandwidth of the modulating signal.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-frequency-modulation-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-frequency-modulation-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxlockin-hardware-group a owl:Class ;
    rdfs:label "NXlockin/hardware"^^xsd:string ;
    rdfs:comment """
            Hardware manufacturers and type (product number) of lock-in amplifier.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-hardware-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-hardware-group> ;
    rdfs:subClassOf :NXfabrication,
        :NeXusGroup .

:nxlockin-harmonic-ordern-field a owl:Class ;
    rdfs:label "NXlockin/harmonic_orderN"^^xsd:string ;
    rdfs:comment """
            The reference signal can be a higher harmonic of the modulation signal.
            Here the order of the harmonic is stored.
            N is envisioned to represent the channel number e.g., harmonic_order1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-harmonic-ordern-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-harmonic-ordern-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-high-passn-field a owl:Class ;
    rdfs:label "NXlockin/high_passN"^^xsd:string ;
    rdfs:comment """
            Frequency of the high-pass filter or cut-off frequency. Only signals above
            this frequency are passed through the filter.
            N is envisioned to represent the channel number e.g., high_pass1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-high-passn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-high-passn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-hp-filter-ordern-field a owl:Class ;
    rdfs:label "NXlockin/hp_filter_orderN"^^xsd:string ;
    rdfs:comment """
            Order of the high-pass filter applied on the input or demodulated
            signal. This is used mainly to suppress a DC component of the input
            signal noise.
            N is envisioned to represent the channel number e.g., hp_filter_order1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-hp-filter-ordern-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-hp-filter-ordern-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-low-passn-field a owl:Class ;
    rdfs:label "NXlockin/low_passN"^^xsd:string ;
    rdfs:comment """
            Frequency of the low-pass filter or cut-off frequency. Only signals below
            this frequency are passed through the filter.
            N is envisioned to represent the channel number e.g., low_pass1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-low-passn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-low-passn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxlockin-lp-filter-ordern-field a owl:Class ;
    rdfs:label "NXlockin/lp_filter_orderN"^^xsd:string ;
    rdfs:comment """
            Order of the low-pass filter applied on the input or demodulated signals (X, Y).
            Reducing the bandwidth or increasing the order reduces noise on the demodulated signals,
            but increases settling and measurement times.
            N is envisioned to represent the channel number e.g., lp_filter_order1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-lp-filter-ordern-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-lp-filter-ordern-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxlockin-modulation-frequency-field a owl:Class ;
    rdfs:label "NXlockin/modulation_frequency"^^xsd:string ;
    rdfs:comment """
            The frequency of the sine modulation that is used to modulate the signal in
            lock-in.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-modulation-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-modulation-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-modulation-status-field a owl:Class ;
    rdfs:label "NXlockin/modulation_status"^^xsd:string ;
    rdfs:comment """
            Switch the lock-in modulation on or off.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-modulation-status-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-modulation-status-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        :NeXusField .

:nxlockin-phase-difference-field a owl:Class ;
    rdfs:label "NXlockin/phase_difference"^^xsd:string ;
    rdfs:comment """
            Phase difference between the input signal and the reference signal.
            This is used in two phase lock-in amplifiers.
            In single phase lock-in amplifiers, this value is set to zero.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-phase-difference-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-phase-difference-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxlockin-phase-modulation-bandwidth-field a owl:Class ;
    rdfs:label "NXlockin/phase_modulation_bandwidth"^^xsd:string ;
    rdfs:comment """
            The bandwidth of the modulating signal over which modulated signal spreads.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-phase-modulation-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-phase-modulation-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxlockin-ref-offset-phasen-field a owl:Class ;
    rdfs:label "NXlockin/ref_offset_phaseN"^^xsd:string ;
    rdfs:comment """
            An extra phase offset added to the reference signal in modulation step.
            N is envisioned to represent the channel number e.g., hp_filter_order1.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-ref-offset-phasen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-ref-offset-phasen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxlockin-reference-amplitude-field a owl:Class ;
    rdfs:label "NXlockin/reference_amplitude"^^xsd:string ;
    rdfs:comment """
            Amplitude of the reference signal for the lock-in amplifier.
            Unit could be NX_VOLTAGE or NX_CURRENT depending on the type of the reference signal.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-reference-amplitude-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-reference-amplitude-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
