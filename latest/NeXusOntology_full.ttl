:NXsolenoid_magnet a owl:Class ;
    rdfs:label "NXsolenoid_magnet"^^xsd:string ;
    rdfs:comment "definition for a solenoid magnet."^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsolenoid_magnet.html> ;
