:nxspm-entry-instrument-software-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/software"^^xsd:string ;
    rdfs:comment """
                    The software description of core instrument setup of experiment.
                    Usually, the entire instrument is supplied by a single name/manufacturer/model/etc.
                    To describe the software from any sub-components, use the ``software`` group of that component.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-software-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-software-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-software-model-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-software-vendor-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-software-name-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxinstrument-fabrication-group .

