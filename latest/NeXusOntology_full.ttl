            owl:onClass :nxwaveplate-retardance-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxwaveplate-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxwaveplate-reflectance-field ;
            owl:onProperty :has ],
        :NXcomponent,
        :NeXusBaseClass ;
    :extends "NXcomponent"^^xsd:string .

:NXxlaue a owl:Class ;
    rdfs:label "NXxlaue"^^xsd:string ;
    rdfs:comment """
    raw data from a single crystal laue camera, extends :ref:`NXxrot`
    
    This is the application definition for raw data from a single crystal laue 
    camera. It extends :ref:`NXxrot`.
  """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXxlaue.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXxlaue.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxlaue-entry-group ;
            owl:onProperty :has ],
        :NXxrot,
        :NeXusApplicationClass ;
    :extends "NXxrot"^^xsd:string .

:NXxraylens a owl:Class ;
    rdfs:label "NXxraylens"^^xsd:string ;
    rdfs:comment """
      An X-ray lens, typically at a synchrotron X-ray beam line.
      
      Based on information provided by Gerd Wellenreuther (DESY).
      """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXxraylens.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXxraylens.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-lens-length-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-symmetric-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-lens-thickness-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-lens-material-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-off-geometry-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-curvature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-aperture-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-focus-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-gas-pressure-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-gas-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-number-of-lenses-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-depends-on-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-cylinder-orientation-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-lens-geometry-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxraylens-cylindrical-field ;
            owl:onProperty :has ],
        :NXcomponent,
        :NeXusBaseClass ;
    :extends "NXcomponent"^^xsd:string .

:NXxrd a owl:Class ;
    rdfs:label "NXxrd"^^xsd:string ;
    rdfs:comment """
        NXxrd on top of NXmonopd
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXxrd.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXxrd.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxrd-entry-group ;
            owl:onProperty :has ],
        :NXmonopd,
        :NeXusApplicationClass ;
    :extends "NXmonopd"^^xsd:string .

:NXxrot a owl:Class ;
    rdfs:label "NXxrot"^^xsd:string ;
    rdfs:comment """
    raw data from a rotation camera, extends :ref:`NXxbase` 
    
    This is the application definition for raw data from a rotation camera.
    It extends :ref:`NXxbase`, so the full definition is the content of :ref:`NXxbase`
    plus the data defined here.
  """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXxrot.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXxrot.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxrot-entry-group ;
            owl:onProperty :has ],
        :NXxbase,
        :NeXusApplicationClass ;
    :extends "NXxbase"^^xsd:string .

:nxaberration-alias-field a owl:Class ;
    rdfs:label "NXaberration/alias"^^xsd:string ;
    rdfs:comment """
            Alias to name or refer to this specific type of aberration.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-alias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-alias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxaberration-angle-field a owl:Class ;
    rdfs:label "NXaberration/angle"^^xsd:string ;
    rdfs:comment """
            For the CEOS definitions the C aberrations are radial-symmetric and have
            no angle entry, while the A, B, D, S, or R aberrations are n-fold
            symmetric and have an angle entry.
            For the NION definitions the coordinate system differs to the one
            used in CEOS and instead two aberration coefficients a and b are used.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-angle-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-angle-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        :NeXusField .

:nxaberration-delta-time-field a owl:Class ;
    rdfs:label "NXaberration/delta_time"^^xsd:string ;
    rdfs:comment """
            Time elapsed since the last measurement.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-delta-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-delta-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxaberration-magnitude-errors-field a owl:Class ;
    rdfs:label "NXaberration/magnitude_errors"^^xsd:string ;
    rdfs:comment """
            Uncertainty of the magnitude of the aberration
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-magnitude-errors-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-magnitude-errors-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxobject-fieldname-errors-field .

:nxaberration-magnitude-errors-model-field a owl:Class ;
    rdfs:label "NXaberration/magnitude_errors_model"^^xsd:string ;
    rdfs:comment """
            Free-text description how magnitude_errors was quantified
            e.g. via the 95% confidence interval, variance, standard deviation,
            using which algorithm or statistical model.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-magnitude-errors-model-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-magnitude-errors-model-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxaberration-name-field a owl:Class ;
    rdfs:label "NXaberration/name"^^xsd:string ;
    rdfs:comment """
            Given name to this aberration.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-name-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaberration.html#nxaberration-name-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxactivity-description-field a owl:Class ;
    rdfs:label "NXactivity/description"^^xsd:string ;
    rdfs:comment """
             Short description of the activity.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-description-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-description-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxactivity-end-time-estimated-attribute a owl:Class ;
    rdfs:label "NXactivity/end_time/estimated"^^xsd:string ;
    rdfs:comment """
                In some cases, the end time of an activity can only be estimated. In this case,
                this attribute shall be True.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-end-time-estimated-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-end-time-estimated-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        :NeXusAttribute .

:nxactivity-note-group a owl:Class ;
    rdfs:label "NXactivity/NOTE"^^xsd:string ;
    rdfs:comment """
             This can be any data or other descriptor acquired during the activity
             (NXnote allows to add pictures, audio, movies). Alternatively, a
             reference to the location or a unique identifier or other metadata file. In the
             case these are not available, free-text description.

             Any number of instances of :ref:`NXnote` are allowed for describing extra details of
             this activity.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-note-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactivity.html#nxactivity-note-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxobject-note-group .

:nxactuator-outputvalue-field a owl:Class ;
    rdfs:label "NXactuator/outputVALUE"^^xsd:string ;
    rdfs:comment """
             Any output that the actuator produces.
             For example, a heater can have the field output_power(NX_NUMBER).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-outputvalue-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-outputvalue-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxactuator-short-name-field a owl:Class ;
    rdfs:label "NXactuator/short_name"^^xsd:string ;
    rdfs:comment """
             Short name of actuator used e.g. on monitor display program
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-short-name-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-short-name-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxafm-entry-definition-nxafm-enum a owl:Class ;
    rdfs:label "NXafm/ENTRY/definition/NXafm"^^xsd:string ;
    rdfs:comment "Enumeration item for NXafm/ENTRY/definition: NXafm"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-definition-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-definition-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "NXafm"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxafm-entry-experiment-technique-afm-enum a owl:Class ;
    rdfs:label "NXafm/ENTRY/experiment_technique/AFM"^^xsd:string ;
    rdfs:comment "Enumeration item for NXafm/ENTRY/experiment_technique: AFM"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-experiment-technique-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-experiment-technique-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "AFM"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxafm-entry-group a owl:Class ;
    rdfs:label "NXafm/ENTRY"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-resolution-indicators-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-scan-mode-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-experiment-technique-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-reproducibility-indicators-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-definition-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-group .

:nxafm-entry-instrument-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-phase-lock-loop-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-scan-environment-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-spm-cantilever-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-head-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-photo-detector-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-instrument-group .

:nxafm-entry-instrument-head-temperature-sensor-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT/head_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                    The temperature of the scan environment or head of the cantilever.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-head-temperature-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-head-temperature-sensor-group> ;
    rdfs:subClassOf :NXsensor,
        :NeXusGroup .

:nxafm-entry-instrument-phase-lock-loop-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT/phase_lock_loop"^^xsd:string ;
    rdfs:comment """
                    Phase locked loop for cantilever lock-in device.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-phase-lock-loop-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-phase-lock-loop-group> ;
    rdfs:subClassOf :NXphase_lock_loop,
        :NeXusGroup .

:nxafm-entry-instrument-photo-detector-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT/photo_detector"^^xsd:string ;
    rdfs:comment """
                    Information about the quadrant photodiode deflection detector or interferometer.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-photo-detector-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-photo-detector-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-photo-detector-sensor-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxinstrument-detector-group .

:nxafm-entry-instrument-photo-detector-sensor-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT/photo_detector/SENSOR"^^xsd:string ;
    rdfs:comment """
                        The sensor information for the photodiode or interferometer.
                    """^^xsd:string ;
