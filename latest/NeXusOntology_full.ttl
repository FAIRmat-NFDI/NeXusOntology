            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxem-eds-indexing-peak-atom-group ;
            owl:onProperty :has ],
        :NXpeak,
        :NeXusGroup .

:nxem-eds-indexing-program-group a owl:Class ;
    rdfs:label "NXem_eds/indexing/PROGRAM"^^xsd:string ;
