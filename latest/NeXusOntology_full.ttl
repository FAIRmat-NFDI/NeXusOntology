            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcoordinate-system-z-field ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

