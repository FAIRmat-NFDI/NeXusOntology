:nxspm-entry-instrument-current-sensortag-current-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/current_sensorTAG/current"^^xsd:string ;
    rdfs:comment """
                        Name of the current according to the purpose of the measurement.
                        E.g., the field can be named as tip_current defining the current measured at the tip.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-current-sensortag-current-field> ;
