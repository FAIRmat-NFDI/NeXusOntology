            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        :NeXusField .

:nxmicrostructure-score-config-entry-numerics-cell-cache-defragment-x-field a owl:Class ;
    rdfs:label "NXmicrostructure_score_config/ENTRY/numerics/cell_cache/defragment_x"^^xsd:string ;
