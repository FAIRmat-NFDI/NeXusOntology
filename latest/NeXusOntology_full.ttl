            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxps-entry-instrument-source-probe-group ;
            owl:onProperty :has ],
