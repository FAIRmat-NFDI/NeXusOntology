            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-neighbors-field a owl:Class ;
    rdfs:label "NXapm_paraprobe_tessellator_config/ENTRY/tessellateID/has_cell_neighbors"^^xsd:string ;
