    rdfs:subClassOf :NeXusGroup,
        :nxspm-entry-instrument-bias-spectroscopy-environment-group .

:nxstm-entry-instrument-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-group> ;
