            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxmpes-entry-transmission-correction-transmission-function-signal-attribute a owl:Class ;
    rdfs:label "NXmpes/ENTRY/transmission_correction/transmission_function/signal"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
