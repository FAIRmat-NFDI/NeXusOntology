    rdfs:subClassOf :NeXusGroup,
        :nxsensor-scan-entry-instrument-environment-sensor-group .

:nxstm-entry-instrument-scan-environment-cryo-shield-temperature-sensor-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/cryo_shield_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                        This should be a link to
                        /entry/instrument/cryo_shield_temperature_sensor
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-cryo-shield-temperature-sensor-group> ;
