:nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment/SPM_BIAS_SPECTROSCOPY"^^xsd:string ;
    rdfs:comment """
                        Setup and scan data for continuous measurement of bias voltage on the subject of experiment
                        vs tunneling current from probe.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-group ;
            owl:onProperty :has ],
        :NXspm_bias_spectroscopy,
        :NeXusGroup .

