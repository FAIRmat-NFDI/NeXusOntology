        :NXactuator,
        :NeXusGroup .

:nxspm-positioner-z-controller-controller-label-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/controller_label"^^xsd:string ;
    rdfs:comment """
                Controller label. This label which will be displayed at places where you can
                select a channel or controller.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-controller-label-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-controller-label-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-positioner-z-controller-d-t-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/D_t"^^xsd:string ;
    rdfs:comment """
                The derivative time constant of the derivative part of the PID controller. Proportional Derivative constant
                K_d can be expressed as :math:`K_d = K_p D_t`.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-d-t-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-d-t-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-positioner-z-controller-feedback-on-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/feedback_on"^^xsd:string ;
    rdfs:comment """
                The status of the controller PID feedback system in z-axis is ON / OFF.
                E.g., for constant height mode, the z-controller feedback system is off.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-feedback-on-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-feedback-on-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-positioner-z-controller-final-z-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/final_z"^^xsd:string ;
    rdfs:comment """
                The final Z position of the tip after the scan.
                This parameter is used to indicate any unexpected displacement of the tip.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-final-z-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-final-z-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-positioner-z-controller-i-t-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/I_t"^^xsd:string ;
    rdfs:comment """
                The integral time constant of the integral part of the PID controller. Proportional Integral constant
                K_i can be expressed as :math:`K_i = \\frac{K_p}{I_t}`.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-i-t-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-i-t-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-positioner-z-controller-set-point-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/set_point"^^xsd:string ;
    rdfs:comment """
                The set point for the z-controller to be fixed and the target value could be
                height or current.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-set-point-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-set-point-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-positioner-z-controller-switch-off-delay-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/switch_off_delay"^^xsd:string ;
    rdfs:comment """
                The switch-off delay of the controller from its stable point.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-switch-off-delay-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-switch-off-delay-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR_OR_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR_OR_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-positioner-z-controller-tip-lift-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/tip_lift"^^xsd:string ;
    rdfs:comment """
                If the tip is lifted from the stable point.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-tip-lift-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-tip-lift-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-positioner-z-controller-z-average-time-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/z_average_time"^^xsd:string ;
    rdfs:comment """
                The averaging time for stabilizing the Z position.
                Usually, the signal for z-position contains noise, to reduce the noise
                impacts, z-position is being averaged over this time window.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-average-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-average-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-positioner-z-controller-z-controller-hold-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/z_controller_hold"^^xsd:string ;
    rdfs:comment """
                Controller feedback system status: OFF / ON.
                The `z_controller_hold-field` is True, refers feedback system off
                (mostly case in STS bias spectra) and False refers feedback system on
                (mostly case in STM constant current spectra).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-controller-hold-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-controller-hold-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-positioner-z-controller-z-controller-time-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/z_controller_time"^^xsd:string ;
    rdfs:comment """
                Time taken by the Z controller to switch mode e.g., feedback off from on and vice versa.
                In this time window, controller fixed its position if feedback changed to off mode.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-controller-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-controller-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-positioner-z-controller-z-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/z"^^xsd:string ;
    rdfs:comment """
                To indicate the relative tip position z between tip and sample. The tip position
                can also be varied when the z_controller is not running.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        :NeXusField .

:nxspm-positioner-z-controller-z-offset-value-field a owl:Class ;
    rdfs:label "NXspm_positioner/z_controller/z_offset_value"^^xsd:string ;
    rdfs:comment """
                Offset added to the initial averaged tip position on Z-axis before starting
                scan.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-offset-value-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_positioner.html#nxspm-positioner-z-controller-z-offset-value-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-control-accuracyn-field a owl:Class ;
    rdfs:label "NXspm_scan_control/accuracyN"^^xsd:string ;
    rdfs:comment """
            Define the accuracy of the scan probe.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-accuracyn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-accuracyn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-scan-control-independent-scan-axes-field a owl:Class ;
    rdfs:label "NXspm_scan_control/independent_scan_axes"^^xsd:string ;
    rdfs:comment """
            An array of scan axes which are controlled independently of each other.
            (e.g. X, Y, Z, or other physical dimensions)
            
            The array elements are in the order of axes of the scan from the fastest to the slowest.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-independent-scan-axes-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-independent-scan-axes-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-scan-control-scan-control-type-field a owl:Class ;
    rdfs:label "NXspm_scan_control/scan_control_type"^^xsd:string ;
    rdfs:comment """
            This string describes how the scan was performed.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-control-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-control-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxspm-scan-control-scan-control-type-stepping-enum :nxspm-scan-control-scan-control-type-continuous-enum :nxspm-scan-control-scan-control-type-oscillating-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxspm-scan-control-scan-resolutionn-field a owl:Class ;
    rdfs:label "NXspm_scan_control/scan_resolutionN"^^xsd:string ;
    rdfs:comment """
            Define the scan resolution along each dimension as the number of steps per unit of the dimension parameters.
            
            Rename the field according to the name of the independent dimension (e.g. scan_resolution_x, scan_resolution_voltage).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-resolutionn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-resolutionn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-control-scan-time-end-field a owl:Class ;
    rdfs:label "NXspm_scan_control/scan_time_end"^^xsd:string ;
    rdfs:comment """
            The end time of the scan.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-time-end-field> ;
