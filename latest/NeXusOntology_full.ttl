    rdfs:subClassOf :NeXusGroup,
        :nxsensor-scan-entry-instrument-environment-sensor-group .

:nxstm-entry-instrument-scan-environment-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT"^^xsd:string ;
    rdfs:comment """
                    The environment information for stm or sts experiment.
                    
                    Note: At least one field from head_temperature, cryo_bottom_temperature and cryo_shield_temperature must be provided.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-instrument-scan-environment-cryo-bottom-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-instrument-scan-environment-head-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-instrument-scan-environment-cryo-shield-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-instrument-scan-environment-spm-scan-control-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-instrument-scan-environment-lockin-status-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-instrument-scan-environment-group .

:nxstm-entry-instrument-scan-environment-head-temperature-sensor-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/head_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                        This should be a link to
                        /entry/instrument/head_temperature_sensor
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-head-temperature-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-head-temperature-sensor-group> ;
