    :extends "NXobject"^^xsd:string .

:NXlockin a owl:Class ;
    rdfs:label "NXlockin"^^xsd:string ;
    rdfs:comment """
        A base class definition for a lock-in amplifier.
        
        The lock-in amplifier information: the device is being used to extract a (potentially)
        very weak input signal buried in the noisy background, where the input signal has
        the same frequency (or its harmonic) as carrier signal or reference signal, using heterodyne
        detection.
        
        This method extracts the amplitude and phase shift between input signal and reference signal.
        
        In single phase lock-in amplifiers used in high signal-to-noise ratio applications, only
        the amplitude is measured and phase difference is set to zero.
        
        In two phase lock-in amplifiers used in low signal-to-noise ratio applications, both the
        amplitude and phase difference are measured.
        
        Fields with partial names like low_passN, high_passN, etc., can be repeated for each channel
        of the lockin amplifier. It is envisioned that these fields are named low_pass_0, low_pass_1,
        and so on.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-reference-phase-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-sensitivity-factor-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-hp-filter-ordern-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-low-passn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-demodulated-signal-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-ref-offset-phasen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-demodulated-amplitude-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-frequency-modulation-bandwidth-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-demodulator-channels-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-modulation-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-demodulated-phase-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-amplitude-modulation-bandwidth-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-reference-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-hardware-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-high-passn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-bias-divider-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-demodulated-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-lp-filter-ordern-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-dc-offset-valuen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxlockin-modulation-status-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
