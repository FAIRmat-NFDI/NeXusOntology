:nxapm-paraprobe-nanochem-config-entry-oned-profileid-feature-checksum-field a owl:Class ;
    rdfs:label "NXapm_paraprobe_nanochem_config/ENTRY/oned_profileID/feature/checksum"^^xsd:string ;
