    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
