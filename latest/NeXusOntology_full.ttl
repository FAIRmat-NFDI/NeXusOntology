:nxspm-entry-definition-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/definition"^^xsd:string ;
    rdfs:comment """
                Name of the definition that is used for the application.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-definition-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-definition-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:unionOf ( [ a owl:Restriction ;
                                                owl:allValuesFrom [ a owl:Class ;
                                                        owl:unionOf ( :nxspm-entry-definition-nxspm-enum ) ] ;
                                                owl:onProperty :hasEnumContainer ] :nxafm-entry-definition-field ) ] :nxstm-entry-definition-field ) ] :nxsts-entry-definition-field ) ],
        :NeXusField,
        :nxsensor-scan-entry-definition-field .

:nxspm-scan-pattern-scan-pointsn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/scan_pointsN"^^xsd:string ;
    rdfs:comment """
            Define the total number of points in the given axis the scan to be performed (except the spiral and trajectory scans).
            Rename the field, according to the name of the dimension (e.g. scan_points_x, scan_points_voltage).
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-scan-pointsn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-scan-pointsn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxuser-affiliation-field a owl:Class ;
    rdfs:label "NXuser/affiliation"^^xsd:string ;
