            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusAttribute,
        :nxdata-axes-attribute .

:nxstress-entry-fit-diffractogram-background-interpretation-attribute a owl:Class ;
    rdfs:label "NXstress/ENTRY/FIT/DIFFRACTOGRAM/background/interpretation"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-diffractogram-background-interpretation-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-diffractogram-background-interpretation-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxstress-entry-fit-diffractogram-background-interpretation-spectrum-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusAttribute .

:nxstress-entry-fit-diffractogram-background-interpretation-spectrum-enum a owl:Class ;
    rdfs:label "NXstress/ENTRY/FIT/DIFFRACTOGRAM/background/interpretation/spectrum"^^xsd:string ;
    rdfs:comment "Enumeration item for NXstress/ENTRY/FIT/DIFFRACTOGRAM/background/interpretation: spectrum"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-diffractogram-background-interpretation-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-diffractogram-background-interpretation-attribute> ;
