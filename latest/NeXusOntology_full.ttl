:nxcrystal-unit-cell-c-field a owl:Class ;
    rdfs:label "NXcrystal/unit_cell_c"^^xsd:string ;
    rdfs:comment "Unit cell lattice parameter: length of side c"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXcrystal.html#nxcrystal-unit-cell-c-field> ;
