:nxapm-paraprobe-distancer-config-entry-point-to-triangleid-triangle-setid-face-normals-field a owl:Class ;
    rdfs:label "NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/triangle_setID/face_normals"^^xsd:string ;
