            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField ;
    owl:equivalentClass :nxmonitor-data-field .

:nxazint2d-entry-monitor-group a owl:Class ;
    rdfs:label "NXazint2d/ENTRY/MONITOR"^^xsd:string ;
