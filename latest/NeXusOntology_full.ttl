:nxshape-direction-concave-enum a owl:Class ;
    rdfs:label "NXshape/direction/concave"^^xsd:string ;
    rdfs:comment "Enumeration item for NXshape/direction: concave"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXshape.html#nxshape-direction-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXshape.html#nxshape-direction-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "concave"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations ;
    owl:disjointWith :nxshape-direction-convex-enum .

:nxshape-direction-field a owl:Class ;
    rdfs:label "NXshape/direction"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXshape.html#nxshape-direction-field> ;
