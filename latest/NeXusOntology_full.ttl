    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG/calibration/calibration_parameters"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-calibration-calibration-parameters-group> ;
