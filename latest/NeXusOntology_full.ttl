            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcrystal-curvature-horizontal-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcrystal-off-geometry-group ;
