            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "band_contrast"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxem-ebsd-indexing-roi-descriptor-confidence-index-enum a owl:Class ;
    rdfs:label "NXem_ebsd/indexing/roi/descriptor/confidence_index"^^xsd:string ;
