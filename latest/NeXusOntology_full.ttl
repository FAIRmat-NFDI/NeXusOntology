:nxoptical-spectroscopy-entry-title-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/title"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-title-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-title-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField ;
    owl:equivalentClass :nxentry-title-field .

:nxpeak-data-group a owl:Class ;
    rdfs:label "NXpeak/data"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxpeak-data-intensity-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxpeak-data-position-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxobject-data-group .

:nxpeak-data-intensity-field a owl:Class ;
    rdfs:label "NXpeak/data/intensity"^^xsd:string ;
    rdfs:comment """
                This array holds the intensity/count values of the fitted peak at each position.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-intensity-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-intensity-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxpeak-data-position-field a owl:Class ;
    rdfs:label "NXpeak/data/position"^^xsd:string ;
    rdfs:comment """
                Position values along one or more data dimensions (to hold the
                values for the independent variable).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-position-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-position-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxpeak-function-group a owl:Class ;
    rdfs:label "NXpeak/function"^^xsd:string ;
    rdfs:comment """
            The functional form of the peak. This could be a Gaussian, Lorentzian, Voigt,
            etc.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-function-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-function-group> ;
    rdfs:subClassOf :NXfit_function,
        :NeXusGroup .

:nxpositioner-description-field a owl:Class ;
    rdfs:label "NXpositioner/description"^^xsd:string ;
    rdfs:comment "description of positioner"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpositioner.html#nxpositioner-description-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpositioner.html#nxpositioner-description-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxcomponent-description-field .

:nxprogram-program-url-attribute a owl:Class ;
    rdfs:label "NXprogram/program/url"^^xsd:string ;
    rdfs:comment """
                Description of an ideally ever persistent resource where the source code
                of the program or this specific compiled version of the program can be
                found so that the program yields repeatably exactly the same numerical
                and categorical results.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXprogram.html#nxprogram-program-url-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXprogram.html#nxprogram-program-url-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxresolution-relative-resolution-field a owl:Class ;
    rdfs:label "NXresolution/relative_resolution"^^xsd:string ;
    rdfs:comment """
             Ratio of the resolution at a specified measurand value to that measurand value.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-relative-resolution-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-relative-resolution-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxsample-history-group a owl:Class ;
    rdfs:label "NXsample/history"^^xsd:string ;
    rdfs:comment """
        	A set of physical processes that occurred to the sample prior/during experiment.
		"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-history-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-history-group> ;
    rdfs:subClassOf :NXhistory,
        :NeXusGroup .

:nxsample-situation-field a owl:Class ;
    rdfs:label "NXsample/situation"^^xsd:string ;
    rdfs:comment """
			The atmosphere will be one of the components, which is where 
			its details will be stored; the relevant components will be 
			indicated by the entry in the sample_component member.
		"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-situation-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-situation-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :nxsample-situation-air-enum :nxsample-situation-vacuum-enum :nxsample-situation-inert-atmosphere-enum :nxsample-situation-oxidising-atmosphere-enum :nxsample-situation-reducing-atmosphere-enum :nxsample-situation-sealed-can-enum :nxsample-situation-other-enum ) ] ;
                        owl:onProperty :hasEnumContainer ] :nxmpes-entry-sample-situation-field ) ],
        :NeXusField .

:nxsample-stress-field-field a owl:Class ;
    rdfs:label "NXsample/stress_field"^^xsd:string ;
    rdfs:comment "Applied external stress field"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-stress-field-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-stress-field-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsample-stress-field-direction-attribute ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxsample-temperature-env-group a owl:Class ;
    rdfs:label "NXsample/temperature_env"^^xsd:string ;
    rdfs:comment "Additional sample temperature environment information"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-env-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-env-group> ;
    rdfs:subClassOf :NXenvironment,
        :NeXusGroup .

:nxsample-thickness-field a owl:Class ;
    rdfs:label "NXsample/thickness"^^xsd:string ;
    rdfs:comment "sample thickness"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-thickness-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-thickness-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxsample-type-field a owl:Class ;
    rdfs:label "NXsample/type"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-type-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom [ a owl:Class ;
                                owl:unionOf ( :nxsample-type-sample-enum :nxsample-type-sample-can-enum :nxsample-type-can-enum :nxsample-type-sample-buffer-enum :nxsample-type-buffer-enum :nxsample-type-calibration-sample-enum :nxsample-type-normalisation-sample-enum :nxsample-type-simulated-data-enum :nxsample-type-none-enum :nxsample-type-sample-environment-enum ) ] ;
                        owl:onProperty :hasEnumContainer ] :nxarchive-entry-sample-type-field ) ],
        :NeXusField .

:nxscan-controller-dwell-time-field a owl:Class ;
    rdfs:label "NXscan_controller/dwell_time"^^xsd:string ;
    rdfs:comment """
            Time period during which the beam remains at one position.
            
            This concept is related to term `Dwell Time`_ of the EMglossary standard.
            
            .. _Dwell Time: https://purls.helmholtz-metadaten.de/emg/EMG_00000015
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-dwell-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-dwell-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxscan-controller-scan-schema-field a owl:Class ;
    rdfs:label "NXscan_controller/scan_schema"^^xsd:string ;
    rdfs:comment """
            Name of the typically tech-partner-specific term that specifies an
            automated protocol which details how the components of the scan_box
            and the instrument work together to achieve a controlled
            scanning of the beam (over the sample surface).
            
            Oftentimes users do not need to or are not able to disentangle the intricate
            details of the spatiotemporal dynamics of their instrument. Instead, often
            they rely on the assumption that the instrument and its controlling programs
            work as expected. The field scan_schema can be used to add some constraints
            on how the beam was scanned over the surface.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-scan-schema-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-scan-schema-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxsensor-scan-entry-data-group a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY/DATA"^^xsd:string ;
    rdfs:comment """
                A scan specific representation of the measured signals as a function of the independently controlled environment settings.
                Plot of every measured signal as a function of the timestamp of when they have been acquired is also possible.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-data-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-data-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxentry-data-group .

:nxsensor-scan-entry-definition-field a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY/definition"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-definition-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-definition-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom [ a owl:Class ;
                                            owl:unionOf ( :nxsensor-scan-entry-definition-nxsensor-scan-enum ) ] ;
                                    owl:onProperty :hasEnumContainer ] :nxiv-temp-entry-definition-field ) ] :nxspm-entry-definition-field ) ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-definition-version-attribute ;
            owl:onProperty :has ],
        :NeXusField,
        :nxentry-definition-field .

:nxsensor-scan-entry-group a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-identifier-collection-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-definition-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-end-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-process-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-data-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-identifier-experiment-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-user-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-default-attribute ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-sample-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-start-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-note-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-experiment-description-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-group ;
            owl:onProperty :has ],
        :NXentry,
        :NeXusGroup .

:nxsensor-scan-entry-instrument-group a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY/INSTRUMENT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-environment-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-instrument-group .

:nxsensor-scan-entry-sample-group a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY/SAMPLE"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-sample-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-sample-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-sample-history-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-sample-name-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-sample-group .

:nxsource-frequency-field a owl:Class ;
    rdfs:label "NXsource/frequency"^^xsd:string ;
    rdfs:comment "Frequency of pulsed source"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxsource-power-field a owl:Class ;
    rdfs:label "NXsource/power"^^xsd:string ;
    rdfs:comment "Source power"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-power-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-power-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_POWER ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxspm-entry-instrument-bias-spectroscopy-environment-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment"^^xsd:string ;
    rdfs:comment """
                    To explain bias and current behavior (sweep measurement especially in STS experiment)
                    due to voltage applied to the sample.
                    
                    In some experiments, e.g., STM, bias spectroscopy could also be part of the measurement setup.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-scan-entry-instrument-environment-group .

:nxspm-entry-instrument-lockin-amplifier-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/lockin_amplifier"^^xsd:string ;
    rdfs:comment """
                    The lock-in amplifier information.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-lockin-amplifier-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-lockin-amplifier-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-lockin-amplifier-active-channel-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-lockin-amplifier-flip-sign-field ;
            owl:onProperty :has ],
        :NXlockin,
        :NeXusGroup .

:nxspm-entry-instrument-scan-environment-spm-scan-control-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/SPM_SCAN_CONTROL"^^xsd:string ;
    rdfs:comment """
                        The scan control information like scan region or phase space, type of scan (e.g.
                        mesh, spiral, etc.), and scan speed, etc. This group mainly stores the scan settings
                        data. For processed data or final experimental data would go to NXdata group.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-scan-environment-spm-scan-control-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-scan-environment-spm-scan-control-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-spm-scan-control-meshscan-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-spm-scan-control-scantag-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-spm-scan-control-scan-region-group ;
            owl:onProperty :has ],
        :NXspm_scan_control,
        :NeXusGroup .

:nxspm-entry-reproducibility-indicators-link-to-field-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/reproducibility_indicators/LINK_TO_FIELD"^^xsd:string ;
    rdfs:comment """
                    A place holder to create link to any field relevant considered as
                    reproducibility indicators (defined by laboratory).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-link-to-field-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-link-to-field-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-entry-resolution-indicators-link-to-field-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/resolution_indicators/LINK_TO_FIELD"^^xsd:string ;
    rdfs:comment """
                    A place holder to create link to any field relevant considered as
                    reproducibility indicators (defined by laboratory).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-link-to-field-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-link-to-field-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-scan-control-scan-region-group a owl:Class ;
    rdfs:label "NXspm_scan_control/scan_region"^^xsd:string ;
    rdfs:comment """
            The scan region is the area of phase space or sub-phase space where the scan is
            performed. The region could be N-dimensional and is defined by the minimum and
            maximum values of the scan axes.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-region-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-region-group> ;
    rdfs:subClassOf :NXspm_scan_region,
        :NeXusGroup .

:nxspm-scan-region-scan-anglen-field a owl:Class ;
    rdfs:label "NXspm_scan_region/scan_angleN"^^xsd:string ;
    rdfs:comment """
            The orientation of the scan region or subspace. Usually, the scan_offset and scan_range are enough
            to define the scan region. This field defines how the spatial space is oriented with respect to
            the frame of reference.
            
            Rename the field describing the angle with an axis of the spatial space (e.g. scan_angle_x).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-anglen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-anglen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
