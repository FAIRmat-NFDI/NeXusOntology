:nxspm-entry-instrument-voltage-sensortag-calibration-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/voltage_sensorTAG/calibration"^^xsd:string ;
    rdfs:comment """
                        Calibration data of the voltage sensor.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-calibration-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-calibration-group> ;
