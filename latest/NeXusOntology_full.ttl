    rdfs:label "NXstxm/ENTRY/DATA/stxm_scan_type/osa image"^^xsd:string ;
    rdfs:comment "Enumeration item for NXstxm/ENTRY/DATA/stxm_scan_type: osa image"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
