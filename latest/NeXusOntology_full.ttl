                    owl:complementOf :NX_UINT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        :NeXusField .

:nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-group a owl:Class ;
    rdfs:label "NXapm_paraprobe_clusterer_config/ENTRY/cluster_analysisID"^^xsd:string ;
