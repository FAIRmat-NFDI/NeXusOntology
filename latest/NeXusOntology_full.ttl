        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxlockin-reference-frequency-field a owl:Class ;
    rdfs:label "NXlockin/reference_frequency"^^xsd:string ;
    rdfs:comment """
            Frequency of the reference signal for the lock-in amplifier.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-reference-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-reference-frequency-field> ;
