:nxspm-entry-instrument-head-temperature-sensor-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/head_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                    The temperature of the SPM measured near the sample or tip. This group is intended to be used for
                    an array data (e.g., time series).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-head-temperature-sensor-group> ;
