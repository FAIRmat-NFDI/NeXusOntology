:nxstxm-entry-data-stxm-scan-type-detector-image-enum a owl:Class ;
    rdfs:label "NXstxm/ENTRY/DATA/stxm_scan_type/detector image"^^xsd:string ;
    rdfs:comment "Enumeration item for NXstxm/ENTRY/DATA/stxm_scan_type: detector image"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "detector image"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxstxm-entry-data-stxm-scan-type-field a owl:Class ;
    rdfs:label "NXstxm/ENTRY/DATA/stxm_scan_type"^^xsd:string ;
    rdfs:comment """ Label for typical scan types as a convenience for humans. 
                Each label corresponds to a specific set of axes being scanned 
                to produce a data array of shape:
                
                * sample point spectrum: (photon_energy,)
                * sample line spectrum: (photon_energy, sample_y/sample_x)
                * sample image: (sample_y, sample_x)
                * sample image stack: (photon_energy, sample_y, sample_x)
                * sample focus: (zoneplate_z, sample_y/sample_x)
                * osa image: (osa_y, osa_x)
                * osa focus: (zoneplate_z, osa_y/osa_x)
                * detector image: (detector_y, detector_x)
                
                The "generic scan" string is to be used when none of the 
                other choices are appropriate.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxstxm-entry-data-stxm-scan-type-sample-point-spectrum-enum :nxstxm-entry-data-stxm-scan-type-sample-line-spectrum-enum :nxstxm-entry-data-stxm-scan-type-sample-image-enum :nxstxm-entry-data-stxm-scan-type-sample-image-stack-enum :nxstxm-entry-data-stxm-scan-type-sample-focus-enum :nxstxm-entry-data-stxm-scan-type-osa-image-enum :nxstxm-entry-data-stxm-scan-type-osa-focus-enum :nxstxm-entry-data-stxm-scan-type-detector-image-enum :nxstxm-entry-data-stxm-scan-type-generic-scan-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxstxm-entry-data-stxm-scan-type-generic-scan-enum a owl:Class ;
    rdfs:label "NXstxm/ENTRY/DATA/stxm_scan_type/generic scan"^^xsd:string ;
    rdfs:comment "Enumeration item for NXstxm/ENTRY/DATA/stxm_scan_type: generic scan"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field> ;
