    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/linear_sweep/backward_sweep"^^xsd:string ;
    rdfs:comment """
                    If the bias voltage sweep is also performed in the opposite direction.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-backward-sweep-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-backward-sweep-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-linear-sweep-data-group a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/linear_sweep/DATA"^^xsd:string ;
    rdfs:comment """
                    The scan data is the data collected during the scan.
                    If the scan has several channels or derivatives from the channel data,
                    please duplicate this NXdata group for each.
                    
                    To define specific current or voltage use :ref:`DATA </NXdata/DATA-field>`
                    and :ref:`AXISNAME </NXdata/AXISNAME-field>`.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-data-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-data-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxspm-scan-pattern-data-group .

:nxspm-bias-spectroscopy-bias-sweep-linear-sweep-reset-bias-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/linear_sweep/reset_bias"^^xsd:string ;
    rdfs:comment """
                    The reset_bias defines whether the bias voltage should be reset to the starting
                    value after the sweep is completed.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-reset-bias-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-reset-bias-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-linear-sweep-scan-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/linear_sweep/scan_time"^^xsd:string ;
    rdfs:comment """
                    The time taken by the scanner to scan the entire area.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-scan-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-linear-sweep-scan-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-max-slew-rate-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/max_slew_rate"^^xsd:string ;
    rdfs:comment """
                The rate at which the amplifier responds to the voltage change
                (to reach at the desired value). It defines if the tip movement and
                voltage sweep are synchronized.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-max-slew-rate-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-max-slew-rate-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-number-of-sweeps-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/number_of_sweeps"^^xsd:string ;
    rdfs:comment """
                The number of sweeps (a full scan from starting bias to end bias)
                taken during the bias spectroscopy.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-number-of-sweeps-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-number-of-sweeps-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-scan-type-linear-enum a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/scan_type/linear"^^xsd:string ;
    rdfs:comment "Enumeration item for NXspm_bias_spectroscopy/BIAS_SWEEP/scan_type: linear"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "linear"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxspm-bias-spectroscopy-bias-sweep-settling-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/settling_time"^^xsd:string ;
    rdfs:comment """
                The time taken to settle the bias voltage at the desired value. On each sweep usually, the system
                takes time to settle the bias voltage at the next value.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-settling-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-settling-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-bias-spectroscopy-bias-sweep-spatial-location-group a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/spatial_location"^^xsd:string ;
    rdfs:comment """
                The spatial location of the scan points.
                This would be recommended to use if there are multiple bias sweep scans
                at different locations.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-bias-sweep-spatial-location-y-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-bias-sweep-spatial-location-z-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-bias-sweep-spatial-location-x-field ;
            owl:onProperty :has ],
        :NXcoordinate_system,
        :NeXusGroup .

:nxspm-bias-spectroscopy-bias-sweep-spatial-location-x-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/spatial_location/x"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-x-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-x-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField ;
    owl:equivalentClass :nxcoordinate-system-x-field .

:nxspm-bias-spectroscopy-bias-sweep-spatial-location-y-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/spatial_location/y"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-y-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-y-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField ;
    owl:equivalentClass :nxcoordinate-system-y-field .

:nxspm-bias-spectroscopy-bias-sweep-spatial-location-z-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/spatial_location/z"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-z-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-spatial-location-z-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField ;
    owl:equivalentClass :nxcoordinate-system-z-field .

:nxspm-bias-spectroscopy-bias-sweep-total-spectroscopy-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/BIAS_SWEEP/total_spectroscopy_time"^^xsd:string ;
    rdfs:comment """
                The total time needed for the entire voltage sweep.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-total-spectroscopy-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-total-spectroscopy-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-bias-spectroscopy-circuit-acquisition-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/CIRCUIT/acquisition_time"^^xsd:string ;
    rdfs:comment """
                The time or period (average) to acquire the data for a single bias sweep point.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-acquisition-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-acquisition-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxcircuit-acquisition-time-field .

:nxspm-bias-spectroscopy-circuit-animation-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/CIRCUIT/animation_time"^^xsd:string ;
    rdfs:comment """
                The time or period a bias sweep to be displayed.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-animation-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-animation-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-bias-spectroscopy-circuit-group a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/CIRCUIT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-circuit-animation-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-circuit-acquisition-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-circuit-measurement-time-field ;
            owl:onProperty :has ],
        :NXcircuit,
        :NeXusGroup .

:nxspm-bias-spectroscopy-circuit-measurement-time-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/CIRCUIT/measurement_time"^^xsd:string ;
    rdfs:comment """
                The time or period taken by the circuit to measure a full bias sweep
                (duration of the voltage-current measurement measurement).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-measurement-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-circuit-measurement-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-bias-spectroscopy-identifier-environment-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/identifier_environment"^^xsd:string ;
    rdfs:comment """
            Unique identifier for the environment defined by the user or lab. When multiple scans are performed
            in a single environment conditions or settings, the entire scan environment can be differentiated
            by this identifier. For example, scan on a sample of TiSe2 with layered of evaporated pyrene and
            annealed at 300K temperature for 5 min process.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-identifier-environment-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-identifier-environment-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxobject-identifiername-field .

:nxspm-bias-spectroscopy-measurement-type-constant-spacing-enum a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/measurement_type/constant_spacing"^^xsd:string ;
    rdfs:comment "Enumeration item for NXspm_bias_spectroscopy/measurement_type: constant_spacing"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "constant_spacing"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations ;
    owl:disjointWith :nxspm-bias-spectroscopy-measurement-type-variadic-spacing-enum .

:nxspm-bias-spectroscopy-measurement-type-field a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy/measurement_type"^^xsd:string ;
    rdfs:comment """
            The measurement type defines how current is measured under the different input variables like
            bias voltage (constant_spacing) or height (variadic_spacing) is applied during the measurement.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-measurement-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxspm-bias-spectroscopy-measurement-type-constant-spacing-enum :nxspm-bias-spectroscopy-measurement-type-variadic-spacing-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxspm-cantilever-cantilever-config-group a owl:Class ;
    rdfs:label "NXspm_cantilever/cantilever_config"^^xsd:string ;
    rdfs:comment """
            The configuration parameters of the cantilever used in scanning probe
            microscopy.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-cantilever-config-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html#nxspm-cantilever-cantilever-config-group> ;
    rdfs:subClassOf :NXspm_cantilever_config,
        :NeXusGroup .

:nxspm-cantilever-config-amplitude-excitation-field a owl:Class ;
    rdfs:label "NXspm_cantilever_config/amplitude_excitation"^^xsd:string ;
    rdfs:comment """
            Either the drive amplitude in mv for the driving cantilever or the free-oscillation amplitude which is the
            resulted movement amplitude without interaction to the surface.
        """^^xsd:string ;
