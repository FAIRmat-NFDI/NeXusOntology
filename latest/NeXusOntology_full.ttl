    :extends "NXapm_paraprobe_tool_results"^^xsd:string .

:NXapm_paraprobe_nanochem_config a owl:Class ;
    rdfs:label "NXapm_paraprobe_nanochem_config"^^xsd:string ;
    rdfs:comment """
        Application definition for a configuration file of the paraprobe-nanochem tool.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-paraprobe-nanochem-config-entry-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-paraprobe-nanochem-config-entry-group ;
            owl:onProperty :has ],
        :NXapm_paraprobe_tool_config,
        :NeXusApplicationClass ;
    :extends "NXapm_paraprobe_tool_config"^^xsd:string .

:NXapm_paraprobe_nanochem_results a owl:Class ;
    rdfs:label "NXapm_paraprobe_nanochem_results"^^xsd:string ;
    rdfs:comment """
