            owl:onClass :nxstress-entry-instrument-source-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstress-entry-instrument-calibration-group ;
