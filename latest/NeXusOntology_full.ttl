        :NeXusField .

:nxcg-grid-coordinate-field a owl:Class ;
    rdfs:label "NXcg_grid/coordinate"^^xsd:string ;
    rdfs:comment """
             Coordinate of each cell with respect to the discrete grid.
        """^^xsd:string ;
