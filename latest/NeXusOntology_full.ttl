    :extends "NXcomponent"^^xsd:string .

:NXspm_bias_spectroscopy a owl:Class ;
    rdfs:label "NXspm_bias_spectroscopy"^^xsd:string ;
    rdfs:comment """
        A base class for bias spectroscopy to describe the change in the physical properties
        of the sample with respect to the sweep voltage applied on a sample of STM/AFM/... experiments.
        
        In these experiments an electric potential is applied between the (conductive) sample and the probe
        (tip), and the physical properties (e.g. tunnelling current) are measured as the function of this
        potential. The potential is varied in so-called voltage sweeps and the corresponding properties are
        recorded accordingly.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-spm-positioner-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-circuit-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-measurement-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-identifier-environment-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-bias-spectroscopy-bias-sweep-group ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXspm_cantilever a owl:Class ;
    rdfs:label "NXspm_cantilever"^^xsd:string ;
    rdfs:comment """
        A base class to describe the cantilever used in Atomic Force Microscopy (AFM).
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-cantilever-oscillator-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-cantilever-config-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-phase-positioner-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-amplitude-positioner-group ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXspm_cantilever_config a owl:Class ;
    rdfs:label "NXspm_cantilever_config"^^xsd:string ;
    rdfs:comment """
        This file defines the NXspm_cantilever_config base class, which contains configuration
        information about the cantilever used in the AFM (atomic force microscopy) experiments.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_config.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_config.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-cantilever-thickness-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-cantilever-coating-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-resonance-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-fermi-level-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-spring-constant-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-cantilever-width-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-resonance-amplitude-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-amplitude-excitation-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-calibration-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-cantilever-length-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-curvature-radiusn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-cantilever-config-cantilever-type-field ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXspm_piezo_config a owl:Class ;
    rdfs:label "NXspm_piezo_config"^^xsd:string ;
    rdfs:comment """
        A base class describing piezo actuator settings for scanning probe microscopy.
        
        Piezoelectric actuators work utilizing the inverse-piezoelectric effect, when a voltage
        is applied on the material and it deforms proportional to the applied voltage.
        Description below shows calibration coefficients and other configuration parameters of
        open loop piezo actuators (that is actuators without capacitive sensor feedback systems).
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_config.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-piezo-material-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-piezo-config-calibration-group ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXspm_scan_region a owl:Class ;
    rdfs:label "NXspm_scan_region"^^xsd:string ;
    rdfs:comment """
        The scan region is the area of phase space or sub-phase space where the scan is
        performed. The region could be N-dimensional and is defined by the minimum and
        maximum values of the scan axes.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-region-scan-rangen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-region-scan-offset-valuen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-region-scan-endn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-region-scan-startn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-region-scan-anglen-field ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXsubentry a owl:Class ;
    rdfs:label "NXsubentry"^^xsd:string ;
    rdfs:comment """
		Group of multiple application definitions for "multi-modal" (e.g. SAXS/WAXS) measurements.
		
		``NXsubentry`` is a base class virtually identical to :ref:`NXentry`
		and is used as the (overlay) location for application definitions.
		Use a separate ``NXsubentry`` for each application definition. 
		
		To use ``NXsubentry`` with a hypothetical application definition 
		called ``NXmyappdef``:

		* Create a group with attribute ``NX_class="NXsubentry"``
		* Within that group, create a field called ``definition="NXmyappdef"``.
		* There are two optional attributes of definition: ``version`` and ``URL``

		The intended use is to define application definitions for a 
		multi-modal (a.k.a. multi-technique) :ref:`NXentry`. 
		Previously, an application definition 
		replaced :ref:`NXentry` with its own definition. 
		With the increasing popularity of instruments combining 
		multiple techniques for data collection (such as SAXS/WAXS instruments), 
		it was recognized the application definitions must be entered in the NeXus
		data file tree as children of :ref:`NXentry`. 
	"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsubentry.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsubentry.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-data-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-entry-identifier-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-program-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-title-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-experiment-identifier-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-idf-version-attribute ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-experiment-description-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-collection-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-revision-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-sample-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-monitor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-pre-sample-flightpath-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-default-attribute ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-definition-local-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-parameters-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-instrument-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-collection-identifier-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-run-cycle-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-collection-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-start-time-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-definition-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsubentry-notes-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
