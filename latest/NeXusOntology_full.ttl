            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-entry-atom-probeid-hit-finding-programid-program-field ;
            owl:onProperty :has ],
        :NXprogram,
        :NeXusGroup .

