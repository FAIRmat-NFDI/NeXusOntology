:nxspm-cantilever-config-calibration-sensitivity-field a owl:Class ;
    rdfs:label "NXspm_cantilever_config/CALIBRATION/sensitivity"^^xsd:string ;
    rdfs:comment """
                A force applied to the cantilever tip will cause a change in
                cantilever's oscillation amplitude (in dynamic mode) or deflection of the cantilever.
                The sensitivity of the cantilever is calculated as the ratio of this change to the force causing it.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_config.html#nxspm-cantilever-config-calibration-sensitivity-field> ;
