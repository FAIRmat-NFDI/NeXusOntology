:nxcircuit-output-slew-rate-field a owl:Class ;
    rdfs:label "NXcircuit/output_slew_rate"^^xsd:string ;
    rdfs:comment """
            The rate at which the signal changes when ramping from the starting
            value.
        """^^xsd:string ;
