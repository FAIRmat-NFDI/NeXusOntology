    rdfs:label "NXsts/ENTRY/reproducibility_indicators/BIAS_SWEEP"^^xsd:string ;
    rdfs:comment """
                    Bias sweep measurement in bias spectroscopy.
                    This should be a link to
                    /ENTRY[*]/INSTRUMENT[*]/bias_spectroscopy_environment/BIAS_SPECTROSCOPY[bias_spectroscopy]/bias_sweep
                    
                    Note: group name (could be any meaningful and relevant name e.g. entry in ENTRY[entry]) inside the
                    square bracket would be the `exact` name of the NXentry group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-bias-sweep-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-bias-sweep-group> ;
    rdfs:subClassOf :NXspm_scan_control,
        :NeXusGroup .

:nxsts-entry-reproducibility-indicators-current-field a owl:Class ;
    rdfs:label "NXsts/ENTRY/reproducibility_indicators/current"^^xsd:string ;
    rdfs:comment """
                    The tunneling current between tip and sample after application of bias voltage.
                    This should be a link to
                    /ENTRY[*]/INSTRUMENT[*]/current_sensorTAG/current
                    
                    Note: group name (could be any meaningful and relevant name e.g. entry in ENTRY[entry]) inside the
                    square bracket would be the `exact` name of the NXentry group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxsts-entry-reproducibility-indicators-current-gain-field a owl:Class ;
    rdfs:label "NXsts/ENTRY/reproducibility_indicators/current_gain"^^xsd:string ;
    rdfs:comment """
                    Proportional relationship between the probe output voltage and the actual
                    tunneling current when measuring the tunneling current.
                    This should be a link to
                    /ENTRY[*]/INSTRUMENT[*]/current_sensorTAG[current_sensor*]/amplifier/current_gain
                    
                    Note: group name (could be any meaningful and relevant name e.g. entry in ENTRY[entry]) inside the
                    square bracket would be the `exact` name of the NXentry group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-gain-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-gain-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxsts-entry-reproducibility-indicators-current-offset-field a owl:Class ;
    rdfs:label "NXsts/ENTRY/reproducibility_indicators/current_offset"^^xsd:string ;
    rdfs:comment """
                    The offset in tunneling current between tip and sample after application of bias voltage.
                    This should be a link to
                    /ENTRY[*]/INSTRUMENT[*]/current_sensorTAG[current_sensor*]/current_offset
                    
                    Note: group name (could be any meaningful and relevant name e.g. entry in ENTRY[entry]) inside the
                    square bracket would be the `exact` name of the NXentry group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-offset-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-current-offset-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxsts-entry-reproducibility-indicators-group a owl:Class ;
    rdfs:label "NXsts/ENTRY/reproducibility_indicators"^^xsd:string ;
    rdfs:comment """
                The group's concepts hold the link to the related concepts that define the
                reproducibility of the STM experiment.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsts.html#nxsts-entry-reproducibility-indicators-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-current-offset-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-current-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-modulation-signal-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-bias-sweep-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-reference-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsts-entry-reproducibility-indicators-current-gain-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-reproducibility-indicators-group .

:nxsts-entry-reproducibility-indicators-modulation-signal-type-field a owl:Class ;
    rdfs:label "NXsts/ENTRY/reproducibility_indicators/modulation_signal_type"^^xsd:string ;
    rdfs:comment """
                    This is the signal on which the modulation voltage or current will be added.
                    This should be a link to
                    /ENTRY[*]/INSTRUMENT[*]/lockin_amplifier/modulation_signal_type
                    
                    Note: group name (could be any meaningful and relevant name e.g. entry in ENTRY[entry]) inside the
                    square bracket would be the `exact` name of the NXentry group.
