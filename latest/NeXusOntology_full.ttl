        :nxobject-note-group .

:nxmicrostructure-score-config-entry-deformation-ebsd-stepsize-field a owl:Class ;
    rdfs:label "NXmicrostructure_score_config/ENTRY/deformation/ebsd/stepsize"^^xsd:string ;
    rdfs:comment """
                        Extent of the pixel of the EBSD orientation mapping assuming square-shaped pixels
                        or cube-shaped voxels respectively.
                    """^^xsd:string ;
