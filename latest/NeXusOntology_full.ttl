:nxsas-entry-instrument-monochromator-wavelength-spread-field a owl:Class ;
    rdfs:label "NXsas/ENTRY/INSTRUMENT/MONOCHROMATOR/wavelength_spread"^^xsd:string ;
    rdfs:comment """
	          delta_lambda/lambda (:math:`\\Delta\\lambda/\\lambda`):
