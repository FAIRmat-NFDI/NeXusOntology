    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxxpcs-entry-twotime-two-time-corr-func-baseline-reference-0-enum :nxxpcs-entry-twotime-two-time-corr-func-baseline-reference-1-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusAttribute .

:nxxpcs-entry-twotime-two-time-corr-func-populated-elements-attribute a owl:Class ;
