:nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-next-set-objectid-feature-type-field a owl:Class ;
    rdfs:label "NXapm_paraprobe_intersector_config/ENTRY/v_v_spatial_correlationID/next_set/objectID/feature_type"^^xsd:string ;
    rdfs:comment """
