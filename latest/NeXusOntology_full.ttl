            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        :NeXusField .

:nxlockin-sensitivity-factor-field a owl:Class ;
    rdfs:label "NXlockin/sensitivity_factor"^^xsd:string ;
    rdfs:comment """
            Ratio of output signal amplitude to input signal amplitude (V/V).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-sensitivity-factor-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-sensitivity-factor-field> ;
