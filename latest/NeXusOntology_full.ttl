:NXspm_scan_pattern a owl:Class ;
    rdfs:label "NXspm_scan_pattern"^^xsd:string ;
    rdfs:comment """
        Basic base class to define the pattern of a scan in a given scan region.
        
        The base class is intended to handle the following scan types or patterns:
        
        Trajectory: A list of N-dimensional sequential vectors, representing a point in phase space, describes
          the trajectory line for a full scan.
        Mesh: For each dimension, a range and a direction are chosen. When a scan along a dimension is done, a
          single step in the next dimension is taken, and then the scan in the previous dimension is repeated.
          As such we can speak about the fastest and the slowest scan axes.
          
        Snake: Similar to a mesh scan but the current scanning direction reversed after each line completed.
        Spiral: A scan taken along a spiral trajectory.
        Tilt: At each step, a proportional movement is done in all dimensions (an special case of Trajectory scan).
        Linear: A scan where the scanning will be performed along a single independent axis.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-step-sizen-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-trajectory-points-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-spiral-radiusn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-oscillation-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-continuousn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-oscillating-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-number-of-trajectory-points-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-data-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-channelname-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-scan-speedn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-scan-pointsn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-backward-speedn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-steppingn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-forward-speedn-field ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NXspm_temperature_sensor a owl:Class ;
    rdfs:label "NXspm_temperature_sensor"^^xsd:string ;
    rdfs:comment """
        The :ref:`NXspm_temperature_sensor` class describes a temperature sensor
        used in scanning probe microscopy (SPM) experiments. It includes fields
        for the temperature measurement, calibration, and associated data.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-calibration-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-temperaturechannel-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-temp-offset-value-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-data-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-temperature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-target-temperature-field ;
            owl:onProperty :has ],
        :NXsensor,
        :NeXusBaseClass ;
    :extends "NXsensor"^^xsd:string .

:NXuser a owl:Class ;
    rdfs:label "NXuser"^^xsd:string ;
    rdfs:comment """
		Contact information for a user.  
		
		The format allows more 
		than one user with the same affiliation and contact information, 
		but a second :ref:`NXuser` group should be used if they have different 
		affiliations, etc.
	"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXuser.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXuser.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-address-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-email-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-telephone-number-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-orcid-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-affiliation-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-name-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-fax-number-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-facility-user-id-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxuser-role-field ;
            owl:onProperty :has ],
        :NXobject,
        :NeXusBaseClass ;
    :extends "NXobject"^^xsd:string .

:NeXus a owl:Class ;
    rdfs:comment "NeXus concept"^^xsd:string ;
    rdfs:subClassOf owl:Thing ;
    owl:versionInfo "v2026.01"^^xsd:string .

:nxactuator-actuation-target-field a owl:Class ;
    rdfs:label "NXactuator/actuation_target"^^xsd:string ;
    rdfs:comment """
             The physical component on which this actuator acts.
             This should be a path in the NeXus tree structure.
             For example, this could be an instance of NXsample or a device on NXinstrument.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-actuation-target-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-actuation-target-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxbeam-incident-polarization-field a owl:Class ;
    rdfs:label "NXbeam/incident_polarization"^^xsd:string ;
    rdfs:comment "Polarization vector on entering beamline component"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-polarization-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-polarization-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxcalibration-calibrated-axis-field a owl:Class ;
    rdfs:label "NXcalibration/calibrated_axis"^^xsd:string ;
    rdfs:comment """
            An array representing the axis after calibration, matching the data length
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-calibrated-axis-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-calibrated-axis-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
