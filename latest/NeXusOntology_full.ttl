                    owl:unionOf ( :nxxpcs-entry-data-delay-difference-storage-mode-one-array-enum :nxxpcs-entry-data-delay-difference-storage-mode-data-exchange-keys-enum :nxxpcs-entry-data-delay-difference-storage-mode-other-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusAttribute .

:nxxpcs-entry-data-g2-derr-storage-mode-attribute a owl:Class ;
    rdfs:label "NXxpcs/ENTRY/data/g2_derr/storage_mode"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-data-g2-derr-storage-mode-attribute> ;
