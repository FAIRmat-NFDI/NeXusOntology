        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField,
        :nxlockin-modulation-signal-field .

:nxstm-entry-instrument-scan-environment-cryo-bottom-temperature-sensor-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/cryo_bottom_temperature_sensor"^^xsd:string ;
    rdfs:comment """
                        This should be a link to
                        /entry/instrument/cryo_bottom_temperature_sensor
                    """^^xsd:string ;
