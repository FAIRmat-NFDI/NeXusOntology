    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_piezo_sensor.html#nxspm-piezo-sensor-x-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        :NeXusField .

:nxspm-piezo-sensor-y-field a owl:Class ;
    rdfs:label "NXspm_piezo_sensor/y"^^xsd:string ;
    rdfs:comment """
            The y position (e.g., target or averaged target value) of the piezo.
        """^^xsd:string ;
