    rdfs:label "NXxas/ENTRY/INSTRUMENT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXxas.html#nxxas-entry-instrument-group> ;
