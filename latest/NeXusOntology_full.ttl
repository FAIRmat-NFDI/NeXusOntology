:nxstm-entry-instrument-scan-environment-lockin-status-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/lockin_status"^^xsd:string ;
    rdfs:comment """
                        The status of the lock-in amplifier. It is well established convention that for topographic measurements
                        lockin amplifier is turned off state while current scan lockin amplifier is turned on.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-lockin-status-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-lockin-status-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxstm-entry-instrument-scan-environment-spm-scan-control-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/SPM_SCAN_CONTROL"^^xsd:string ;
    rdfs:comment """
                        The scan control information like scan region or phase space, e.g. pattern of scan
                        (e.g. mesh), scanner speed, etc.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-spm-scan-control-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-scan-environment-spm-scan-control-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxspm-entry-instrument-scan-environment-spm-scan-control-group .

:nxstm-entry-reproducibility-indicators-bias-sweep-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators/BIAS_SWEEP"^^xsd:string ;
    rdfs:comment """
                    Bias sweep measurement in bias spectroscopy.
                    This should be a link to
                    /entry/instrument/bias_spectroscopy_environment/bias_spectroscopy/bias_sweep
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-bias-sweep-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-bias-sweep-group> ;
    rdfs:subClassOf :NXspm_scan_control,
        :NeXusGroup .

:nxstm-entry-reproducibility-indicators-current-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators/current"^^xsd:string ;
    rdfs:comment """
                    The tunneling current between tip and sample after application of bias voltage.
                    This should be a link to
                    /entry/instrument/current_sensor/current
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-current-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-current-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxstm-entry-reproducibility-indicators-current-offset-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators/current_offset"^^xsd:string ;
    rdfs:comment """
                    The offset in tunneling current between tip and sample after application of bias voltage.
                    This should be a link to
                    /entry/instrument/current_sensor/current_offset
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-current-offset-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-current-offset-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxstm-entry-reproducibility-indicators-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators"^^xsd:string ;
    rdfs:comment """
                The group's concepts hold the link to the related concepts that define the
                reproducibility of the STM experiment.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-reproducibility-indicators-reference-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-reproducibility-indicators-current-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-reproducibility-indicators-current-offset-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-reproducibility-indicators-modulation-signal-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstm-entry-reproducibility-indicators-bias-sweep-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-entry-reproducibility-indicators-group .

:nxstm-entry-reproducibility-indicators-modulation-signal-type-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators/modulation_signal_type"^^xsd:string ;
    rdfs:comment """
                    This is the signal on which the modulation voltage or current will be added.
                    This should be a link to
                    /entry/instrument/phase_lock_loop/modulation_signal
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-modulation-signal-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-modulation-signal-type-field> ;
