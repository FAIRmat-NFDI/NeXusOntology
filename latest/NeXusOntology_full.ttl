                    owl:oneOf ( "reciprocal"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxcollectioncolumn-scheme-field a owl:Class ;
    rdfs:label "NXcollectioncolumn/scheme"^^xsd:string ;
