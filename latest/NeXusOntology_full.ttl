                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField ;
    owl:equivalentClass :nxsample-name-field .

:nxoptical-spectroscopy-entry-sample-normal-ref-frame-depends-on-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/sample_normal_ref_frame/depends_on"^^xsd:string ;
    rdfs:comment """
                    Link to transformations defining the sample-normal base coordinate system,
                    which is defined such that the positive z-axis is parallel to the sample normal,
                    and the x-y-plane lies inside the sample surface.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-depends-on-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-depends-on-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField,
        :nxcoordinate-system-depends-on-field .

:nxoptical-spectroscopy-entry-sample-normal-ref-frame-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/sample_normal_ref_frame"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-normal-ref-frame-depends-on-field ;
            owl:onProperty :has ],
        :NXcoordinate_system,
        :NeXusGroup .

:nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/sample_normal_ref_frame/TRANSFORMATIONS"^^xsd:string ;
    rdfs:comment """
                    Set of transformations, describing the orientation of the sample-normal coordinate system
                    with respect to the beam coordinate system (.).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxcoordinate-system-transformations-group .

:nxoptical-spectroscopy-entry-sample-physical-form-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/physical_form"^^xsd:string ;
    rdfs:comment """
                    State the form of the sample, examples are:
                    thin film, single crystal, poly crystal, amorphous, single layer,
                    multi layer, liquid, gas, pellet, powder.
                    Generic properties of liquids or gases see NXsample properties.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-physical-form-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-physical-form-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField,
        :nxsample-physical-form-field .

:nxoptical-spectroscopy-entry-sample-preparation-date-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/preparation_date"^^xsd:string ;
    rdfs:comment """
                    ISO 8601 time code with local time zone offset to UTC information
                    when the specimen was prepared.
                    
                    Ideally, report the end of the preparation, i.e. the last known timestamp when
                    the measured specimen surface was actively prepared.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-preparation-date-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-preparation-date-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxsample-preparation-date-field .

:nxoptical-spectroscopy-entry-sample-sample-id-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/sample_id"^^xsd:string ;
    rdfs:comment """
                    Locally unique ID of the sample, used in the research institute or group.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-sample-id-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-sample-id-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxoptical-spectroscopy-entry-sample-sample-orientation-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/sample_orientation"^^xsd:string ;
    rdfs:comment """
                    Specify the sample orientation, how is its sample normal oriented
                    relative in the laboratory reference frame, incident beam reference
                    frame.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-sample-orientation-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-sample-orientation-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxoptical-spectroscopy-entry-sample-substrate-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/substrate"^^xsd:string ;
    rdfs:comment """
                    If the sample is grown or fixed on a substrate, specify this here by
                    a free text description.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-substrate-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-substrate-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxoptical-spectroscopy-entry-sample-temperature-env-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env"^^xsd:string ;
    rdfs:comment """
                    Sample temperature (either controlled or just measured).
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-temperature-env-sample-cooler-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsample-temperature-env-group .

:nxoptical-spectroscopy-entry-sample-temperature-env-sample-cooler-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/sample_cooler"^^xsd:string ;
    rdfs:comment """
                        Device for cooling the sample (Cryostat, Airflow cooler, etc.).
                        This should be a link to /entry/instrument/manipulator/cryostat.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-cooler-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-cooler-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxenvironment-actuator-group .

:nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/sample_heater"^^xsd:string ;
    rdfs:comment """
                        Device to heat the sample.
                        This should be a link to /entry/instrument/manipulator/sample_heater.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxenvironment-actuator-group .

:nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/temperature_nominal"^^xsd:string ;
    rdfs:comment """
                        If no sensor was available for the determination of temperature, selected
                        a nominal value which represents approximately the situation of sample temperature.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/temperature_sensor"^^xsd:string ;
    rdfs:comment """
                        Temperature sensor measuring the sample temperature.
                        This should be a link to /entry/instrument/manipulator/temperature_sensor.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxenvironment-sensor-group .

:nxoptical-spectroscopy-entry-sample-thickness-determination-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/thickness_determination"^^xsd:string ;
    rdfs:comment """
                    If a thickness if given, please specify how this thickness was estimated or
                    determined.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-thickness-determination-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-thickness-determination-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxoptical-spectroscopy-entry-sample-thickness-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/SAMPLE/thickness"^^xsd:string ;
    rdfs:comment """
                    (Measured) sample thickness.
                    
                    The information is recorded to qualify if the light used was likely
                    able to shine through the sample.
                    
                    In this case the value should be set to the actual thickness of
                    the specimen viewed for an illumination situation where the nominal
                    surface normal of the specimen is parallel to the optical axis.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-thickness-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-thickness-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxoptical-spectroscopy-entry-start-time-field a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/start_time"^^xsd:string ;
    rdfs:comment """
                Datetime of the start of the measurement.
                Should be a ISO8601 date/time stamp. It is recommended to add an explicit time zone,
                otherwise, the local time zone is assumed per ISO8601.
                
                It is required to enter at least one of both measurement times, either "start_time" or "end_time".
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-start-time-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-start-time-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxentry-start-time-field .

:nxoptical-spectroscopy-entry-user-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/USER"^^xsd:string ;
    rdfs:comment """
                Contact information and eventually details of at persons who
                performed the measurements. This can be for example the principal
                investigator or student. Examples are: name, affiliation, address, telephone
                number, email, role as well as identifiers such as orcid or similar.
                It is recommended to add multiple users if relevant.
                
                Due to data privacy concerns, there is no minimum requirement.
                If no user with specific name is allowed to be given, it is required to
                assign at least an affiliation
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-user-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-user-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxentry-user-group .

:nxoptical-window-material-field a owl:Class ;
    rdfs:label "NXoptical_window/material"^^xsd:string ;
    rdfs:comment """
            The material of the window.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-material-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-material-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxaperture-material-field .

:nxoptical-window-material-other-field a owl:Class ;
    rdfs:label "NXoptical_window/material_other"^^xsd:string ;
    rdfs:comment """
            If you specified 'other' as material, describe here what it is.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-material-other-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-material-other-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxoptical-window-orientation-angle-field a owl:Class ;
    rdfs:label "NXoptical_window/orientation_angle"^^xsd:string ;
    rdfs:comment """
            Angle of the window normal (outer) vs. the substrate normal
            (similar to the angle of incidence).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-orientation-angle-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-orientation-angle-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxoptical-window-thickness-field a owl:Class ;
    rdfs:label "NXoptical_window/thickness"^^xsd:string ;
    rdfs:comment """
            Thickness of the window.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-thickness-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-thickness-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxoptical-window-window-correction-group a owl:Class ;
    rdfs:label "NXoptical_window/window_correction"^^xsd:string ;
    rdfs:comment """
            Group to describe any window correction - if none performed, then omit this
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-window-window-correction-reference-data-link-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxoptical-window-window-correction-procedure-field ;
            owl:onProperty :has ],
        :NXprocess,
        :NeXusGroup .

:nxoptical-window-window-correction-procedure-field a owl:Class ;
    rdfs:label "NXoptical_window/window_correction/procedure"^^xsd:string ;
    rdfs:comment """
                Describe when (before or after the main measurement + time
                stamp in 'date') and how the window effects have been
                corrected, i.e. either mathematically or by performing a
                reference measurement. In the latter case, provide the link to
                to the reference data in ``reference_data_file``.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-procedure-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-procedure-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxoptical-window-window-correction-reference-data-link-field a owl:Class ;
    rdfs:label "NXoptical_window/window_correction/reference_data_link"^^xsd:string ;
    rdfs:comment """
                :ref:`External link <Design-Links>` to the data field in the NeXus file which describes                   
                the reference data if a reference measurement for window correction 
                was performed.

                Ideally, the reference measurement was performed on the same sample,
                using the same conditions as for the actual measurement, with
                and, if possible, without windows. It should have been conducted as close in time
                to the actual measurement as possible.
                
                Ideally, the link uses the relative path with respect to the actual
                NeXus file.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-reference-data-link-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-reference-data-link-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxoptical-window-window-effects-corrected-field a owl:Class ;
    rdfs:label "NXoptical_window/window_effects_corrected"^^xsd:string ;
    rdfs:comment """
            Was a window correction performed? If so, describe the window
            correction procedure in ``window_correction/procedure``.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-effects-corrected-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-effects-corrected-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxoptical-window-window-effects-type-field a owl:Class ;
    rdfs:label "NXoptical_window/window_effects_type"^^xsd:string ;
    rdfs:comment """
            Type of effects due to this window on the measurement.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-effects-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-effects-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxorientation-geometry-group a owl:Class ;
    rdfs:label "NXorientation/GEOMETRY"^^xsd:string ;
    rdfs:comment "Link to another object if we are using relative positioning, else absent"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXorientation.html#nxorientation-geometry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXorientation.html#nxorientation-geometry-group> ;
    rdfs:subClassOf :NXgeometry,
        :NeXusGroup .

:nxparameters-model-attribute a owl:Class ;
    rdfs:label "NXparameters/model"^^xsd:string ;
    rdfs:comment """
            The name of the model used in optimizing the parameter
            values. Fitting packages such as LMFIT
            (https://lmfit.github.io/lmfit-py/) provide models, which
            instantiate functions to be fitted to the data. If this
            attribute is provided, it is assumed that all the parameters
            in this group are associated with this model.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-model-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-model-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusAttribute .

:nxparameters-parameter-error-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/error"^^xsd:string ;
    rdfs:comment """
                The standard deviation of the parameter after optimizing
                its value.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-error-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-error-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxparameters-parameter-expression-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/expression"^^xsd:string ;
    rdfs:comment """
                A string representing an expression that can be used to
                relate the parameter to another parameter's value. The
                format of this string is dependent on the program used
                to optimize the parameters and is not specified by
                NeXus.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-expression-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-expression-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusAttribute .

:nxparameters-parameter-initial-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/initial"^^xsd:string ;
    rdfs:comment """
                The initial value of the parameter used in optimization.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-initial-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-initial-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxparameters-parameter-max-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/max"^^xsd:string ;
    rdfs:comment """
                The upper bound of the parameter used in optimization.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-max-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-max-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxparameters-parameter-min-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/min"^^xsd:string ;
    rdfs:comment """
                The lower bound of the parameter used in optimization.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-min-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-min-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxparameters-parameter-units-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/units"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-units-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-units-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxparameters-parameter-vary-attribute a owl:Class ;
    rdfs:label "NXparameters/PARAMETER/vary"^^xsd:string ;
    rdfs:comment """
                True if the parameter was varied during optimization.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-vary-attribute> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-vary-attribute> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusAttribute .

:nxphase-atom-group a owl:Class ;
    rdfs:label "NXphase/ATOM"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-atom-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-atom-group> ;
    rdfs:subClassOf :NXatom,
        :NeXusGroup .

:nxphase-lock-loop-calibration-group a owl:Class ;
    rdfs:label "NXphase_lock_loop/calibration"^^xsd:string ;
    rdfs:comment """
            Calibration information for the PLL, including any relevant parameters
            or procedures.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-calibration-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-calibration-group> ;
    rdfs:subClassOf :NXcalibration,
        :NeXusGroup .

:nxphase-lock-loop-center-frequency-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/center_frequency"^^xsd:string ;
    rdfs:comment """
            The center frequency of the PLL is the middle frequency of the PLL's operating
            range.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-center-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-center-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxphase-lock-loop-frequency-bandwidth-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/frequency_bandwidth"^^xsd:string ;
    rdfs:comment """
            The frequency bandwidth of the PLL is where it responds or is stable.
            If phase difference (also called phase error) is calculated from the input and output signal
            frequencies.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-frequency-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-frequency-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-lock-loop-frequency-step-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/frequency_step"^^xsd:string ;
    rdfs:comment """
            The frequency step size of the PLL determines the resolution of frequency
            changes.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-frequency-step-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-frequency-step-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-lock-loop-hardware-group a owl:Class ;
    rdfs:label "NXphase_lock_loop/hardware"^^xsd:string ;
    rdfs:comment """
            Manufacturer and model of the PLL hardware or controller.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-hardware-order-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-hardware-type-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxcomponent-fabrication-group .

:nxphase-lock-loop-hardware-order-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/hardware/order"^^xsd:string ;
    rdfs:comment """
                Order of the PLL. This is characteristic of circuit design and is defined as the number of roots of
                characteristics polynomial of the PLL circuit.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-order-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-order-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxphase-lock-loop-hardware-type-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/hardware/type"^^xsd:string ;
    rdfs:comment """
                Types (design parameter for circuit) of the PLL from type-1, type-2, and type-3
                available in device specifications (for mathematical details: https://www.nxp.com/docs/en/application-note/AN535.pdf).
                Type is defined by the number of poles that exist in the transfer function of the PLL.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-type-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-type-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxphase-lock-loop-hardware-type-type-1-enum :nxphase-lock-loop-hardware-type-type-2-enum :nxphase-lock-loop-hardware-type-type-3-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxphase-lock-loop-loop-filter-group a owl:Class ;
    rdfs:label "NXphase_lock_loop/loop_filter"^^xsd:string ;
    rdfs:comment """
            The loop filter component of the PLL filters the voltage from the phase detector to the VCO.
            It extracts the average voltage of the phase error signals emitted from the phase detector.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-loop-filter-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-loop-filter-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-loop-filter-kf-coefficient-field ;
            owl:onProperty :has ],
        :NXcomponent,
        :NeXusGroup .

:nxphase-lock-loop-loop-filter-kf-coefficient-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/loop_filter/Kf_coefficient"^^xsd:string ;
    rdfs:comment """
                The Kf coefficient, called loop filter gain, determines the gain of the
                loop filter circuit in the PLL.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-loop-filter-kf-coefficient-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-loop-filter-kf-coefficient-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxphase-lock-loop-phase-bandwidth-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_bandwidth"^^xsd:string ;
    rdfs:comment """
            The phase bandwidth of the PLL is where it responds or is stable.
            If phase difference (also called phase error) is calculated from the input and output signal
            phases.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxphase-lock-loop-phase-detector-frequency-shift-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector/frequency_shift"^^xsd:string ;
    rdfs:comment """
                Measured or target shift in oscillation from the VCO. relative to the reference
                signal.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-frequency-shift-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-frequency-shift-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        :NeXusField .

:nxphase-lock-loop-phase-detector-group a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector"^^xsd:string ;
    rdfs:comment """
            The phase detector component of the PLL, which compares the phase between the
            reference signal generated (e.g., in AFM, generated by the cantilever) and the signal coming from the VCO.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-phase-detector-frequency-shift-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-phase-detector-reference-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-phase-detector-reference-phase-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-phase-detector-phase-error-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-phase-detector-kp-coefficient-field ;
            owl:onProperty :has ],
        :NXcomponent,
        :NeXusGroup .

:nxphase-lock-loop-phase-detector-kp-coefficient-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector/Kp_coefficient"^^xsd:string ;
    rdfs:comment """
                The gain coefficient of the phase detector which determines how much the output
                voltage changes in response to a phase difference (V/rad).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-kp-coefficient-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-kp-coefficient-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxphase-lock-loop-phase-detector-phase-error-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector/phase_error"^^xsd:string ;
    rdfs:comment """
                Measured phase error (also called phase difference) between the reference signal
                and the VCO output.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-phase-error-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-phase-error-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-lock-loop-phase-detector-reference-frequency-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector/reference_frequency"^^xsd:string ;
    rdfs:comment """
                The input reference frequency to the PLL through the component Phase-detector.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-reference-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-reference-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxphase-lock-loop-phase-detector-reference-phase-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/phase_detector/reference_phase"^^xsd:string ;
    rdfs:comment """
                Reference phase of the input signal to the phase detector.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-reference-phase-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-reference-phase-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANGLE ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-lock-loop-voltage-controlled-oscillator-group a owl:Class ;
    rdfs:label "NXphase_lock_loop/voltage_controlled_oscillator"^^xsd:string ;
    rdfs:comment """
            The voltage-controlled oscillator (VCO) component of the PLL, which generates the output signal
            based on the filtered voltage from the loop filter.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-voltage-controlled-oscillator-output-frequency-range-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-voltage-controlled-oscillator-kn-coefficient-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxphase-lock-loop-voltage-controlled-oscillator-ko-coefficient-field ;
            owl:onProperty :has ],
        :NXcomponent,
        :NeXusGroup .

:nxphase-lock-loop-voltage-controlled-oscillator-kn-coefficient-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/voltage_controlled_oscillator/Kn_coefficient"^^xsd:string ;
    rdfs:comment """
                The Kn coefficient, called the input-output frequency ratio, relates the input frequency to the output
                frequency of the VCO. This coefficient is used to adjust the output frequency based on the input frequency.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-kn-coefficient-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-kn-coefficient-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-lock-loop-voltage-controlled-oscillator-ko-coefficient-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/voltage_controlled_oscillator/Ko_coefficient"^^xsd:string ;
    rdfs:comment """
                The output voltage coefficient of the VCO, which determines how much the output
                frequency changes in response to a change in input voltage (Hz/V).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-ko-coefficient-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-ko-coefficient-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxphase-lock-loop-voltage-controlled-oscillator-output-frequency-range-field a owl:Class ;
    rdfs:label "NXphase_lock_loop/voltage_controlled_oscillator/output_frequency_range"^^xsd:string ;
    rdfs:comment """
                The output frequency range (written in an array of frequencies as [min, max]) of the VCO which is the range
                of frequencies it can generate. The range is either the same as the frequency bandwidth of the PLL or shorter
                and inside that.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-output-frequency-range-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-output-frequency-range-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxphase-phase-id-field a owl:Class ;
    rdfs:label "NXphase/phase_id"^^xsd:string ;
    rdfs:comment """
            Identifier for each phase.
            
            The value 0 is reserved for the unknown phase that represents the
            null-model (no sufficiently significant information available).
            In other words, the phase_name is n/a aka notIndexed.
            
            The  phase_id value should match with the integer suffix of the
            group name which represents that instance in a NeXus/HDF5 file, i.e.
            if three phases were used e.g. 0, 1, and 2, three instances of
            :ref:`NXphase` named phase0, phase1, and phase2 should be stored
            in that HDF5 file.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-phase-id-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-phase-id-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_INT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_INT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxpid-controller-control-action-direct-enum a owl:Class ;
    rdfs:label "NXpid_controller/control_action/direct"^^xsd:string ;
    rdfs:comment "Enumeration item for NXpid_controller/control_action: direct"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-control-action-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-control-action-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "direct"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations ;
    owl:disjointWith :nxpid-controller-control-action-reverse-enum .

:nxpid-controller-control-action-field a owl:Class ;
    rdfs:label "NXpid_controller/control_action"^^xsd:string ;
    rdfs:comment """
            The Error Value of PID feedback system is normally constructed in terms of the correction needed to bring
            the Process Variable towards a match with the Setpoint. This "direct" control action means that a measurement of
            the Process Variable that is lower than the Setpoint results in a positive Error Value and a generally positive 
            control output that tells the actuator to push the value of the Process Variable upwards. In some implementations,
            the actuator will respond to a more positive control output by pushing the Process Variable towards lower values (e.g. 
            a Peltier cooler) and so the output of the feedback system must be reversed to match the behavior of the physical system.
            A feedback system may also be implemented with reverse action in order to ensure that failures (e.g. disconnected sensor
            output or actuator input) result in a safe state (e.g. a valve should be left open to release pressure).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-control-action-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-control-action-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxpid-controller-control-action-direct-enum :nxpid-controller-control-action-reverse-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxpid-controller-description-field a owl:Class ;
    rdfs:label "NXpid_controller/description"^^xsd:string ;
    rdfs:comment """
            Description of how the Process Value for the PID controller is produced by sensor(s) in the setup.
             
            For example, a set of sensors could be averaged over before feeding it back into the loop.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-description-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-description-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxcomponent-description-field .

:nxpid-controller-feed-forward-model-field a owl:Class ;
    rdfs:label "NXpid_controller/feed_forward_model"^^xsd:string ;
    rdfs:comment """
            A description of the model used for the Feed Forward part of the feedback system. Note that such models typically
            involve the Setpoint value, but not the Error Value. The simplest model is simply proportional to the Setpoint value.
            For example, the position (Process Variable) of a sample is measured by a a linear optical encoder (sensor) and 
            manipulated by a piezoelectric scanning stage (actuator). The corresponding Feed Forward model could be that the 
            output value (voltage applied to the piezo) is proportional to the Setpoint value (measured position of the sample).
             
            A complex model could involve any number of input variables, mathematical functions, and coefficients in order to
            describe the physical system relevant to the PID controller.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-feed-forward-model-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-feed-forward-model-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxpid-controller-k-d-field a owl:Class ;
    rdfs:label "NXpid_controller/K_d"^^xsd:string ;
    rdfs:comment """
            Derivative gain constant. This constant determines how much the feedback system
            should anticipate the future value of the Error Value function through adjustment of the 
            output value that is proportional to the rate of change (i.e. derivative) of the Error Value.
            This term is important for damping oscillations in the feedback system.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-d-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-d-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxpid-controller-k-ff-field a owl:Class ;
    rdfs:label "NXpid_controller/K_ff"^^xsd:string ;
    rdfs:comment """
            Feed Forward gain constant. This constant determines how much the feedback system
            should rely on a calculated output value to achieve the desired Process Variable value.
            A Feed Forward system uses a model of the physical system to calculate an appropriate 
            output value to achieve a desired Setpoint value. A description of this model should be provided
            in the ``feed_forward_model`` field.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-ff-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-ff-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxpid-controller-k-i-field a owl:Class ;
    rdfs:label "NXpid_controller/K_i"^^xsd:string ;
    rdfs:comment """
            Integral gain constant. This constant determines how strongly the output value
            should react to an accumulated offset in the Error Value that should have
            been corrected previously. since the integral term is proportional to both
            the magnitude and persistence of the Error Value over time.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-i-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-i-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxpid-controller-k-p-field a owl:Class ;
    rdfs:label "NXpid_controller/K_p"^^xsd:string ;
    rdfs:comment """
            Proportional gain constant. This constant determines how strongly the output value
            directly follows the current Error Value. When this constant dominates, the output
            value is linearly proportional to the Error Value.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-p-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-k-p-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxpid-controller-pv-sensor-group a owl:Class ;
    rdfs:label "NXpid_controller/pv_sensor"^^xsd:string ;
    rdfs:comment """
            The sensor representing the Process Value used in the feedback loop for the PID.
             
            In case multiple sensors were used, this NXsensor should contain the proper calculated/aggregated value.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxpid-controller-pv-sensor-value-log-group ;
            owl:onProperty :has ],
        :NXsensor,
        :NeXusGroup .

:nxpid-controller-pv-sensor-value-log-group a owl:Class ;
    rdfs:label "NXpid_controller/pv_sensor/value_log"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-value-log-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-value-log-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxpid-controller-pv-sensor-value-log-value-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-value-log-group .

:nxpid-controller-pv-sensor-value-log-value-field a owl:Class ;
    rdfs:label "NXpid_controller/pv_sensor/value_log/value"^^xsd:string ;
    rdfs:comment """
                     The actual timeseries data fed back into the PID controller.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-value-log-value-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-value-log-value-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField,
        :nxlog-value-field .

:nxpinhole-depends-on-field a owl:Class ;
    rdfs:label "NXpinhole/depends_on"^^xsd:string ;
    rdfs:comment """
			The reference direction of the pinhole is parallel with the z axis. The reference
			point of the pinhole is its center in the x and y axis. The reference point on the z axis is the
			plane which overlaps the side of the opening of the pin hole pointing towards the source (minus on the z axis).

			.. image:: pinhole/pinhole.png
				:width: 40%
		"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXpinhole.html#nxpinhole-depends-on-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXpinhole.html#nxpinhole-depends-on-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxcomponent-depends-on-field .

:nxpinhole-diameter-field a owl:Class ;
    rdfs:label "NXpinhole/diameter"^^xsd:string ;
    rdfs:comment "Size of the circular hole defining the transmitted beam size."^^xsd:string ;
