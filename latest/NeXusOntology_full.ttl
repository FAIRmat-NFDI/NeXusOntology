:nxspm-entry-instrument-scan-environment-identifier-environment-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT/identifier_environment"^^xsd:string ;
    rdfs:comment """
                        Unique identifier for the scan environment defined by the user or lab. When multiple scans are performed
                        in a single environment conditions or settings, the entire scan environment can be differentiated
                        by this identifier. For example, scan on a sample of TiSe2 with layered of evaporated pyrene and
                        annealed at 300K temperature for 5 min process.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-scan-environment-identifier-environment-field> ;
