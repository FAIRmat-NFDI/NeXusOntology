                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-scan-control-snakescan-group a owl:Class ;
    rdfs:label "NXspm_scan_control/snakeSCAN"^^xsd:string ;
    rdfs:comment """
            To define the snake scan, use this group.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-snakescan-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-snakescan-group> ;
    rdfs:subClassOf :NXspm_scan_pattern,
        :NeXusGroup .

:nxspm-scan-control-spiralscan-group a owl:Class ;
    rdfs:label "NXspm_scan_control/spiralSCAN"^^xsd:string ;
    rdfs:comment """
            To define the spiral or circular scan, use this group.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-control-spiralscan-spiral-radiusn-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-control-spiralscan-scan-pointsn-field ;
            owl:onProperty :has ],
        :NXspm_scan_pattern,
        :NeXusGroup .

:nxspm-scan-control-spiralscan-scan-pointsn-field a owl:Class ;
    rdfs:label "NXspm_scan_control/spiralSCAN/scan_pointsN"^^xsd:string ;
    rdfs:comment """
                Define the total number of points in a given circle scan to be performed.
                
                Rename the field, according to the circle order, the nearest circle to the center
                is 0 (e.g. scan_points_2).
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-scan-pointsn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-scan-pointsn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxspm-scan-pattern-scan-pointsn-field .

:nxspm-scan-control-spiralscan-spiral-radiusn-field a owl:Class ;
    rdfs:label "NXspm_scan_control/spiralSCAN/spiral_radiusN"^^xsd:string ;
    rdfs:comment """
                Define the radius of the spiral circle of scanning.
                
                Rename the field, according to the circle order, the nearest circle to the center is 0.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-spiral-radiusn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-spiral-radiusn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxspm-scan-pattern-spiral-radiusn-field .

:nxspm-scan-control-trajscan-group a owl:Class ;
    rdfs:label "NXspm_scan_control/trajSCAN"^^xsd:string ;
    rdfs:comment """
            To define the trajectory scan, use this group.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-trajscan-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-trajscan-group> ;
    rdfs:subClassOf :NXspm_scan_pattern,
        :NeXusGroup .

:nxspm-scan-pattern-backward-speedn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/backward_speedN"^^xsd:string ;
    rdfs:comment """
            Define the scan speed in the backward directions (except the spiral and trajectory scans).
            Rename the field, according to the name of the dimension.
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-backward-speedn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-backward-speedn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-scan-pattern-channelname-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/channelNAME"^^xsd:string ;
    rdfs:comment """
            Name of the channel that leads the scan data. The ending annotation 'NAME' is to represent the name of the channel and/or dimension.
            
            Rename the field, according to the name of the channel and dimension (e.g. channel_piezo_scanner_x).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-channelname-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-channelname-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-scan-pattern-continuousn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/continuousN"^^xsd:string ;
    rdfs:comment """
            If the scan probe moves continuously over the scan points or steps, use True. The default value is True.
            Usually, continuous scanning is possible in one dimension. On other dimensions, the scan probe moves
            in steps.
            
            Rename the field, according to the name of the dimension (e.g. continuous_voltage).
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-continuousn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-continuousn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-scan-pattern-data-axisname-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/DATA/AXISNAME"^^xsd:string ;
    rdfs:comment """
                The name of the axis that corresponds to the data field.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-axisname-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-axisname-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR_OR_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR_OR_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField,
        :nxdata-axisname-field .

:nxspm-scan-pattern-data-data-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/DATA/DATA"^^xsd:string ;
    rdfs:comment """
                The data (e.g. current, voltage, temperature) field that can be plotted against
                the axes.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-data-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-data-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField,
        :nxdata-data-field .

:nxspm-scan-pattern-forward-speedn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/forward_speedN"^^xsd:string ;
    rdfs:comment """
            Define the scan speed in the forward directions (except the spiral and trajectory scans).
            Rename the field, according to the name of the dimension.
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-forward-speedn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-forward-speedn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-pattern-number-of-trajectory-points-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/number_of_trajectory_points"^^xsd:string ;
    rdfs:comment """
            The number of trajectory points in the entire scan that defines the path or lines of the trajectory.
            Each trajectory line is defined by two subsequent trajectory points.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-number-of-trajectory-points-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-number-of-trajectory-points-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-pattern-oscillating-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/oscillating"^^xsd:string ;
    rdfs:comment """
            If the scan probe oscillates over the scan point, use True.
            The default value is False.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-oscillating-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-oscillating-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        :NeXusField .

:nxspm-scan-pattern-oscillation-frequency-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/oscillation_frequency"^^xsd:string ;
    rdfs:comment """
            The number of oscillations on each scanning point per second.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-oscillation-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-oscillation-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-scan-pattern-scan-speedn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/scan_speedN"^^xsd:string ;
    rdfs:comment """
            Define the scan speed in the forward direction along the axis (except the spiral and trajectory scans),
            if forward and backward speeds below are not specified.
            
            If the scan goes in the negative direction, the speed should be negative.
            
            Rename the field, according to the name of the dimension (e.g. scan_speed_x, scan_speed_voltage).
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-scan-speedn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-scan-speedn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-pattern-steppingn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/steppingN"^^xsd:string ;
    rdfs:comment """
            The number of steps the probe jumps over the scan steps or points in the scanning process. This comes into picture, when not
            every point from the scan_points is scanned along an axis (except the spiral and trajectory scans).
            
            Rename the field, according to the name of the dimension (e.g. stepping_x, stepping_voltage).
            
            Trajectory scan:  N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-steppingn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-steppingn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-scan-pattern-trajectory-points-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/trajectory_points"^^xsd:string ;
    rdfs:comment """
            The trajectory points (nTraj) are the N-dimensional vectors (nD), each vector refers to a point in
            N-dimensional phase space.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-trajectory-points-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-trajectory-points-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxspm-temperature-sensor-calibration-calibration-parameters-coefficient-field a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/calibration/calibration_parameters/coefficient"^^xsd:string ;
    rdfs:comment """
                    The coefficient of the calibration.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-calibration-parameters-coefficient-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-calibration-parameters-coefficient-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-temperature-sensor-calibration-calibration-parameters-group a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/calibration/calibration_parameters"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-calibration-parameters-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-calibration-parameters-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-calibration-calibration-parameters-coefficient-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxcalibration-calibration-parameters-group .

:nxspm-temperature-sensor-calibration-group a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/calibration"^^xsd:string ;
    rdfs:comment """
            Calibration of the temperature measurement.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-calibration-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-temperature-sensor-calibration-calibration-parameters-group ;
            owl:onProperty :has ],
        :NXcalibration,
        :NeXusGroup .

:nxspm-temperature-sensor-data-axisname-field a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/DATA/AXISNAME"^^xsd:string ;
    rdfs:comment """
                independent axis data like time or position or bias voltage.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-data-axisname-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-data-axisname-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-temperature-sensor-data-data-field a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/DATA/DATA"^^xsd:string ;
    rdfs:comment """
                Temperature data collected during the scan.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-data-data-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_temperature_sensor.html#nxspm-temperature-sensor-data-data-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TEMPERATURE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxdata-data-field .

:nxspm-temperature-sensor-data-group a owl:Class ;
    rdfs:label "NXspm_temperature_sensor/DATA"^^xsd:string ;
    rdfs:comment """
            Data related to the temperature measurement, such as time series data
            or voltage-temperature data.
        """^^xsd:string ;
