    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_UINT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_UINT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxapm-paraprobe-nanochem-config-entry-interface-meshingid-decoration-filter-method-whitelist-enum a owl:Class ;
    rdfs:label "NXapm_paraprobe_nanochem_config/ENTRY/interface_meshingID/decoration_filter/method/whitelist"^^xsd:string ;
    rdfs:comment "Enumeration item for NXapm_paraprobe_nanochem_config/ENTRY/interface_meshingID/decoration_filter/method: whitelist"^^xsd:string ;
