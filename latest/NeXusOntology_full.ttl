:nxspm-scan-pattern-data-group a owl:Class ;
    rdfs:label "NXspm_scan_pattern/DATA"^^xsd:string ;
    rdfs:comment """
            The scan data is the data collected during the scan.
            If the scan has several channels or derivatives from the channel data, please
            duplicate this NXdata group for each.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-data-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-data-axisname-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-scan-pattern-data-data-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxobject-data-group .

:nxspm-scan-pattern-spiral-radiusn-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/spiral_radiusN"^^xsd:string ;
    rdfs:comment """
            Define the radius of the spiral circle of scanning.
            
            Rename the field, according to the circle order, the nearest circle to the center is 0.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-spiral-radiusn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-spiral-radiusn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

