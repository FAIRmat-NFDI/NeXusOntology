:nxoptical-spectroscopy-entry-instrument-sample-stage-transformations-group a owl:Class ;
    rdfs:label "NXoptical_spectroscopy/ENTRY/INSTRUMENT/sample_stage/transformations"^^xsd:string ;
    rdfs:comment """
                        This allows a description of the stages relation or orientation and
                        position with respect to the sample or beam, if an laboratory or
                        an stage coordinate system is defined.
                    """^^xsd:string ;
