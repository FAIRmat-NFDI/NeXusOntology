:nxstm-entry-instrument-lockin-amplifier-modulation-signal-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/INSTRUMENT/lockin_amplifier/modulation_signal"^^xsd:string ;
    rdfs:comment """
                        The type of the signal (voltage or current) subject to modulation.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-instrument-lockin-amplifier-modulation-signal-field> ;
