                    owl:oneOf ( "1"^^xsd:string ) ] ;
            owl:onProperty :actualValue ],
        :NeXusEnumerations .

:nxxbase-entry-instrument-detector-data-signal-attribute a owl:Class ;
    rdfs:label "NXxbase/ENTRY/instrument/detector/data/signal"^^xsd:string ;
