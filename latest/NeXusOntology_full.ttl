        :nxinstrument-sensor-group .

:nxspm-entry-instrument-sample-temperature-sensor-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/sample_temperature_sensor"^^xsd:string ;
    rdfs:comment """
