    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXentry.html#nxentry-monitor-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXentry.html#nxentry-monitor-group> ;
