            owl:onClass :nxcalibration-calibrated-axis-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-calibration-object-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-identifier-calibration-reference-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-original-axis-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-fit-formula-description-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-mapping-mapping-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-fit-formula-inputs-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-description-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcalibration-calibration-parameters-group ;
            owl:onProperty :has ],
        :NXprocess,
        :NeXusBaseClass ;
    :extends "NXprocess"^^xsd:string .

:nxmonitor-mode-field a owl:Class ;
    rdfs:label "NXmonitor/mode"^^xsd:string ;
    rdfs:comment """
            Count to a preset value based on either clock time (timer)
            or received monitor counts (monitor).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-mode-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-mode-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:unionOf ( [ a owl:Class ;
                                                owl:unionOf ( [ a owl:Class ;
                                                            owl:unionOf ( [ a owl:Class ;
                                                                        owl:unionOf ( [ a owl:Class ;
                                                                                    owl:unionOf ( [ a owl:Class ;
                                                                                                owl:unionOf ( [ a owl:Class ;
                                                                                                            owl:unionOf ( [ a owl:Class ;
                                                                                                                        owl:unionOf ( [ a owl:Class ;
                                                                                                                                    owl:unionOf ( [ a owl:Class ;
                                                                                                                                                owl:unionOf ( [ a owl:Class ;
                                                                                                                                                            owl:unionOf ( [ a owl:Restriction ;
                                                                                                                                                                        owl:allValuesFrom [ a owl:Class ;
                                                                                                                                                                                owl:unionOf ( :nxmonitor-mode-monitor-enum :nxmonitor-mode-timer-enum ) ] ;
                                                                                                                                                                        owl:onProperty :hasEnumContainer ] :nxfluo-entry-monitor-mode-field ) ] :nxlauetof-entry-control-mode-field ) ] :nxmonopd-entry-monitor-mode-field ) ] :nxrefscan-entry-control-mode-field ) ] :nxreftof-entry-control-mode-field ) ] :nxsas-entry-monitor-mode-field ) ] :nxsastof-entry-control-mode-field ) ] :nxtas-entry-monitor-mode-field ) ] :nxtofnpd-entry-monitor-mode-field ) ] :nxtofraw-entry-monitor-mode-field ) ] :nxtofsingle-entry-monitor-mode-field ) ] :nxxas-entry-monitor-mode-field ) ] :nxxbase-entry-control-mode-field ) ],
        :NeXusField .

:nxobject-groupname-log-group a owl:Class ;
    rdfs:label "NXobject/GROUPNAME_log"^^xsd:string ;
    rdfs:comment """
            NXlog group containing logged values of GROUPNAME.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXobject.html#nxobject-groupname-log-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXobject.html#nxobject-groupname-log-group> ;
