            owl:onClass :nxxpcs-entry-instrument-masks-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxxpcs-entry-instrument-detector-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-instrument-group .

