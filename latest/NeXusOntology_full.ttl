:nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-group a owl:Class ;
    rdfs:label "NXafm/ENTRY/INSTRUMENT/SPM_CANTILEVER/cantilever_oscillator"^^xsd:string ;
    rdfs:comment """
                        When a cantilever is oscillated close to its resonance, this describes the oscillator properties.
                        
                        A cantilever can be used in direct contact mode to detect interaction forces or oscillated close to its
                        resonance frequency. Changes in the oscillation amplitude, phase (between oscillated tail and moving tip)
                        or resonance frequency are very sensitive to changes in the interaction potential field, giving rise of
                        various measurement modes, such as non-contact or intermittent-contact (tapping) modes.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-phase-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-frequency-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-amplitude-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxspm-cantilever-cantilever-oscillator-group .

