:nxmicrostructure-score-results-entry-discretization-boundary-boundary-conditions-field a owl:Class ;
    rdfs:label "NXmicrostructure_score_results/ENTRY/discretization/boundary/boundary_conditions"^^xsd:string ;
    rdfs:comment """
                        The boundary conditions for each boundary:
                        
                        * 0 - undefined
                        * 1 - open
                        * 2 - periodic
                        * 3 - mirror
                        * 4 - von Neumann
                        * 5 - Dirichlet
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_results.html#nxmicrostructure-score-results-entry-discretization-boundary-boundary-conditions-field> ;
