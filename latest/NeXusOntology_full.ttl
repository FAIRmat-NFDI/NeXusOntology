        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-entry-instrument-hardware-vendor-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/hardware/vendor"^^xsd:string ;
    rdfs:comment """
                        Company name of the manufacturer.
                    """^^xsd:string ;
