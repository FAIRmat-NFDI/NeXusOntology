            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-surface-distance-group ;
