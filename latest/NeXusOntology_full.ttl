:nxem-ebsd-indexing-roi-descriptor-field a owl:Class ;
    rdfs:label "NXem_ebsd/indexing/roi/descriptor"^^xsd:string ;
    rdfs:comment """
                    Descriptor representing the image contrast.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-indexing-roi-descriptor-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-indexing-roi-descriptor-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxem-ebsd-indexing-roi-descriptor-band-contrast-enum :nxem-ebsd-indexing-roi-descriptor-confidence-index-enum :nxem-ebsd-indexing-roi-descriptor-mean-angular-deviation-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusField .

:nxem-ebsd-indexing-roi-descriptor-mean-angular-deviation-enum a owl:Class ;
    rdfs:label "NXem_ebsd/indexing/roi/descriptor/mean_angular_deviation"^^xsd:string ;
