        :NeXusGroup .

:nxspm-entry-instrument-lockin-amplifier-active-channel-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/lockin_amplifier/active_channel"^^xsd:string ;
    rdfs:comment """
                        The name of the active channel of the lock-in amplifier which is used for the
                        measurement.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-lockin-amplifier-active-channel-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-lockin-amplifier-active-channel-field> ;
