            owl:onClass :nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-iso-surfaceid-triangle-soup-triangles-volumetric-features-indices-triangle-cluster-field ;
            owl:onProperty :has ],
        :NXprocess,
