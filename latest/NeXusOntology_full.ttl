            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        :NeXusAttribute .

:nxattenuator-thickness-field a owl:Class ;
    rdfs:label "NXattenuator/thickness"^^xsd:string ;
    rdfs:comment "Thickness of attenuator along beam direction"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXattenuator.html#nxattenuator-thickness-field> ;
