        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxafm-entry-scan-mode-field a owl:Class ;
    rdfs:label "NXafm/ENTRY/scan_mode"^^xsd:string ;
    rdfs:comment """
                The mode of the scan.
                
                contact mode: Cantilever attempts to move on the sample surface in very close contact with the sample.
                 The cantilever deflection is usually employed to control the cantilever position using a PID feedback loop.
                non-contact mode: Cantilever attempts to oscillate above the sample surface. Cantilever attempts to stay in the
                 interaction (atomic force) zone therefore cantilever oscillator amplitude and frequency are deformed.
                 The cantilever frequency or oscillation amplitude is usually employed to control the cantilever position using a PID feedback loop.
                tapping mode: Resembles to the non-contact mode, but at every point of scan the cantilever tip comes closer
                 to the sample surface ("taps it").
                 The cantilever oscillation amplitude is usually employed to control the cantilever position using a PID feedback loop.
                peak force tapping mode: Like the tapping mode, but at each point of the scan force-distance curve is recorded.
                 The maximum force is usually employed to control the cantilever position using a PID feedback loop.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-scan-mode-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-scan-mode-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxspm-entry-scan-mode-field .

:nxamplifier-active-channels-field a owl:Class ;
    rdfs:label "NXamplifier/active_channels"^^xsd:string ;
    rdfs:comment """
            The number of preamplifier channels are ready to be used. (array for active
            channels)
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-active-channels-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-active-channels-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxamplifier-bandwidth-field a owl:Class ;
    rdfs:label "NXamplifier/bandwidth"^^xsd:string ;
    rdfs:comment """
            The spectrum of frequency it can amplify, from its lowest to highest frequency
            limits. If it is difference of the frequencies, please also provide :ref: 
            `center_frequency </NXamplifier/center_frequency-field>`.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-bandwidth-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-bandwidth-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxamplifier-center-frequency-field a owl:Class ;
    rdfs:label "NXamplifier/center_frequency"^^xsd:string ;
    rdfs:comment """
            The frequency in the middle of the bandwidth.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-center-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-center-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxamplifier-classification-field a owl:Class ;
    rdfs:label "NXamplifier/classification"^^xsd:string ;
    rdfs:comment """
            Type of the amplifier base on the response on frequency.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-classification-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-classification-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxamplifier-crosstalk-compensation-field a owl:Class ;
    rdfs:label "NXamplifier/crosstalk_compensation"^^xsd:string ;
    rdfs:comment """
            If measures are taken for reducing interferences between different signalling
            pathways.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-crosstalk-compensation-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-crosstalk-compensation-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_BOOLEAN ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_BOOLEAN ],
        :NeXusField .

:nxamplifier-crosstalk-factor-field a owl:Class ;
    rdfs:label "NXamplifier/crosstalk_factor"^^xsd:string ;
    rdfs:comment """
            The unwanted coupling between different channels (if active >1).
            In ideal amplifier, channels are independent of each other, But due to different resources
            sharing (e.g., same power supply, electromagnetic interference), there may have some 
            unwanted coupling between different channels, which is called crosstalk.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-crosstalk-factor-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-crosstalk-factor-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxamplifier-gain-field a owl:Class ;
    rdfs:label "NXamplifier/gain"^^xsd:string ;
    rdfs:comment """
            The ratio of the output signal to the input signal of the amplifier.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-gain-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-gain-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxamplifier-hardware-group a owl:Class ;
    rdfs:label "NXamplifier/hardware"^^xsd:string ;
    rdfs:comment """
            (IC, device) (NXmanufacturer?)
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-hardware-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-hardware-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxcomponent-fabrication-group .

:nxamplifier-lower-cutoff-frequency-field a owl:Class ;
    rdfs:label "NXamplifier/lower_cutoff_frequency"^^xsd:string ;
    rdfs:comment """
            The lower frequency point of the bandwidth where gain drops significantly (e.g.,
            -3dB point).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-lower-cutoff-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-lower-cutoff-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxamplifier-num-of-channels-field a owl:Class ;
    rdfs:label "NXamplifier/num_of_channels"^^xsd:string ;
    rdfs:comment """
            The number of preamplifier channels are assigned.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-num-of-channels-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-num-of-channels-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxamplifier-openloop-amplification-field a owl:Class ;
    rdfs:label "NXamplifier/openloop_amplification"^^xsd:string ;
    rdfs:comment """
            The output signal does not go through a feedback loop to adjust the
            amplification of the amplifier. (array for active channels)
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-openloop-amplification-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-openloop-amplification-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxamplifier-signal-over-noise-field a owl:Class ;
    rdfs:label "NXamplifier/signal_over_noise"^^xsd:string ;
    rdfs:comment """
            The ratio of the amplitude of the target signal to the amplitude of the noise in
            the output signal of the amplifier. S/N=V_signal/V_noise. (array for active
            channels)
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-signal-over-noise-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-signal-over-noise-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxamplifier-upper-cutoff-frequency-field a owl:Class ;
    rdfs:label "NXamplifier/upper_cutoff_frequency"^^xsd:string ;
    rdfs:comment """
            The upper frequency point of the bandwidth where gain drops significantly (e.g.,
            -3dB point).
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-upper-cutoff-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXamplifier.html#nxamplifier-upper-cutoff-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_FREQUENCY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxaperture-blade-geometry-group a owl:Class ;
    rdfs:label "NXaperture/BLADE_GEOMETRY"^^xsd:string ;
    rdfs:comment "location and shape of each blade"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-blade-geometry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-blade-geometry-group> ;
    rdfs:subClassOf :NXgeometry,
        :NeXusGroup ;
    owl:deprecated true .

:nxaperture-depends-on-field a owl:Class ;
    rdfs:label "NXaperture/depends_on"^^xsd:string ;
    rdfs:comment """
        The reference point of the aperture is its center in the x and y axis. The reference point on the z axis is the
        surface of the aperture pointing towards the source.

        In complex (asymmetric) geometries an NXoff_geometry group can be used to provide an unambiguous reference.

        .. image:: aperture/aperture.png
            :width: 40%
      """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-depends-on-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-depends-on-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxcomponent-depends-on-field .

:nxaperture-description-field a owl:Class ;
    rdfs:label "NXaperture/description"^^xsd:string ;
    rdfs:comment "Description of aperture"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-description-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-description-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxcomponent-description-field .

:nxaperture-note-group a owl:Class ;
    rdfs:label "NXaperture/NOTE"^^xsd:string ;
    rdfs:comment """
             Describe any additional information in a note.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-note-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-note-group> ;
    rdfs:subClassOf :NeXusGroup,
        :nxobject-note-group .

:nxaperture-off-geometry-group a owl:Class ;
    rdfs:label "NXaperture/OFF_GEOMETRY"^^xsd:string ;
    rdfs:comment """
        Use this group to describe the shape of the aperture.
      """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-off-geometry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-off-geometry-group> ;
    rdfs:subClassOf :NXoff_geometry,
        :NeXusGroup .

:nxaperture-positioner-group a owl:Class ;
    rdfs:label "NXaperture/POSITIONER"^^xsd:string ;
    rdfs:comment """
             Stores the raw positions of aperture motors.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-positioner-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-positioner-group> ;
    rdfs:subClassOf :NXpositioner,
        :NeXusGroup .

:nxaperture-size-field a owl:Class ;
    rdfs:label "NXaperture/size"^^xsd:string ;
    rdfs:comment """
             The relevant dimension for the aperture, i.e. slit width, pinhole and iris
             diameter
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-size-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-size-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxapm-compositionspace-config-entry-clustering-dbscan-eps-field a owl:Class ;
    rdfs:label "NXapm_compositionspace_config/ENTRY/clustering/dbscan/eps"^^xsd:string ;
    rdfs:comment """
                        The maximum distance between voxel pairs in a neighborhood to be considered
                        connected.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-eps-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-eps-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxapm-compositionspace-config-entry-clustering-dbscan-group a owl:Class ;
    rdfs:label "NXapm_compositionspace_config/ENTRY/clustering/dbscan"^^xsd:string ;
    rdfs:comment """
                    Configuration for the DBScan algorithm that is used in the clustering step.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-compositionspace-config-entry-clustering-dbscan-min-samples-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-compositionspace-config-entry-clustering-dbscan-eps-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxprocess-parameters-group .

:nxapm-compositionspace-config-entry-clustering-dbscan-min-samples-field a owl:Class ;
    rdfs:label "NXapm_compositionspace_config/ENTRY/clustering/dbscan/min_samples"^^xsd:string ;
    rdfs:comment """
                        The number of voxels in a neighborhood for a voxel to be considered as a core
                        point.
                    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-min-samples-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-dbscan-min-samples-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_UINT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_UNITLESS ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_UINT ],
        :NeXusField .

:nxapm-compositionspace-config-entry-clustering-group a owl:Class ;
    rdfs:label "NXapm_compositionspace_config/ENTRY/clustering"^^xsd:string ;
    rdfs:comment """
                Step during which the chemically segmented voxel sets are analyzed for their
                spatial organization.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-clustering-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxapm-compositionspace-config-entry-clustering-dbscan-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-process-group .

