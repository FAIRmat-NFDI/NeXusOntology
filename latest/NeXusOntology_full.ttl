            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField,
        :nxspm-entry-reproducibility-indicators-link-to-field-field .

:nxstm-entry-reproducibility-indicators-reference-frequency-field a owl:Class ;
    rdfs:label "NXstm/ENTRY/reproducibility_indicators/reference_frequency"^^xsd:string ;
    rdfs:comment """
                    The frequency of the sine modulation that is used as a carrier signal of input signal in lock-in.
                    
                    This should be a link to
                    /entry/instrument/lockin_amplifier/reference_frequency
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-reference-frequency-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXstm.html#nxstm-entry-reproducibility-indicators-reference-frequency-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxstm-entry-resolution-indicators-bias-sweep-group a owl:Class ;
    rdfs:label "NXstm/ENTRY/resolution_indicators/BIAS_SWEEP"^^xsd:string ;
    rdfs:comment """
