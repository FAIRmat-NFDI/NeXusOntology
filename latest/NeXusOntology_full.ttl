                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_DATE_TIME ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TIME ],
        :NeXusField .

:nxspm-scan-control-scan-time-start-field a owl:Class ;
    rdfs:label "NXspm_scan_control/scan_time_start"^^xsd:string ;
    rdfs:comment """
            The start time of the scan.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-time-start-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-time-start-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
