            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxstxm-entry-data-sample-x-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
