    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( :nxcansas-entry-process-cansas-class-sasprocess-enum ) ] ;
            owl:onProperty :hasEnumContainer ],
        :NeXusAttribute .

:nxcansas-entry-process-cansas-class-sasprocess-enum a owl:Class ;
    rdfs:label "NXcanSAS/ENTRY/PROCESS/canSAS_class/SASprocess"^^xsd:string ;
