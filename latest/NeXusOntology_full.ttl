            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_DATE_TIME ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxsample-temperature-field a owl:Class ;
    rdfs:label "NXsample/temperature"^^xsd:string ;
    rdfs:comment "Sample temperature. This could be a scanned variable"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_TEMPERATURE ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        :NeXusField .

:nxsample-unit-cell-field a owl:Class ;
    rdfs:label "NXsample/unit_cell"^^xsd:string ;
    rdfs:comment "Unit cell parameters (lengths and angles)"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-unit-cell-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-unit-cell-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        :NeXusField .

:nxsample-x-translation-field a owl:Class ;
    rdfs:label "NXsample/x_translation"^^xsd:string ;
    rdfs:comment """
			Translation of the sample along the X-direction of the laboratory coordinate system
			Note, it is recommended to use NXtransformations instead.
		"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-x-translation-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-x-translation-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_FLOAT ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_LENGTH ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_FLOAT ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxsensor-scan-entry-instrument-environment-group a owl:Class ;
    rdfs:label "NXsensor_scan/ENTRY/INSTRUMENT/ENVIRONMENT"^^xsd:string ;
    rdfs:comment """
                    Describes an environment setup for the experiment.
                    
                    All the setting values of the independently scanned controllers are listed under corresponding
                    NXsensor groups. Similarly, separate NXsensor groups are used to store the readings from each
                    measurement sensor.
                    
                    For example, in a temperature-dependent IV measurement, the temperature and voltage must be
                    present as independently scanned controllers and the current sensor must also be present with
                    its readings.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-environment-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-environment-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-environment-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-environment-independent-controllers-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-environment-pid-controller-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxsensor-scan-entry-instrument-environment-measurement-sensors-field ;
            owl:onProperty :has ],
        :NXenvironment,
        :NeXusGroup .

:nxspm-entry-experiment-technique-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/experiment_technique"^^xsd:string ;
    rdfs:comment """
                The technique of the experiment like STM, STS, AFM.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-experiment-technique-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-experiment-technique-field> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:unionOf ( [ a owl:Class ;
                                    owl:unionOf ( [ a owl:Restriction ;
                                                owl:allValuesFrom [ a owl:Class ;
                                                        owl:unionOf ( :nxspm-entry-experiment-technique-stm-enum :nxspm-entry-experiment-technique-sts-enum :nxspm-entry-experiment-technique-afm-enum ) ] ;
                                                owl:onProperty :hasEnumContainer ] :nxafm-entry-experiment-technique-field ) ] :nxstm-entry-experiment-technique-field ) ] :nxsts-entry-experiment-technique-field ) ],
        :NeXusField .

:nxspm-entry-group a owl:Class ;
    rdfs:label "NXspm/ENTRY"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-definition-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-scan-mode-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-data-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-sample-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-experiment-technique-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-resolution-indicators-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-process-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-scan-type-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-reproducibility-indicators-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-identifier-experiment-field ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-scan-entry-group .

:nxspm-entry-instrument-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT"^^xsd:string ;
    rdfs:comment ""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-cryo-shield-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-voltage-sensortag-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-height-piezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-cryo-bottom-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-head-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-current-sensortag-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-real-time-controller-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-sample-temperature-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-sample-bias-voltage-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-bias-spectroscopy-environment-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-hardware-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-piezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-xyzpiezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-software-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-lockin-amplifier-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-scan-entry-instrument-group .

:nxspm-entry-instrument-scan-environment-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/INSTRUMENT/SCAN_ENVIRONMENT"^^xsd:string ;
    rdfs:comment """
                    Information of the scan environment holding concept for
                    temperature, setpoint (current or height), scan area and scan data.
                    
                    Note: At least one field from head_temperature, cryo_bottom_temperature and cryo_shield_temperature must be provided.
                """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-scan-environment-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-scan-environment-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-xyzpiezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-cryo-shield-temperature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-spm-scan-control-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-piezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-height-piezo-sensor-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-identifier-environment-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-current-sensortag-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-cryo-bottom-temperature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-head-temperature-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-instrument-scan-environment-voltage-sensortag-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxsensor-scan-entry-instrument-environment-group .

:nxspm-entry-reproducibility-indicators-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/reproducibility_indicators"^^xsd:string ;
    rdfs:comment """
                The group of indicators (links to the existing fields in different groups) that measure
                the reproducibility of the experiment.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-reproducibility-indicators-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-reproducibility-indicators-link-to-field-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-reproducibility-indicators-link-to-group-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-collection-group .

:nxspm-entry-resolution-indicators-group a owl:Class ;
    rdfs:label "NXspm/ENTRY/resolution_indicators"^^xsd:string ;
    rdfs:comment """
                The group of indicators (links to the existing fields in different groups) that
                are used to measure the resolution of the experiment results.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-group> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-resolution-indicators-group> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-resolution-indicators-link-to-field-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxspm-entry-resolution-indicators-link-to-group-group ;
            owl:onProperty :has ],
        :NeXusGroup,
        :nxentry-collection-group .

:nxspm-entry-scan-mode-field a owl:Class ;
    rdfs:label "NXspm/ENTRY/scan_mode"^^xsd:string ;
    rdfs:comment """
                The mode of the scan. The possible options depend on the type of experiment.
                For example, in STM, the scan mode could be constant height or constant current,
                in AFM, the scan mode could be contact mode, tapping mode or non-contact mode.
                
                For general purpose usage, all scan modes from its sub-techniques are listed.
            """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-scan-mode-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-scan-mode-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:nxspm-scan-pattern-step-sizen-field a owl:Class ;
    rdfs:label "NXspm_scan_pattern/step_sizeN"^^xsd:string ;
    rdfs:comment """
            The size of each step in the scan on each dimension (except the spiral and trajectory scans).
            
            Rename the field, according to the name of the dimension (e.g. step_size_x, step_size_voltage).
            
            Trajectory scan:  N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-step-sizen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-step-sizen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-scan-region-scan-endn-field a owl:Class ;
    rdfs:label "NXspm_scan_region/scan_endN"^^xsd:string ;
    rdfs:comment """
            The end of the scan is the ending point of the scan region (phase space or sub-phase space)
            for each independent scan axis.
            
            Note: The scan_offset and scan_range are equivalent to the scan_start and scan_end.
            
            For N-dimensional, it is a list of N numbers.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-endn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-endn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        :NeXusField .

:nxspm-scan-region-scan-rangen-field a owl:Class ;
    rdfs:label "NXspm_scan_region/scan_rangeN"^^xsd:string ;
    rdfs:comment """
            The range of the scan is the difference start and end values of the scan region
            along the dimension 'N'.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-rangen-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-rangen-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        :NeXusField .

:nxspm-scan-region-scan-startn-field a owl:Class ;
    rdfs:label "NXspm_scan_region/scan_startN"^^xsd:string ;
    rdfs:comment """
            The start of the scan is the starting point of the scan region (phase space or sub-phase space)
            for each independent scan axis.
            
            For N-dimensional, it is a list of N numbers.
        """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-startn-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_region.html#nxspm-scan-region-scan-startn-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_NUMBER ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_NUMBER ] ;
            owl:onProperty :hasValueContainer ],
        :NeXusField .

:nxuser-facility-user-id-field a owl:Class ;
    rdfs:label "NXuser/facility_user_id"^^xsd:string ;
    rdfs:comment """
			facility based unique identifier for this person 
			e.g. their identification code on the facility 
			address/contact database
		"""^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXuser.html#nxuser-facility-user-id-field> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXuser.html#nxuser-facility-user-id-field> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:complementOf :NX_CHAR ] ;
            owl:onProperty :hasValueContainer ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnitContainer ;
            owl:someValuesFrom :NX_ANY ],
        [ a owl:Restriction ;
            owl:onProperty :hasValueContainer ;
            owl:someValuesFrom :NX_CHAR ],
        :NeXusField .

:NX_BINARY a owl:Class ;
    rdfs:label "NX_BINARY"^^xsd:string ;
    rdfs:comment "any representation of binary data - if text, line terminator is [CR][LF]"^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/nxdl-types.html#nx-binary> ;
    rdfs:seeAlso <https://manual.nexusformat.org/nxdl-types.html#nx-binary> ;
    rdfs:subClassOf :NeXusDataType .

:NXcg_triangle a owl:Class ;
    rdfs:label "NXcg_triangle"^^xsd:string ;
    rdfs:comment """
        Computational geometry description of a set of triangles.
    """^^xsd:string ;
    rdfs:isDefinedBy <https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html> ;
    rdfs:seeAlso <https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcg-triangle-triangles-group ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass :nxcg-triangle-edge-length-field ;
            owl:onProperty :has ],
        [ a owl:Restriction ;
