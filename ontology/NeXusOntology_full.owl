  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">How this crystal is used.  Choices are in the list.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcrystal.html#nxcrystal-usage-field</rdfs:seeAlso>
</owl:Class>

