</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-head-temperature-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_temperature_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/head_temperature_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The temperature of the SPM measured near the sample or tip. This group is intended to be used for
                    an array data (e.g., time series).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-head-temperature-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-cryo-bottom-temperature-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_temperature_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/cryo_bottom_temperature_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The temperature of the cold tail of the cryostat. This group is intended to be
                    used for an array data (e.g., time series).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-cryo-bottom-temperature-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-cryo-shield-temperature-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_temperature_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/cryo_shield_temperature_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The temperature of the liquid nitrogen shield. This group is intended to be used
                    for an array data (e.g., time series).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-cryo-shield-temperature-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-sample-temperature-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_temperature_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/sample_temperature_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The temperature of the sample. This group is intended to be used for
                    an array data (e.g., time series).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-sample-temperature-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxsensor-scan-entry-instrument-environment-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    To explain bias and current behavior (sweep measurement especially in STS experiment)
                    due to voltage applied to the sample.
                    
                    In some experiments, e.g., STM, bias spectroscopy could also be part of the measurement setup.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXspm_bias_spectroscopy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment/SPM_BIAS_SPECTROSCOPY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Setup and scan data for continuous measurement of bias voltage on the subject of experiment
                        vs tunneling current from probe.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-z-controller-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxspm-bias-spectroscopy-spm-positioner-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment/SPM_BIAS_SPECTROSCOPY/SPM_POSITIONER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Information about positioner used in STS scan settings, like PID controller and offset.
                            
                            Reuse, if needed, this group for positioners for multiple scans at different points on sample.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-z-controller-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <owl:equivalentClass rdf:resource="#nxspm-bias-spectroscopy-spm-positioner-z-controller-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment/SPM_BIAS_SPECTROSCOPY/SPM_POSITIONER/z_controller</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-spm-positioner-z-controller-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-scan-region-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-linear-sweep-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxspm-bias-spectroscopy-bias-sweep-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/bias_spectroscopy_environment/SPM_BIAS_SPECTROSCOPY/BIAS_SWEEP</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            The bias voltage sweep is a common technique used to study properties (in this case current) in
                            the sample or environment due to change in applied bias voltage.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-scan-region-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-scan-region-scan-start-bias-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-bias-spectroscopy-environment-spm-bias-spectroscopy-bias-sweep-scan-region-scan-end-bias-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
