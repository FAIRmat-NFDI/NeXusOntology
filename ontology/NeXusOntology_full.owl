<owl:Class rdf:about="#nxstress-entry-fit-description-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxprocess-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXstress/ENTRY/FIT/DESCRIPTION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The note will contain information about how the data was processed
                    or anything about the data provenance. 
                    The contents of the note can be anything that the processing code 
                    can understand, or a simple text.
            
                    The name will be numbered to allow for ordering of steps.
                 </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-description-group</rdfs:seeAlso>
</owl:Class>

