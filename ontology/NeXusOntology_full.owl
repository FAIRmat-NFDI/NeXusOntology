  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                All experiment results data such as scattering angle (2theta),
                intensity, incident angle, scattering vector, etc will be stored here.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxrd_pan.html#nxxrd-pan-entry-experiment-result-group</rdfs:seeAlso>
</owl:Class>

