</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-configuration-disorientation-threshold-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANGLE"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/configuration/disorientation_threshold</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Threshold to define at which disorientation angle to assume two crystalline regions have a significant
                orientation difference that warrants to assume that there exists an interface between the two regions.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-configuration-disorientation-threshold-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-phases-index-offset-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_INT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_INT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UNITLESS"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/phases/index_offset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                First identifier whereby to identify phases implicitly.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-phases-index-offset-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-crystals-representation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/crystals/representation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Reference to an instance of:
                
                * :ref:`NXcg_polyline` for a one- or two-dimensional representation as only a projection is available (like in linear intercept analysis)
                * :ref:`NXcg_polygon`, :ref:`NXcg_triangle`, or :ref:`NXcg_polyhedron` for a two- or three-dimensional representation as only a projection is available (like in most experiments)
                * :ref:`NXcg_grid` for regularly pixelated (in 1D, 2D) or voxelated representations (in 3D)
                
                which represent the geometrical entities of the discretization.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-crystals-representation-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-crystals-number-of-crystals-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UINT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_UINT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UNITLESS"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/crystals/number_of_crystals</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                How many crystals are distinguished.
                
                Crystals are listed irrespective of the phase to which these are assigned.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-crystals-number-of-crystals-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-crystals-number-of-phases-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UINT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_UINT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UNITLESS"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/crystals/number_of_phases</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                How many phases are distinguished.
                
                Phases are typically distinguished based on statistical thermodynamics argument and crystal structure.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-crystals-number-of-phases-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-crystals-index-offset-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_INT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
