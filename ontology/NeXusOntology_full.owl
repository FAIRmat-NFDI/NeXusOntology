  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-interfaces-number-of-interfaces-field</rdfs:seeAlso>
</owl:Class>

