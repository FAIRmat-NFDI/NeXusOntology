<owl:Class rdf:about="#NX_TIME_OF_FLIGHT">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_TIME_OF_FLIGHT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of (neutron) time of flight
				(alias to `NX_TIME`)
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-time-of-flight</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_TRANSFORMATION">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_TRANSFORMATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of the specified transformation
				
				could be any of these: ``NX_LENGTH``, ``NX_ANGLE``, or ``NX_UNITLESS``
				
				There will be one or more transformations defined by one or more fields
				for each transformation.  The units type ``NX_TRANSFORMATION`` designates the
				particular axis generating a transformation (e.g. a rotation axis or a translation
				axis or a general axis).   ``NX_TRANSFORMATION`` designates the
				units will be appropriate to the type of transformation,
				indicated in the :ref:`NXtransformations` base class
				by the ``transformation_type`` value:
				
				* ``NX_LENGTH`` for ``translation``
				* ``NX_ANGLE`` for ``rotation`` 
				* ``NX_UNITLESS`` for axes for which no transformation type is specified.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-transformation</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_UNITLESS">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_UNITLESS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				for fields that don't have a unit (e.g. hkl) so that they don't
				inherit the wrong units (NOTE: not the same as NX_DIMENSIONLESS)
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-unitless</rdfs:seeAlso>
</owl:Class>

