    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxlockin-harmonic-ordern-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxlockin-sensitivity-factor-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxlockin-dc-offset-valuen-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        A base class definition for a lock-in amplifier.
        
        The lock-in amplifier information: the device is being used to extract a (potentially)
        very weak input signal buried in the noisy background, where the input signal has
        the same frequency (or its harmonic) as carrier signal or reference signal, using heterodyne
        detection.
        
        This method extracts the amplitude and phase shift between input signal and reference signal.
        
        In single phase lock-in amplifiers used in high signal-to-noise ratio applications, only
        the amplitude is measured and phase difference is set to zero.
        
        In two phase lock-in amplifiers used in low signal-to-noise ratio applications, both the
        amplitude and phase difference are measured.
        
        Fields with partial names like low_passN, high_passN, etc., can be repeated for each channel
        of the lockin amplifier. It is envisioned that these fields are named low_pass_0, low_pass_1,
        and so on.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXlockin</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

