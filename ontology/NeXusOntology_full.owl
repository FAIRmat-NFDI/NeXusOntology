</owl:Class>

<owl:Class rdf:about="#nxbeam-splitter-shape-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-shape-sketch-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-shape-shape-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-shape-size-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-shape-wedge-angle-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXshape"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/SHAPE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Describe the geometry (shape, dimension etc.) of the beam splitter.
            Specify the dimensions in 'SHAPE/size'. A sketch of the device should be
            provided in the 'sketch(NXdata)' field to clarify (i) the shape and
            dimensions of the device, and (ii) the input and outputs (i.e. the
            direction of the incoming and outcoming (split) beams).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-shape-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxbeam-splitter-shape-sketch-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/SHAPE/sketch</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Sketch of the beam splitter showing its geometry. The paths of the
                incoming and split beam should be illustrated and labelled (0 for the
                incoming beam, and 1, 2,..., N_outputs for the outputs (i.e. the split
                beam paths)).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-shape-sketch-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxbeam-splitter-substrate-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-substrate-substrate-material-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-substrate-substrate-thickness-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-substrate-index-of-refraction-substrate-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXsample"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/substrate</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Substrate of the beam splitter. Describe the material of the substrate in
            substrate/substrate_material and provide its index of refraction in
            substrate/index_of_refraction_substrate, if known.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-substrate-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxbeam-splitter-coating-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-coating-coating-type-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-coating-coating-material-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-coating-coating-thickness-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-coating-wavelength-range-coating-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxbeam-splitter-coating-index-of-refraction-coating-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXsample"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/coating</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Is the beam splitter coated? If yes, specify the type and material of the
            coating and the spectral range for which it is designed. If known, you
            may also provide its index of refraction. For a beam splitter cube
            consisting of two prisms which are glued together, you may want to
            specify the the glue and the coatings of each prism.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-coating-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcontainer-beam-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXbeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcontainer/beam</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Details of beam incident on container, including the position 
			relative to the sample (to determine whether the container is 
			upstream or downstream of the sample).
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-beam-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcontainer-shape-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXshape"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcontainer/shape</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Shape of the container. In combination with orientation this 
			should allow the beampath through the container to be modelled to 
			allow the adsorption to be calculated.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-shape-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcontainer-orientation-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxcomponent-transformations-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcontainer/orientation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			The angle the container makes to the beam and how it may change 
			during the experiment.In combination with shape this should allow 
			the beampath through the container to be modelled to allow the 
			adsorption of the container to be calculated.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-orientation-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcsg-a-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcsg"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcsg/a</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
     The first operand of constructive solid geometry operation.
     Compulsory if 'operation' is UNION, INTERSECTION,
     DIFFERENCE or COMPLEMENT.
   </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-a-group</rdfs:seeAlso>
