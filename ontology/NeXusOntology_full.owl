      <owl:onClass rdf:resource="#nxspm-entry-instrument-piezo-sensor-z-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXspm_piezo_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/piezo_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    This piezo sensor group refers to the XYZ (in all directions) piezo sensor.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-piezo-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-height-piezo-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_piezo_sensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm/ENTRY/INSTRUMENT/height_piezo_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The sensor information for the height (Z-axis) piezo device.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-height-piezo-sensor-group</rdfs:seeAlso>
