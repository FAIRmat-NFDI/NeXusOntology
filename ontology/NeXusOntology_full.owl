    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxapm-paraprobe-tool-config-entry-taskconfig-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_clusterer_config/ENTRY/cluster_analysisID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                This process performs a cluster analysis on a
                reconstructed dataset or a ROI within it.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_config.html#nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-group</rdfs:seeAlso>
</owl:Class>

