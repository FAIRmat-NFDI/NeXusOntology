  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxoptical-lens-coating-index-of-refraction-coating-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXsample"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_lens/COATING</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            If the lens has a coating describe the material and its properties.
            Some basic information can be found e.g. [here]
            (https://www.opto-e.com/basics/reflection-transmission-and-coatings).
            If the back and front side of the lens are coated with different
            materials, use separate COATING(NXsample) fields to describe the coatings
            on the front and back side, respectively. For example:
            coating_front(NXsample) and coating_back(NXsample).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-coating-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxoptical-window-window-correction-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxoptical-window-window-correction-procedure-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxoptical-window-window-correction-reference-data-link-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXprocess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_window/window_correction</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Group to describe any window correction - if none performed, then omit this
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-window-correction-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxorientation-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXorientation/GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Link to another object if we are using relative positioning, else absent</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXorientation.html#nxorientation-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxpeak-data-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxpeak-data-position-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxpeak-data-intensity-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpeak/data</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-data-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxpeak-function-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXfit_function"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpeak/function</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The functional form of the peak. This could be a Gaussian, Lorentzian, Voigt,
            etc.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-function-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxphase-unit-cell-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXunit_cell"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase/UNIT_CELL</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-unit-cell-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxphase-atom-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXatom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase/ATOM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXphase.html#nxphase-atom-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxpid-controller-pv-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxpid-controller-pv-sensor-value-log-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXsensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpid_controller/pv_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The sensor representing the Process Value used in the feedback loop for the PID.
             
            In case multiple sensors were used, this NXsensor should contain the proper calculated/aggregated value.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxpid-controller-pv-sensor-value-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxpid-controller-pv-sensor-value-log-value-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxsensor-value-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpid_controller/pv_sensor/value_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpid_controller.html#nxpid-controller-pv-sensor-value-log-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxprocess-note-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXprocess/NOTE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The note will contain information about how the data was
            processed or anything about the data provenance. The
            contents of the note can be anything that the processing
            code can understand, or simple text.
            
            The name will be numbered to allow for ordering of steps.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXprocess.html#nxprocess-note-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxprocess-parameters-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-parameters-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXprocess/PARAMETERS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Parameters used in performing the data analysis.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXprocess.html#nxprocess-parameters-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxprocess-data-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXprocess/DATA</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The data resulting from the operation.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXprocess.html#nxprocess-data-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxregistration-transformations-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXtransformations"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXregistration/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             To describe the operations of image registration (combinations of rigid
             translations and rotations)
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXregistration.html#nxregistration-transformations-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxresolution-note-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXresolution/note</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Additional details of the estimate or description of the calibration procedure
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-note-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxresolution-response-function-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXresolution/response_function</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             The response of the instrument or part of the instrument to a infinitesimally sharp input signal
             along the physical quantity of this group.
             This is also sometimes called instrument response function for time resolution or
             point spread function for spatial response.
             The resolution is typically determined by taking the full width at half maximum (FWHM)
             of the response function.

             This could have an AXISNAME field ```input``` (the input axis or grid of the response function)
             and a ``DATA`` field ```magnitude```. Both of these should have the same unit. The dimensions
             should match those of the :ref:`resolution &lt;/NXresolution/resolution-field&gt;` field.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-response-function-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxresolution-formula-symbols-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-parameters-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXresolution/formula_symbols</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Symbols linking to another path in the NeXus tree to be referred to from the
            `resolution_formula_description` field. The ``TERM``  should be a valid path inside this application
            definition, i.e., of the form /entry/instrument/my_part/my_field.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-formula-symbols-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxresolution-calibration-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcalibration"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXresolution/CALIBRATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             For storing details and data of a calibration to derive a resolution from data.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-calibration-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxroi-process-process-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXprocess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXroi_process/PROCESS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXroi_process.html#nxroi-process-process-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxroot-entry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXentry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXroot/ENTRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entries</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXroot.html#nxroot-entry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/geometry</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The position and orientation of the center of mass of the sample</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-geometry-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxsample-beam-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXbeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/BEAM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Details of beam incident on sample - used to calculate sample/beam interaction point</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-beam-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-sample-component-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXsample_component"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/SAMPLE_COMPONENT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			One group per sample component
			This is the preferred way of recording per component information over the n_comp arrays
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-sample-component-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-transmission-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/transmission</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As a function of Wavelength</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-transmission-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-temperature-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-groupname-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/temperature_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature_log.value is a link to e.g. temperature_env.sensor1.value_log.value</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-log-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxsample-temperature-env-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXenvironment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/temperature_env</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Additional sample temperature environment information</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-temperature-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-magnetic-field-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxsample-magnetic-field-direction-attribute"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/magnetic_field</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">magnetic_field.value is a link to e.g. magnetic_field_env.sensor1.value</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-magnetic-field-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-magnetic-field-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-groupname-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/magnetic_field_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">magnetic_field_log.value is a link to e.g. magnetic_field_env.sensor1.value_log.value</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-magnetic-field-log-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxsample-magnetic-field-env-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXenvironment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/magnetic_field_env</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Additional sample magnetic environment information</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-magnetic-field-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-external-adc-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/external_ADC</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">logged value (or logic state) read from user's setup</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-external-adc-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-positioner-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXpositioner"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/POSITIONER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any positioner (motor, PZT, ...) used to locate the sample</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-positioner-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-off-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			This group describes the shape of the sample
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-environment-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXenvironment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/ENVIRONMENT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Any environmental or external stimuli/measurements.
			These can include, among others:
			applied pressure, surrounding gas phase and gas pressure,
			external electric/magnetic/mechanical fields, temperature, ...
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-environment-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-history-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXhistory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/history</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        	A set of physical processes that occurred to the sample prior/during experiment.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-history-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-component-transmission-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample_component/transmission</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">As a function of Wavelength</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample_component.html#nxsample-component-transmission-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsample-component-history-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXhistory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample_component/history</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             A set of physical processes that occurred to the sample component prior/during
             experiment.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample_component.html#nxsample-component-history-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxscan-controller-deflector-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXdeflector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXscan_controller/DEFLECTOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Details about components which realize the deflection technically.
            
            This concept should be used for all those components that implement
            the scanning of the beam, while components like beam blankers etc. should
            use rather the NXdeflector concept of the NXebeam_column base class.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-deflector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxscan-controller-circuit-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcircuit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXscan_controller/CIRCUIT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXscan_controller.html#nxscan-controller-circuit-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsensor-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/geometry</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Defines the axes for logged vector quantities if they are not the global instrument axes.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-geometry-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxsensor-value-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-groupname-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/value_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time history of sensor readings</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-value-log-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsensor-value-deriv1-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-groupname-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/value_deriv1_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time history of first derivative of sensor readings</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-value-deriv1-log-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsensor-value-deriv2-log-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-groupname-log-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/value_deriv2_log</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time history of second derivative of sensor readings</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-value-deriv2-log-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsensor-external-field-full-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXorientation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/external_field_full</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For complex external fields not satisfied by External_field_brief</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-external-field-full-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsensor-off-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                         This group describes the shape of the sensor when necessary.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-notes-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/notes</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			any source/facility related messages/events that 
			occurred during the experiment
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-notes-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-bunch-pattern-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxsource-bunch-pattern-title-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/bunch_pattern</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			For storage rings, description of the bunch pattern.  
			This is useful to describe irregular bunch patterns.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-bunch-pattern-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-pulse-shape-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/pulse_shape</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source pulse shape</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-pulse-shape-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/geometry</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			"Engineering" location of source.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-geometry-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxsource-aperture-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXaperture"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/APERTURE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			 The size and position of an aperture inside the source.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-aperture-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-electromagnetic-lens-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXelectromagnetic_lens"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/ELECTROMAGNETIC_LENS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Individual electromagnetic lenses inside the source.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-electromagnetic-lens-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-deflector-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXdeflector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/DEFLECTOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			 Deflectors inside the source.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-deflector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-fabrication-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <owl:equivalentClass rdf:resource="#nxcomponent-fabrication-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/FABRICATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-fabrication-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-off-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			This group describes the shape of the beam line component
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxsource-distribution-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/distribution</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The wavelength or energy distribution of the source</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-distribution-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspectrum-process-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-process-input-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-process-program-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-process-mode-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-process-detector-identifier-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXprocess"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspectrum/PROCESS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Details how spectra were processed from the detector readings.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXspectrum.html#nxspectrum-process-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspectrum-process-input-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-process-input-context-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxprocess-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspectrum/PROCESS/input</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Resolvable data artifact (e.g. filename) from which all values in the :ref:`NXdata`
                instances in this :ref:`NXspectrum` were loaded during parsing.
                
                Possibility to document from which specific other serialized resource as the source
                pieces of information were processed when using NeXus as a semantic file format
                to serialize that information differently.
                
                The group in combination with an added field *context* therein adds context.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXspectrum.html#nxspectrum-process-input-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspectrum-process-program-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXprogram"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspectrum/PROCESS/PROGRAM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXspectrum.html#nxspectrum-process-program-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspectrum-spectrum-0d-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-spectrum-0d-intensity-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-spectrum-0d-axis-energy-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspectrum/spectrum_0d</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            One spectrum for a point of a 0d ROI. Also known as spot measurement.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXspectrum.html#nxspectrum-spectrum-0d-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspectrum-spectrum-1d-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-spectrum-1d-intensity-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspectrum-spectrum-1d-axis-i-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
