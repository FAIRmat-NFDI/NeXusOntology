<owl:Class rdf:about="#nxazint2d-entry-default-attribute">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxentry-default-attribute"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXazint2d/ENTRY/default</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
          .. index:: plotting
          
          Declares which :ref:`NXdata` group 
          contains the data to be shown by default.
          It is needed to resolve ambiguity when more than one :ref:`NXdata` group exists. 
          The value is the name of the default :ref:`NXdata` group.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXazint2d.html#nxazint2d-entry-default-attribute</rdfs:seeAlso>
