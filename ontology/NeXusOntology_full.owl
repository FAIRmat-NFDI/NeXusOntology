<owl:Class rdf:about="#nxsource-probe-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                      <owl:unionOf rdf:parseType="Collection">
                        <owl:Class>
                          <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                              <owl:unionOf rdf:parseType="Collection">
                                <owl:Class>
                                  <owl:unionOf rdf:parseType="Collection">
                                    <owl:Class>
                                      <owl:unionOf rdf:parseType="Collection">
                                        <owl:Class>
                                          <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class>
                                              <owl:unionOf rdf:parseType="Collection">
                                                <owl:Class>
                                                  <owl:unionOf rdf:parseType="Collection">
                                                    <owl:Class>
                                                      <owl:unionOf rdf:parseType="Collection">
                                                        <owl:Class>
                                                          <owl:unionOf rdf:parseType="Collection">
                                                            <owl:Class>
