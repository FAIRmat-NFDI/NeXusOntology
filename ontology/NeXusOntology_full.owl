  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXellipsometry.html#nxellipsometry-entry-sample-backside-roughness-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxellipsometry-entry-data-collection-data-identifier-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
