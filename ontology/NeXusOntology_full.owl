<owl:Class rdf:about="#nxapm-paraprobe-nanochem-config-entry-delocalizationid-isosurfacing-has-proxy-edge-contact-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_BOOLEAN"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
