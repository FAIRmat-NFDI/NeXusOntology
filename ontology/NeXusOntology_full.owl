      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-voltage-controlled-oscillator-ko-coefficient-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase_lock_loop/voltage_controlled_oscillator</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The voltage-controlled oscillator (VCO) component of the PLL, which generates the output signal
            based on the filtered voltage from the loop filter.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-voltage-controlled-oscillator-group</rdfs:seeAlso>
</owl:Class>

