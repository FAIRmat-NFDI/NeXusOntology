  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxem-ebsd-pattern-center-y-boundary-convention-top-enum"/>
            <rdf:Description rdf:about="#nxem-ebsd-pattern-center-y-boundary-convention-right-enum"/>
            <rdf:Description rdf:about="#nxem-ebsd-pattern-center-y-boundary-convention-bottom-enum"/>
            <rdf:Description rdf:about="#nxem-ebsd-pattern-center-y-boundary-convention-left-enum"/>
          </owl:unionOf>
        </owl:Class>
