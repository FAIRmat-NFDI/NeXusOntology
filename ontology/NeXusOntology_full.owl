            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-end-settling-time-field</rdfs:seeAlso>
