  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxdetector-bit-depth-readout-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/INSTRUMENT/DETECTOR/bit_depth_readout</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            How many bits the electronics record per pixel.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-bit-depth-readout-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmx-entry-instrument-detector-detector-readout-time-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
