  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Pixel center coordinate calibrated for step size along the z axis of the map.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-map-axis-z-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-ipf-map-axis-y-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
