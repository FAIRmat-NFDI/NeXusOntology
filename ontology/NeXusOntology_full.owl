<owl:Class rdf:about="#nxmicrostructure-score-config-entry-deformation-model-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-deformation-model-cuboidal-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-deformation-model-poisson-voronoi-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-deformation-model-ebsd-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-deformation-model-damask-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_score_config/ENTRY/deformation/model</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Which model should be used to generate a starting microstructure.
                    
                    * cuboidal, a regular array of equally-shaped cuboidal grains
                    * poisson_voronoi, a discretized Poisson Voronoi tessellation
                    * ebsd, a microstructure synthesized based on a simulated or a measured EBSD orientation map
                    * damask, the result of a simulation from `DAMASK &lt;https://damask-multiphysics.org&gt;`_.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-deformation-model-field</rdfs:seeAlso>
</owl:Class>

