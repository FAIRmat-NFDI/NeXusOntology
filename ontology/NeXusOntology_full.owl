<owl:Class rdf:about="#nxxps-entry-method-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxmpes-entry-method-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxps/ENTRY/method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                A name of the experimental method according to `Clause 11`_ of
                the `ISO 18115-1:2023`_ specification.
                
                Examples for XPS-related experiments include:
                    * X-ray photoelectron spectroscopy (XPS)
                    * angle-resolved X-ray photoelectron spectroscopy (ARXPS)
                    * ultraviolet photoelectron spectroscopy (UPS)
                    * hard X-ray photoemission spectroscopy (HAXPES)
                    * near ambient pressure X-ray photoelectron spectroscopy (NAPXPS)
                    * electron spectroscopy for chemical analysis (ESCA)
                
                .. _ISO 18115-1:2023: https://www.iso.org/standard/74811.html
                .. _Clause 11: https://www.iso.org/obp/ui/en/#iso:std:iso:18115:-1:ed-3:v1:en:sec:11
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-method-field</rdfs:seeAlso>
</owl:Class>

