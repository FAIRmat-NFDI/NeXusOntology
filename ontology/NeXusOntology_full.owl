<owl:Class rdf:about="#nxxpcs-entry-data-g2-storage-mode-attribute">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxxpcs-entry-data-g2-storage-mode-one-array-enum"/>
            <rdf:Description rdf:about="#nxxpcs-entry-data-g2-storage-mode-data-exchange-keys-enum"/>
            <rdf:Description rdf:about="#nxxpcs-entry-data-g2-storage-mode-other-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxpcs/ENTRY/data/g2/storage_mode</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            storage_mode describes the format of the data to be loaded

            We encourage the documentation of other formats not represented here.

            * one array representing entire data set ("one_array")
            * data exchange format with each key representing one ``q`` by its corresponding roi_map value ("data_exchange_keys")
          </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-data-g2-storage-mode-attribute</rdfs:seeAlso>
</owl:Class>

