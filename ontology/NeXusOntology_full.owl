<owl:Class rdf:about="#nxapm-paraprobe-nanochem-config-entry-interface-meshingid-method-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxapm-paraprobe-nanochem-config-entry-interface-meshingid-method-pca-plus-dcom-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_nanochem_config/ENTRY/interface_meshingID/method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Method used for identifying and refining the location of the interface. Currently,
                    paraprobe-nanochem implements a PCA followed by an iterative loop of isotropic
                    mesh refinement and DCOM step(s), paired with self-intersection detection.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html#nxapm-paraprobe-nanochem-config-entry-interface-meshingid-method-field</rdfs:seeAlso>
</owl:Class>

