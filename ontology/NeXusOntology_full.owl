<owl:Class rdf:about="#nxapm-paraprobe-surfacer-results-entry-point-set-wrappingid-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxapm-paraprobe-surfacer-results-entry-point-set-wrappingid-alpha-complexid-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxapm-paraprobe-tool-results-entry-taskprocessed-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_surfacer_results/ENTRY/point_set_wrappingID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Paraprobe-surfacer can be used to load a ROI that is the entire or a
                sub-set of the ion point cloud. In the point_cloud_wrapping process
                the tool computes a triangulated surface mesh which encloses the
                ROI/point cloud. This mesh can be seen as a model for the edge of
                the dataset.
                
                Different algorithms can be used with paraprobe-surfacer to create
                this mesh such as convex hulls, alpha-shapes as their generalization,
                or alpha wrappings.
                
                Ideally, the resulting mesh should be a watertight polyhedron.
                This polyhedron is not necessarily convex. For some algorithms there
                is no guarantee that the resulting mesh yields a watertight mesh.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_surfacer_results.html#nxapm-paraprobe-surfacer-results-entry-point-set-wrappingid-group</rdfs:seeAlso>
</owl:Class>

