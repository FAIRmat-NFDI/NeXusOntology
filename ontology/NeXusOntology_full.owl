            uses for any such process.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcircuit.html#nxcircuit-acquisition-time-field</rdfs:seeAlso>
</owl:Class>

