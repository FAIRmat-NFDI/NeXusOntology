  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_stop/status/in</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXbeam_stop/status: in</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam_stop.html#nxbeam-stop-status-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxbeam-stop-status-out-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
