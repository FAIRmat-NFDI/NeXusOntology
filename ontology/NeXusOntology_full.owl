<owl:Class rdf:about="#nxcollectioncolumn-projection-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxcollectioncolumn-projection-real-enum"/>
            <rdf:Description rdf:about="#nxcollectioncolumn-projection-reciprocal-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcollectioncolumn/projection</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The space projected in the angularly dispersive directions, real or reciprocal
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcollectioncolumn.html#nxcollectioncolumn-projection-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcollectioncolumn-projection-real-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">real</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#nxcollectioncolumn-projection-reciprocal-enum"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcollectioncolumn/projection/real</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXcollectioncolumn/projection: real</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcollectioncolumn.html#nxcollectioncolumn-projection-field</rdfs:seeAlso>
</owl:Class>

