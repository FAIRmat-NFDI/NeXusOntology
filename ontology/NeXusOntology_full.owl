      <owl:onClass rdf:resource="#nxmicrostructure-odf-phi-two-plot-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        Base class to store an orientation distribution function (ODF).
        
        An orientation distribution function is a probability distribution that details how
        much volume of material has a specific orientation. An ODF is computed from
        pole figure data in a computational process called `pole figure inversion &lt;https://doi.org/10.1107/S0021889808030112&gt;`_.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_odf</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_odf.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXprocess</extends>
</owl:Class>

