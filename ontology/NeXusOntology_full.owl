<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://w3id.org/PaN/NeXus/definitions"
         xmlns="https://w3id.org/PaN/NeXus/definitions#"
         xmlns:term="http://purl.org/dc/terms/"
         xmlns:voca="https://w3id.org/widoco/vocab#">

<owl:Ontology rdf:about="https://w3id.org/PaN/NeXus/definitions">
  <term:abstract xml:lang="en">The NeXus Ontology is a formal semantic representation of the NeXus data standard,providing a structured vocabulary for experimental materials science, neutron, X-ray, and muon facilities. By translating the hierarchical NeXus Application Definitions (NXDL) into the Web Ontology Language (OWL), this ontology facilitates FAIR data principles. It enables machine-actionability, automated data indexing, and advanced semantic reasoning across diverse scientific data management pipelines.</term:abstract>
  <term:description xml:lang="en">The NeXus Ontology maps the structural components of the NeXus hierarchical format—including base classes, application definitions, fields, and dimensions into a comprehensive semantic graph. This mapping transforms raw experimental data schemas into a standardized ontology that supports automated inference and integration with external knowledge graphs. Designed for seamless integration into modern research data management platforms, the ontology provides the semantic scaffolding necessary to parse complex measurement workflows. By defining explicit relationships between instruments, physical properties, and measurement protocols, it supports the extraction and standardization of metadata.  The ontology is persistently resolvable via the w3id.org namespace, ensuring stable, long-term integration for standalone ontology services, automated REST endpoints, and customized data extraction plugins tailored to advanced solid-state physics and materials characterization.</term:description>
  <voca:introduction xml:lang="en">Welcome to the documentation for the NeXus Ontology. This framework serves as a critical bridge between the established NeXus data format and the Semantic Web, bringing robust knowledge representation to experimental physics and materials science. In this documentation, you will find a complete taxonomy of the NeXus classes, object properties, and data properties. Navigating through the sections will reveal how instrument components andexperimental measurements are logically structured. Whether you are validating measurement protocol configurations, developing automated indexing services, or mapping laboratory data to FAIR standards, this ontology provides the necessary semantic infrastructure to ensure your datasets are interoperable and fully machine-readable. </voca:introduction>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#has">
  <rdfs:domain rdf:resource="#NeXusObject"/>
  <rdfs:range rdf:resource="#NeXusObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A representation of a "has a" relationship.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasValueContainer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NeXusQuantity"/>
  <rdfs:range rdf:resource="#NeXusDataType"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representation of having a Value assigned.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnitContainer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NeXusQuantity"/>
  <rdfs:range rdf:resource="#NeXusUnitCategory"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representation of having a Unit assigned.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasEnumContainer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#NeXusQuantity"/>
  <rdfs:range rdf:resource="#NeXusEnumerations"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Representation of having an Enumeration assigned.</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#actualValue">
  <rdfs:domain rdf:resource="#NeXus"/>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#extends"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>

<owl:AnnotationProperty rdf:about="https://w3id.org/widoco/vocab#introduction"/>

<owl:Class rdf:about="#NeXus">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus concept</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0ad0f78</owl:versionInfo>
</owl:Class>

<owl:Class rdf:about="#NeXusObject">
  <rdfs:subClassOf rdf:resource="#NeXus"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Object (All the concepts defined by the NeXus definitions)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeXusBaseClass">
  <rdfs:subClassOf rdf:resource="#NeXusObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Base Class (Newer entries are found in Contributed Definitions)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/index.html</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NeXusApplicationClass">
  <rdfs:subClassOf rdf:resource="#NeXusObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Application Class (Newer entries are found in Contributed Definitions)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/index.html</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NeXusQuantity">
  <rdfs:subClassOf rdf:resource="#NeXusObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Quantity (Attributes and Fields which can contain actual data values)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeXusAttribute">
  <rdfs:subClassOf rdf:resource="#NeXusQuantity"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Attribute</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeXusField">
  <rdfs:subClassOf rdf:resource="#NeXusQuantity"/>
  <owl:disjointWith rdf:resource="#NeXusAttribute"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Field</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeXusGroup">
  <rdfs:subClassOf rdf:resource="#NeXusObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXus Group</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NeXusUnitCategory">
  <rdfs:subClassOf rdf:resource="#NeXus"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit categories in NXDL specifications describe the expected type of units for a NeXus field.They should describe valid units consistent withthe manual section on NeXus units (based on UDUNITS).Units are not validated by NeXus.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXusUnitCategory</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NeXusDataType">
  <rdfs:subClassOf rdf:resource="#NeXus"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any valid NeXus field or attribute type</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXusDataType</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NeXusEnumerations">
  <rdfs:subClassOf rdf:resource="#NeXus"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vocabulary used in NeXus enumerations</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NeXusEnumerations</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ISO8601">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO8601</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			ISO8601 date/time stamp.
			It is recommended to add an explicit time zone,
			otherwise the local time zone *is assumed* per ISO8601.
			The norm is that if there is no time zone, it is assumed
			local time, however, when a file moves from one country to
			another it is undefined. If the local time zone is written,
			the ambiguity is gone.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#iso8601</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_BINARY">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_BINARY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any representation of binary data - if text, line terminator is [CR][LF]</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-binary</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_BOOLEAN">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_BOOLEAN</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">true/false value ( true | 1 | false | 0 )</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-boolean</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CCOMPLEX">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CCOMPLEX</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Compound type cartesian representation of complex numbers (real and
			imaginary parts) in NeXus.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-ccomplex</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CHAR">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CHAR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				A string of characters. The preferred string encoding is :index:`UTF-8`. 
				This is the default field type.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-char</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_COMPLEX">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_COMPLEX</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				Compound type representation of complex numbers (either
				cartesian or polar form) in NeXus.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-complex</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_DATE_TIME">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_DATE_TIME</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Alias for the ``ISO8601`` date/time stamp.
			It is recommended to add an explicit time zone,
			otherwise the local time zone is assumed per ISO8601.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-date-time</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_FLOAT">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_FLOAT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any representation of a floating point number</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-float</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_INT">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_INT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any representation of an integer number</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-int</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_NUMBER">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        </owl:Restriction>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_NUMBER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any valid NeXus number representation</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-number</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_PCOMPLEX">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_PCOMPLEX</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				Compound type polar representation of complex numbers 
				(amplitude and phase *in radians*) in NeXus.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-pcomplex</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_POSINT">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_POSINT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any representation of a positive integer number (greater than zero)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-posint</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_QUATERNION">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_QUATERNION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				Compound type representation of quaternion numbers 
				(real,i,j,k) in NeXus.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-quaternion</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_UINT">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_UINT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any representation of an unsigned integer number (includes zero)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-uint</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CHAR_OR_NUMBER">
  <rdfs:subClassOf rdf:resource="#NeXusDataType"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CHAR_OR_NUMBER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any valid character string or NeXus number representation</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-char-or-number</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_ANGLE">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_ANGLE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of angle
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-angle</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_ANY">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_ANY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units for things like logs that aren't picky on units
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-any</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_AREA">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_AREA</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of area
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-area</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CROSS_SECTION">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CROSS_SECTION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of area (alias of NX_AREA)
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-cross-section</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CHARGE">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CHARGE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of electrical charge
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-charge</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_CURRENT">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_CURRENT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of electrical current
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-current</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_DIMENSIONLESS">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_DIMENSIONLESS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units for fields where the units cancel out
				(NOTE: not the same as NX_UNITLESS)
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-dimensionless</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_EMITTANCE">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_EMITTANCE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of emittance (``length * angle``) of a
				radiation source
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-emittance</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#NX_ENERGY">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_ENERGY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of energy
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-energy</rdfs:seeAlso>
</owl:Class>

