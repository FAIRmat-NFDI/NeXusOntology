  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_surfacer_config.html#nxapm-paraprobe-surfacer-config-entry-surface-meshingid-alpha-value-choice-field</rdfs:seeAlso>
</owl:Class>

