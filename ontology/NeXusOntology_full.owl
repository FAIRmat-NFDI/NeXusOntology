<owl:Class rdf:about="#nxcsg-operation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxcsg-operation-union-enum"/>
            <rdf:Description rdf:about="#nxcsg-operation-intersection-enum"/>
            <rdf:Description rdf:about="#nxcsg-operation-difference-enum"/>
            <rdf:Description rdf:about="#nxcsg-operation-complement-enum"/>
            <rdf:Description rdf:about="#nxcsg-operation-is-quadric-enum"/>
            <rdf:Description rdf:about="#nxcsg-operation-is-mesh-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcsg/operation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      One of the standard construction solid geometry set operations,
      or statement IS_QUADRIC or IS_MESH if the CSG is a pointer to an
      instance of a geometry class. Takes values:
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-operation-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcsg-operation-union-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UNION</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcsg/operation/UNION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXcsg/operation: UNION</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-operation-field</rdfs:seeAlso>
</owl:Class>

