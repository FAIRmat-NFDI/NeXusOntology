  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtransformations/AXISNAME/transformation_type/translation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXtransformations/AXISNAME/transformation_type: translation</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXtransformations.html#nxtransformations-axisname-transformation-type-attribute</rdfs:seeAlso>
</owl:Class>

