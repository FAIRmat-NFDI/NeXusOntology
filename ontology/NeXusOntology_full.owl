<owl:Class rdf:about="#nxdeflector-type-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxdeflector-type-dipole-enum"/>
            <rdf:Description rdf:about="#nxdeflector-type-quadrupole-enum"/>
            <rdf:Description rdf:about="#nxdeflector-type-hexapole-enum"/>
            <rdf:Description rdf:about="#nxdeflector-type-octupole-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdeflector/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Qualitative type of deflector with respect to the number of pole pieces.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdeflector.html#nxdeflector-type-field</rdfs:seeAlso>
