  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_nanochem_results/ENTRY/oned_profileID/xdmf_cylinder/rois_far_from_edge/roiID</rdfs:label>
