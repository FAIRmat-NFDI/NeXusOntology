<owl:Class rdf:about="#nxcg-alpha-complex-type-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasEnumContainer"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#nxcg-alpha-complex-type-convex-hull-enum"/>
                <rdf:Description rdf:about="#nxcg-alpha-complex-type-alpha-shape-enum"/>
                <rdf:Description rdf:about="#nxcg-alpha-complex-type-alpha-wrapping-enum"/>
              </owl:unionOf>
            </owl:Class>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="#nxapm-paraprobe-surfacer-results-entry-point-set-wrappingid-alpha-complexid-type-field"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_alpha_complex/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Type of alpha complex following the terminology used by CGAL for now.
             
             Alpha_shape means meshes created using one of the alpha_shape algorithm.
             Alpha_wrapping means meshes created using the alpha_wrapping algorithm.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_alpha_complex.html#nxcg-alpha-complex-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-alpha-complex-type-convex-hull-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">convex_hull</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
