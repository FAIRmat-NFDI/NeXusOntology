  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The frequency of the demodulated signal.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXlockin.html#nxlockin-demodulated-frequency-field</rdfs:seeAlso>
</owl:Class>

