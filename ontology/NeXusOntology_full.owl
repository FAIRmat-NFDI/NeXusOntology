  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-configuration-dimensionality-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-configuration-dimensionality-3-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
