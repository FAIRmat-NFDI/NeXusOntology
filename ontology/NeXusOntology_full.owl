<owl:Class rdf:about="#nxenvironment-position-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenvironment/position</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             The position and orientation of the apparatus.
             Note, it is recommended to use NXtransformations instead.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXenvironment.html#nxenvironment-position-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxenvironment-transformations-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXtransformations"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenvironment/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This is the group recommended for holding the chain of translation
            and rotation operations necessary to position the component within
            the instrument. The dependency chain may however traverse similar groups in
            other component groups.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXenvironment.html#nxenvironment-transformations-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxenvironment-note-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenvironment/NOTE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Additional information, LabView logs, digital photographs, etc</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXenvironment.html#nxenvironment-note-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxenvironment-actuator-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXactuator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenvironment/ACTUATOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Any actuator used to control the environment. This can be linked to an actuator
             defined in an NXinstrument instance.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXenvironment.html#nxenvironment-actuator-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxenvironment-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXsensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenvironment/SENSOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Any sensor used to monitor the environment. This can be linked to a sensor
             defined in an NXinstrument instance.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXenvironment.html#nxenvironment-sensor-group</rdfs:seeAlso>
</owl:Class>

