    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdetector/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      Description of type such as He3 gas cylinder, He3 PSD, scintillator,
      fission chamber, proportion counter, ion chamber, ccd, pixel, image plate,
      CMOS, ...
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxdetector-efficiency-efficiency-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
