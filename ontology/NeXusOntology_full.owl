<owl:Class rdf:about="#nxmanipulator-cryostat-pid-controller-setpoint-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
