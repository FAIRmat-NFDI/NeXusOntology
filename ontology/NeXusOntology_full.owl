                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-userid-telephone-number-field</rdfs:seeAlso>
</owl:Class>

