      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">success</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#nxapm-measurement-status-aborted-enum"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_measurement/status/success</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXapm_measurement/status: success</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_measurement.html#nxapm-measurement-status-field</rdfs:seeAlso>
</owl:Class>

