  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxbeam-splitter-type-dichroic-mirror-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-dielectric-mirror-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-metal-coated-mirror-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-nicol-prism-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-glan-thompson-prism-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-pellicle-mirror-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-polka-dot-beam-splitter-enum"/>
            <rdf:Description rdf:about="#nxbeam-splitter-type-fiber-optic-splitter-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Specify the beam splitter type (e.g. dielectric mirror, pellicle,
            dichroic mirror etc.). Shape (e.g. prism, plate, cube) and dimension
            should be described in 'geometry'. Define if the beam splitter is
            polarizing or not in the field 'polarizing(NX_BOOLEAN)'.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-type-field</rdfs:seeAlso>
</owl:Class>

