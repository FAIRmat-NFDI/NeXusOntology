        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_config.html#nxspm-cantilever-config-fermi-level-field</rdfs:seeAlso>
