  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXdetector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXelectronanalyzer/DETECTOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
