</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-score-config-entry-nucleation-orientation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-nucleation-orientation-ensemble-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-nucleation-orientation-random-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-nucleation-orientation-damask-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_score_config/ENTRY/nucleation/orientation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    According to which model will the nuclei get their orientation assigned:
                    
                    * ensemble, picking randomly one from ensemble/bunge_euler
                    * random, picking randomly on the SO3
                    * damask, picking based on information provided in deformation/damask
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-nucleation-orientation-field</rdfs:seeAlso>
</owl:Class>

