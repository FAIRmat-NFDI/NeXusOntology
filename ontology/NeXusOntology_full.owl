</owl:Class>

<owl:Class rdf:about="#nxmicrostructure-configuration-dimensionality-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxmicrostructure-configuration-dimensionality-1-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-configuration-dimensionality-2-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-configuration-dimensionality-3-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/configuration/dimensionality</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Dimensionality of Euclidean space in which the analysis is performed.
                
                This field can be used e.g. by a research data management system to identify
                if the description specifies one-, two-, or three-dimensional microstructural representations.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-configuration-dimensionality-field</rdfs:seeAlso>
</owl:Class>

