  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpeak</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpeak.html</rdfs:seeAlso>
