<owl:Class rdf:about="#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxcoordinate-system-transformations-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/beam_ref_frame/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    This is the default NeXus coordinate system (McStas), if the transformation
                    does not change the coordinate system at all - i.e. it is unity.
                    Otherwise, by this a respective transformation of the beam
                    reference frame to the default reference frame could be made. i.e.
                    exchange of x and z coordinate, rotation of respective coordinates
                    towards each other.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxoptical-spectroscopy-entry-sample-normal-ref-frame-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxoptical-spectroscopy-entry-sample-normal-ref-frame-depends-on-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcoordinate_system"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/sample_normal_ref_frame</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxcoordinate-system-transformations-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/sample_normal_ref_frame/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Set of transformations, describing the orientation of the sample-normal coordinate system
                    with respect to the beam coordinate system (.).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-normal-ref-frame-transformations-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxoptical-spectroscopy-entry-user-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxentry-user-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/USER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Contact information and eventually details of at persons who
                performed the measurements. This can be for example the principal
                investigator or student. Examples are: name, affiliation, address, telephone
                number, email, role as well as identifiers such as orcid or similar.
                It is recommended to add multiple users if relevant.
                
                Due to data privacy concerns, there is no minimum requirement.
                If no user with specific name is allowed to be given, it is required to
                assign at least an affiliation
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-user-group</rdfs:seeAlso>
</owl:Class>

