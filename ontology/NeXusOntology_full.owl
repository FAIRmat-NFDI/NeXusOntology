        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-snakescan-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-scan-control-trajscan-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXspm_scan_pattern"/>
