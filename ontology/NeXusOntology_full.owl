    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxsimilarity-grouping-categorical-label-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_clusterer_results/ENTRY/cluster_analysisID/dbscanID/categorical_label</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Categorical label(s) for each target (member in the set) aka cluster name(s).
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_results.html#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-categorical-label-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-weight-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UNITLESS"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_clusterer_results/ENTRY/cluster_analysisID/dbscanID/weight</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Weights for each target that specifies how probable the target is assigned to
                        a specific cluster.
                        
                        For the DBScan algorithm and atom probe tomography this value is the
                        multiplicity of each ion with respect to the cluster. That is how many times
                        should the position of the ion be accounted for because the ion is e.g. a
                        molecular ion with several elements or nuclides of requested type.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_results.html#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-weight-field</rdfs:seeAlso>
</owl:Class>

