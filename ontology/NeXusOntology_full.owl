  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-rotation-convention-field</rdfs:seeAlso>
</owl:Class>

