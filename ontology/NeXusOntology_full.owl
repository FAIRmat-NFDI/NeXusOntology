                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-description-field</rdfs:seeAlso>
