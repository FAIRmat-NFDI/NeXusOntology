  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-accuracyn-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-scan-control-scan-type-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasEnumContainer"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-trajectory-enum"/>
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-mesh-enum"/>
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-snake-enum"/>
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-spiral-enum"/>
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-linear-enum"/>
                <rdf:Description rdf:about="#nxspm-scan-control-scan-type-tilt-enum"/>
              </owl:unionOf>
            </owl:Class>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="#nxspm-bias-spectroscopy-bias-sweep-scan-type-field"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_scan_control/scan_type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This group specifies how the trajectory of the scan is defined.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-scan-type-field</rdfs:seeAlso>
</owl:Class>

