  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes_arpes</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes_arpes.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes</extends>
</owl:Class>

