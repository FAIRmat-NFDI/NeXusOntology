                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-scalar-field-magn-suffix-xdmf-intensity-field</rdfs:seeAlso>
</owl:Class>

