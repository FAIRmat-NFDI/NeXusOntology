  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Define the scan speed in the backward directions (except the spiral and trajectory scans).
            Rename the field, according to the name of the dimension.
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-backward-speedn-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-scan-pattern-channelname-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
