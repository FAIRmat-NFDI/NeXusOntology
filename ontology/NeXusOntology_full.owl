  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Engineering" position of bending magnet</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbending_magnet.html#nxbending-magnet-geometry-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxbending-magnet-off-geometry-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbending_magnet/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
     This group describes the shape of the beam line component
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbending_magnet.html#nxbending-magnet-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcalibration-calibration-object-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxprocess-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcalibration/calibration_object</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            A file serialization of a calibration which may not be publicly available (externally from the NeXus file).
            
            This metadata can be a documentation of the source (file) or database (entry) from which pieces
            of information have been extracted for consumption (e.g. in a research data management system (RDMS)).
            It is also possible to include the actual file by using the `file` field.
            
            The axis values may be copied or linked in the appropriate NXcalibration fields for reference.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-calibration-object-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcalibration-fit-formula-inputs-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcalibration-fit-formula-inputs-parameter-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxprocess-parameters-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcalibration/fit_formula_inputs</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Additional input axis to be used in the formula.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-fit-formula-inputs-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcalibration-calibration-parameters-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcalibration-calibration-parameters-an-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcalibration-calibration-parameters-scaling-factor-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcalibration-calibration-parameters-offset-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxprocess-parameters-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcalibration/calibration_parameters</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Fit coefficients to be used in ``fit_formula_description``.
            
            As an example, for nonlinear energy calibrations, e.g. in a time-of-flight (TOF) detector, a polynomial
            function is fitted to a set of features (peaks) at well defined energy positions to determine
            E(TOF). Here we can store the fit coefficients for that procedure.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-calibration-parameters-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcalibration-data-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxprocess-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcalibration/DATA</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Any data acquired/used during the calibration that does not fit the `NX_FLOAT` fields above.
            NXdata groups can be used for multidimensional data which are relevant to the calibration
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-data-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcapillary-gain-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcapillary/gain</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
           The gain of the capillary as a function of energy
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcapillary.html#nxcapillary-gain-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcapillary-transmission-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcapillary/transmission</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
           The transmission of the capillary as a function of energy
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcapillary.html#nxcapillary-transmission-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-alpha-complex-cg-point-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_point"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_alpha_complex/CG_POINT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Point cloud serving as input for the computation of the alpha complex.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_alpha_complex.html#nxcg-alpha-complex-cg-point-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-alpha-complex-triangle-soup-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_triangle"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_alpha_complex/TRIANGLE_SOUP</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Triangle soup serving as input for the computation of the alpha complex.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_alpha_complex.html#nxcg-alpha-complex-triangle-soup-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-alpha-complex-alpha-complex-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_triangle"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_alpha_complex/ALPHA_COMPLEX</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Triangle mesh representing the output of the computation, i.e. the alpha complex.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_alpha_complex.html#nxcg-alpha-complex-alpha-complex-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-alpha-complex-tetrahedralization-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_tetrahedron"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_alpha_complex/TETRAHEDRALIZATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Tetrahedra representing an interior volume of the alpha complex (if such exists).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_alpha_complex.html#nxcg-alpha-complex-tetrahedralization-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-grid-bounding-box-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_polyhedron"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_grid/bounding_box</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             A tight bounding box about the grid.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_grid.html#nxcg-grid-bounding-box-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-hexahedron-vertex-normal-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <owl:equivalentClass rdf:resource="#nxcg-primitive-vertex-normal-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_hexahedron/vertex_normal</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_hexahedron.html#nxcg-hexahedron-vertex-normal-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcg-hexahedron-edge-normal-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
