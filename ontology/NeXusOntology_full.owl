  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-nucleation-spatial-distribution-csr-enum"/>
            <rdf:Description rdf:about="#nxmicrostructure-score-config-entry-nucleation-spatial-distribution-damask-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_score_config/ENTRY/nucleation/spatial_distribution</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    According to which model will the nuclei become distributed spatially:
                    
                    * csr, complete spatial randomness
                    * custom, implementation-specific
                    * gb, nuclei placed at grain boundaries
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-nucleation-spatial-distribution-field</rdfs:seeAlso>
</owl:Class>

