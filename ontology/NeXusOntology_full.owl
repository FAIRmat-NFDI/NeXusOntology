      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-phase-detector-reference-phase-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-phase-detector-phase-error-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-phase-detector-kp-coefficient-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase_lock_loop/phase_detector</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The phase detector component of the PLL, which compares the phase between the
            reference signal generated (e.g., in AFM, generated by the cantilever) and the signal coming from the VCO.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-phase-detector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxphase-lock-loop-loop-filter-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-loop-filter-kf-coefficient-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase_lock_loop/loop_filter</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The loop filter component of the PLL filters the voltage from the phase detector to the VCO.
            It extracts the average voltage of the phase error signals emitted from the phase detector.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-loop-filter-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxphase-lock-loop-voltage-controlled-oscillator-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxphase-lock-loop-voltage-controlled-oscillator-output-frequency-range-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
