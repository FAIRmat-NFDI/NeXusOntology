<owl:Class rdf:about="#nxaperture-shape-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasEnumContainer"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#nxaperture-shape-straight-slit-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-curved-slit-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-pinhole-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-circle-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-square-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-hexagon-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-octagon-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-bladed-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-open-enum"/>
                <rdf:Description rdf:about="#nxaperture-shape-grid-enum"/>
              </owl:unionOf>
            </owl:Class>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="#nxmpes-arpes-entry-instrument-electronanalyzer-energydispersion-entrance-slit-shape-field"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
