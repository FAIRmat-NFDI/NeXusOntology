      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXbeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_instrument/pulser/sourceID/beamID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Details about specific positions along the laser beam
                    which illuminates the (atom probe) specimen.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-pulser-sourceid-beamid-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-instrument-pulser-sourceid-transformations-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxcomponent-transformations-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_instrument/pulser/sourceID/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
