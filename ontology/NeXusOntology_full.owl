  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Reference (e.g. path and filename) to an existent data artifact which
                stores either the measured patterns or input (already processed EBSD data).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-measurement-source-group</rdfs:seeAlso>
</owl:Class>

