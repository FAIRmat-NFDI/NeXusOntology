  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXmatch_filter"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_nanochem_config/ENTRY/oned_profileID/feature/patch_filter</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        If interface_model is isosurface this filter can be used to restrict the analysis to specific
                        patches of an iso-surface.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html#nxapm-paraprobe-nanochem-config-entry-oned-profileid-feature-patch-filter-group</rdfs:seeAlso>
</owl:Class>

