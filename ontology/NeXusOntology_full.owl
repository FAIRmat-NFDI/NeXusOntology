  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blaze or trapezoidal angles, with the angle of the upstream facing edge listed first. Blazed gratings can be identified by the low value of the first-listed angle.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXgrating.html#nxgrating-angles-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxgrating-period-field">
