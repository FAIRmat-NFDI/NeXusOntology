<owl:Class rdf:about="#nxcg-face-list-data-structure-number-of-vertices-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UINT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
