<owl:Class rdf:about="#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-amplitude-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-frequency-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-reference-phase-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxspm-cantilever-cantilever-oscillator-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXafm/ENTRY/INSTRUMENT/SPM_CANTILEVER/cantilever_oscillator</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        When a cantilever is oscillated close to its resonance, this describes the oscillator properties.
                        
                        A cantilever can be used in direct contact mode to detect interaction forces or oscillated close to its
                        resonance frequency. Changes in the oscillation amplitude, phase (between oscillated tail and moving tip)
                        or resonance frequency are very sensitive to changes in the interaction potential field, giving rise of
                        various measurement modes, such as non-contact or intermittent-contact (tapping) modes.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-spm-cantilever-cantilever-oscillator-group</rdfs:seeAlso>
</owl:Class>

