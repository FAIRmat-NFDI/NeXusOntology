<owl:Class rdf:about="#nxmatch-filter-method-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasEnumContainer"/>
                  <owl:allValuesFrom>
                    <owl:Class>
                      <owl:unionOf rdf:parseType="Collection">
                        <rdf:Description rdf:about="#nxmatch-filter-method-whitelist-enum"/>
                        <rdf:Description rdf:about="#nxmatch-filter-method-blacklist-enum"/>
                      </owl:unionOf>
                    </owl:Class>
                  </owl:allValuesFrom>
                </owl:Restriction>
                <rdf:Description rdf:about="#nxapm-paraprobe-nanochem-config-entry-delocalizationid-decomposition-method-field"/>
              </owl:unionOf>
            </owl:Class>
            <rdf:Description rdf:about="#nxapm-paraprobe-nanochem-config-entry-interface-meshingid-decoration-filter-method-field"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="#nxdelocalization-weighting-model-method-field"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmatch_filter/method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Definition of the logic what the filter yields:
            
            * Whitelist specifies which entries with said value to include.
              Entries with all other values will be excluded.
            * Blacklist specifies which entries with said value to exclude.
              Entries with all other values will be included.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmatch-filter-method-whitelist-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">whitelist</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#nxmatch-filter-method-blacklist-enum"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmatch_filter/method/whitelist</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXmatch_filter/method: whitelist</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmatch-filter-method-blacklist-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blacklist</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmatch_filter/method/blacklist</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXmatch_filter/method: blacklist</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmatch-filter-match-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_UNITLESS"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmatch_filter/match</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Array of values to filter according to method. If the match e.g. specifies
            [1, 5, 6] and method is set to whitelist, only entries with values matching
            1, 5 or 6 will be processed. All other entries will be excluded.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-match-field</rdfs:seeAlso>
</owl:Class>

