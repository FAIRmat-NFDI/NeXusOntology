  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxcomponent-name-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdeflector/name</rdfs:label>
