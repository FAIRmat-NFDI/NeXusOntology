    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxobject-data-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_scan_pattern/DATA</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The scan data is the data collected during the scan.
            If the scan has several channels or derivatives from the channel data, please
            duplicate this NXdata group for each.
