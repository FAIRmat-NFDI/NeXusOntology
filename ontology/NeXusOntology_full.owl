  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Describes the energy dispersion section
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXelectronanalyzer.html#nxelectronanalyzer-energydispersion-group</rdfs:seeAlso>
</owl:Class>

