<owl:Class rdf:about="#nxphase-lock-loop-hardware-type-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxphase-lock-loop-hardware-type-type-1-enum"/>
            <rdf:Description rdf:about="#nxphase-lock-loop-hardware-type-type-2-enum"/>
            <rdf:Description rdf:about="#nxphase-lock-loop-hardware-type-type-3-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXphase_lock_loop/hardware/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Types (design parameter for circuit) of the PLL from type-1, type-2, and type-3
                available in device specifications (for mathematical details: https://www.nxp.com/docs/en/application-note/AN535.pdf).
                Type is defined by the number of poles that exist in the transfer function of the PLL.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXphase_lock_loop.html#nxphase-lock-loop-hardware-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxphase-lock-loop-hardware-type-type-1-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type-1</rdf:first>
