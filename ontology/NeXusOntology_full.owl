  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_cantilever_config/resonance_amplitude</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Nominal free resonance amplitude of the cantilever in air, in nm i.e., out of
            interaction force.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_config.html#nxspm-cantilever-config-resonance-amplitude-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-cantilever-config-spring-constant-field">
