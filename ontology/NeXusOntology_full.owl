</owl:Class>

<owl:Class rdf:about="#nxem-entry-consistent-rotations-rotation-handedness-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxem-entry-consistent-rotations-rotation-handedness-counter-clockwise-enum"/>
            <rdf:Description rdf:about="#nxem-entry-consistent-rotations-rotation-handedness-clockwise-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXem/ENTRY/consistent_rotations/rotation_handedness</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Convention how a positive rotation angle is defined when viewing
                    from the end of the rotation unit vector towards its origin.
                    This is in accordance with convention 2 of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                    
                    Counter_clockwise is equivalent to a right-handed choice.
                    Clockwise is equivalent to a left-handed choice.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-rotation-handedness-field</rdfs:seeAlso>
</owl:Class>

