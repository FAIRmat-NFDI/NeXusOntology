  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXdispersion_function.html#nxdispersion-function-convention-field</rdfs:seeAlso>
