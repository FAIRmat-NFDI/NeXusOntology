  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXelectromagnetic_lens.html#nxelectromagnetic-lens-type-field</rdfs:seeAlso>
