<owl:Class rdf:about="#nxunit-cell-crystal-system-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-triclinic-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-monoclinic-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-orthorhombic-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-tetragonal-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-rhombohedral-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-hexagonal-enum"/>
            <rdf:Description rdf:about="#nxunit-cell-crystal-system-cubic-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXunit_cell/crystal_system</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Crystal system.
            
            For a crystal system in 2D space monoclinic is an exact synonym for oblique.
            For a crystal system in 2D space orthorhombic is an exact synonym for rectangular.
            For a crystal system in 2D space tetragonal is an exact synonym for square.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXunit_cell.html#nxunit-cell-crystal-system-field</rdfs:seeAlso>
</owl:Class>

