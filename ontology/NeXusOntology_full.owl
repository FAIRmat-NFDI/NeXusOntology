<owl:Class rdf:about="#nxsample-situation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasEnumContainer"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#nxsample-situation-air-enum"/>
                <rdf:Description rdf:about="#nxsample-situation-vacuum-enum"/>
