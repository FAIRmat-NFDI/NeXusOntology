<owl:Class rdf:about="#nxxpcs-entry-note-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxpcs/ENTRY/NOTE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        Any other notes.

        NAME: The NeXus convention, to use all upper case
        to indicate the name (here ``NOTE``), is left to the file
        writer.  In our case, follow the suggested name
        pattern and sequence: note_1, note_2, note_3, ...
        Start with ``note_1`` if the first one, otherwise
        pick the next number in this sequence.
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-note-group</rdfs:seeAlso>
</owl:Class>

