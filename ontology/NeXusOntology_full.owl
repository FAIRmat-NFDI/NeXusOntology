<owl:Class rdf:about="#nxspm-scan-control-spiralscan-spiral-radiusn-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxspm-scan-pattern-spiral-radiusn-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_scan_control/spiralSCAN/spiral_radiusN</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Define the radius of the spiral circle of scanning.
                
                Rename the field, according to the circle order, the nearest circle to the center is 0.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-spiral-radiusn-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-scan-control-spiralscan-scan-pointsn-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxspm-scan-pattern-scan-pointsn-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_scan_control/spiralSCAN/scan_pointsN</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Define the total number of points in a given circle scan to be performed.
                
                Rename the field, according to the circle order, the nearest circle to the center
                is 0 (e.g. scan_points_2).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_control.html#nxspm-scan-control-spiralscan-scan-pointsn-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-scan-pattern-scan-speedn-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_scan_pattern/scan_speedN</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Define the scan speed in the forward direction along the axis (except the spiral and trajectory scans),
            if forward and backward speeds below are not specified.
            
            If the scan goes in the negative direction, the speed should be negative.
            
            Rename the field, according to the name of the dimension (e.g. scan_speed_x, scan_speed_voltage).
            
            Trajectory scan: N refers to the nth trajectory line (line between two trajectory points).
            Spiral scan: N refers to the nth circle from center.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_scan_pattern.html#nxspm-scan-pattern-scan-speedn-field</rdfs:seeAlso>
</owl:Class>

