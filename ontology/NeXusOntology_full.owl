      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an application definition for raw data from a generic TOF instrument</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtofraw</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtofraw.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXtofsingle">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxtofsingle-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is a application definition for raw data from a generic TOF instrument</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtofsingle</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtofsingle.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXtomo">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxtomo-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
          This is the application definition for x-ray or neutron tomography raw data. 
          
          In tomography 
          a number of dark field images are measured, some bright field images and, of course the sample. 
          In order to distinguish between them images carry a image_key.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtomo</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtomo.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXtomophase">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxtomophase-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      This is the application definition for x-ray or neutron tomography raw data with phase contrast variation at each point. 
      
      In tomography first 
      some dark field images are measured, some bright field images and, of course the sample. In order 
      to properly sort the order of the images taken, a sequence number is stored with each image.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtomophase</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtomophase.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXtomoproc">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxtomoproc-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an application definition for the final result of a tomography experiment: a 3D construction of some volume of physical properties.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtomoproc</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtomoproc.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXxas">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxxas-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      This is an application definition for raw data from an X-ray absorption spectroscopy experiment. 
      
      This is essentially a scan on energy versus incoming/ 
      absorbed beam.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxas</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxas.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXxasproc">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxxasproc-entry-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
       Processed data from XAS. This is energy versus I(incoming)/I(absorbed).
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxasproc</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxasproc.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

<owl:Class rdf:about="#NXxbase">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
