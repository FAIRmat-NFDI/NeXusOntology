  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linked temperature_log for the filter</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXfilter.html#nxfilter-temperature-log-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxfilter-sensor-type-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXsensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXfilter/sensor_type</rdfs:label>
