  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The frequency of the real-time controller system which indicated the number of close-loop process
            (gathering data, process data and update system) control cycles per unit time.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXrcs.html#nxrcs-frequency-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxrcs-measurement-time-field">
