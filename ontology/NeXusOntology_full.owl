  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        **Locally** unique identifier for the experiment (a.k.a. run or scan).

        * For bluesky users, this is the run's `"scan_id"`.
        * For SPEC users, this is the scan number (``SCAN_N``).
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-entry-identifier-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxxpcs-entry-entry-identifier-uuid-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
