            Note: At least one from reference_amplitude, reference_frequency, or reference_phase is expected.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_cantilever_oscillator.html#nxspm-cantilever-oscillator-reference-phase-field</rdfs:seeAlso>
</owl:Class>

