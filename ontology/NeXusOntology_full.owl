		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-name-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxcontainer-description-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
