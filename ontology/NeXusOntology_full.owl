<owl:Class rdf:about="#NXcylindrical_geometry">
  <rdfs:subClassOf rdf:resource="#NeXusBaseClass"/>
  <rdfs:subClassOf rdf:resource="#NXobject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcylindrical-geometry-vertices-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcylindrical-geometry-cylinders-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcylindrical-geometry-detector-number-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Geometry description for cylindrical shapes.
    This class can be used in place of ``NXoff_geometry`` when an exact
    representation for cylinders is preferred.
    For example, for Helium-tube, neutron detectors.
    It can be used to describe the shape of any component, including detectors.
    In the case of detectors it can be used to define the shape of a single pixel, or,
    if the pixel shapes are non-uniform, to describe the shape of the whole detector.
  </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcylindrical_geometry</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcylindrical_geometry.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
</owl:Class>

