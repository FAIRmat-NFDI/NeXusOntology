  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The orientation matrix according to Busing and 
            Levy conventions. This is not strictly necessary as 
            the UB can always be derived from the data.  But 
            let us bow to common usage which includes the 
            UB nearly always.
           </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxbase.html#nxxbase-entry-sample-orientation-matrix-field</rdfs:seeAlso>
</owl:Class>

