<owl:Class rdf:about="#nxcalibration-original-axis-symbol-attribute">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcalibration/original_axis/symbol</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The symbol of the axis to be used in the fit_function, e.g., `energy`, `E`.
                This should comply to the following naming rules (similar to python's naming rules):
                
                * A variable name must start with a letter or the underscore character
                * A variable name cannot start with a number
                * A variable name can only contain alpha-numeric characters and underscores (A-z, 0-9, and _ )
                * Variable names are case-sensitive (age, Age and AGE are three different variables)
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-original-axis-symbol-attribute</rdfs:seeAlso>
</owl:Class>

