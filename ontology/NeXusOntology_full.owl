  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        Use this group to describe the shape of the aperture.
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxaperture-positioner-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXpositioner"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXaperture/POSITIONER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Stores the raw positions of aperture motors.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-positioner-group</rdfs:seeAlso>
</owl:Class>

