  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXaperture/BLADE_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location and shape of each blade</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-blade-geometry-group</rdfs:seeAlso>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

<owl:Class rdf:about="#nxaperture-note-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXaperture/NOTE</rdfs:label>
