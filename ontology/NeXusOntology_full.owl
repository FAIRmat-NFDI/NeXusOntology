<owl:Class rdf:about="#nxapm-paraprobe-tool-common-status-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxapm-paraprobe-tool-common-status-success-enum"/>
            <rdf:Description rdf:about="#nxapm-paraprobe-tool-common-status-failure-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_tool_common/status</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            A statement whether the tool executable managed to process the analysis
            or whether this failed. Status is written to the results file after the
            end_time beyond which point in time the tool must no longer compute
            any further analysis results but exit.
            
            Only when this status message is present and its value is `success`,
            one should consider the results of the tool. In all other cases it might
            be that the tool has terminated prematurely or another error occurred.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-status-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-paraprobe-tool-common-status-success-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">success</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#nxapm-paraprobe-tool-common-status-failure-enum"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_tool_common/status/success</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXapm_paraprobe_tool_common/status: success</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-status-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-paraprobe-tool-common-status-failure-enum">
  <rdfs:subClassOf rdf:resource="#NeXusEnumerations"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
