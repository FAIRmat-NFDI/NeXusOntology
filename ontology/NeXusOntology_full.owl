  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasEnumContainer"/>
              <owl:allValuesFrom>
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#nxsensor-scan-entry-definition-nxsensor-scan-enum"/>
                  </owl:unionOf>
                </owl:Class>
              </owl:allValuesFrom>
            </owl:Restriction>
            <rdf:Description rdf:about="#nxiv-temp-entry-definition-field"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="#nxspm-entry-definition-field"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxsensor-scan-entry-definition-version-attribute"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxentry-definition-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor_scan/ENTRY/definition</rdfs:label>
