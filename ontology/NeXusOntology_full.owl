  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Length of the semi-axes (e.g. semi-major and semi-minor
             respectively for an ellipse).
             
             Use if all ellipsoids in the set have the same half-axes.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_ellipsoid.html#nxcg-ellipsoid-semi-axes-value-field</rdfs:seeAlso>
</owl:Class>

