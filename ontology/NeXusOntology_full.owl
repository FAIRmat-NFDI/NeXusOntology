<owl:Class rdf:about="#nxsample-type-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasEnumContainer"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#nxsample-type-sample-enum"/>
                <rdf:Description rdf:about="#nxsample-type-sample-can-enum"/>
                <rdf:Description rdf:about="#nxsample-type-can-enum"/>
                <rdf:Description rdf:about="#nxsample-type-sample-buffer-enum"/>
                <rdf:Description rdf:about="#nxsample-type-buffer-enum"/>
                <rdf:Description rdf:about="#nxsample-type-calibration-sample-enum"/>
                <rdf:Description rdf:about="#nxsample-type-normalisation-sample-enum"/>
                <rdf:Description rdf:about="#nxsample-type-simulated-data-enum"/>
