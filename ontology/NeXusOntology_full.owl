      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-polyline-number-of-total-vertices-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-polyline-number-of-vertices-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-polyline-vertices-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-polyline-vertices-are-unique-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-polyline-polylines-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
         Computational geometry description of a set of polylines.
         
         Each polyline is built from a sequence of vertices (points with identifiers).
         Each polyline must have a start and an end point.
         The sequence describes the traversal along the polyline when
         walking from the first to the last vertex.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_polyline</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_polyline.html</rdfs:seeAlso>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_primitive</extends>
</owl:Class>

<owl:Class rdf:about="#NXcg_primitive">
  <rdfs:subClassOf rdf:resource="#NeXusBaseClass"/>
  <rdfs:subClassOf rdf:resource="#NXobject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxcg-primitive-vertex-normal-group"/>
