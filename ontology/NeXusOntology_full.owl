      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxspm-entry-instrument-voltage-sensortag-calibration-calibration-parameters-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcalibration"/>
