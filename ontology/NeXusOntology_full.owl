    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxpcs/ENTRY/instrument/masks/static_roi_map</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            roi index array.

            The values of this mask index the :math:`|Q|` value from the
            the ``static_q_list`` field.

            The ``units`` attribute should be set to ``"au"``
            indicating arbitrary units.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-instrument-masks-static-roi-map-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxxpcs-entry-instrument-masks-static-q-list-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
