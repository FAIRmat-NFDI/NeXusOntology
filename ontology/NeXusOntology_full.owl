                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-calibration-group</rdfs:seeAlso>
</owl:Class>

