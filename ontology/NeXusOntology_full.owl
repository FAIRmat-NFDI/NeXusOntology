    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxinstrument-name-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXem_instrument/name</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Given name of the microscope at the hosting institution.
            This is an alias. Examples could be NionHermes, Titan, JEOL,
            Gemini, etc.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-name-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxem-instrument-location-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
