  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_clusterer_results/ENTRY/cluster_analysisID/dbscanID/statistics/number_of_targets</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Total number of targets in the set, i.e. ions that were filtered
                            and considered in this cluster analysis.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_results.html#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-statistics-number-of-targets-field</rdfs:seeAlso>
