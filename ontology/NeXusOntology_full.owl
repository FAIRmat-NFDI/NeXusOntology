<owl:Class rdf:about="#nxcxi-ptycho-data-1-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxobject-collection-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcxi_ptycho/data_1</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				To ensure CXI compatibility the data in this group must always have shape that is
				(npts_x*npts_y, frame_size_x, frame_size_y). For nexus-style raster scans it is proposed that
				hdf5 virtual dataset is used.
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-data-1-group</rdfs:seeAlso>
</owl:Class>

