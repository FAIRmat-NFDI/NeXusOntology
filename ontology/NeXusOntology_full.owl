  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Orientation matrix of single crystal sample using Busing-Levy convention:
			W. R. Busing and H. A. Levy (1967). Acta Cryst. 22, 457-464
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-orientation-matrix-field</rdfs:seeAlso>
