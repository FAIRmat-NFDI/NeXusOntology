      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxentry-entry-identifier-uuid-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxpcs/ENTRY/entry_identifier_uuid</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        (optional) UUID identifier for this entry.

        See the `UUID standard &lt;https://www.rfc-editor.org/rfc/rfc4122.html&gt;`__ (or
        `wikipedia &lt;https://en.wikipedia.org/wiki/Universally_unique_identifier&gt;`__)
        for more information.

        * For `bluesky &lt;https://blueskyproject.io/&gt;`__ users, this is the
          run's `"uid"` and is expected for that application.
        * Typically, `SPEC &lt;https://certif.com/content/spec/&gt;`__ users will
          not use this field without further engineering.
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-entry-identifier-uuid-field</rdfs:seeAlso>
</owl:Class>

