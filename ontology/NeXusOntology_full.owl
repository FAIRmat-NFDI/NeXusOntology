  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-voltage-sensortag-calibration-calibration-parameters-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxspm-entry-instrument-voltage-sensortag-amplifier-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
