        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcs_computer.html#nxcs-computer-memoryid-group</rdfs:seeAlso>
</owl:Class>

