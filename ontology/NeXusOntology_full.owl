  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/ELECTROMAGNETIC_LENS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-electromagnetic-lens-group</rdfs:seeAlso>
