  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        The name of the active channel of the lock-in amplifier which is used for the
                        measurement.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-instrument-lockin-amplifier-active-channel-field</rdfs:seeAlso>
</owl:Class>

