      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxmpes-entry-sample-gas-pressure-env-value-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxsample-environment-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/gas_pressure_env</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Gas pressure surrounding the sample and actuators/sensors controlling/measuring
                    it.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-gas-pressure-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxmpes-entry-sample-gas-pressure-env-pressure-gauge-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#nxenvironment-sensor-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/gas_pressure_env/pressure_gauge</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Gauge measuring the gas pressure.
                        
                        In most cases, this can be a link to /entry/instrument/pressure_gauge or to another
                        NXsensor measuring gas pressure (typically, the gauge in closest proximity to the
                        sample) if such a pressure gauge is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-gas-pressure-env-pressure-gauge-group</rdfs:seeAlso>
