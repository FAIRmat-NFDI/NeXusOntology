  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Specifies if the tool evaluates if objects lay closer to one another than
                    threshold_proximity.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-proximity-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_BOOLEAN"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_BOOLEAN"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_intersector_config/ENTRY/v_v_spatial_correlationID/analyze_coprecipitation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Specifies if the tool evaluates, provided that all (preprocessing tasks were successful), how intersecting
                    or proximity related objects build sub-graphs. This is the feature that was used in `M. Kühbach et al. &lt;https://arxiv.org/abs/2205.13510&gt;`_
                    for the high-throughput analyses of how many objects are coprecipitates in the sense that they are single,
                    duplet, triplet, or high-order local groups.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field</rdfs:seeAlso>
</owl:Class>

