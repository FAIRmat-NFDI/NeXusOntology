  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Sketch of the device showing its geometry. The paths of the
                incoming and outgoing beam should be illustrated and labelled (0 for
                the incoming beam, and 1, 2,..., N_outputs for the outputs).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_polarizer.html#nxoptical-polarizer-shape-sketch-group</rdfs:seeAlso>
</owl:Class>

