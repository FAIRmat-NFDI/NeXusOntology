  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Minimum coordinate value along the z-direction
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-obb-zmin-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxapm-reconstruction-obb-zmax-field">
