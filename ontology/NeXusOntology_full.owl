<owl:Class rdf:about="#nxmicrostructure-ipf-interpolation-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxmicrostructure-ipf-interpolation-nearest-neighbour-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_ipf/interpolation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            How where orientation values at positions of input_grid computed to values on output_grid.
            
            Nearest neighbour means the orientation of the closed (Euclidean distance) grid point of the input_grid was taken.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-interpolation-field</rdfs:seeAlso>
</owl:Class>

