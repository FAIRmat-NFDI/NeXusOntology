      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxapm-entry-consistent-rotations-rotation-convention-passive-enum"/>
            <rdf:Description rdf:about="#nxapm-entry-consistent-rotations-rotation-convention-active-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm/ENTRY/consistent_rotations/rotation_convention</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    How are rotations interpreted into an orientation according to convention 3
                    of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-consistent-rotations-rotation-convention-field</rdfs:seeAlso>
</owl:Class>

