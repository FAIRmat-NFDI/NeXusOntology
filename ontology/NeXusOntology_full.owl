  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-aperture-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-deflector-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXdeflector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/DEFLECTOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-deflector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-blankerid-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXdeflector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/blankerID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            A component for blanking the beam or generating pulsed electron beams.
            See e.g . `I. G. C. Weppelman et al. &lt;https://doi.org/10.1016/j.ultramic.2017.10.002&gt;`_
            or `Y. Liao &lt;https://www.globalsino.com/EM/page2464.html&gt;`_ for details.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-blankerid-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-monochromator-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-monochromator-fabrication-group"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-monochromator-type-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-monochromator-applied-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-monochromator-dispersion-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-monochromator-voltage-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXmonochromator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/MONOCHROMATOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Device to improve energy resolution or chromatic aberration.
            
            Examples are Wien, $\textalpha$-, or $\Omega$- energy filter or `cc corrector
            like &lt;https://www.ceos-gmbh.de/en/basics/cc-corrector&gt;`_
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-monochromator-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-monochromator-fabrication-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <owl:equivalentClass rdf:resource="#nxcomponent-fabrication-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/MONOCHROMATOR/FABRICATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-monochromator-fabrication-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-corrector-cs-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcorrector_cs"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/CORRECTOR_CS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-corrector-cs-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-corrector-ax-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-corrector-ax-value-x-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-corrector-ax-value-y-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/corrector_ax</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Component that reshapes an ellipse-shaped electron beam into a circular one.
            
            * `L. Reimer 1998, Springer, 1998 &lt;https://dx.doi.org/10.1007/978-3-540-3896&gt;`_
            * `M. Tanaka et al., Electron Microscopy Glossary, 2024 &lt;https://www.jeol.com/words/semterms/20201020.111014.php#gsc.tab=0&gt;`_
            
            Stigmator is an exact synonym.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-corrector-ax-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-biprismid-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/biprismID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Electron biprism as it is used e.g. for electron holography.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-biprismid-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-phaseplateid-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxebeam-column-phaseplateid-type-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXcomponent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/phaseplateID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Device that causes a change in the phase of an electron wave.
            
            * `M. Malac et al. &lt;https://doi.org/10.1093/jmicro/dfaa070&gt;`_
            * `R. R. Schröder et al. &lt;https://www.lem.kit.edu/152.php&gt;`_
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-phaseplateid-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-sensor-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXsensor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/SENSOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-actuator-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXactuator"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/ACTUATOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-actuator-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxebeam-column-beam-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXbeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/BEAM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Individual characterization results for the position, shape,
            and characteristics of the electron beam at a given location.
            
            :ref:`NXtransformations` should be used to specify the location
            or the position at which details about the beam were probed.
            
            This concept is related to term `Electron Beam`_ of the EMglossary standard.
            
            .. _Electron Beam: https://purls.helmholtz-metadaten.de/emg/EMG_00000021
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-beam-group</rdfs:seeAlso>
</owl:Class>

