            A parameter that is used in or results from processing. 
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXparameters.html#nxparameters-parameter-field</rdfs:seeAlso>
</owl:Class>

