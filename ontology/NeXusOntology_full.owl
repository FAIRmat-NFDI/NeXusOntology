  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unit cell lattice parameter: length of side a</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXfilter.html#nxfilter-unit-cell-a-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxfilter-unit-cell-b-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_FLOAT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
