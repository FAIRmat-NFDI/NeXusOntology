            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXspm_bias_spectroscopy/BIAS_SWEEP/scan_type/linear</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXspm_bias_spectroscopy/BIAS_SWEEP/scan_type: linear</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm_bias_spectroscopy.html#nxspm-bias-spectroscopy-bias-sweep-scan-type-field</rdfs:seeAlso>
</owl:Class>

