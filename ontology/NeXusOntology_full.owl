  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-consistent-rotations-rotation-handedness-field</rdfs:seeAlso>
</owl:Class>

