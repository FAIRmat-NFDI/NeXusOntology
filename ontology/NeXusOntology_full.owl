            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-skin-enum"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/method/default</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/method: default</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field</rdfs:seeAlso>
</owl:Class>

