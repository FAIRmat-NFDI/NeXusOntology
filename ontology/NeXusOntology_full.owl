<owl:Class rdf:about="#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasEnumContainer"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-default-enum"/>
            <rdf:Description rdf:about="#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-skin-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Specifies for which point the tool will compute distances.
                    
                    The value *default* configures that distances are computed for all points.
                    The value *skin* configures that distances are computed only for those
                    points which are not farther away located to a triangle than
                    threshold_distance.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field</rdfs:seeAlso>
</owl:Class>

