  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxapm-paraprobe-ranger-results-entry-iontypesid-iontypes-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxapm-paraprobe-tool-results-entry-taskprocessed-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_ranger_results/ENTRY/iontypesID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The tool loads ranging definitions from the configuration file and
                evaluates for each ion to which iontype it matches.
                If an ion matches on no type, the ion is assume of the default
                *unknown_type*. In this case, the value *iontypes* is 0.
                In other cases the value is larger than 0.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_ranger_results.html#nxapm-paraprobe-ranger-results-entry-iontypesid-group</rdfs:seeAlso>
</owl:Class>

