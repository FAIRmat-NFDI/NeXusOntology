  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-chirp-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="#nxbeam-chirp-gdd-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
