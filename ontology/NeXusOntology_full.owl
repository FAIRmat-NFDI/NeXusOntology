  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            The beam profile, Gaussian, Airy function, top-hat or
                            rectangular.  The profile is given in the plane of
                            incidence of the beam on the sample.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-beam-profile-field</rdfs:seeAlso>
