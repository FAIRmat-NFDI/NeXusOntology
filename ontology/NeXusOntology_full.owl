    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_ranging/mass_to_charge_distribution/max_mass_to_charge</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Largest :math:`{\frac{m}{q}}_{max}` mass-to-charge-state ratio value.
                
                The upper (right-hand side) inclusive bound of the interval :math:`[{\frac{m}{q}}_{min}`, {\frac{m}{q}}_{max}]`.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_ranging.html#nxapm-ranging-mass-to-charge-distribution-max-mass-to-charge-field</rdfs:seeAlso>
</owl:Class>

