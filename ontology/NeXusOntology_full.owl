            <rdf:Description rdf:about="#nxoptical-spectroscopy-entry-instrument-beam-type-beam-polarization-type-unpolarized-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
