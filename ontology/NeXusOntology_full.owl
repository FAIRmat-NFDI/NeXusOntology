    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-triangle-setid-indices-patch-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxobject-note-group"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/triangle_setID</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Each triangle_set that is referred to here should be a face_list_data_structure,
                    i.e. an array of (n_vertices, 3) of NX_FLOAT for vertex coordinates, an (n_facets, 3)
                    array of NX_UINT incident vertices of each facet. Vertex indices are assumed to
                    start at zero and must not exceed n_vertices - 1, i.e. the index_offset is 0.
                    Facet normal have to be provided as an array of (n_facets, 3) of NX_FLOAT.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-triangle-setid-group</rdfs:seeAlso>
