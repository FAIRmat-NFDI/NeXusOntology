  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Specifies if the tool evaluates if objects intersect volumetrically.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-intersection-field</rdfs:seeAlso>
</owl:Class>

