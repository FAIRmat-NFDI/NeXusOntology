<owl:Class rdf:about="#nxmicrostructure-ipf-projection-direction-depends-on-attribute">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_ipf/projection_direction/depends_on</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Reference to an instance of :ref:`NXcoordinate_system` in which the projection_direction is defined.
                
                If the field depends_on is not provided but parents of the instance of this base class or its
                specializations define an instance of :ref:`NXcoordinate_system`, projection_direction
                is defined in this coordinate system.
                
                If nothing is provided, it is assumed that projection_direction is defined in the McStas coordinate system.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-projection-direction-depends-on-attribute</rdfs:seeAlso>
</owl:Class>

