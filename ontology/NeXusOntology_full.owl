  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdetector/layout/point</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enumeration item for NXdetector/layout: point</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-layout-field</rdfs:seeAlso>
