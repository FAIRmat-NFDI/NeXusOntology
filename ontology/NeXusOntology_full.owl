  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxmicrostructure-triple-junctions-volume-field"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#NXmicrostructure_feature"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure/triple_junctions</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Projections or representations of junctions at which three interfaces meet.
            
            An example for a line defect. Triple junctions are characterized as triple lines or triple points as their projections,
            or junctions observed between crystals (at the specimen surface exposed to an environment)
            (including wetting phenomena) or inside the specimen (crack, pores).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-triple-junctions-group</rdfs:seeAlso>
</owl:Class>

