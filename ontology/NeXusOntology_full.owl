            <rdf:Description rdf:about="#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-current-set-objectid-feature-type-objects-close-to-edge-enum"/>
            <rdf:Description rdf:about="#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-current-set-objectid-feature-type-proxies-far-from-edge-enum"/>
            <rdf:Description rdf:about="#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-current-set-objectid-feature-type-proxies-close-to-edge-enum"/>
            <rdf:Description rdf:about="#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-current-set-objectid-feature-type-other-enum"/>
          </owl:unionOf>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_intersector_config/ENTRY/v_v_spatial_correlationID/current_set/objectID/feature_type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Descriptive category explaining what these features are.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-current-set-objectid-feature-type-field</rdfs:seeAlso>
</owl:Class>

