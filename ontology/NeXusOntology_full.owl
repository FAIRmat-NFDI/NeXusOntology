<owl:Class rdf:about="#nxcg-triangle-triangles-group">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="#NXcg_face_list_data_structure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_triangle/triangles</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Combined storage of all primitives of all triangles.
            
            This description resembles the typical representation of primitives
            in file formats such as OFF, PLY, VTK, or STL.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html#nxcg-triangle-triangles-group</rdfs:seeAlso>
