<owl:Class rdf:about="#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-polar-angle-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_NUMBER"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANGLE"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-polar-angle-transformation-type-attribute"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-polar-angle-vector-attribute"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-polar-angle-depends-on-attribute"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="#nxtransformations-axisname-field"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxps/ENTRY/INSTRUMENT/ELECTRONANALYZER/transformations/analyzer_take_off_polar_angle</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Polar tilt of the analyzer with respect to the upward z-direction, defined by
                            the sample stage.
                            
                            The angle between the incoming beam and the analyzer is given by
                            beam_analyzer_angle = beam_polar_angle_of_incidence + analyzer_take_off_polar_angle.
                            In practice, the analyzer axis is often set as the z axis (analyzer_take_off_polar_angle = 0),
                            so that beam_analyzer_angle = beam_polar_angle_of_incidence. For magic angle configurations,
                            this angle is 54.5°.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-polar-angle-field</rdfs:seeAlso>
</owl:Class>

