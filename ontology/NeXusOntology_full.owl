<owl:Class rdf:about="#nxmicrostructure-score-config-entry-sample-atom-types-field">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="#NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="#NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_score_config/ENTRY/sample/atom_types</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    List of comma-separated elements from the periodic table that are
                    contained in the specimen. If the specimen substance has multiple
                    components, all elements from each component must be included in
                    `atom_types`.
                    
                    The purpose of the field is to offer research data management systems an
                    opportunity to parse the relevant elements without having to interpret
                    these from other sources.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-sample-atom-types-field</rdfs:seeAlso>
</owl:Class>

