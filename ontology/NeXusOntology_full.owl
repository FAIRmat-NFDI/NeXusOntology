  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        The raw array of core sample indices which specify which of the
                        targets are core points.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_results.html#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-core-sample-indices-field</rdfs:seeAlso>
</owl:Class>

