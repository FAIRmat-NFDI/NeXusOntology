        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#nxelectromagnetic-lens-type-single-enum"/>
            <rdf:Description rdf:about="#nxelectromagnetic-lens-type-double-enum"/>
            <rdf:Description rdf:about="#nxelectromagnetic-lens-type-quadrupole-enum"/>
            <rdf:Description rdf:about="#nxelectromagnetic-lens-type-hexapole-enum"/>
            <rdf:Description rdf:about="#nxelectromagnetic-lens-type-octupole-enum"/>
