  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="#nxapm-paraprobe-clusterer-config-entry-cameca-to-nexus-reconstruction-file-name-field"/>
