  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Curvature type:
             
             * 0 - unspecified,
             * 1 - convex,
             * 2 - concave
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_polygon.html#nxcg-polygon-shape-field</rdfs:seeAlso>
</owl:Class>

