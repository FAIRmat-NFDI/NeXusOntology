  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The mask. The length of the mask is an integer multiple of bitdepth.
                In such case, padded bits are set to 0.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_results.html#nxapm-paraprobe-tool-results-window-mask-field</rdfs:seeAlso>
