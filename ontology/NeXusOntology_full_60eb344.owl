    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/electron_source/emission_current</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Electrical current which is released from the source.
                
                This concept is related to term `Emission Current`_ of the EMglossary standard.
                
                .. _Emission Current: https://purls.helmholtz-metadaten.de/emg/EMG_00000025
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXebeam_column.html#nxebeam-column-electron-source-emission-current-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXebeam_column/electron_source/filament_current">
