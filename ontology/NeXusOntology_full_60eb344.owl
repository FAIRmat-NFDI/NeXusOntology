  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                     Array of offset values to use when alpha_value_choice is set_of_alpha_wrappings.
                     The array of alpha_values and offset_values define a sequence of (alpha and offset value).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_surfacer_config.html#nxapm-paraprobe-surfacer-config-entry-surface-meshing-offset-values-field</rdfs:seeAlso>
</owl:Class>

