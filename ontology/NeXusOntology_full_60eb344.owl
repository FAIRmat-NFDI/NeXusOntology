                     Specifies if the tool should report the first-order neighbors of each cell.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tessellator_config.html#nxapm-paraprobe-tessellator-config-entry-tessellate-has-cell-neighbors-field</rdfs:seeAlso>
</owl:Class>

