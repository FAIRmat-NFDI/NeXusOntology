    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rotating analyzer</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXellipsometry/ENTRY/INSTRUMENT/ellipsometer_type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    What type of ellipsometry was used? See Fujiwara Table 4.2.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXellipsometry.html#nxellipsometry-entry-instrument-ellipsometer-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXellipsometry/ENTRY/INSTRUMENT/focusing_probes/type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
