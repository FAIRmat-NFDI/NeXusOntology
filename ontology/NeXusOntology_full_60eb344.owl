      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_nanochem_results/ENTRY/oned_profile/xdmf_cylinder/identifier"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
