  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            The maximum distance between voxel pairs in a neighborhood to be considered
                            connected.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-config-clustering-dbscan-eps-field</rdfs:seeAlso>
