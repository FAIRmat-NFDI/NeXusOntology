  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXafm/ENTRY/INSTRUMENT/CANTILEVER_SPM/cantilever_oscillator/phase_lock_loop/cantilever_phase_positioner</rdfs:label>
