    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/INSTRUMENT/OPTICAL_LENS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    This is the optical element used to focus or collect light. This may
                    be a generic lens or microcope objectives which are used for the
                    Raman scattering process.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-optical-lens-group</rdfs:seeAlso>
</owl:Class>

