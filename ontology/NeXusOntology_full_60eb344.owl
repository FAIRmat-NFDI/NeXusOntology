  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Mobility scaling factor :math:`c_2`. Typically 5.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_gragles_config.html#nxmicrostructure-gragles-config-entry-grain-boundary-mobility-c-two-field</rdfs:seeAlso>
