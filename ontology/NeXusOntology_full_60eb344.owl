            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/time_control</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Qualitative statement for how long (assuming regular uninterrupted)
                    preparation at the specified conditions the preparation step was
                    applied.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXlab_electro_chemo_mechanical_preparation.html#nxlab-electro-chemo-mechanical-preparation-entry-grinding-step-time-control-field</rdfs:seeAlso>
</owl:Class>

