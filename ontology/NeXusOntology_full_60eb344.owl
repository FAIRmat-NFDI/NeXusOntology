      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxrd_pan/ENTRY/q_data/q_parallel</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The scattering vector (q) component, which is parallel to the sample surface.
                    This component is used in the Reciprocal Space Mapping (RSM) technique of
                    X-ray diffraction method.
                    
                    The concept is the same as 'q_parallel' of experiment_result,
                    and should be linked to /entry[ENTRY]/experiment_result/q_parallel.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxrd_pan.html#nxxrd-pan-entry-q-data-q-parallel-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXxrd_pan/ENTRY/q_data/q_perpendicular">
