</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXem_ebsd/gnomonic_reference_frame/origin">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in_the_pattern_centre</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXem_ebsd/gnomonic_reference_frame/origin</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Origin of the gnomonic_reference_frame.
                
                Reference `&lt;https://doi.org/10.1016/j.matchar.2016.04.008&gt;`_ suggests to
                assume that this is coordinate :math:`Xg = 0, Yg = 0, Zg = 0`.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_ebsd.html#nxem-ebsd-gnomonic-reference-frame-origin-field</rdfs:seeAlso>
</owl:Class>

