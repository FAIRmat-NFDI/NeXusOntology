  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The harmonic (e.g., second harmonic of the fundamental frequency) frequency of
                the cantilever.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcantilever_spm.html#nxcantilever-spm-cantilever-oscillator-frequency-harmonic-field</rdfs:seeAlso>
</owl:Class>

