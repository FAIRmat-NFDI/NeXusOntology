  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Integer offset whereby the identifier of the first member
             of the edges differs from zero.
             
             Identifier can be defined explicitly or implicitly.
             Inspect the definition of NXcg_primitive for further details.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_face_list_data_structure.html#nxcg-face-list-data-structure-identifier-edge-offset-field</rdfs:seeAlso>
</owl:Class>

