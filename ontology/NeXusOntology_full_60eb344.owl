  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        Scan number (must be an integer).

        NOTE: Link to collection_identifier.
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-scan-number-field</rdfs:seeAlso>
