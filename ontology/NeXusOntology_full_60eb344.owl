    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmanipulator/sample_bias_potentiostat/PID_CONTROLLER/setpoint_log/value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        In the case of an experiment in which the bias is changed and the setpoints are
                        recorded with time stamps, this is an array of length m of voltage setpoints.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmanipulator.html#nxmanipulator-sample-bias-potentiostat-pid-controller-setpoint-log-value-field</rdfs:seeAlso>
</owl:Class>

