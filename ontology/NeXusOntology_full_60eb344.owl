  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tessellator_config.html#nxapm-paraprobe-tessellator-config-entry-tessellate-method-field</rdfs:seeAlso>
