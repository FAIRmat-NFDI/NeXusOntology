  <owl:equivalentClass rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdisk_chopper/GEOMETRY</rdfs:label>
