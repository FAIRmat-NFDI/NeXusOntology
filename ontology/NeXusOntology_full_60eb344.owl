    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/INSTRUMENT/beam_TYPE/associated_source</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        The source that emitted this beam.
                        Should be named with the same suffix, e.g.,
                        for ``beam_laser`` it should refer to ``source_laser``.
                        This should be specified if an associated source exists.
                        
                        Example:
                          * /entry/instrument/beam_laser/associated_source = /entry/instrument/source_laser
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-instrument-beam-type-associated-source-field</rdfs:seeAlso>
</owl:Class>

