  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_distancer_results/ENTRY/point_to_triangle/identifier_triangle</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    For each point the identifier of the triangle for which the
                    shortest distance was found
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangle-identifier-triangle-field</rdfs:seeAlso>
</owl:Class>

