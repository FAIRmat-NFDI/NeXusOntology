<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXxrot/ENTRY/definition">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:allValuesFrom>
            <rdfs:Datatype>
              <owl:oneOf>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxrot</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXxlaue/ENTRY/definition"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxrot/ENTRY/definition</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Official NeXus NXDL schema to which this file conforms.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxrot.html#nxxrot-entry-definition-field</rdfs:seeAlso>
</owl:Class>

