  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/history/sample_preparation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Details about the sample preparation for the photoemission experiment (e.g. UHV cleaving,
                        in-situ growth, sputtering/annealing, etc.).
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-history-sample-preparation-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/temperature_env">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
