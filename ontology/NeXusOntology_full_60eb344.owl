      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXapm/ENTRY/atom_probe/voltage_and_bowl/tof_zero_estimate"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXapm/ENTRY/atom_probe/voltage_and_bowl/calibrated_tof"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm/ENTRY/atom_probe/voltage_and_bowl</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Configuration of and results obtained from a voltage-and-bowl time-of-flight correction algorithm.
                    
                    The voltage-and-bowl correction is a data post-processing step to correct ion impact
                    positions for flight path differences, detector bias, and nonlinearities.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm.html#nxapm-entry-atom-probe-voltage-and-bowl-group</rdfs:seeAlso>
</owl:Class>

