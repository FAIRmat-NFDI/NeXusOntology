  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html#nxapm-paraprobe-nanochem-config-entry-interface-meshing-decoration-filter-method-field</rdfs:seeAlso>
</owl:Class>

