  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                From which border of the EBSP (in the detector reference frame) is the pattern
                centre's x-position (PCx) measured.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_ebsd.html#nxem-ebsd-pattern-centre-x-boundary-convention-field</rdfs:seeAlso>
</owl:Class>

