  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcalibration"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXresolution/CALIBRATION</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             For storing details and data of a calibration to derive a resolution from data.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXresolution.html#nxresolution-calibration-group</rdfs:seeAlso>
</owl:Class>

