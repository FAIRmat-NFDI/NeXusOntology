<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcsg/a">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcsg"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcsg/a</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
     The first operand of constructive solid geometry operation.
     Compulsory if 'operation' is UNION, INTERSECTION,
     DIFFERENCE or COMPLEMENT.
   </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-a-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcsg/b">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcsg"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcsg/b</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
     The second operand of constructive solid geometry operation.
     Compulsory if 'operation' is UNION, INTERSECTION or
     DIFFERENCE.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-b-group</rdfs:seeAlso>
</owl:Class>

