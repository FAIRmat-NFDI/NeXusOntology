  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        A reference to a beam emitted by this source.
                        Should be named with the same suffix, e.g.,
                        for ``monochromator_probe`` it should refer to ``beam_probe``.
                        
                        Example:
                          * /entry/instrument/monochromator_probe/associated_beam = /entry/instrument/beam_probe
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-instrument-monochromator-type-associated-beam-field</rdfs:seeAlso>
</owl:Class>

