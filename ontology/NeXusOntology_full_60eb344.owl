        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXsample/orientation_matrix"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxbase/ENTRY/sample/orientation_matrix</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The orientation matrix according to Busing and 
            Levy conventions. This is not strictly necessary as 
            the UB can always be derived from the data.  But 
            let us bow to common usage which includes the 
            UB nearly always.
           </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxbase.html#nxxbase-entry-sample-orientation-matrix-field</rdfs:seeAlso>
</owl:Class>

