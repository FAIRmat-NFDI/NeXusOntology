      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Attribute/NXem_calorimetry/ENTRY/environment/PROGRAM/program/version"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
