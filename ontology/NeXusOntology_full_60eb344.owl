    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxrd_pan/ENTRY/experiment_result/q_perpendicular</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The scattering vector component, which is perpendicular to the sample surface.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxrd_pan.html#nxxrd-pan-entry-experiment-result-q-perpendicular-field</rdfs:seeAlso>
</owl:Class>

