<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXsensor_scan/ENTRY/default">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor_scan/ENTRY/default</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                .. index:: plotting
                
                Declares which child group contains a path leading
                to a :ref:`NXdata` group.
                
                It is recommended (as of NIAC2014) to use this attribute
                to help define the path to the default dataset to be visualized upon entry.
                See https://www.nexusformat.org/2014_How_to_find_default_data.html
                for a summary of the discussion.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-default-attribute</rdfs:seeAlso>
</owl:Class>

