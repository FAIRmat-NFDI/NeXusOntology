        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_cylinder.html#nxcg-cylinder-radii-field</rdfs:seeAlso>
</owl:Class>

