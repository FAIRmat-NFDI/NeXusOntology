  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Direction of the positively pointing x-axis base vector of the
                gnomonic_reference_frame.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_ebsd.html#nxem-ebsd-gnomonic-reference-frame-x-direction-field</rdfs:seeAlso>
</owl:Class>

