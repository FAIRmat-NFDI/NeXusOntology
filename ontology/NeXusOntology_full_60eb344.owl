<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_nanochem_config/ENTRY/interface_meshing/method">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pca_plus_dcom</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_nanochem_config/ENTRY/interface_meshing/method</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Method used for identifying and refining the location of the interface. Currently,
                    paraprobe-nanochem implements a PCA followed by an iterative loop of isotropic
                    mesh refinement and DCOM step(s), paired with self-intersection detection.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html#nxapm-paraprobe-nanochem-config-entry-interface-meshing-method-field</rdfs:seeAlso>
</owl:Class>

