    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_surfacer_config/ENTRY/surface_meshing/has_exterior_facets</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                     Specifies if the tool should compute the set of exterior triangle facets
                     for each alpha complex (for convex hull, alpha shapes, and wrappings).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_surfacer_config.html#nxapm-paraprobe-surfacer-config-entry-surface-meshing-has-exterior-facets-field</rdfs:seeAlso>
</owl:Class>

