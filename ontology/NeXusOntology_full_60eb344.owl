  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
              This is the x position where the direct beam would hit the detector. This is a
              length, not a pixel position, and can be outside of the actual detector.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxrot.html#nxxrot-entry-instrument-detector-beam-center-x-field</rdfs:seeAlso>
