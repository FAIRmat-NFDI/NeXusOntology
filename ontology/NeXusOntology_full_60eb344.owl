            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-data-group</rdfs:seeAlso>
