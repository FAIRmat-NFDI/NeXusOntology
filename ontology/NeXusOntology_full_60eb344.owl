  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The factor of enlargement of the apparent size,
            not the physical size, of an object.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_system_em.html#nxoptical-system-em-magnification-field</rdfs:seeAlso>
</owl:Class>

