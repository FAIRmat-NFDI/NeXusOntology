  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            The size and position of the field aperture inserted in the column. To add
                            additional or other apertures use the APERTURE group of NXcollectioncolumn.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-instrument-electronanalyzer-collectioncolumn-field-aperture-group</rdfs:seeAlso>
