  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The identifiers for the experiment which should be unique at least in lab.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXspm.html#nxspm-entry-identifier-experiment-field</rdfs:seeAlso>
</owl:Class>

