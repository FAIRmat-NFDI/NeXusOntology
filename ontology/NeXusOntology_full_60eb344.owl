  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Identifier of a specific state and setting of the microscope.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXevent_data_em.html#nxevent-data-em-identifier-event-field</rdfs:seeAlso>
</owl:Class>

