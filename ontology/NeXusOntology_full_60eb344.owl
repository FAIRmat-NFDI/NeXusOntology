      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_surfacer_results/ENTRY/point_set_wrapping/ALPHA_COMPLEX/window/bitdepth"/>
