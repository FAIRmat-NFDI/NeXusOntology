    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXcs_profiling/end_time"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_tool_common/profiling/end_time</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                 ISO 8601 formatted time code with local time zone offset to UTC
                 information included when the analysis in this results file were
                 completed and the respective process of the tool exited.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-profiling-end-time-field</rdfs:seeAlso>
</owl:Class>

