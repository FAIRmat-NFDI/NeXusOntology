  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcs_filter_boolean_mask.html#nxcs-filter-boolean-mask-bitdepth-field</rdfs:seeAlso>
</owl:Class>

