    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxpcs/ENTRY/instrument/masks/static_q_list</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            1-D list of :math:`|Q|` values, 1 for each roi.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-instrument-masks-static-q-list-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXxpcs/ENTRY/sample/temperature_set">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_NUMBER"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
