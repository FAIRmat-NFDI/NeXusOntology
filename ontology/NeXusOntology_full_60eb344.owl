  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Possibility to define an alias for the name of the x-axis.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcoordinate_system.html#nxcoordinate-system-x-alias-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcoordinate_system/x_direction">
