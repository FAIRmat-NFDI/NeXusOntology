  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_spatstat_config</rdf:first>
