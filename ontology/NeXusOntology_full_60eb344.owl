  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXellipsometry/ENTRY/title</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXellipsometry.html#nxellipsometry-entry-title-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXellipsometry/ENTRY/experiment_type">
