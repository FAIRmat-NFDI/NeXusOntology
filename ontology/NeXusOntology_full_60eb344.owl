</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/rotation_control">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">undefined</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/rotation_control</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Qualitative statement how the revelation of the machine was configured.
                    If the rotation was controlled manually, e.g. by turning knobs
                    choose manual and estimate the nominal average rotation.
                    If the rotation was controlled via choosing from a fixed set
                    of options offered by the machine choose fixed and
                    specify the nominal rotation.
                    If programmed use rotation_history (e.g. for automated/robot systems).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXlab_electro_chemo_mechanical_preparation.html#nxlab-electro-chemo-mechanical-preparation-entry-grinding-step-rotation-control-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/force_control">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">undefined</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/force_control</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Qualitative statement how the (piston) force with which the sample
                    was pressed into/against the abrasive medium was controlled if at all.
                    If the force was controlled manually e.g. by turning knobs
                    choose manual and estimate nominal average force.
                    If the force was controlled via choosing from a fixed set
                    of options offered by the machine choose fixed and
                    specify the nominal force.
                    If programmed use force_history (e.g. for automated/robot systems).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXlab_electro_chemo_mechanical_preparation.html#nxlab-electro-chemo-mechanical-preparation-entry-grinding-step-force-control-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/time_control">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
