<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXscanbox_em/DEFLECTOR">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXdeflector"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXscanbox_em/DEFLECTOR</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Details about components which realize the deflection technically.
            
            This concept should be used for all those components that implement
            the scanning of the beam, while components like beam blankers etc. should
            use rather the NXdeflector concept of the NXebeam_column base class.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXscanbox_em.html#nxscanbox-em-deflector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXscanbox_em/CIRCUIT">
