  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            A counter electrode of the LEAP 6000 series atom probes.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXinstrument_apm.html#nxinstrument-apm-decelerate-electrode-group</rdfs:seeAlso>
</owl:Class>

