    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpiezoelectric_material/P_pyroelectric_constant</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The pyroelectric constant defines the change of the polarization vector of the piezoelectric material
            per unit change in temperature.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXpiezoelectric_material.html#nxpiezoelectric-material-p-pyroelectric-constant-field</rdfs:seeAlso>
</owl:Class>

