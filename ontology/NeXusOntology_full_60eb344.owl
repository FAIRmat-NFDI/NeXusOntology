  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Pulse reduction factor of this chopper in relation to other
			choppers/fastest pulse in the instrument
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdisk_chopper.html#nxdisk-chopper-ratio-field</rdfs:seeAlso>
