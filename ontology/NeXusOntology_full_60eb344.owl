  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of quantity of item(s) such as number of photons,
				neutrons, pulses, or other counting events
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-count</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Units/NX_SCATTERING_LENGTH_DENSITY">
  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
