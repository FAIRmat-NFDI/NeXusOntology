  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                To indicate the relative tip position z between tip and sample. The tip position
                can also be varied when the z_controller is not running.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXpositioner_spm.html#nxpositioner-spm-z-controller-z-field</rdfs:seeAlso>
