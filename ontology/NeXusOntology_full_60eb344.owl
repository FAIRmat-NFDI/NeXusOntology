    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXactuator/outputVALUE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Any output that the actuator produces.
             For example, a heater can have the field output_power(NX_NUMBER).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXactuator.html#nxactuator-outputvalue-field</rdfs:seeAlso>
</owl:Class>

