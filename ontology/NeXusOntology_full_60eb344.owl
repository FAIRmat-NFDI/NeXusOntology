    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/electron_source/filament_current</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Electrical current which flows through the source.
                
                This concept is related to term `Filament Current`_ of the EMglossary standard.
                
                .. _Filament Current: https://purls.helmholtz-metadaten.de/emg/EMG_00000027
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXebeam_column.html#nxebeam-column-electron-source-filament-current-field</rdfs:seeAlso>
</owl:Class>

