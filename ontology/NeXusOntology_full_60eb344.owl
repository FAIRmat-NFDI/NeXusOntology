</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXxpcs/ENTRY/data/frame_average">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
