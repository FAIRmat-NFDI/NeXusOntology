  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        The spectrum of the lamp used
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXtransmission.html#nxtransmission-entry-instrument-source-spectrum-field</rdfs:seeAlso>
</owl:Class>

