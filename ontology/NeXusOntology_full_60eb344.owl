  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Total area under the peak after background removal.
                        
                        This concept is related to term `3.16`_ of the ISO 18115-1:2023 standard.
                        
                        .. _3.16: https://www.iso.org/obp/ui/en/#iso:std:iso:18115:-1:ed-3:v1:en:term:3.16
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxps.html#nxxps-entry-fit-peakpeak-total-area-field</rdfs:seeAlso>
</owl:Class>

