  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Handedness of the coordinate system if it is a Cartesian.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcoordinate_system.html#nxcoordinate-system-handedness-field</rdfs:seeAlso>
</owl:Class>

