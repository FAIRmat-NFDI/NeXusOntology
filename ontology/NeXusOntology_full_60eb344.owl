  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Average disorientation angle for each crystal between individual orientations
                of that crystal evaluated as a summary statistic for all probed positions vs the
                average disorientation of that crystal.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-crystals-orientation-spread-field</rdfs:seeAlso>
</owl:Class>

