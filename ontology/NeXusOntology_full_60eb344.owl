  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             The offset distance parameter used when computing alpha_wrappings.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_alpha_complex.html#nxcg-alpha-complex-offset-field</rdfs:seeAlso>
</owl:Class>

