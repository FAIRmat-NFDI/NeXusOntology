<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_clusterer_config/ENTRY/CLUSTER_ANALYSIS/hdbscan/high_throughput_method">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
