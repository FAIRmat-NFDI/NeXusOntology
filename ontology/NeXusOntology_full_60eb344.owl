  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                 Paraprobe-ranger loads the iontypes and evaluates for each
                 ion on which iontype it matches. If it matches on None, the
                 ion is considered of the default *unknown_type*. This iontype
                 is marked with a 0 in the iontypes array.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_ranger_results.html#nxapm-paraprobe-ranger-results-entry-iontypes-group</rdfs:seeAlso>
