  <owl:equivalentClass rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcircuit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXscanbox_em/CIRCUIT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXscanbox_em.html#nxscanbox-em-circuit-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcs_profiling/CS_COMPUTER">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcs_computer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcs_profiling/CS_COMPUTER</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             A collection with one or more computing nodes each with own resources.
             This can be as simple as a laptop or the nodes of a cluster computer.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcs_profiling.html#nxcs-profiling-cs-computer-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcs_profiling/CS_PROFILING_EVENT">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcs_profiling_event"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcs_profiling/CS_PROFILING_EVENT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             A collection of individual profiling event data which detail e.g. how
             much time the app took for certain computational steps and/or how much
             memory was consumed during these operations.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcs_profiling.html#nxcs-profiling-cs-profiling-event-group</rdfs:seeAlso>
</owl:Class>

