  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Normally the detector group will have the name ``detector``.
                        However, in the case of multiple detectors, each detector
                        needs a uniquely named NXdetector.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmx/ENTRY/INSTRUMENT/DETECTOR/TRANSFORMATIONS">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Group/NXcomponent/TRANSFORMATIONS"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/INSTRUMENT/DETECTOR/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Location for axes (transformations) to do with the
                            detector.  In the case of a single-module detector, the
                            axes of the detector axis chain may be stored here.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-transformations-group</rdfs:seeAlso>
</owl:Class>

