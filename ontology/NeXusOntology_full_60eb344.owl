    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/drain_current_env/value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        This is to be used if there is no actuator/sensor that controls/measures
                        the drain current.
                        
                        Note that this method for recording the drain current is not advised, but using
                        NXsensor and NXactuator is strongly recommended instead.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-drain-current-env-value-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/SAMPLE/flood_gun_current_env/value">
