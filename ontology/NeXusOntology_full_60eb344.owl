    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxrd_pan/ENTRY/q_data/q_perpendicular</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The scattering vector component, which is perpendicular to the sample surface.
                    
                    The concept is the same as  'q_perpendicular' of experiment_result,
                    and should be linked to /entry[ENTRY]/experiment_result/q_perpendicular.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxrd_pan.html#nxxrd-pan-entry-q-data-q-perpendicular-field</rdfs:seeAlso>
</owl:Class>

