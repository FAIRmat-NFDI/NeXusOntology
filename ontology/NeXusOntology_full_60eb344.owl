                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXxps.html#nxxps-entry-instrument-electronanalyzer-transformations-analyzer-take-off-azimuth-angle-field</rdfs:seeAlso>
</owl:Class>

