    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_clusterer_config/ENTRY/CLUSTER_ANALYSIS/dbscan/min_pts</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Array of minimum points (min_pts) parameter values.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_config.html#nxapm-paraprobe-clusterer-config-entry-cluster-analysis-dbscan-min-pts-field</rdfs:seeAlso>
