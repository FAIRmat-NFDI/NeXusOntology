  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Sample temperature (either controlled or just measured) and actuators/sensors
                    controlling/measuring it.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-temperature-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/temperature_env/temperature_sensor">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/temperature_env/temperature_sensor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Temperature sensor measuring the sample temperature.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/temperature_sensor
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-temperature-env-temperature-sensor-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/temperature_env/sample_heater">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/temperature_env/sample_heater</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Device to heat the sample.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/sample_heater
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-temperature-env-sample-heater-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/temperature_env/cryostat">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/temperature_env/cryostat</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Cryostat for cooling the sample.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/cryostat
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-temperature-env-cryostat-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/gas_pressure_env">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/gas_pressure_env/pressure_gauge"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/SAMPLE/gas_pressure_env/value"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/gas_pressure_env</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Gas pressure surrounding the sample and actuators/sensors controlling/measuring
                    it.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-gas-pressure-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/gas_pressure_env/pressure_gauge">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/gas_pressure_env/pressure_gauge</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Gauge measuring the gas pressure.
                        
                        In most cases, this can be a link to /entry/instrument/pressure_gauge or to another
                        NXsensor measuring gas pressure (typically, the gauge in closest proximity to the
                        sample) if such a pressure gauge is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-gas-pressure-env-pressure-gauge-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/bias_env">
