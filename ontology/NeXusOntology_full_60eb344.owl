  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxbase/ENTRY/sample/name</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Descriptive name of sample</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxbase.html#nxxbase-entry-sample-name-field</rdfs:seeAlso>
