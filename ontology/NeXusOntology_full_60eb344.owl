    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/INSTRUMENT/beam_probe</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Properties of the probe beam at a given location.
                    
                    This is the beam that is used to facilitate the photoemission during MPES
                    experiments.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-instrument-beam-probe-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/INSTRUMENT/beam_pump">
