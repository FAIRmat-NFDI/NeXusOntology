  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Maximum simulated physical time.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-numerics-max-time-field</rdfs:seeAlso>
