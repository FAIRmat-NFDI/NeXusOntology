<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXflipper/flip_turns">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
