  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Number of faces of the primitives.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_face_list_data_structure.html#nxcg-face-list-data-structure-number-of-faces-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcg_face_list_data_structure/identifier_vertex_offset">
