  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                     Specifies if the tool should check if the alpha complex of
                     exterior triangular facets is a closed polyhedron.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_surfacer_config.html#nxapm-paraprobe-surfacer-config-entry-surface-meshing-has-closure-field</rdfs:seeAlso>
