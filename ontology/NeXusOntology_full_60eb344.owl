<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXbeam/average_power">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
