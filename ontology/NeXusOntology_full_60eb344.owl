      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXapm_paraprobe_clusterer_config/ENTRY/CLUSTER_ANALYSIS/iontype_filter"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXapm_paraprobe_clusterer_config/ENTRY/CLUSTER_ANALYSIS/hit_multiplicity_filter"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
