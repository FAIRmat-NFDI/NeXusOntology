  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Specific name or type of the polarizer used.
                        
                        Free text, for example: Glan-Thompson, Glan-Taylor, Rochon Prism, Wollaston
                        Polarizer...
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-polfilter-type-specific-polarization-filter-type-field</rdfs:seeAlso>
