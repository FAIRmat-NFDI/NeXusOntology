  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If cylindrical: cylinder orientation angle</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcrystal.html#nxcrystal-cylindrical-orientation-angle-field</rdfs:seeAlso>
