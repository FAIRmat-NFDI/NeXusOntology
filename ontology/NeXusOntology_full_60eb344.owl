  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlation-current-set-object-type-field</rdfs:seeAlso>
</owl:Class>

