<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcoordinate_system/type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:allValuesFrom>
            <rdfs:Datatype>
              <owl:oneOf>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cartesian</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmicrostructure_score_results/ENTRY/sample_reference_frame/type"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcoordinate_system/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Coordinate system type.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcoordinate_system.html#nxcoordinate-system-type-field</rdfs:seeAlso>
</owl:Class>

