  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/SAMPLE/bias_env/value"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/bias_env</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-bias-env-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/bias_env/voltmeter">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/bias_env/voltmeter</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Sensor measuring the applied voltage.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/sample_bias_voltmeter
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-bias-env-voltmeter-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/bias_env/potentiostat">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/bias_env/potentiostat</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Actuator applying a voltage to sample and sample holder.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/sample_bias_potentiostat
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmpes.html#nxmpes-entry-sample-bias-env-potentiostat-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/drain_current_env">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
