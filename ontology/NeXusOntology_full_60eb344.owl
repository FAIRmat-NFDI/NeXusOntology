    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcantilever_spm/cantilever_oscillator/reference_amplitude</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The reference amplitude (also called drive amplitude) of the cantilever.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcantilever_spm.html#nxcantilever-spm-cantilever-oscillator-reference-amplitude-field</rdfs:seeAlso>
</owl:Class>

