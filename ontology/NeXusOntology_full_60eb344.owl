            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXellipsometry.html#nxellipsometry-entry-ellipsometry-experiment-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXellipsometry/ENTRY/INSTRUMENT/ellipsometer_type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
