                    depends or the string "." for origin.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-transformations-direction-depends-on-attribute</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXbeam/TRANSFORMATIONS/reference_plane/transformation_type">
