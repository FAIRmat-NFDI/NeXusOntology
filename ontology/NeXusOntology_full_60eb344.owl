  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      Distance of source point from particle beam waist in Y (vertical) direction.
      Note, it is recommended to use NXtransformations instead to place component.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbending_magnet.html#nxbending-magnet-source-distance-y-field</rdfs:seeAlso>
</owl:Class>

