<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmicrostructure_odf/kth_extrema/extrema">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minima</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmicrostructure_odf/kth_extrema/extrema</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Minima or maxima, if extrema is set to minima values for location and volume_fraction
                are sorted in increasing order. If extrema is set to maxima values for location and
                volume_fraction are sorted in decreasing order. Therefore, the global extremum is
                always the first entry in location and volume_fraction.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_odf.html#nxmicrostructure-odf-kth-extrema-extrema-field</rdfs:seeAlso>
</owl:Class>

