</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXbeam/TRANSFORMATIONS/DIRECTION/offset">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
