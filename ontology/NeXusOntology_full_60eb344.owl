<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcg_primitive/is_closed">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
