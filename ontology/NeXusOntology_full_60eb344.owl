  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsnsevent/ENTRY/DASlogs/LOG/average_value</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXsnsevent.html#nxsnsevent-entry-daslogs-log-average-value-field</rdfs:seeAlso>
