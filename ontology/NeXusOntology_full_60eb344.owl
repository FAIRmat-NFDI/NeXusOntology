  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                If the scan probe oscillates over the scan point, use True.
                The default value is False.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXscan_control.html#nxscan-control-traj-scan-oscillating-n-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXscan_control/traj_SCAN/oscillation_frequency">
