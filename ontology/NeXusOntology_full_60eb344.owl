  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_config.html#nxapm-paraprobe-tool-config-subsampling-filter-group</rdfs:seeAlso>
</owl:Class>

