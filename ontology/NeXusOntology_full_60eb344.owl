  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Minimum distinguishable wavelength separation of peaks in spectra.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-wavelength-resolution-resolution-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/SAMPLE/name">
