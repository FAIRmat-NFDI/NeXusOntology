  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Prefactor :math:`0.5Gb^2` that factorizes the average
                    stored elastic energy per length dislocation line.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_gragles_config.html#nxmicrostructure-gragles-config-entry-stored-elastic-energy-line-energy-field</rdfs:seeAlso>
</owl:Class>

