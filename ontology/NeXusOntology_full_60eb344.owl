      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam/TRANSFORMATIONS/DIRECTION/transformation_type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-transformations-direction-transformation-type-attribute</rdfs:seeAlso>
