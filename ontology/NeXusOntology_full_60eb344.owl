  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Wedge angle if 'shape' is 'wedged'.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXpolarizer_opt.html#nxpolarizer-opt-shape-wedge-angle-field</rdfs:seeAlso>
</owl:Class>

