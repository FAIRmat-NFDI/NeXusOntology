  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            The number of voxels in a neighborhood for a voxel to be considered as a core
                            point.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-config-clustering-dbscan-min-samples-field</rdfs:seeAlso>
