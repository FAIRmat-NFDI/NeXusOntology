  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXentry/pre_sample_flightpath"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtofraw/ENTRY/pre_sample_flightpath</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        This is the flight path before the sample position. This can be determined by a chopper,
        by the moderator, or the source itself. In other words: it is the distance to the component
        which gives the T0 signal to the detector electronics. If another component in the
        NXinstrument hierarchy provides this information, this should be a link.
      </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtofraw.html#nxtofraw-entry-pre-sample-flightpath-field</rdfs:seeAlso>
</owl:Class>

