  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Matrix of numerical label for each member in the set.
             For classical clustering algorithms this can for instance
             encode the identifier_cluster.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXsimilarity_grouping.html#nxsimilarity-grouping-numerical-label-field</rdfs:seeAlso>
</owl:Class>

