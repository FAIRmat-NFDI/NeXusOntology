  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbias_spectroscopy/bias_sweep/max_slew_rate</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The rate at which the amplifier responds to the voltage change
                (to reach at the desired value). It defines if the tip movement and
                voltage sweep are synchronized.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbias_spectroscopy.html#nxbias-spectroscopy-bias-sweep-max-slew-rate-field</rdfs:seeAlso>
</owl:Class>

