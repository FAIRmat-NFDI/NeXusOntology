      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXinstrument_apm/pulser/SOURCE/BEAM/spot_position"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXinstrument_apm/pulser/SOURCE/BEAM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Details about specific positions along the laser beam
                    which illuminates the (atom probe) specimen.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXinstrument_apm.html#nxinstrument-apm-pulser-source-beam-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXinstrument_apm/pulser/SOURCE/TRANSFORMATIONS">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXinstrument_apm/pulser/SOURCE/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Affine transformations which describe the geometry how the
                    laser focusing optics/pinhole-attached coordinate system is
                    defined, how it has to be transformed so that it aligns with
                    the specimen coordinate system.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXinstrument_apm.html#nxinstrument-apm-pulser-source-transformations-group</rdfs:seeAlso>
</owl:Class>

