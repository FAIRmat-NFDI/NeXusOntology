    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXwaveplate/coating/coating_type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Specify the coating type (e.g. dielectric, anti-reflection (AR),
                multilayer coating etc.).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXwaveplate.html#nxwaveplate-coating-coating-type-field</rdfs:seeAlso>
