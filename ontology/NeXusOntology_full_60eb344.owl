  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    A set of activities that occurred to the sample prior to/during the experiment.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-history-group</rdfs:seeAlso>
