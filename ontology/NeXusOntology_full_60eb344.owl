  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Density of the material the container is made from.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-density-field</rdfs:seeAlso>
</owl:Class>

