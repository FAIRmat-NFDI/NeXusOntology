    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANGLE"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbending_magnet/divergence_x_minus</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      Accepted photon beam divergence in X- (horizontal inboard) direction.
      Note that divergence_x_plus+divergence_x_minus is the total horizontal beam divergence.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbending_magnet.html#nxbending-magnet-divergence-x-minus-field</rdfs:seeAlso>
</owl:Class>

