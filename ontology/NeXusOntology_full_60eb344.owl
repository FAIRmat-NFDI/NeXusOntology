<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsource/type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#actualValue"/>
                      <owl:allValuesFrom>
                        <rdfs:Datatype>
                          <owl:oneOf>
                            <rdf:Description>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spallation Neutron Source</rdf:first>
                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </owl:oneOf>
                        </rdfs:Datatype>
                      </owl:allValuesFrom>
                    </owl:Restriction>
                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/INSTRUMENT/source_TYPE/type"/>
                  </owl:unionOf>
                </owl:Class>
                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtransmission/ENTRY/instrument/SOURCE/type"/>
              </owl:unionOf>
            </owl:Class>
            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/INSTRUMENT/source_probe/type"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXarchive/ENTRY/instrument/SOURCE/type"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type of radiation source (pick one from the enumerated list and spell exactly)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-type-field</rdfs:seeAlso>
</owl:Class>

