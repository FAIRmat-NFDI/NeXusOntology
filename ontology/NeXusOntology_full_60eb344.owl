      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXafm/ENTRY/INSTRUMENT/CANTILEVER_SPM/cantilever_oscillator/phase_lock_loop/amplitude_excitation"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXafm/ENTRY/INSTRUMENT/CANTILEVER_SPM/cantilever_oscillator/phase_lock_loop</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Phase locked loop for cantilever lock-in device.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXafm.html#nxafm-entry-instrument-cantilever-spm-cantilever-oscillator-phase-lock-loop-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXafm/ENTRY/INSTRUMENT/CANTILEVER_SPM/cantilever_oscillator/phase_lock_loop/cantilever_phase_positioner">
