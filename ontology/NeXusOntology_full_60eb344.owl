  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalization-weighting-model-weighting-method-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_nanochem_results/ENTRY/DELOCALIZATION/weighting_model/method">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
