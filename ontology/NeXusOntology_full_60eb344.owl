  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Control parameter set typically in the GUI relevant to assure that
                the instrument internally controls its settings such to assure a
                significant yet not too high ion influx on the detector to avoid
                detection losses.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXinstrument_apm.html#nxinstrument-apm-control-target-detection-rate-field</rdfs:seeAlso>
</owl:Class>

