  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Complex index of refraction of the coating. Specify at given spectral
                values (e.g. wavelength, energy, wavenumber etc.).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-coating-index-of-refraction-coating-field</rdfs:seeAlso>
</owl:Class>

