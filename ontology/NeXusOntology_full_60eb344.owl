        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_polygon.html#nxcg-polygon-edge-length-field</rdfs:seeAlso>
