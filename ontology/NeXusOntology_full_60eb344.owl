    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXebeam_column/corrector_ax/value_y</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Descriptor for the correction strength along the second direction when exact technical details
                are unknown or not directly controllable as the control software of the microscope does not
                enable or was not configured to display these values for users.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXebeam_column.html#nxebeam-column-corrector-ax-value-y-field</rdfs:seeAlso>
</owl:Class>

