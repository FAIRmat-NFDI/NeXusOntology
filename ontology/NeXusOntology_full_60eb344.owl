  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Describe the geometry (shape, dimension etc.) of the device.
            Specify the dimensions in 'SHAPE/size'. A sketch of the device should be
            provided in the 'sketch(NXdata)' field to clarify (i) the shape and
            dimensions of the device, and (ii) the input and outputs (i.e. the
            direction of the incoming and outcoming (split) beams).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXpolarizer_opt.html#nxpolarizer-opt-shape-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXpolarizer_opt/SHAPE/sketch">
