  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                True or false value, one for each crystal, to communicate whether that feature
                makes contact with the edge of the ROI.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-crystals-boundary-contact-field</rdfs:seeAlso>
</owl:Class>

