<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXxpcs/ENTRY/twotime/g2_from_two_time_corr_func/first_point_for_fit">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
