  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Bunge-Euler angle parameterization of the texture components
                    location in orientation space for which specifically different settings
                    should be configured.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_imm_config.html#nxmicrostructure-imm-config-entry-component-analysis-bunge-euler-field</rdfs:seeAlso>
</owl:Class>

