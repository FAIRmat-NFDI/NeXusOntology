  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Name of the PRNG implementation and version. If such information is not
             available or if the PRNG type was set to other the DOI to the publication
             or the source code should be given.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcs_prng.html#nxcs-prng-program-group</rdfs:seeAlso>
