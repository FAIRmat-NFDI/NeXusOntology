  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Accumulated counts
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_eds.html#nxem-eds-indexing-summary-intensity-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXem_eds/indexing/summary/axis_energy">
