    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXstxm/ENTRY/DATA/energy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> List of photon energies of the X-ray beam. If scanned through multiple values,
              then an 'axis' attribute will be required to link the field to the appropriate data array dimension.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-energy-field</rdfs:seeAlso>
</owl:Class>

