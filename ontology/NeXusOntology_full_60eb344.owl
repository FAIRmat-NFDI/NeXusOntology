  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXelectronanalyzer.html#nxelectronanalyzer-collectioncolumn-group</rdfs:seeAlso>
</owl:Class>

