      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/INSTRUMENT/beam_TYPE/incident_wavelength_spread"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
