  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXguide/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
           This group describes the shape of the beam line component
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXguide.html#nxguide-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmonochromator/entrance_slit">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXaperture"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonochromator/entrance_slit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Size, position and shape of the entrance slit of the monochromator.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonochromator.html#nxmonochromator-entrance-slit-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmonochromator/exit_slit">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXaperture"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonochromator/exit_slit</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Size, position and shape of the exit slit of the monochromator.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonochromator.html#nxmonochromator-exit-slit-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmonochromator/distribution">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonochromator/distribution</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonochromator.html#nxmonochromator-distribution-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmonochromator/geometry">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <owl:equivalentClass rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXgeometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonochromator/geometry</rdfs:label>
