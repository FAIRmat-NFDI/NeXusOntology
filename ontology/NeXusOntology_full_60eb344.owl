    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_face_list_data_structure/number_of_edges</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Number of edges for each face.
             
             Each entry represents the total number of edges for that face,
             irrespectively whether edges are shared across faces or not.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_face_list_data_structure.html#nxcg-face-list-data-structure-number-of-edges-field</rdfs:seeAlso>
</owl:Class>

