  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
          Count to a preset value based on either clock time
          (timer) or received monitor counts (monitor).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXsas.html#nxsas-entry-monitor-mode-field</rdfs:seeAlso>
</owl:Class>

