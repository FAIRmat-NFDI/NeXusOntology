                from the specified boundary.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_ebsd.html#nxem-ebsd-pattern-centre-x-normalization-direction-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXem_ebsd/pattern_centre/y_boundary_convention">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
