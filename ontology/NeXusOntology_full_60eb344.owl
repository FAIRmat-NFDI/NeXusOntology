  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Number of vertices for each face.
             
             Each entry represents the total number of vertices for that face,
             irrespectively whether vertices are shared among faces or not.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_face_list_data_structure.html#nxcg-face-list-data-structure-number-of-vertices-field</rdfs:seeAlso>
</owl:Class>

