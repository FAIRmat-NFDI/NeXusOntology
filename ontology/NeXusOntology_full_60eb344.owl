</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXsolid_geometry/CSG">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcsg"/>
