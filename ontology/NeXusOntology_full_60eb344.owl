  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXinstrument_em.html#nxinstrument-em-nanoprobe-fabrication-group</rdfs:seeAlso>
</owl:Class>

