  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Specify the coating type (e.g. dielectric, anti-reflection (AR),
                multilayer coating etc.).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-coating-coating-type-field</rdfs:seeAlso>
</owl:Class>

