  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbending_magnet/divergence_y_plus</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      Accepted photon beam divergence in Y+ (vertical upward) direction.
      Note that divergence_y_plus+divergence_y_minus is the total vertical beam divergence.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbending_magnet.html#nxbending-magnet-divergence-y-plus-field</rdfs:seeAlso>
</owl:Class>

