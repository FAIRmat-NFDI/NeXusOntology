            Principle type of the pump.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXpump.html#nxpump-design-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcg_unit_normal/normals">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
