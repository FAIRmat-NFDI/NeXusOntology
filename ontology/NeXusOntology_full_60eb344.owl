  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-generic-beam-sample-angle-type-type-field</rdfs:seeAlso>
</owl:Class>

