<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmanipulator/cryostat/actuation_target">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:allValuesFrom>
            <rdfs:Datatype>
              <owl:oneOf>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/INSTRUMENT/MANIPULATOR/cryostat/actuation_target"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmanipulator/cryostat/actuation_target</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXmanipulator.html#nxmanipulator-cryostat-actuation-target-field</rdfs:seeAlso>
</owl:Class>

