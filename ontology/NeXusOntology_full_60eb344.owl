<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcg_triangle/triangles">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcg_face_list_data_structure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_triangle/triangles</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Combined storage of all primitives of all triangles.
             
             This description resembles the typical representation of primitives
             in file formats such as OFF, PLY, VTK, or STL.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_triangle.html#nxcg-triangle-triangles-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXcg_triangle/TRIANGLE">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcg_face_list_data_structure"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_triangle/TRIANGLE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Individual storage of each triangle.
             Users are advised that using such individual storage of primitives
             may be less storage efficient than creating a combined storage.
             
             Instances should use triangle as a name prefix.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_triangle.html#nxcg-triangle-triangle-group</rdfs:seeAlso>
</owl:Class>

