  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXiv_temp/ENTRY/INSTRUMENT/ENVIRONMENT</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
