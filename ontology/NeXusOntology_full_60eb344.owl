    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam_splitter/substrate/index_of_refraction_substrate</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Complex index of refraction of the beam splitter substrate. Specify at
                given spectral values (e.g. wavelength, energy, wavenumber etc.).
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbeam_splitter.html#nxbeam-splitter-substrate-index-of-refraction-substrate-field</rdfs:seeAlso>
</owl:Class>

