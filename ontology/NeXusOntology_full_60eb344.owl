            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbias_spectroscopy.html#nxbias-spectroscopy-bias-sweep-final-z-field</rdfs:seeAlso>
