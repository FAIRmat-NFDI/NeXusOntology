  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXvelocity_selector.html#nxvelocity-selector-type-field</rdfs:seeAlso>
</owl:Class>

