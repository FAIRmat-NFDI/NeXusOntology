<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXlab_electro_chemo_mechanical_preparation/ENTRY/GRINDING_STEP/force">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
