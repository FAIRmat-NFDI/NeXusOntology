  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm.html#nxapm-entry-atom-probe-ranging-peak-search-peak-label-field</rdfs:seeAlso>
</owl:Class>

