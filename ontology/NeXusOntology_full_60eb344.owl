  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wavelength spread FWHM of beam leaving this component</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-final-wavelength-spread-field</rdfs:seeAlso>
