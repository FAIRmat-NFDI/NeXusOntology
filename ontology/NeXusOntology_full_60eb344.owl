  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                 Wall-clock time.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-profiling-total-elapsed-time-field</rdfs:seeAlso>
