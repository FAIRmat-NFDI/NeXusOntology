  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcanSAS/ENTRY/INSTRUMENT/DETECTOR/beam_center_x</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Position of the beam center on the detector.
            
            This is the x position where the direct beam would hit the detector plane.
            This is a length and can be outside of the actual
            detector.  The length can be in physical units or pixels
            as documented by the units attribute. The value can be any
            real number (positive, zero, or negative).
          </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-detector-beam-center-x-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXcanSAS/ENTRY/INSTRUMENT/DETECTOR/beam_center_y">
