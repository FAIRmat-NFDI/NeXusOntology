      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXcg_polyline/vertices"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
