  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    The time taken by the scanner to scan the entire area.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXbias_spectroscopy.html#nxbias-spectroscopy-bias-sweep-linear-sweep-scan-time-field</rdfs:seeAlso>
</owl:Class>

