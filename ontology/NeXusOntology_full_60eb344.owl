            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_results.html#nxapm-paraprobe-tool-results-window-bitdepth-field</rdfs:seeAlso>
