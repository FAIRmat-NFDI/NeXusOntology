  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor_scan/ENTRY/NOTE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Any additional information or notes (e.g. purpose of the experiment) that might
                be useful to understand the experiment.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-note-group</rdfs:seeAlso>
</owl:Class>

