<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_nanochem_config/ENTRY/delocalization/reconstruction/checksum">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
