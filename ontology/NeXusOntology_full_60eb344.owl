  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Provide data about the determined accuracy of the device, this may
                        may be a single value or a dataset like wavelength error vs. wavelength etc.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-instrument-calibration-device-calibration-accuracy-group</rdfs:seeAlso>
</owl:Class>

