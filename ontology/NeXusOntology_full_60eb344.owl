  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                An optional free-text description of the experiment. However, details of the
                experiment should be defined in the specific fields of this application
                definition rather than in this experiment description.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXtransmission.html#nxtransmission-entry-experiment-description-field</rdfs:seeAlso>
