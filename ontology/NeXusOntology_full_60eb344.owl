  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-attached-to-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsensor/measurement">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                      <owl:unionOf rdf:parseType="Collection">
                        <owl:Class>
                          <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                              <owl:onProperty rdf:resource="#actualValue"/>
                              <owl:allValuesFrom>
                                <rdfs:Datatype>
                                  <owl:oneOf>
                                    <rdf:Description>
                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature</rdf:first>
                                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                  </owl:oneOf>
                                </rdfs:Datatype>
                              </owl:allValuesFrom>
                            </owl:Restriction>
                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/INSTRUMENT/temperature_sensor/measurement"/>
                          </owl:unionOf>
                        </owl:Class>
                        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/INSTRUMENT/pressure_gauge/measurement"/>
                      </owl:unionOf>
                    </owl:Class>
                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmanipulator/temperature_sensor/measurement"/>
                  </owl:unionOf>
                </owl:Class>
                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmanipulator/drain_current_ammeter/measurement"/>
              </owl:unionOf>
            </owl:Class>
            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmanipulator/sample_bias_voltmeter/measurement"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXinstrument_apm/analysis_chamber/pressure_sensor/measurement"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/measurement</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name for measured signal</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-measurement-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsensor/type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			The type of hardware used for the measurement.  
			Examples (suggestions but not restrictions):
			
			:Temperature:
			  J | K | T | E | R | S | Pt100 | Rh/Fe
			:pH:
			  Hg/Hg2Cl2 | Ag/AgCl | ISFET
			:Ion selective electrode:
			  specify species; e.g. Ca2+
			:Magnetic field:
			  Hall
			:Surface pressure:
			  wilhelmy plate
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-type-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsensor/run_control">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_BOOLEAN"/>
