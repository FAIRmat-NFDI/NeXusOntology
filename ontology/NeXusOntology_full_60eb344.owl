  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXapm_paraprobe_intersector_config/ENTRY/V_V_SPATIAL_CORRELATION/next_set"/>
