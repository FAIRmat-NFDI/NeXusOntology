<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_paraprobe_spatstat_config/ENTRY/SPATIAL_STATISTICS/surface_distance/edge_distance">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_LENGTH"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_paraprobe_spatstat_config/ENTRY/SPATIAL_STATISTICS/surface_distance/edge_distance</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Threshold to define how far an ion has to lay at least from the edge
                        of the dataset so that the ion can act as a source. This means that
                        an ROI is placed at the location of the ion and its neighbors are
                        analyzed how they contribute to the computed statistics.
                        
                        The edge_distance threshold can be combined with the feature_distance threshold. This threshold defines defines up to which distance to a
                        microstructural feature an ROI is placed.
                        
                        The threshold is useful to process the dataset such that ROIs do
                        not protrude out of the dataset as this would add bias.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_spatstat_config.html#nxapm-paraprobe-spatstat-config-entry-spatial-statistics-surface-distance-edge-distance-field</rdfs:seeAlso>
</owl:Class>

