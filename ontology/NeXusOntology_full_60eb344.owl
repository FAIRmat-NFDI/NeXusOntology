  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Radius of the cylinder if all have the same radius.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXcg_cylinder.html#nxcg-cylinder-radius-field</rdfs:seeAlso>
</owl:Class>

