  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The number of oscillations on each scanning point per second.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXscan_control.html#nxscan-control-linear-scan-oscillation-frequency-field</rdfs:seeAlso>
</owl:Class>

