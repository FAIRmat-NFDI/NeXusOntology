  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                     How many triangle sets to consider.
                     Multiple triangle sets can be defined which are
                     composed into one joint triangle set for the analysis.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangle-number-of-triangle-sets-field</rdfs:seeAlso>
</owl:Class>

