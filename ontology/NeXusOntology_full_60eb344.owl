  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Binning i.e. downsampling to each pattern.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem_ebsd.html#nxem-ebsd-indexing-binning-group</rdfs:seeAlso>
</owl:Class>

