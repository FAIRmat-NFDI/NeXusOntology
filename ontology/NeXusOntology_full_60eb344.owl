  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXem.html#nxem-entry-coordinate-system-type-field</rdfs:seeAlso>
</owl:Class>

