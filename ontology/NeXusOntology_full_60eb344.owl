  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    A support field to enable the visualization of each point
                    by an explicit identifier on the interval [0, n_ions - 1].
                    The field can be used to visualize the points as a function
                    of their distance to the triangle set (e.g. via XDMF/Paraview).
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangle-identifier-point-field</rdfs:seeAlso>
