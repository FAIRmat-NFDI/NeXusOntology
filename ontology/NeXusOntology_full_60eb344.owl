<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsensor_scan/ENTRY/definition">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#actualValue"/>
              <owl:allValuesFrom>
                <rdfs:Datatype>
                  <owl:oneOf>
                    <rdf:Description>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor_scan</rdf:first>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </owl:oneOf>
                </rdfs:Datatype>
              </owl:allValuesFrom>
            </owl:Restriction>
            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXiv_temp/ENTRY/definition"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXspm/ENTRY/definition"/>
      </owl:unionOf>
    </owl:Class>
