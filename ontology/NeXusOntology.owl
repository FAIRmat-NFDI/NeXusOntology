  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Type of signal (input signal) the circuit is designed to handle, e.g., analog,
            digital, mixed-signal.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcircuit.html#nxcircuit-signal-type-field</rdfs:seeAlso>
