      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXfresnel_zone_plate/focus_parameters</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	list of polynomial coefficients describing the focal length of the zone plate, in increasing powers of photon energy,
	that describes the focal length of the zone plate (in microns) at an X-ray photon energy (in electron volts).
   </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXfresnel_zone_plate.html#nxfresnel-zone-plate-focus-parameters-field</rdfs:seeAlso>
</owl:Class>

