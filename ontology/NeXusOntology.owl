<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmx/ENTRY/INSTRUMENT/DETECTOR/CHANNELNAME_channel">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Group/NXdetector/CHANNELNAME_channel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/INSTRUMENT/DETECTOR/CHANNELNAME_channel</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Group containing the description and metadata for a single channel from a multi-channel
                            detector.

                            Given an :ref:`NXdata` group linked as part of an NXdetector group that has an axis with
                            named channels (see the example in :ref:`NXdata &lt;/NXdata@default_slice-attribute&gt;`),
                            the NXdetector will have a series of NXdetector_channel groups, one for each channel,
                            named CHANNELNAME_channel.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-channelname-channel-group</rdfs:seeAlso>
</owl:Class>

