      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Attribute/NXdetector_module/default"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
		Geometry and logical description of a detector module. When used, child group to NXdetector.
		
		Many detectors consist of multiple
		smaller modules. Sometimes it is important to know the exact position of such
		modules.
		This is the purpose of this group. It is a child group to NXdetector.

		Note, the pixel size is given as values in the array fast_pixel_direction and slow_pixel_direction.
	</rdfs:comment>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdetector_module</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector_module.html</rdfs:seeAlso>
</owl:Class>

