<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/SAMPLE/situation">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:allValuesFrom>
            <rdfs:Datatype>
              <owl:oneOf>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vacuum</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inert atmosphere</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidizing atmosphere</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reducing atmosphere</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes_arpes/ENTRY/SAMPLE/situation"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXsample/situation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes/ENTRY/SAMPLE/situation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-situation-field</rdfs:seeAlso>
</owl:Class>

