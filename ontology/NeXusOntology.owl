  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            A description of the manipulator.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmanipulator.html#nxmanipulator-description-field</rdfs:seeAlso>
</owl:Class>

