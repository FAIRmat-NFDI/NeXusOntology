      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXapm_reconstruction/reconstructed_positions"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
