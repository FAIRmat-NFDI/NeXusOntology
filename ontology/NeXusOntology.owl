        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXcoordinate_system/depends_on"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmpes_arpes/ENTRY/arpes_geometry/depends_on</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Link to transformations defining an ARPES base coordinate system,
                    which is defined such that the positive z-axis points towards the analyzer entry,
                    and the x-axis lies within the beam/analyzer plane.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes_arpes.html#nxmpes-arpes-entry-arpes-geometry-depends-on-field</rdfs:seeAlso>
</owl:Class>

