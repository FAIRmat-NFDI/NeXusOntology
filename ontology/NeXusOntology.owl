<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsource/probe">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                      <owl:unionOf rdf:parseType="Collection">
                        <owl:Class>
                          <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                              <owl:unionOf rdf:parseType="Collection">
                                <owl:Class>
                                  <owl:unionOf rdf:parseType="Collection">
                                    <owl:Class>
                                      <owl:unionOf rdf:parseType="Collection">
                                        <owl:Class>
                                          <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class>
                                              <owl:unionOf rdf:parseType="Collection">
                                                <owl:Class>
                                                  <owl:unionOf rdf:parseType="Collection">
                                                    <owl:Class>
                                                      <owl:unionOf rdf:parseType="Collection">
                                                        <owl:Class>
                                                          <owl:unionOf rdf:parseType="Collection">
                                                            <owl:Class>
                                                              <owl:unionOf rdf:parseType="Collection">
                                                                <owl:Class>
                                                                  <owl:unionOf rdf:parseType="Collection">
                                                                    <owl:Restriction>
                                                                      <owl:onProperty rdf:resource="#actualValue"/>
                                                                      <owl:allValuesFrom>
                                                                        <rdfs:Datatype>
                                                                          <owl:oneOf>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neutron</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photon</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">x-ray</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muon</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electron</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible light</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positron</rdf:first>
                                                                            <rdf:rest>
                                                                            <rdf:Description>
                                                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proton</rdf:first>
                                                                            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                            </rdf:rest>
                                                                            </rdf:Description>
                                                                          </owl:oneOf>
                                                                        </rdfs:Datatype>
                                                                      </owl:allValuesFrom>
                                                                    </owl:Restriction>
                                                                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXebeam_column/electron_source/probe"/>
                                                                  </owl:unionOf>
                                                                </owl:Class>
                                                                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXfluo/ENTRY/INSTRUMENT/SOURCE/probe"/>
                                                              </owl:unionOf>
                                                            </owl:Class>
                                                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtas/ENTRY/INSTRUMENT/SOURCE/probe"/>
                                                          </owl:unionOf>
                                                        </owl:Class>
                                                        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXarpes/ENTRY/INSTRUMENT/SOURCE/probe"/>
                                                      </owl:unionOf>
                                                    </owl:Class>
                                                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXsastof/ENTRY/instrument/source/probe"/>
                                                  </owl:unionOf>
                                                </owl:Class>
                                                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXiqproc/ENTRY/instrument/SOURCE/probe"/>
                                              </owl:unionOf>
                                            </owl:Class>
                                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtomoproc/ENTRY/INSTRUMENT/SOURCE/probe"/>
                                          </owl:unionOf>
                                        </owl:Class>
