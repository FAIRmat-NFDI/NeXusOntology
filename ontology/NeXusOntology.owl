  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Cryostat for cooling the sample.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/cryostat
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-temperature-env-cryostat-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmpes/ENTRY/SAMPLE/gas_pressure_env">
