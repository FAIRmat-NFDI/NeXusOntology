  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Response of each pixel given a constant input</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector_channel.html#nxdetector-channel-flatfield-field</rdfs:seeAlso>
</owl:Class>

