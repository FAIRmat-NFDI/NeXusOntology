<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Application/NXsqom">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXsqom/ENTRY"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    This is the application definition for S(Q,OM) processed data. 
    
    As this kind of data is in
    general not on a rectangular grid after data reduction, it is stored as Q,E positions plus their
    intensity, table like. It is the task of a possible visualisation program to regrid this data in
    a sensible way.
  </rdfs:comment>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsqom</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXsqom.html</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Application/NXarchive">
