  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Number of scan points in the original mapping.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-indexing-number-of-scan-points-field</rdfs:seeAlso>
</owl:Class>

