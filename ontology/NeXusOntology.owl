<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXenergydispersion/APERTURE">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXaperture"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXenergydispersion/APERTURE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Size, position and shape of a slit in dispersive analyzer, e.g. entrance and
