    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Attribute/NXoptical_spectroscopy/ENTRY/INSTRUMENT/detector_TYPE/raw_data/signal"/>
