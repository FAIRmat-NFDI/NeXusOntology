    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/SAMPLE/thickness_determination</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    If a thickness if given, please specify how this thickness was estimated or
                    determined.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-thickness-determination-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/SAMPLE/layer_structure">
