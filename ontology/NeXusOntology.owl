              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">energy</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmpes/ENTRY/INSTRUMENT/ELECTRONANALYZER/energy_resolution/physical_quantity"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXresolution/physical_quantity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXelectronanalyzer/energy_resolution/physical_quantity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXelectronanalyzer.html#nxelectronanalyzer-energy-resolution-physical-quantity-field</rdfs:seeAlso>
</owl:Class>

