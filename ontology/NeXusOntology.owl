  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Diameter of the waveplate (if the waveplate is circular).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXwaveplate.html#nxwaveplate-diameter-field</rdfs:seeAlso>
</owl:Class>

