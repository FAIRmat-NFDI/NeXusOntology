  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcollectioncolumn"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXelectronanalyzer/COLLECTIONCOLUMN</rdfs:label>
