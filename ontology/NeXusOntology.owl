  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcollectioncolumn.html#nxcollectioncolumn-magnification-field</rdfs:seeAlso>
