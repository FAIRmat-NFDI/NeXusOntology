            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_img.html#nxem-img-image-half-angle-interval-field</rdfs:seeAlso>
</owl:Class>

