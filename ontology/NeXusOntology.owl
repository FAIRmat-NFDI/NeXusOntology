  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_SOLID_ANGLE</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
