                                      </owl:unionOf>
                                    </owl:Class>
                                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXsqom/ENTRY/instrument/SOURCE/probe"/>
                                  </owl:unionOf>
                                </owl:Class>
                                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXxbase/ENTRY/instrument/source/probe"/>
                              </owl:unionOf>
                            </owl:Class>
                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtomophase/ENTRY/instrument/SOURCE/probe"/>
                          </owl:unionOf>
