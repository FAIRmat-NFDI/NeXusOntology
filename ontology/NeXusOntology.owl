      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
         Computational geometry description of a set of (oriented) unit normal vectors.
         
         Store normal vector information as properties of primitives.
         Use only only as a child of an instance of :ref:`NXcg_primitive`
         so that this instance acts as the parent to define a context.
    </rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcg_unit_normal</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_unit_normal.html</rdfs:seeAlso>
