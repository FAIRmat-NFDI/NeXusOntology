  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXnote.html#nxnote-data-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXpinhole/depends_on">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_CHAR"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXpinhole/depends_on</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Points to the path of the last element in the geometry chain that places
			this object in space. 
			When followed through that chain is supposed to end at an element depending
			on "." i.e. the origin of the coordinate system.
			If desired the location of the slit can also be described relative to
			an NXbeam, which will allow a simple description of a non-centred pinhole.

			The reference direction of the pinhole is parallel with the z axis. The reference
			point of the pinhole is its center in the x and y axis. The reference point on the z axis is the
			plane which overlaps the side of the opening of the pin hole pointing towards the source (minus on the z axis).

			.. image:: pinhole/pinhole.png
				:width: 40%

		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXpinhole.html#nxpinhole-depends-on-field</rdfs:seeAlso>
</owl:Class>

