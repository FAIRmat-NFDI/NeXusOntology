  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXstxm/ENTRY/DATA/sample_y</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> List of Y positions on the sample. If scanned through multiple values,
              then an 'axis' attribute will be required to link the field to the appropriate data array dimension.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-sample-y-field</rdfs:seeAlso>
</owl:Class>

