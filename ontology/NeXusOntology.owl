          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXxrot/entry/definition"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXentry/definition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxbase/entry/definition</rdfs:label>
