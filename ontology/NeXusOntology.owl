    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcoordinate_system/y</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Basis unit vector along the second axis which spans the coordinate system.
            This axis is frequently referred to as the y-axis in Euclidean space and
            the j-axis in reciprocal space.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-y-field</rdfs:seeAlso>
</owl:Class>

