  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                General type of the processing unit e.g.
                
                * pu, processing core or hyper-threading core
                * cpu, (multi-)core central processing unit
                * gpu, (multi-)core general purpose processing unit
                * fpga, field programmable gate array
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-type-field</rdfs:seeAlso>
</owl:Class>

