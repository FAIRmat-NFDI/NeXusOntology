  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
        Errors of the flat field correction data.
        The form flatfield_error is deprecated.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector_channel.html#nxdetector-channel-flatfield-errors-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXdetector_channel/pixel_mask_applied">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
