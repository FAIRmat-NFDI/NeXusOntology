  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        A list of weights by how much the intensity of each peak
                        contributes to the intensity of the EDS map.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-process-weight-field</rdfs:seeAlso>
