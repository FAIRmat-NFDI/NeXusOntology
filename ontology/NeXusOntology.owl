<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmx/ENTRY/SAMPLE/TRANSFORMATIONS">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Group/NXcomponent/TRANSFORMATIONS"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/SAMPLE/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        This is the recommended location for sample goniometer
                        and other related axes.

                        This is a requirement to describe for any scan experiment.
                        The reason it is optional is mainly to accommodate XFEL
                        single shot exposures.

                        Use of the depends_on field and the NXtransformations group is
                        strongly recommended.  As noted above this should be an absolute
                        requirement to have for any scan experiment.

                        The reason it is optional is mainly to accommodate XFEL
                        single shot exposures.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-sample-transformations-group</rdfs:seeAlso>
</owl:Class>

