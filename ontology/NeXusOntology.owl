  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Version of HDF (version 4) library used in writing the file</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXroot.html#nxroot-hdf-version-attribute</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXroot/HDF5_Version">
  <rdfs:subClassOf rdf:resource="#NeXusAttribute"/>
