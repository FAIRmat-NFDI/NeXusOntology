    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXgeometry/component_index</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	    Position of the component along the beam path. The sample is at 0, components upstream
	    have negative component_index, components downstream have positive
	    component_index.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXgeometry.html#nxgeometry-component-index-field</rdfs:seeAlso>
</owl:Class>

