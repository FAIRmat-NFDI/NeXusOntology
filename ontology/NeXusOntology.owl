        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXfabrication.html#nxfabrication-model-field</rdfs:seeAlso>
</owl:Class>

