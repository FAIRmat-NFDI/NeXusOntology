  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compensating field coil current in "on" state"</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXflipper.html#nxflipper-comp-current-field</rdfs:seeAlso>
