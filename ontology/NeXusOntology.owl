  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXdetector/description</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name/manufacturer/model/etc. information</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-description-field</rdfs:seeAlso>
</owl:Class>

