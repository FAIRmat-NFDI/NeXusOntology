  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Number of edges for each face.
            
            Each entry represents the total number of edges for that face,
            irrespectively whether edges are shared across faces or not.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_half_edge_data_structure.html#nxcg-half-edge-data-structure-number-of-edges-field</rdfs:seeAlso>
