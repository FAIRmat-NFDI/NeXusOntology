  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                The maximum voltage applied to the reflectron, relative to system ground.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-reflectron-voltage-field</rdfs:seeAlso>
</owl:Class>

