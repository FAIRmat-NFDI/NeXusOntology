<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXmonitor/TRANSFORMATIONS">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXtransformations"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonitor/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This is the group recommended for holding the chain of translation
            and rotation operations necessary to position the component within
            the instrument. The dependency chain may however traverse similar groups in
            other component groups.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-transformations-group</rdfs:seeAlso>
</owl:Class>

