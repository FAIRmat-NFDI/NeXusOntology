    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXroot/HDF5_Version</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Version of HDF5 library used in writing the file.

            Note this attribute is spelled with uppercase "V",
            different than other version attributes.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXroot.html#nxroot-hdf5-version-attribute</rdfs:seeAlso>
</owl:Class>

