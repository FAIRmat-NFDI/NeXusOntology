  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector_channel.html#nxdetector-channel-threshold-energy-field</rdfs:seeAlso>
