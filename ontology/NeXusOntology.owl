                            a primary observation.  If true or not provided, that value of
                            beam_center_derived is assumed to be true.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-beam-center-derived-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmx/ENTRY/INSTRUMENT/DETECTOR/beam_center_x">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_LENGTH"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXdetector/beam_center_x"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/INSTRUMENT/DETECTOR/beam_center_x</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            This is the x position where the direct beam would hit the
                            detector. This is a length and can be outside of the actual
                            detector. The length can be in physical units or pixels as
                            documented by the units attribute.  Normally, this should
                            be derived from the axis chain, but the direct specification
                            may take precedence if it is not a derived quantity.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-beam-center-x-field</rdfs:seeAlso>
</owl:Class>

