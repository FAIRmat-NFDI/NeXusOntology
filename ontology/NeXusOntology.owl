<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsource/target_material">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ta</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">depleted_U</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enriched_U</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hg</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pb</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsource/target_material</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulsed source target material</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-target-material-field</rdfs:seeAlso>
</owl:Class>

