  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                                Position of the peak on the energy axis.
                            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-fit-peakpeak-function-fit-parameters-position-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXxps/ENTRY/FIT/peakPEAK/total_area">
