  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-instrument-energy-resolution-type-field</rdfs:seeAlso>
</owl:Class>

