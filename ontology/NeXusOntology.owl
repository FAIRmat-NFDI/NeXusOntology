<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsample/type">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#actualValue"/>
          <owl:allValuesFrom>
            <rdfs:Datatype>
              <owl:oneOf>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample+can</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">can</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample+buffer</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">buffer</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration sample</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">normalisation sample</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">simulated data</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">none</rdf:first>
                <rdf:rest>
                <rdf:Description>
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample environment</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
                </rdf:rest>
                </rdf:Description>
              </owl:oneOf>
            </rdfs:Datatype>
          </owl:allValuesFrom>
        </owl:Restriction>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXarchive/entry/sample/type"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/type</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-type-field</rdfs:seeAlso>
