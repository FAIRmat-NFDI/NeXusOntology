  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXinstrument/name</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Name of instrument</rdfs:comment>
