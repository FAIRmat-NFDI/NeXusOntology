  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proportion of incident beam sampled by the monitor (0&lt;x&lt;1)</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-sampled-fraction-field</rdfs:seeAlso>
