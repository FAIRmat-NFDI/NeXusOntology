  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXcanSAS/ENTRY/INSTRUMENT/DETECTOR/x_pixel_size</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Size of each detector pixel. If it is scalar all pixels are the same size</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-detector-x-pixel-size-field</rdfs:seeAlso>
