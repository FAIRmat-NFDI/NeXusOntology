                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-drain-current-env-group</rdfs:seeAlso>
