    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsas/ENTRY/MONITOR/preset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preset value for time or monitor.</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXsas.html#nxsas-entry-monitor-preset-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsas/ENTRY/MONITOR/integral">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
