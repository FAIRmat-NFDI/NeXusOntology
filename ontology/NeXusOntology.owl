    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Attribute/NXcanSAS/ENTRY/TRANSMISSION_SPECTRUM/timestamp"/>
