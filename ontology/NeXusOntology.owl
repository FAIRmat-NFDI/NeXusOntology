  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXoptical_window.html#nxoptical-window-material-field</rdfs:seeAlso>
</owl:Class>

