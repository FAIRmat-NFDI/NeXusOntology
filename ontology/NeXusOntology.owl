  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXlog.html#nxlog-cue-timestamp-zero-start-attribute</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Attribute/NXlog/cue_timestamp_zero/scaling_factor">
