  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXibeam_column.html#nxibeam-column-beam-group</rdfs:seeAlso>
</owl:Class>

