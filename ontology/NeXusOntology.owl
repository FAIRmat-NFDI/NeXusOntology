  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Sequence index of note, for placing a sequence of 
            multiple **NXnote** groups in an order.  Starts with 1.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXnote.html#nxnote-sequence-index-field</rdfs:seeAlso>
</owl:Class>

