  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsensor/value_deriv1</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Nominal/average first derivative of value 
			e.g. strain rate 
			- same dimensions as "value" (may be a vector)
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-value-deriv1-field</rdfs:seeAlso>
</owl:Class>

