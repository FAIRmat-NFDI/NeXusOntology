<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXfresnel_zone_plate/fabrication">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#actualValue"/>
      <owl:allValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">etched</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plated</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zone doubled</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">other</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:allValuesFrom>
    </owl:Restriction>
