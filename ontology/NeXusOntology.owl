  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radius of the disk</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdisk_chopper.html#nxdisk-chopper-radius-field</rdfs:seeAlso>
</owl:Class>

