  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Absolute number of pulses starting from the beginning of the experiment.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-pulser-pulse-number-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXapm_instrument/pulser/standing_voltage">
