                    Descriptor representing the image contrast.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-indexing-roi-descriptor-field</rdfs:seeAlso>
</owl:Class>

