  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source operating mode</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsource.html#nxsource-mode-field</rdfs:seeAlso>
