    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm/ENTRY/sample/heat_treatment_quenching_rate_errors</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-sample-heat-treatment-quenching-rate-errors-field</rdfs:seeAlso>
</owl:Class>

