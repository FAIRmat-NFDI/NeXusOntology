  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                A parameter for a fit function.
                This would typically be a variable that
                is optimized in a fit.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXfit_function.html#nxfit-function-fit-parameters-parameter-field</rdfs:seeAlso>
</owl:Class>

