  <rdfs:subClassOf rdf:resource="#NeXusUnitCategory"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_TIME</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				units of time
				</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-time</rdfs:seeAlso>
