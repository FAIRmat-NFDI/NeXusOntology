<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXoptical_spectroscopy/ENTRY/INSTRUMENT/polfilter_TYPE">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
