  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmx/ENTRY/INSTRUMENT/DETECTOR/DETECTOR_MODULE/module_offset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                                Offset of the module in regards to the origin of the detector in an
                                arbitrary direction.
                            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-detector-module-module-offset-field</rdfs:seeAlso>
