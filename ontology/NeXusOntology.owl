  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Dimensionality of the primitives described.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_half_edge_data_structure.html#nxcg-half-edge-data-structure-dimensionality-field</rdfs:seeAlso>
