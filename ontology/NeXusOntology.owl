  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Array of raw information, such as thermocouple voltage</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXlog.html#nxlog-raw-value-field</rdfs:seeAlso>
