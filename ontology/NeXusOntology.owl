  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXwaveplate.html#nxwaveplate-coating-wavelength-range-coating-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXwaveplate/coating/index_of_refraction_coating">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
