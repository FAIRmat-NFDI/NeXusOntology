  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/INSTRUMENT/lateral_focal_point_offset"/>
