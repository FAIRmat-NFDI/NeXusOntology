            <owl:Restriction>
              <owl:onProperty rdf:resource="#actualValue"/>
              <owl:allValuesFrom>
                <rdfs:Datatype>
                  <owl:oneOf>
                    <rdf:Description>
                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtofraw</rdf:first>
                    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </owl:oneOf>
                </rdfs:Datatype>
              </owl:allValuesFrom>
            </owl:Restriction>
            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXdirecttof/entry/definition"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXindirecttof/entry/definition"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXentry/definition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXtofraw/entry/definition</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"> Official NeXus NXDL schema to which this file conforms </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXtofraw.html#nxtofraw-entry-definition-field</rdfs:seeAlso>
