  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
      True when the flat field correction has been applied in the
      electronics, false otherwise.
    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdetector_channel.html#nxdetector-channel-flatfield-applied-field</rdfs:seeAlso>
</owl:Class>

