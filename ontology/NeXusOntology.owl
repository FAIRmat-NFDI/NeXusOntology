    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxps/ENTRY/FIT/peakPEAK/relative_atomic_concentration</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Atomic concentration of the species defined by this peak. This should be a value
                        between 0 and 1.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-fit-peakpeak-relative-atomic-concentration-field</rdfs:seeAlso>
</owl:Class>

