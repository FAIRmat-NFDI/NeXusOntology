  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXcomponent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXoptical_spectroscopy/ENTRY/INSTRUMENT/polfilter_TYPE/filter_mechanism"/>
