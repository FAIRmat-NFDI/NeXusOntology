<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsas/ENTRY/INSTRUMENT/DETECTOR/beam_center_x">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasValueContainer"/>
      <owl:onClass>
        <owl:Class>
          <owl:complementOf rdf:resource="http://purl.org/nexusformat/definitions/DataTypes/NX_FLOAT"/>
        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_LENGTH"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Field/NXdetector/beam_center_x"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsas/ENTRY/INSTRUMENT/DETECTOR/beam_center_x</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This is the x position where the direct beam would hit the detector.
            This is a length, not a pixel position, and can be outside of the
            actual detector.

            It is expected that data reduction will determine beam center from
            the raw data, thus it is not required here.  The instrument can
            provide an initial or nominal value to advise data reduction.
          </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXsas.html#nxsas-entry-instrument-detector-beam-center-x-field</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXsas/ENTRY/INSTRUMENT/DETECTOR/beam_center_y">
