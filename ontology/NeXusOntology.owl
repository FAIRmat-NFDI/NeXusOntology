  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXbeam/final_wavelength</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wavelength on leaving beamline component</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-final-wavelength-field</rdfs:seeAlso>
</owl:Class>

