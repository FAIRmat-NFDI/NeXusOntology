  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXoff_geometry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/OFF_GEOMETRY</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
           This group describes the shape of the sample
          </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-off-geometry-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXsample/TRANSFORMATIONS">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXtransformations"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/TRANSFORMATIONS</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This is the group recommended for holding the chain of translation
            and rotation operations necessary to position the component within
            the instrument. The dependency chain may however traverse similar groups in
            other component groups.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-transformations-group</rdfs:seeAlso>
</owl:Class>

