  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Specify the sample orientation, how is its sample normal oriented
                    relative in the laboratory reference frame, incident beam reference
                    frame.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-sample-orientation-field</rdfs:seeAlso>
</owl:Class>

