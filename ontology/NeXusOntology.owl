  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Generic data which does not fit to the 'NX_FLOAT' fields in NXproces.
                        This can be for example the instrument response function.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-instrument-calibration-device-data-group</rdfs:seeAlso>
</owl:Class>

