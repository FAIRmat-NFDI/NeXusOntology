  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Pre-calibration of an arbitrary device of the instrumental setup, which
                    has the name DEVICE. You can specify here how, at which time by which method
                    the calibration was done. As well the accuracy and a link to the calibration
                    dataset.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-instrument-calibration-device-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXoptical_spectroscopy/ENTRY/INSTRUMENT/instrument_calibration_DEVICE/calibration_accuracy">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Group/NXcalibration/DATA"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXoptical_spectroscopy/ENTRY/INSTRUMENT/instrument_calibration_DEVICE/calibration_accuracy</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        Provide data about the determined accuracy of the device, this may
                        may be a single value or a dataset like wavelength error vs. wavelength etc.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-instrument-calibration-device-calibration-accuracy-group</rdfs:seeAlso>
</owl:Class>

