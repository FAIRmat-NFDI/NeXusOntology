<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Application/NXsas">
  <rdfs:subClassOf rdf:resource="#NeXusApplicationClass"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Group/NXsas/ENTRY"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
    Raw, monochromatic 2-D SAS data with an area detector.

    This is an application definition for raw data (not processed or reduced data)
    from a 2-D small angle scattering instrument collected with a monochromatic
    beam and an area detector. It is meant to be suitable both for neutron SANS
    and X-ray SAXS data.

    It covers all raw data from any monochromatic SAS techniques that
    use an area detector: SAS, WSAS, grazing incidence, GISAS

    It covers all raw data from any SAS techniques that use an area detector and
    a monochromatic beam.
  </rdfs:comment>
  <extends rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXobject</extends>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsas</rdfs:label>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXsas.html</rdfs:seeAlso>
</owl:Class>

