    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_reconstruction/field_of_view</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            The nominal diameter of the specimen ROI which is measured in the
            experiment. The physical specimen cannot be measured completely
            because ions may launch but hit in locations other than the detector.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-field-of-view-field</rdfs:seeAlso>
</owl:Class>

