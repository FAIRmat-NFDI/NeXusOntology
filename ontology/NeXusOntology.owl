  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NX_PULSES</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
				DEPRECATED: see NX_COUNT

				units of clock pulses (alias to `NX_NUMBER`)
			</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/nxdl-types.html#nx-pulses</rdfs:seeAlso>
</owl:Class>

