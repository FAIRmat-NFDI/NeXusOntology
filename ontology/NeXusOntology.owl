    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has"/>
      <owl:onClass rdf:resource="http://purl.org/nexusformat/definitions/Field/NXem_ebsd/indexing/matching_phase_descriptor"/>
