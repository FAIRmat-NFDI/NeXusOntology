  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-wavelength-resolution-group</rdfs:seeAlso>
