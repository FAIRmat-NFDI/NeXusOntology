  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXxeuler/entry/sample/phi</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            This is an array holding the phi rotation of the eulerian
            cradle at each scan point
          </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxeuler.html#nxxeuler-entry-sample-phi-field</rdfs:seeAlso>
