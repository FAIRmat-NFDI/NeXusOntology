<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Field/NXmonitor/mode">
  <rdfs:subClassOf rdf:resource="#NeXusField"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                      <owl:unionOf rdf:parseType="Collection">
                        <owl:Class>
                          <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                              <owl:unionOf rdf:parseType="Collection">
                                <owl:Class>
                                  <owl:unionOf rdf:parseType="Collection">
                                    <owl:Class>
                                      <owl:unionOf rdf:parseType="Collection">
                                        <owl:Class>
                                          <owl:unionOf rdf:parseType="Collection">
                                            <owl:Class>
                                              <owl:unionOf rdf:parseType="Collection">
                                                <owl:Class>
                                                  <owl:unionOf rdf:parseType="Collection">
                                                    <owl:Class>
                                                      <owl:unionOf rdf:parseType="Collection">
                                                        <owl:Restriction>
                                                          <owl:onProperty rdf:resource="#actualValue"/>
                                                          <owl:allValuesFrom>
                                                            <rdfs:Datatype>
                                                              <owl:oneOf>
                                                                <rdf:Description>
                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monitor</rdf:first>
                                                                <rdf:rest>
                                                                <rdf:Description>
                                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">timer</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                </rdf:Description>
                                                                </rdf:rest>
                                                                </rdf:Description>
                                                              </owl:oneOf>
                                                            </rdfs:Datatype>
                                                          </owl:allValuesFrom>
                                                        </owl:Restriction>
                                                        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXfluo/ENTRY/MONITOR/mode"/>
                                                      </owl:unionOf>
                                                    </owl:Class>
                                                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXlauetof/ENTRY/control/mode"/>
                                                  </owl:unionOf>
                                                </owl:Class>
                                                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtas/ENTRY/MONITOR/mode"/>
                                              </owl:unionOf>
                                            </owl:Class>
                                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXsastof/ENTRY/control/mode"/>
                                          </owl:unionOf>
                                        </owl:Class>
                                        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtofnpd/ENTRY/MONITOR/mode"/>
                                      </owl:unionOf>
                                    </owl:Class>
                                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXmonopd/ENTRY/MONITOR/mode"/>
                                  </owl:unionOf>
                                </owl:Class>
                                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtofsingle/ENTRY/MONITOR/mode"/>
                              </owl:unionOf>
                            </owl:Class>
                            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXxbase/ENTRY/control/mode"/>
                          </owl:unionOf>
                        </owl:Class>
                        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXtofraw/ENTRY/MONITOR/mode"/>
                      </owl:unionOf>
                    </owl:Class>
                    <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXxas/ENTRY/MONITOR/mode"/>
                  </owl:unionOf>
                </owl:Class>
                <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXrefscan/ENTRY/control/mode"/>
              </owl:unionOf>
            </owl:Class>
            <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXsas/ENTRY/MONITOR/mode"/>
          </owl:unionOf>
        </owl:Class>
        <rdf:Description rdf:about="http://purl.org/nexusformat/definitions/Field/NXreftof/ENTRY/control/mode"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXmonitor/mode</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Count to a preset value based on either clock time (timer)
            or received monitor counts (monitor).
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-mode-field</rdfs:seeAlso>
</owl:Class>

