  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-fit-peakpeak-function-formula-description-field</rdfs:seeAlso>
</owl:Class>

