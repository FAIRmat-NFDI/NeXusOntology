  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-spatial-filtering-sequence-index-field</rdfs:seeAlso>
