  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Was the component used?
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcomponent.html#nxcomponent-applied-field</rdfs:seeAlso>
</owl:Class>

