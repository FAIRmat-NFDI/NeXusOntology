</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXem_instrument/EBEAM_COLUMN">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXebeam_column"/>
