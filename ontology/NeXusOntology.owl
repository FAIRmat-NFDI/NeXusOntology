  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                    Associated :math:`[e_{min}, e_{max}]` bounds of the energy
                    range for which spectrum counts were accumulated.
                </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-energy-range-field</rdfs:seeAlso>
</owl:Class>

