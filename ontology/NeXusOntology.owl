  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Thickness of a beam entry/exit window on the can (mm) 
			- assumed same for entry and exit
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-path-length-window-field</rdfs:seeAlso>
</owl:Class>

