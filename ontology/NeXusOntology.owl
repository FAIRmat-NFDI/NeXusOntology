  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Number of faces of the primitives.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_face_list_data_structure.html#nxcg-face-list-data-structure-number-of-faces-field</rdfs:seeAlso>
