        </owl:Class>
      </owl:onClass>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasUnitContainer"/>
      <owl:someValuesFrom rdf:resource="http://purl.org/nexusformat/definitions/Units/NX_ANY"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm/ENTRY/atom_probeID/ranging/background_quantification/mrp_mass_to_charge</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                            Mass-to-charge state ratio :math:`\frac{m}{n}` at which mrp_value was specified.
                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-ranging-background-quantification-mrp-mass-to-charge-field</rdfs:seeAlso>
</owl:Class>

