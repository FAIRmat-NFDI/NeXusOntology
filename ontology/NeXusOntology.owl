  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                        A list of :ref:`NXpeak` instance names whose X-ray quanta were
                        accumulated for each pixel to obtain an element-specific
                        EDS map.
                    </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-process-peak-field</rdfs:seeAlso>
</owl:Class>

