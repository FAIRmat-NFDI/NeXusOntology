  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Current necessary to keep the extractor lens at a set voltage. Variations
            indicate leakage, field emission or arc currents to the extractor lens.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcollectioncolumn.html#nxcollectioncolumn-extractor-current-field</rdfs:seeAlso>
</owl:Class>

