  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/BaseClass/NXprogram"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_reconstruction/naive_discretization/PROGRAM</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-naive-discretization-program-group</rdfs:seeAlso>
</owl:Class>

<owl:Class rdf:about="http://purl.org/nexusformat/definitions/Group/NXapm_reconstruction/naive_discretization/DATA">
  <rdfs:subClassOf rdf:resource="#NeXusGroup"/>
  <rdfs:subClassOf rdf:resource="http://purl.org/nexusformat/definitions/Group/NXprocess/DATA"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXapm_reconstruction/naive_discretization/DATA</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
                Visual overview of the reconstructed dataset via a three-dimensional
                histogram of ion counts. Ion counts are characterized using one nanometer
                cubic bins without applying any smoothening of reconstructed positions
                during the histogram computation.
                
                Such preview is useful to get an impression of the macroscopic shape of the
                reconstructed volume. Visualizing by ion counts highlights density variations
                the reconstructed volume that are signatures of features such as poles,
                interfaces or irregularities of the specimen shape.
            </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-naive-discretization-data-group</rdfs:seeAlso>
</owl:Class>

