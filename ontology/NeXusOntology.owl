        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcs_profiling_event.html#nxcs-profiling-event-max-resident-memory-snapshot-field</rdfs:seeAlso>
