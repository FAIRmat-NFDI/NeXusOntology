  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-efficiency-field</rdfs:seeAlso>
</owl:Class>

