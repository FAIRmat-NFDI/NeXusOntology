                        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-ranging-background-quantification-mrp-flight-path-length-field</rdfs:seeAlso>
</owl:Class>

