  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXdisk_chopper.html#nxdisk-chopper-rotation-speed-field</rdfs:seeAlso>
