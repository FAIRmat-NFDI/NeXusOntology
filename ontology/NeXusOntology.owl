		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-value-deriv1-field</rdfs:seeAlso>
