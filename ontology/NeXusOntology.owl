  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NXsample/x_translation</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
			Translation of the sample along the X-direction of the laboratory coordinate system
			Note, it is recommended to use NXtransformations instead.
		</rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXsample.html#nxsample-x-translation-field</rdfs:seeAlso>
