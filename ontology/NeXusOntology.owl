  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
             Radii of the upper circular cap.
             
             This field, combined with upper_cap_radius can be used to describe
             (eventually truncated) circular cones.
        </rdfs:comment>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://manual.nexusformat.org/classes/base_classes/NXcg_cylinder.html#nxcg-cylinder-lower-cap-radii-field</rdfs:seeAlso>
</owl:Class>

