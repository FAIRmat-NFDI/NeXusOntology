                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-named-reference-frameid-y-direction-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
