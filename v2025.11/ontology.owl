        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-x-alias-field"/>
        <rdfs:label>NXcoordinate_system/x_alias</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-x-alias-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcoordinate-system-x-direction-field -->


