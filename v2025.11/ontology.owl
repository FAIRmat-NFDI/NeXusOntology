    <!-- https://w3id.org/PaN/NeXus/definitions#nxcg-half-edge-data-structure-weinberg-vector-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-half-edge-data-structure-weinberg-vector-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Users are referred to the literature for the background of L. Weinberg&apos;s
            work about topological characterization of planar graphs:
            
            * `L. Weinberg 1966a, &lt;https://dx.doi.org/10.1109/TCT.1964.1082216&gt;`_
            * `L. Weinberg, 1966b, &lt;https://dx.doi.org/10.1137/0114062&gt;`_
            * `E. A. Lazar et al. &lt;https://doi.org/10.1103/PhysRevLett.109.095505&gt;`_
            
            and how this work can e.g. be applied in space-filling tessellations
            of microstructural objects like crystals/grains.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_half_edge_data_structure.html#nxcg-half-edge-data-structure-weinberg-vector-field"/>
        <rdfs:label>NXcg_half_edge_data_structure/weinberg_vector</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_half_edge_data_structure.html#nxcg-half-edge-data-structure-weinberg-vector-field"/>
    </owl:Class>
    


