    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-kernel-size-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-kernel-size-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_DIMENSIONLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_POSINT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
