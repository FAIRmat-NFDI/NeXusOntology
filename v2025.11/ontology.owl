    <!-- https://w3id.org/PaN/NeXus/definitions#nxcg-triangle-triangleid-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-triangle-triangleid-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXcg_face_list_data_structure"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:comment>
            Individual storage of each triangle.
            Users are advised that using such individual storage of primitives
            may be less storage efficient than creating a combined storage.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html#nxcg-triangle-triangleid-group"/>
        <rdfs:label>NXcg_triangle/triangleID</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html#nxcg-triangle-triangleid-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcg-triangle-triangles-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-triangle-triangles-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXcg_face_list_data_structure"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:comment>
            Combined storage of all primitives of all triangles.
            
            This description resembles the typical representation of primitives
            in file formats such as OFF, PLY, VTK, or STL.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_triangle.html#nxcg-triangle-triangles-group"/>
