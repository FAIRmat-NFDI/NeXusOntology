                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                                    Array of edge length values. For each triangle the edge length
                                    is reported for the edges traversed according to the sequence
                                    in which vertices are indexed in triangles.
                                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-iso-surfaceid-triangle-soup-triangles-edge-length-field"/>
        <rdfs:label>NXapm_paraprobe_nanochem_results/ENTRY/delocalizationID/grid/iso_surfaceID/triangle_soup/triangles/edge_length</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-iso-surfaceid-triangle-soup-triangles-edge-length-field"/>
    </owl:Class>
    


