                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxdispersion-function-energy-unit-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
