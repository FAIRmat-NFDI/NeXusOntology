        <rdfs:label>NXatom/position/depends_on</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXatom.html#nxatom-position-depends-on-attribute"/>
    </owl:Class>
    


