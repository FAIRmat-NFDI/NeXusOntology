                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Free-text field to give a term how that a stage_lab at this level of the
                stage_lab hierarchy is commonly referred to. Examples could be stub,
                puck, carousel, microtip, clip, holder, etc.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-stageid-alias-field"/>
        <rdfs:label>NXem_instrument/stageID/alias</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-stageid-alias-field"/>
