        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_computer.html#nxcs-computer-name-field"/>
        <rdfs:label>NXcs_computer/name</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_computer.html#nxcs-computer-name-field"/>
    </owl:Class>
    


