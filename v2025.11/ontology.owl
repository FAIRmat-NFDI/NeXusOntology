        <rdfs:label>NXdetector/sequence_number</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-sequence-number-field"/>
    </owl:Class>
    


