    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxfit-backgroundbackground-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxfit-backgroundbackground-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXpeak"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:comment>
            One fitted background (functional form, position (see :ref:`data/input_independent &lt;/NXfit/data/input_independent-field&gt;`),
            and intensities) of the peak fit.
            If there is no characteristic name for each background component, it is envisioned that backgrounds are labeled
            as background_0, background_1, and so on.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXfit.html#nxfit-backgroundbackground-group"/>
        <rdfs:label>NXfit/backgroundBACKGROUND</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXfit.html#nxfit-backgroundbackground-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxfit-data-fit-sum-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxfit-data-fit-sum-field">
