                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Three values that define the location of a point through which the beam passes
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-transformations-beamdirection-offset-attribute"/>
        <rdfs:label>NXbeam/TRANSFORMATIONS/BEAMdirection/offset</rdfs:label>
