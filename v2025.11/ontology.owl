                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Clock speed of the circuit
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-clock-speed-field"/>
        <rdfs:label>NXcs_processor/CIRCUIT/clock_speed</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-clock-speed-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXcircuit"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-clock-speed-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-type-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Typical examples for the granularization of processing units are:
            
            * A desktop computer with a single CPU; describe using one instance of NXcircuit.
            * A dual-socket server; describe using two instances of NXcircuit.
            * A server with two dual-socket server nodes; describe with four
              instances of NXcircuit surplus a field that defines their level
              in the hierarchy.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-group"/>
        <rdfs:label>NXcs_processor/CIRCUIT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-type-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcs-processor-circuit-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                General type of the processing unit e.g.
                
                * pu, processing core or hyper-threading core
                * cpu, (multi-)core central processing unit
                * gpu, (multi-)core general purpose processing unit
                * fpga, field programmable gate array
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-type-field"/>
        <rdfs:label>NXcs_processor/CIRCUIT/type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_processor.html#nxcs-processor-circuit-type-field"/>
    </owl:Class>
    


