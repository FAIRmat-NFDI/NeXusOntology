            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>This is a application definition for raw data from a direct geometry TOF spectrometer</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXdirecttof.html"/>
        <rdfs:label>NXdirecttof</rdfs:label>
