    <!-- https://w3id.org/PaN/NeXus/definitions#nxmonitor-count-time-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmonitor-count-time-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_TIME"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Elapsed actual counting time, can be an array of size ``np``
            when scanning. This is not the difference of the calendar time
            but the time the instrument was really counting, without
            pauses or times lost due beam unavailability
	    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-count-time-field"/>
        <rdfs:label>NXmonitor/count_time</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-count-time-field"/>
    </owl:Class>
    


