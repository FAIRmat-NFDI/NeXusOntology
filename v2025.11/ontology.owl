        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxenvironment-actuator-group"/>
        <rdfs:comment>
                        Actuator applying a voltage to sample and sample holder.
                        
                        In most cases, this can be a link to /entry/instrument/manipulator/sample_bias_potentiostat
                        if a manipulator is present in the instrument.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-bias-env-potentiostat-group"/>
