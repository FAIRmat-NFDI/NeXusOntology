    <!-- https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-channel-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-d-spacing-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-energy-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-momentum-transfer-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-time-of-flight-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-peaks-center-type-two-theta-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        The space in which :ref:`center &lt;/NXstress/ENTRY/peaks/center-field&gt;` is defined.
                        It defines the *c_Unit* as follows

                            - if *center_type=&quot;two-theta&quot;* then *c_Unit* must have the angle unit *degrees*
                            - if *center_type=&quot;energy&quot;* then *c_Unit* must have the unit *keV*
                            - if *center_type=&quot;momentum-transfer&quot;* then *c_Unit* must have the unit \ :math:`Å^{-1}`
                            - if *center_type=&quot;d-spacing&quot;* then *c_Unit* must have the unit \ :math:`Å`
                            - if *center_type=&quot;channel&quot;* then *c_Unit* must be *dimensioness*
                            - if *center_type=&quot;time-of-flight&quot;* then *c_Unit* must have the unit \ :math:`\mu\mathrm{s}`
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-peaks-center-type-field"/>
        <rdfs:label>NXstress/ENTRY/peaks/center_type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-peaks-center-type-field"/>
    </owl:Class>
    


