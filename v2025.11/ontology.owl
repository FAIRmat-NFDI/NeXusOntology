        <rdfs:comment>
            Position of the beam center on the detector.
            
            This is the y position where the direct beam would hit the detector plane.
            This is a length and can be outside of the actual
            detector.  The length can be in physical units or pixels
            as documented by the units attribute. The value can be any
            real number (positive, zero, or negative).
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-detector-beam-center-y-field"/>
        <rdfs:label>NXcanSAS/ENTRY/INSTRUMENT/DETECTOR/beam_center_y</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-detector-beam-center-y-field"/>
    </owl:Class>
    


