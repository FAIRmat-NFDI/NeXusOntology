        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_grid.html#nxcg-grid-cell-dimensions-field"/>
        <rdfs:label>NXcg_grid/cell_dimensions</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_grid.html#nxcg-grid-cell-dimensions-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcg-grid-coordinate-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-grid-coordinate-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
