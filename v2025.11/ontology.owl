    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-default-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-skin-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Specifies for which point the tool will compute distances.
                    
                    The value *default* configures that distances are computed for all points.
                    The value *skin* configures that distances are computed only for those
                    points which are not farther away located to a triangle than
                    threshold_distance.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field"/>
        <rdfs:label>NXapm_paraprobe_distancer_config/ENTRY/point_to_triangleID/method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_config.html#nxapm-paraprobe-distancer-config-entry-point-to-triangleid-method-field"/>
    </owl:Class>
    


