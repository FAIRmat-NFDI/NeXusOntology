                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        The source that emitted this beam.
                        Should be named with the same suffix, e.g.,
                        for ``beam_pump`` it should refer to ``source_pump``.
                        This should be specified if an associated source exists.
                        
                        Example:
                          * /entry/instrument/beam_pump/associated_source = /entry/instrument/source_pump
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-instrument-beam-pump-associated-source-field"/>
