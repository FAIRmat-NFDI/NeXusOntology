                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                True, if the triple line makes contact with the edge of the ROI.
                False, if the triple line does not make contact with the edge of the ROI.
            </rdfs:comment>
