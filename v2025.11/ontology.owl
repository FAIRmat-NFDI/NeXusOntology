    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-ion-query-nuclide-source-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-ion-query-nuclide-source-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Matrix of isotope vectors, as many as rows as different candidates
                    for iontypes should be distinguished as possible source iontypes.
                    In the simplest case, the matrix contains only the proton number
                    of the element in the row, all other values set to zero.
                    Combined with ion_query_type_source set to resolve_element this will
                    recover usual spatial correlation statistics like the 1NN C-C
                    spatial statistics.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_spatstat_config.html#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-ion-query-nuclide-source-field"/>
        <rdfs:label>NXapm_paraprobe_spatstat_config/ENTRY/spatial_statisticsID/ion_query_nuclide_source</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_spatstat_config.html#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-ion-query-nuclide-source-field"/>
    </owl:Class>
    


