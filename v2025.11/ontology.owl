                The lower (left-hand side) inclusive bound of the interval :math:`[{\frac{m}{q}}_{min}`, {\frac{m}{q}}_{max}]`.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_ranging.html#nxapm-ranging-mass-to-charge-distribution-min-mass-to-charge-field"/>
        <rdfs:label>NXapm_ranging/mass_to_charge_distribution/min_mass_to_charge</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_ranging.html#nxapm-ranging-mass-to-charge-distribution-min-mass-to-charge-field"/>
    </owl:Class>
    


