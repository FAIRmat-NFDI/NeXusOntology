            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                                (Un)calibrated temperature axis in case of experiments where the temperature was
                                scanned. This is typically the sample temperature and could be linked from
                                /entry/sample/temperature_env/temperature_sensor/value.
                            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-instrument-electronanalyzer-electron-detector-raw-data-temperature-field"/>
        <rdfs:label>NXmpes/ENTRY/INSTRUMENT/ELECTRONANALYZER/ELECTRON_DETECTOR/raw_data/temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-instrument-electronanalyzer-electron-detector-raw-data-temperature-field"/>
    </owl:Class>
    


