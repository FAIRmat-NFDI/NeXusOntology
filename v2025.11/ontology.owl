                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Comma-separated list of chemical_symbol-IUPAC X-ray (emission) line name that
                    documents which elements and their specific lines are theoretically located within
                    the energy_range of the spectrum from which the EDS (element) map was computed.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-iupac-line-candidates-field"/>
        <rdfs:label>NXem_eds/indexing/ELEMENT_SPECIFIC_MAP/iupac_line_candidates</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_eds.html#nxem-eds-indexing-element-specific-map-iupac-line-candidates-field"/>
    </owl:Class>
    


