    <!-- https://w3id.org/PaN/NeXus/definitions#NX_INT -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_INT">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
