    <!-- https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-dichroic-mirror-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-dielectric-mirror-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-fiber-optic-splitter-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-glan-thompson-prism-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-metal-coated-mirror-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-splitter-type-nicol-prism-enum"/>
