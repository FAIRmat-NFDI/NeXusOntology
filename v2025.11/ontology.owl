        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcomponent-transformations-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcxi-ptycho-sample-1-transformations-vector-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
					This must contain two fields with the x and y motors that are linked via the 
					dependency tree according to the real-life motor layout dependency.
					For raster scans x and y will have shape (npts_x, npts_y)
					For arbitrary scans x and y will be (npts_x*npts_y,)
					An attribute with the units for each motor is required.					
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-sample-1-transformations-group"/>
        <rdfs:label>NXcxi_ptycho/sample_1/transformations</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-sample-1-transformations-group"/>
    </owl:Class>
    


