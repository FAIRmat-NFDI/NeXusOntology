    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tool-common-status-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tool-common-status-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tool-common-status-failure-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tool-common-status-success-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            A statement whether the tool executable managed to process the analysis
            or whether this failed. Status is written to the results file after the
            end_time beyond which point in time the tool must no longer compute
            any further analysis results but exit.
            
            Only when this status message is present and its value is `success`,
            one should consider the results of the tool. In all other cases it might
            be that the tool has terminated prematurely or another error occurred.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-status-field"/>
        <rdfs:label>NXapm_paraprobe_tool_common/status</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tool_common.html#nxapm-paraprobe-tool-common-status-field"/>
    </owl:Class>
    


