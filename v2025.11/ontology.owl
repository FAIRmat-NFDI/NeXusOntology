    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-user-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-user-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxentry-user-group"/>
        <rdfs:comment>
                Contact information and eventually details of at persons who
                performed the measurements. This can be for example the principal
                investigator or student. Examples are: name, affiliation, address, telephone
                number, email, role as well as identifiers such as orcid or similar.
                It is recommended to add multiple users if relevant.
                
                Due to data privacy concerns, there is no minimum requirement.
                If no user with specific name is allowed to be given, it is required to
                assign at least an affiliation
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-user-group"/>
        <rdfs:label>NXoptical_spectroscopy/ENTRY/USER</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-user-group"/>
    </owl:Class>
    


