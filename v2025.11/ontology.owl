        <rdfs:label>NXmpes/ENTRY/transmission_correction/transmission_function/kinetic_energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-kinetic-energy-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-relative-intensity-field -->


