        <rdfs:label>NXcanSAS/ENTRY/DATA/Q/units/1/m</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-data-q-units-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-q-units-1-nm-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-q-units-1-nm-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
