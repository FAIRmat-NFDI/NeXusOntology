                            hierarchical groupings of detectors.
                        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-group-group-names-field"/>
        <rdfs:label>NXmx/ENTRY/INSTRUMENT/DETECTOR_GROUP/group_names</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-group-group-names-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmx-entry-instrument-detector-group-group-parent-field -->


