                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Spectral values (e.g. wavelength or energy) used for the measurement.
                    An array of 1 or more elements. Length defines N_spectrum. Replace
                    &apos;NAME&apos; by the physical quantity that is used, e.g. wavelength.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXellipsometry.html#nxellipsometry-entry-data-collection-name-spectrum-field"/>
        <rdfs:label>NXellipsometry/ENTRY/data_collection/NAME_spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXellipsometry.html#nxellipsometry-entry-data-collection-name-spectrum-field"/>
    </owl:Class>
    


