      </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_primitive.html#nxcg-primitive-is-mesh-field"/>
        <rdfs:label>NXcg_primitive/is_mesh</rdfs:label>
