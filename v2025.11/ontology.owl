        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam_transfer_matrix_table.html#nxbeam-transfer-matrix-table-transfer-matrix-output-attribute"/>
        <rdfs:label>NXbeam_transfer_matrix_table/TRANSFER_MATRIX/output</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam_transfer_matrix_table.html#nxbeam-transfer-matrix-table-transfer-matrix-output-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxbeam-transformations-beamdirection-depends-on-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-transformations-beamdirection-depends-on-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxtransformations-axisname-depends-on-attribute"/>
