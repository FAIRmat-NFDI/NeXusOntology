    <!-- https://w3id.org/PaN/NeXus/definitions#nxpump-medium-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-gas-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-liquid-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-powder-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-slurry-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpump-medium-vacuum-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            The material being moved by the pump.
            
            Pumps intending to create a vacuum should state &quot;vacuum&quot; as the medium,
            while pumps having the primary purpose of creating a flow or pressure
            of gas should state &quot;gas&quot; as the medium.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXpump.html#nxpump-medium-field"/>
        <rdfs:label>NXpump/medium</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXpump.html#nxpump-medium-field"/>
    </owl:Class>
    


