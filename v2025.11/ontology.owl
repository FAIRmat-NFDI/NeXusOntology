                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-mtex-config-plotting-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-mtex-config-system-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
        Base class to store the configuration when using the MTex/Matlab software.
        
        MTex is a Matlab package for texture analysis used in the Materials and Earth Sciences.
        See `R. Hielscher et al. &lt;https://mtex-toolbox.github.io/publications&gt;`_ and
        the `MTex source code &lt;https://github.com/mtex-toolbox&gt;`_ for details.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_mtex_config.html"/>
