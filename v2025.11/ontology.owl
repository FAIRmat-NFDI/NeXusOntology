        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXdetector_channel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:comment>
          Group containing the description and metadata for a single channel from a multi-channel
          detector.

          Given an :ref:`NXdata` group linked as part of an NXdetector group that has an axis with
          named channels (see the example in :ref:`NXdata &lt;/NXdata@default_slice-attribute&gt;`),
          the NXdetector will have a series of NXdetector_channel groups, one for each channel,
          named CHANNELNAME_channel.
      </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-channelname-channel-group"/>
        <rdfs:label>NXdetector/CHANNELNAME_channel</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdetector.html#nxdetector-channelname-channel-group"/>
    </owl:Class>
    


