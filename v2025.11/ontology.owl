        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXelectromagnetic_lens.html#nxelectromagnetic-lens-description-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxelectromagnetic-lens-mode-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxelectromagnetic-lens-mode-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Descriptor for the operation mode of the lens when other details are not
            directly controllable as the control software of the microscope
            does not enable or is not configured to display these values.
            
            Like value, the mode can only be interpreted for a specific microscope
            but can still be useful to guide users as to how to repeat the measurement.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXelectromagnetic_lens.html#nxelectromagnetic-lens-mode-field"/>
        <rdfs:label>NXelectromagnetic_lens/mode</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXelectromagnetic_lens.html#nxelectromagnetic-lens-mode-field"/>
    </owl:Class>
    


