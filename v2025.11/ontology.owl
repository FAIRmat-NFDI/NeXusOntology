                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-beam-type-linear-beam-sample-polarization-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
