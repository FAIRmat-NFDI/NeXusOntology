                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-instrument-beam-intensity-profile-secondary-horizontal-sample-width-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
