            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_ranging.html#nxapm-ranging-mass-to-charge-distribution-n-mass-to-charge-field"/>
