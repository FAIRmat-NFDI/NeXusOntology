    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-clusterer-config-entry-cameca-to-nexus-recover-evaporation-id-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-clusterer-config-entry-cameca-to-nexus-recover-evaporation-id-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Specifies if paraprobe-clusterer should use the evaporation_ids from reconstruction
                    for recovering for each position in the :ref:`NXnote` results the closest matching position
                    (within floating point accuracy). This can be useful when users wish to recover the
                    original evaporation_id, which IVAS /AP Suite drops when writing their *.indexed.* cluster
                    results POS files that is referred to results.
                </rdfs:comment>
