    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-aborted-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-aborted-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>aborted</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-success-enum"/>
        <rdfs:comment>Enumeration item for NXapm_measurement/status: aborted</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_measurement.html#nxapm-measurement-status-field"/>
        <rdfs:label>NXapm_measurement/status/aborted</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_measurement.html#nxapm-measurement-status-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-aborted-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-measurement-status-success-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            A statement whether the measurement completed successfully, or was aborted.
        </rdfs:comment>
