                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
             The relevant dimension for the aperture, i.e. slit width, pinhole and iris
             diameter
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXaperture.html#nxaperture-size-field"/>
