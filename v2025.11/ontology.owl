    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-dbscan-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-clusterer-config-entry-cluster-analysisid-dbscan-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXprocess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
