                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Name of that (parent) node whose child stores the ranging definitions that
                    are applied in this analysis with CompositionSpace.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-ranging-ranging-definitions-field"/>
