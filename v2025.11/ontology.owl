                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Point coordinate along the fast dimension.
                
                Different NeXus Unit Category are allowed:
                
                * NX_LENGTH for images slicing real space.
                * NX_WAVENUMBER or NX_UNITLESS respectively
                  for images slicing reciprocal space.
            </rdfs:comment>
