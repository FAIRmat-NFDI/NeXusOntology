    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-calorimetry-entry-synchronization-start-time-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-calorimetry-entry-synchronization-start-time-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_DATE_TIME"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_DATE_TIME"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    ISO8601 with local time zone reference timestamp that tells
                    with which delta_time can be converted in timestamp.
                    The reference timestamp is defined as the time when the
                    actuator started acting on the sample.
                    
                    Time differences to this timestamp when correlated signals such
                    as diffraction pattern matching with a specific state of  the sample
                    (e.g. obtained temperature via the actuator) are reported through
                    delta_time.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXem_calorimetry.html#nxem-calorimetry-entry-synchronization-start-time-field"/>
        <rdfs:label>NXem_calorimetry/ENTRY/synchronization/start_time</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXem_calorimetry.html#nxem-calorimetry-entry-synchronization-start-time-field"/>
    </owl:Class>
    


