        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				for fields that don&apos;t have a unit (e.g. hkl) so that they don&apos;t
				inherit the wrong units (NOTE: not the same as NX_DIMENSIONLESS)
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-unitless"/>
        <rdfs:label>NX_UNITLESS</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-unitless"/>
    </owl:Class>
    


