                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsample-beam-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
