                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-odf-phi-two-plot-intensity-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-odf-phi-two-plot-varphi-one-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-odf-phi-two-plot-varphi-two-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Visualization of the ODF intensity as discretized orthogonal sections through
            orientation space parameterized using Bunge-Euler angles.
            
            This is one example of typical default plots used in the texture community in materials engineering.
            
            Mind that the orientation space is a distorted space when it using an Euler angle parameterization.
            Therefore, equivalent orientations show intensity contributions in eventually multiple locations.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_odf.html#nxmicrostructure-odf-phi-two-plot-group"/>
        <rdfs:label>NXmicrostructure_odf/phi_two_plot</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_odf.html#nxmicrostructure-odf-phi-two-plot-group"/>
    </owl:Class>
    


