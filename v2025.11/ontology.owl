                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcrystal-unit-cell-volume-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcrystal-usage-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcrystal-wavelength-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
    A crystal monochromator or analyzer. 
    
    Permits double bent
    monochromator comprised of multiple segments with anisotropic 
    Gaussian mosaic.
    
    If curvatures are set to zero or are absent, array 
    is considered to be flat.
    
    Scattering vector is perpendicular to surface. Crystal is oriented
    parallel to beam incident on crystal before rotation, and lies in
    vertical plane.
  </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcrystal.html"/>
        <rdfs:label>NXcrystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcrystal.html"/>
        <extends>NXcomponent</extends>
    </owl:Class>
    


