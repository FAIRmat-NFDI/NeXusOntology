                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXevent_data.html#nxevent-data-cue-timestamp-zero-start-attribute"/>
        <rdfs:label>NXevent_data/cue_timestamp_zero/start</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXevent_data.html#nxevent-data-cue-timestamp-zero-start-attribute"/>
