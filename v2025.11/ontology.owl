        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_results.html#nxapm-paraprobe-intersector-results-entry-v-v-spatial-correlationid-coprecipitation-analysis-next-set-feature-to-cluster-field"/>
