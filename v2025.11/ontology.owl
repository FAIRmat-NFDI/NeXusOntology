                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                            The gain setting of the detector. This influences
                            background. This is a detector-specific value meant
                            to document the gain setting of the detector during
                            data collection, for detectors with multiple
                            available gain settings.

                            Examples of gain settings include:

                            * ``standard``
                            * ``fast``
                            * ``auto``
                            * ``high``
                            * ``medium``
                            * ``low``
                            * ``mixed high to medium``
                            * ``mixed medium to low``

                            Developers are encouraged to use one of these terms, or to submit
                            additional terms to add to the list.
                        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-gain-setting-field"/>
        <rdfs:label>NXmx/ENTRY/INSTRUMENT/DETECTOR/gain_setting</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-gain-setting-field"/>
    </owl:Class>
    


