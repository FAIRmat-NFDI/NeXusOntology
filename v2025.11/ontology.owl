        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxinsertion-device-type-undulator-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxinsertion-device-type-wavelength-shifter-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxinsertion-device-type-wiggler-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>It is recommended (effective from 2025) to use the &quot;wavelength_shifter&quot; choice for 3-pole wigglers, while reserving the generic &quot;wiggler&quot; designation for extended multipole wigglers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXinsertion_device.html#nxinsertion-device-type-field"/>
        <rdfs:label>NXinsertion_device/type</rdfs:label>
