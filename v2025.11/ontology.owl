    <!-- https://w3id.org/PaN/NeXus/definitions#nxmonitor-mode-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmonitor-mode-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxbase-entry-control-mode-field"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-monitor-mode-field"/>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxtofsingle-entry-monitor-mode-field"/>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxtofraw-entry-monitor-mode-field"/>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxtofnpd-entry-monitor-mode-field"/>
                                                    <owl:Class>
                                                        <owl:unionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxtas-entry-monitor-mode-field"/>
                                                            <owl:Class>
                                                                <owl:unionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsastof-entry-control-mode-field"/>
                                                                    <owl:Class>
                                                                        <owl:unionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsas-entry-monitor-mode-field"/>
                                                                            <owl:Class>
                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxreftof-entry-control-mode-field"/>
                                                                                    <owl:Class>
                                                                                        <owl:unionOf rdf:parseType="Collection">
                                                                                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxrefscan-entry-control-mode-field"/>
                                                                                            <owl:Class>
                                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmonopd-entry-monitor-mode-field"/>
                                                                                                    <owl:Class>
                                                                                                        <owl:unionOf rdf:parseType="Collection">
                                                                                                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxlauetof-entry-control-mode-field"/>
                                                                                                            <owl:Class>
                                                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxfluo-entry-monitor-mode-field"/>
                                                                                                                    <owl:Restriction>
                                                                                                                        <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                                                                                                                        <owl:allValuesFrom>
                                                                                                                            <owl:Class>
                                                                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmonitor-mode-monitor-enum"/>
                                                                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmonitor-mode-timer-enum"/>
                                                                                                                                </owl:unionOf>
                                                                                                                            </owl:Class>
                                                                                                                        </owl:allValuesFrom>
                                                                                                                    </owl:Restriction>
                                                                                                                </owl:unionOf>
                                                                                                            </owl:Class>
                                                                                                        </owl:unionOf>
                                                                                                    </owl:Class>
                                                                                                </owl:unionOf>
                                                                                            </owl:Class>
                                                                                        </owl:unionOf>
                                                                                    </owl:Class>
                                                                                </owl:unionOf>
                                                                            </owl:Class>
                                                                        </owl:unionOf>
                                                                    </owl:Class>
                                                                </owl:unionOf>
                                                            </owl:Class>
                                                        </owl:unionOf>
                                                    </owl:Class>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>
            Count to a preset value based on either clock time (timer)
            or received monitor counts (monitor).
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-mode-field"/>
        <rdfs:label>NXmonitor/mode</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXmonitor.html#nxmonitor-mode-field"/>
    </owl:Class>
    


