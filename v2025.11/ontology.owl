        <rdfs:label>NXcoordinate_system/TRANSFORMATIONS</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-transformations-group"/>
    </owl:Class>
    


