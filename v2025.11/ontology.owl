        <rdfs:comment>Any valid character string or NeXus number representation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-char-or-number"/>
        <rdfs:label>NX_CHAR_OR_NUMBER</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-char-or-number"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_COMPLEX -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_COMPLEX">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:comment>
				Compound type representation of complex numbers (either
				cartesian or polar form) in NeXus.
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-complex"/>
        <rdfs:label>NX_COMPLEX</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-complex"/>
    </owl:Class>
    


