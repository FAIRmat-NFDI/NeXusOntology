            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Device that causes a change in the phase of an electron wave.
            
            * `M. Malac et al. &lt;https://doi.org/10.1093/jmicro/dfaa070&gt;`_
            * `R. R. Schröder et al. &lt;https://www.lem.kit.edu/152.php&gt;`_
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-phaseplateid-group"/>
        <rdfs:label>NXebeam_column/phaseplateID</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-phaseplateid-group"/>
    </owl:Class>
    


