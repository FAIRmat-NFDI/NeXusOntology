        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Describe the shape (plate, cube, wedged, prism etc.).
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_polarizer.html#nxoptical-polarizer-shape-shape-field"/>
        <rdfs:label>NXoptical_polarizer/SHAPE/shape</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_polarizer.html#nxoptical-polarizer-shape-shape-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-polarizer-shape-size-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-polarizer-shape-size-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Physical extent of the device. The device might be made up of one or
                more objects (NX_objects). The meaning and location of the axes used
                will vary according to the value of the &apos;shape&apos; variable. &apos;N_shapepar&apos;
                defines how many parameters:
                
                * For &apos;cube&apos; the parameters are (width, length).
                * For &apos;cylinder&apos; the parameters are (diameter, length).
                * For &apos;plate&apos; the parameters are (width, height, length).
                * For &apos;prism&apos; the parameters are (width, height, length).
                * For &apos;wedged&apos; the parameters are (width, height, shortest length).
                  The wedge angle should be provided in &apos;SHAPE/wedge_angle&apos;.
                * For &apos;other&apos; the parameters may be (A, B, C, ...) with the labels
                  defined in the sketch plotted in &apos;SHAPE/sketch&apos;.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_polarizer.html#nxoptical-polarizer-shape-size-field"/>
        <rdfs:label>NXoptical_polarizer/SHAPE/size</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXoptical_polarizer.html#nxoptical-polarizer-shape-size-field"/>
    </owl:Class>
    


