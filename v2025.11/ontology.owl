    <!-- https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-match-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-match-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Array of values to filter according to method. If the match e.g. specifies
            [1, 5, 6] and method is set to whitelist, only entries with values matching
            1, 5 or 6 will be processed. All other entries will be excluded.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-match-field"/>
        <rdfs:label>NXmatch_filter/match</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-match-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-blacklist-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-blacklist-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>blacklist</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-whitelist-enum"/>
        <rdfs:comment>Enumeration item for NXmatch_filter/method: blacklist</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
        <rdfs:label>NXmatch_filter/method/blacklist</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-method-field"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-config-entry-interface-meshingid-decoration-filter-method-field"/>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-config-entry-delocalizationid-decomposition-method-field"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                                        <owl:allValuesFrom>
                                            <owl:Class>
                                                <owl:unionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-blacklist-enum"/>
                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-whitelist-enum"/>
                                                </owl:unionOf>
                                            </owl:Class>
                                        </owl:allValuesFrom>
                                    </owl:Restriction>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>
            Definition of the logic what the filter yields:
            
            * Whitelist specifies which entries with said value to include.
              Entries with all other values will be excluded.
            * Blacklist specifies which entries with said value to exclude.
              Entries with all other values will be included.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
        <rdfs:label>NXmatch_filter/method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-whitelist-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmatch-filter-method-whitelist-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>whitelist</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXmatch_filter/method: whitelist</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
        <rdfs:label>NXmatch_filter/method/whitelist</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmatch_filter.html#nxmatch-filter-method-field"/>
    </owl:Class>
    


