    <!-- https://w3id.org/PaN/NeXus/definitions#nxcalibration-original-axis-symbol-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcalibration-original-axis-symbol-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                The symbol of the axis to be used in the fit_function, e.g., `energy`, `E`.
                This should comply to the following naming rules (similar to python&apos;s naming rules):
                
                * A variable name must start with a letter or the underscore character
                * A variable name cannot start with a number
                * A variable name can only contain alpha-numeric characters and underscores (A-z, 0-9, and _ )
                * Variable names are case-sensitive (age, Age and AGE are three different variables)
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-original-axis-symbol-attribute"/>
        <rdfs:label>NXcalibration/original_axis/symbol</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcalibration.html#nxcalibration-original-axis-symbol-attribute"/>
    </owl:Class>
    


