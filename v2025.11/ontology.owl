        <rdfs:label>NXmoderator/depends_on</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXmoderator.html#nxmoderator-depends-on-field"/>
    </owl:Class>
    


