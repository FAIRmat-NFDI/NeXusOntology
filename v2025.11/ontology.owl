        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-area"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_BINARY -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_BINARY">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:comment>any representation of binary data - if text, line terminator is [CR][LF]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-binary"/>
        <rdfs:label>NX_BINARY</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-binary"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>true/false value ( true | 1 | false | 0 )</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-boolean"/>
        <rdfs:label>NX_BOOLEAN</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-boolean"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_CCOMPLEX -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_CCOMPLEX">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:comment>
			Compound type cartesian representation of complex numbers (real and
			imaginary parts) in NeXus.
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-ccomplex"/>
        <rdfs:label>NX_CCOMPLEX</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-ccomplex"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_CHAR -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_CHAR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
				A string of characters. The preferred string encoding is :index:`UTF-8`. 
				This is the default field type.
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-char"/>
        <rdfs:label>NX_CHAR</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-char"/>
    </owl:Class>
    


