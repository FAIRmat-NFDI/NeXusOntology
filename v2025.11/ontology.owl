        <rdfs:label>NXchemical_composition/total</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXchemical_composition.html#nxchemical-composition-total-field"/>
    </owl:Class>
    


