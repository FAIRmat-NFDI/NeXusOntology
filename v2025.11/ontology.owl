    <!-- https://w3id.org/PaN/NeXus/definitions#NXazint1d -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXazint1d">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusApplicationClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxazint1d-entry-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
      Application definition for data from two-dimensional area detectors that has been integrated azimuthally,
      with a certain radial binning in units of q or 2theta.

      An example application that creates these files is documented here: https://maxiv-science.github.io/azint_writer/
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXazint1d.html"/>
        <rdfs:label>NXazint1d</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXazint1d.html"/>
        <extends>NXobject</extends>
    </owl:Class>
    


