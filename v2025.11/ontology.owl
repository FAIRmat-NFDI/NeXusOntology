    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-ebsd-indexing-parameter-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-ebsd-indexing-parameter-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxobject-collection-group"/>
        <rdfs:comment>
                Specific parameter relevant only for certain algorithms used.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-indexing-parameter-group"/>
        <rdfs:label>NXem_ebsd/indexing/parameter</rdfs:label>
