        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_INT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_INT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    A support field to enable the visualization of each point
                    by an explicit identifier on the interval [0, n_ions - 1].
                    The field can be used to visualize the points as a function
                    of their distance to the triangle set (e.g. via XDMF/Paraview).
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangleid-indices-point-field"/>
        <rdfs:label>NXapm_paraprobe_distancer_results/ENTRY/point_to_triangleID/indices_point</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangleid-indices-point-field"/>
    </owl:Class>
    


