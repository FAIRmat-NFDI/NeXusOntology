        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-spectralfilter-type-device-information-group"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-temp-control-type-device-information-group"/>
