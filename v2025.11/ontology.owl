                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-sample-gas-pressure-env-value-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
