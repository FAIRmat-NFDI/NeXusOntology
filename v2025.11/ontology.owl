        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units of (neutron) time of flight
				(alias to `NX_TIME`)
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-time-of-flight"/>
        <rdfs:label>NX_TIME_OF_FLIGHT</rdfs:label>
