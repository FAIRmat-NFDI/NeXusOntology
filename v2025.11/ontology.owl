        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxenvironment-actuator-group"/>
        <rdfs:comment>
                        Device to heat the sample.
                        This should be a link to /entry/instrument/manipulator/sample_heater.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group"/>
        <rdfs:label>NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/sample_heater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-sample-heater-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        If no sensor was available for the determination of temperature, selected
                        a nominal value which represents approximately the situation of sample temperature.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field"/>
        <rdfs:label>NXoptical_spectroscopy/ENTRY/SAMPLE/temperature_env/temperature_nominal</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-nominal-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-sample-temperature-env-temperature-sensor-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxenvironment-sensor-group"/>
        <rdfs:comment>
