    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-roi-cg-cylinder-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXcg_cylinder"/>
