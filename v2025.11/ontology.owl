    <!-- https://w3id.org/PaN/NeXus/definitions#nxbeam-incident-beam-divergence-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-incident-beam-divergence-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANGLE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Beam crossfire in degrees parallel to the laboratory X axis

            The dimension **c** is a series of moments of that represent
            the standard uncertainty (e.s.d.) of the directions of
            of the beam. The first and second moments are in the XZ and YZ
            planes around the mean source beam direction, respectively.

            Further moments in **c** characterize co-variance terms, so
            the next moment is the product of the first two, and so on.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-beam-divergence-field"/>
        <rdfs:label>NXbeam/incident_beam_divergence</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-beam-divergence-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxbeam-incident-energy-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxbeam-incident-energy-field">
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-instrument-beam-probe-incident-energy-field"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-instrument-beam-pump-incident-energy-field"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-instrument-beam-type-incident-energy-field"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxxrd-entry-instrument-beam-incident-energy-field"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ENERGY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Energy carried by each particle of the beam on entering the given location.

            Several use cases are permitted, depending on the presence or absence of
            other ``incident_energy_X`` fields. The usage should follow that of
            :ref:`incident_wavelength &lt;/NXbeam/incident_wavelength-field&gt;`.
       </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-energy-field"/>
        <rdfs:label>NXbeam/incident_energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam.html#nxbeam-incident-energy-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxbeam-incident-energy-spread-field -->


