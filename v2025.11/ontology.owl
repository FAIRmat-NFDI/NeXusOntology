    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcoordinate-system-transformations-group"/>
        <rdfs:comment>
                    This is the default NeXus coordinate system (McStas), if the transformation
                    does not change the coordinate system at all - i.e. it is unity.
                    Otherwise, by this a respective transformation of the beam
                    reference frame to the default reference frame could be made. i.e.
                    exchange of x and z coordinate, rotation of respective coordinates
                    towards each other.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group"/>
        <rdfs:label>NXoptical_spectroscopy/ENTRY/beam_ref_frame/TRANSFORMATIONS</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-beam-ref-frame-transformations-group"/>
    </owl:Class>
    


