                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxbeam-pulse-duration-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
