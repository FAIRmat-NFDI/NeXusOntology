    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nximage-image-1d-axis-i-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
