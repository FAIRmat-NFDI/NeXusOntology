    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-results-entry-specimen-atom-types-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-results-entry-specimen-atom-types-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    List of comma-separated elements from the periodic table that are
                    contained in the specimen. If the specimen substance has multiple
                    components, all elements from each component must be included in
                    `atom_types`.
                    
                    The purpose of the field is to offer research data management systems an
                    opportunity to parse the relevant elements without having to interpret
                    these from the resources pointed to by identifier_parent or walk through
                    eventually deeply nested groups in data instances.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_results.html#nxapm-compositionspace-results-entry-specimen-atom-types-field"/>
        <rdfs:label>NXapm_compositionspace_results/ENTRY/specimen/atom_types</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_results.html#nxapm-compositionspace-results-entry-specimen-atom-types-field"/>
    </owl:Class>
    


