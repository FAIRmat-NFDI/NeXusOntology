        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxentry-sample-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxtomoproc-entry-sample-name-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXtomoproc.html#nxtomoproc-entry-sample-group"/>
        <rdfs:label>NXtomoproc/ENTRY/SAMPLE</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXtomoproc.html#nxtomoproc-entry-sample-group"/>
    </owl:Class>
    


