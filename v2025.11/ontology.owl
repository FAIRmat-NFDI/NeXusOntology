    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-ebsd-indexing-number-of-scan-points-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-ebsd-indexing-number-of-scan-points-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
