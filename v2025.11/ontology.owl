    <!-- https://w3id.org/PaN/NeXus/definitions#nxxps-entry-xps-coordinate-system-origin-sample-stage-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxps-entry-xps-coordinate-system-origin-sample-stage-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>sample stage</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXxps/ENTRY/xps_coordinate_system/origin: sample stage</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXxps.html#nxxps-entry-xps-coordinate-system-origin-field"/>
