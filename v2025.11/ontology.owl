        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
        <rdfs:label>NXdelocalization/weighting_model/weighting_method/default</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-element-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-element-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>element</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXdelocalization/weighting_model/weighting_method: element</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
        <rdfs:label>NXdelocalization/weighting_model/weighting_method/element</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-default-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-element-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-isotope-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                 As an example from the research field of atom probe points/objects are (molecular) ions.
                 Different methods are used for weighting ions:
                 
                 * default, points get all the same weight 1., which for atom probe is equivalent
                    to (molecular) iontype-based delocalization.
                 * element, points get as much weight as they have atoms representing a nuclide
                   with a proton number that is matching to a respective entry in whitelist.
                   In atom probe jargon, this means atomic_decomposition.
                 * isotope, points get as much weight as they have atoms representing a nuclides
                   from a respective entry in whitelist.
                   In atom probe jargon, this means isotope_decomposition.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
        <rdfs:label>NXdelocalization/weighting_model/weighting_method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-weighting-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-isotope-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-weighting-method-isotope-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
