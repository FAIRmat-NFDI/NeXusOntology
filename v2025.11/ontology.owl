    <!-- https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-sample-flood-gun-current-env-flood-gun-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-sample-flood-gun-current-env-flood-gun-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxenvironment-actuator-group"/>
        <rdfs:comment>
                        Flood gun creating a current of low-energy electrons.
                        
                        In most cases this can be a link to /entry/instrument/flood_gun
                        if a flood_gun is present in the instrument.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-sample-flood-gun-current-env-flood-gun-group"/>
        <rdfs:label>NXmpes/ENTRY/SAMPLE/flood_gun_current_env/flood_gun</rdfs:label>
