                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-crystals-orientation-spread-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
