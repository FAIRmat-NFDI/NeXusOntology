        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-type-field"/>
        <rdfs:label>NXcoordinate_system/type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcoordinate_system.html#nxcoordinate-system-type-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcoordinate-system-x-alias-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcoordinate-system-x-alias-field">
