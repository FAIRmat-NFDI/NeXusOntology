                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
				``0|false``: single value, 
				``1|true``: multiple values
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdata.html#nxdata-axisname-distribution-attribute"/>
        <rdfs:label>NXdata/AXISNAME/distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdata.html#nxdata-axisname-distribution-attribute"/>
    </owl:Class>
    


