        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units of emittance (``length * angle``) of a
				radiation source
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-emittance"/>
        <rdfs:label>NX_EMITTANCE</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-emittance"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_ENERGY -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_ENERGY">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units of energy
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-energy"/>
        <rdfs:label>NX_ENERGY</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-energy"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_FLOAT -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>any representation of a floating point number</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-float"/>
        <rdfs:label>NX_FLOAT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-float"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_FLUX -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_FLUX">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units of flux
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-flux"/>
        <rdfs:label>NX_FLUX</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-flux"/>
    </owl:Class>
    


