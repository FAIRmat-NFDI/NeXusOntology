                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Ideally measured otherwise best elaborated guess of the initial radius of the
                    specimen.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-specimen-initial-radius-field"/>
        <rdfs:label>NXapm/ENTRY/specimen/initial_radius</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-specimen-initial-radius-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-entry-specimen-is-amorphous-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-specimen-is-amorphous-field">
