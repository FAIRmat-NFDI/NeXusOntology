		</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXentry.html#nxentry-thumbnail-group"/>
        <rdfs:label>NXentry/thumbnail</rdfs:label>
