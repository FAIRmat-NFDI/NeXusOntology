    <!-- https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-cubic-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-hexagonal-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-monoclinic-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-orthorhombic-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-rhombohedral-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-tetragonal-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-crystal-system-triclinic-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Crystal system.
            
            For a crystal system in 2D space monoclinic is an exact synonym for oblique.
            For a crystal system in 2D space orthorhombic is an exact synonym for rectangular.
            For a crystal system in 2D space tetragonal is an exact synonym for square.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXunit_cell.html#nxunit-cell-crystal-system-field"/>
