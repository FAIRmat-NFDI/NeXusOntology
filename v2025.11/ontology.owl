                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-method-field"/>
        <rdfs:label>NXdelocalization/weighting_model/method</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html#nxdelocalization-weighting-model-method-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-method-whitelist-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-method-whitelist-enum">
