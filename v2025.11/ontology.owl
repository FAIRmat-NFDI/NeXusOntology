            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        The content of the mask. Like for all masks used in the tools
                        of the paraprobe-toolbox, padding is used when number_of_objects
                        is not an integer multiple of bitdepth. If padding is used,
                        padded bits are set to 0.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangleid-sign-valid-mask-field"/>
        <rdfs:label>NXapm_paraprobe_distancer_results/ENTRY/point_to_triangleID/sign_valid/mask</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_distancer_results.html#nxapm-paraprobe-distancer-results-entry-point-to-triangleid-sign-valid-mask-field"/>
    </owl:Class>
    


