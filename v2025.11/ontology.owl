                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-config-entry-delocalizationid-isosurfacing-has-triangle-soup-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
