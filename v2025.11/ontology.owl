    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-entry-consistent-rotations-axis-angle-convention-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-consistent-rotations-axis-angle-convention-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-consistent-rotations-axis-angle-convention-rotation-angle-on-interval-zero-to-pi-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    To which angular range is the rotation angle argument of an
                    axis-angle pair parameterization constrained according to
                    convention 5 of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-consistent-rotations-axis-angle-convention-field"/>
