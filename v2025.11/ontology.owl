    <!-- https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-t-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-t-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_DIMENSIONLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-t-uncertainties-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
          Transmission values (:math:`I/I_0`)
          as a function of wavelength.
          
          This array is of the same shape as ``lambda`` and ``Tdev``.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-t-field"/>
        <rdfs:label>NXcanSAS/ENTRY/TRANSMISSION_SPECTRUM/T</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-t-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-t-uncertainties-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-t-uncertainties-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Names the dataset (in this SASdata group) that provides the 
            uncertainty of each transmission :math:`T` to be used for data analysis.  
            The name of the dataset containing the :math:`T` uncertainty
            is expected to be ``Tdev``.
            
            .. comment
               see: https://github.com/canSAS-org/canSAS2012/issues/7
            
            Typically:
            
                @uncertainties=&quot;Tdev&quot;
            
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-t-uncertainties-attribute"/>
        <rdfs:label>NXcanSAS/ENTRY/TRANSMISSION_SPECTRUM/T/uncertainties</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-t-uncertainties-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-tdev-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-transmission-spectrum-tdev-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_DIMENSIONLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
          .. index:: NXcanSAS (applications); Tdev
          
          Estimated uncertainty (usually standard deviation)
          in :math:`T`.  Must have the same units as :math:`T`.
          
          This is the field is named in the *uncertainties* attribute of *T*, as in::
          
              T/@uncertainties=&quot;Tdev&quot;
              
          This array is of the same shape as ``lambda`` and ``T``.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-tdev-field"/>
        <rdfs:label>NXcanSAS/ENTRY/TRANSMISSION_SPECTRUM/Tdev</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-transmission-spectrum-tdev-field"/>
    </owl:Class>
    


