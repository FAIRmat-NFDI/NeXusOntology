    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxentry-thumbnail-type-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxentry-thumbnail-type-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxentry-thumbnail-type-image-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The mime type should be an ``image/*``</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXentry.html#nxentry-thumbnail-type-attribute"/>
        <rdfs:label>NXentry/thumbnail/type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXentry.html#nxentry-thumbnail-type-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxentry-thumbnail-type-image-enum -->


