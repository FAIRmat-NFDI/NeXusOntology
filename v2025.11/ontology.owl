    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-ranger-results-entry-iontypesid-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tool-results-entry-taskprocessed-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-ranger-results-entry-iontypesid-iontypes-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                The tool loads ranging definitions from the configuration file and
                evaluates for each ion to which iontype it matches.
                If an ion matches on no type, the ion is assume of the default
                *unknown_type*. In this case, the value *iontypes* is 0.
                In other cases the value is larger than 0.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_ranger_results.html#nxapm-paraprobe-ranger-results-entry-iontypesid-group"/>
