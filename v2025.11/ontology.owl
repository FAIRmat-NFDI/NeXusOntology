    <!-- https://w3id.org/PaN/NeXus/definitions#NXmonopd -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXmonopd">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusApplicationClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmonopd-entry-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
        Monochromatic Neutron and X-Ray Powder diffractometer 
        
        Instrument 
        definition for a powder diffractometer at a monochromatic neutron 
        or X-ray beam. This is both suited for a powder diffractometer 
        with a single detector or a powder diffractometer with a position 
        sensitive detector.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmonopd.html"/>
        <rdfs:label>NXmonopd</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmonopd.html"/>
        <extends>NXobject</extends>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NXmpes -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXmpes">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusApplicationClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
