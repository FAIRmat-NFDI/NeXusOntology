    <!-- https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-auger-electron-yield-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-fluorescence-yield-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-partial-electron-yield-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-total-electron-yield-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxas-entry-data-mode-transmission-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Detection method used for observing the sample absorption (pick one from the enumerated list and spell exactly)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXxas.html#nxxas-entry-data-mode-field"/>
