                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxxpcs-entry-instrument-detector-description-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
