                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Describe the shape (plate, cube, wedged, prism etc.).
            </rdfs:comment>
