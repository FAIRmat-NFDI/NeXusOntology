            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-grid-surface-reconstruction-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-grid-symmetry-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
         Computational geometry description of a grid of Wigner-Seitz cells in Euclidean space.
         
         Three-dimensional grids with cubic cells are if not the most frequently used
         example of such grids. Numerical methods and models that use grids are used
         in many cases in the natural sciences and engineering disciplines. Examples are
         discretizations in space and time used for phase-field, cellular automata, or Monte Carlo
         modeling.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_grid.html"/>
        <rdfs:label>NXcg_grid</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_grid.html"/>
        <extends>NXcg_primitive</extends>
    </owl:Class>
    


