    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsubentry-thumbnail-mime-type-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsubentry-thumbnail-mime-type-image-enum"/>
                        </owl:unionOf>
                    </owl:Class>
