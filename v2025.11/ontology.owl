                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmx-entry-data-data-offset-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmx-entry-data-data-scaling-factor-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-data-group"/>
        <rdfs:label>NXmx/ENTRY/DATA</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-data-group"/>
    </owl:Class>
    


