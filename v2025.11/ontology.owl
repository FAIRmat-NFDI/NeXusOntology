    <!-- https://w3id.org/PaN/NeXus/definitions#nxxpcs-entry-note-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxpcs-entry-note-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxobject-note-group"/>
        <rdfs:comment>
        Any other notes.

        NAME: The NeXus convention, to use all upper case
        to indicate the name (here ``NOTE``), is left to the file
        writer.  In our case, follow the suggested name
        pattern and sequence: note_1, note_2, note_3, ...
        Start with ``note_1`` if the first one, otherwise
        pick the next number in this sequence.
      </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-note-group"/>
        <rdfs:label>NXxpcs/ENTRY/NOTE</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-note-group"/>
    </owl:Class>
    


