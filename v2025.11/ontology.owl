        <rdfs:label>NXapm_paraprobe_nanochem_config/ENTRY/delocalizationID/normalization/none</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_config.html#nxapm-paraprobe-nanochem-config-entry-delocalizationid-normalization-field"/>
