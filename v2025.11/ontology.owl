        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-consistent-rotations-axis-angle-convention-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-entry-consistent-rotations-axis-angle-convention-rotation-angle-on-interval-zero-to-pi-enum -->


