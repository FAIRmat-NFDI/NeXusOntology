    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-instrument-type-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-instrument-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-instrument-type-fib-enum"/>
