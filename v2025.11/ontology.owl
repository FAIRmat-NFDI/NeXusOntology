    <!-- https://w3id.org/PaN/NeXus/definitions#nxsas-entry-instrument-detector-data-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsas-entry-instrument-detector-data-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxdetector-data-field"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            This is area detector data, number of x-pixel versus
            number of y-pixels.

            Since the beam center is to be determined as a step of data
            reduction, it is not necessary to document or assume the position of
            the beam center in acquired data.

            It is necessary to define which are the x and y directions, to coordinate
            with the pixel size and compute Q.
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXsas.html#nxsas-entry-instrument-detector-data-field"/>
        <rdfs:label>NXsas/ENTRY/INSTRUMENT/DETECTOR/data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXsas.html#nxsas-entry-instrument-detector-data-field"/>
    </owl:Class>
    


