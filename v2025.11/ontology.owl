    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxtransmission-entry-acquisition-program-identifier-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
