    <!-- https://w3id.org/PaN/NeXus/definitions#nxunit-cell-is-centrosymmetric-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxunit-cell-is-centrosymmetric-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            True if space group is considered a centrosymmetric one.
            False if space group is considered a non-centrosymmetric one.
            
            Centrosymmetric has all types and combinations of symmetry elements
            (translation, rotational axis, mirror planes, center of inversion)
            Non-centrosymmetric compared to centrosymmetric is constrained (no inversion).
            Chiral compared to non-centrosymmetric is constrained (no mirror planes).
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXunit_cell.html#nxunit-cell-is-centrosymmetric-field"/>
        <rdfs:label>NXunit_cell/is_centrosymmetric</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXunit_cell.html#nxunit-cell-is-centrosymmetric-field"/>
    </owl:Class>
    


