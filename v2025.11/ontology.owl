    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxobject-note-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-algorithm-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-checksum-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-file-name-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-compositionspace-config-entry-ranging-ranging-definitions-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Specification of the ranging definitions used for this analysis.
                
                Ranging definitions in the field of atom probe tomography are communicated via
                a file which stores the mass-to-charge-state-ratio interval and the number of elements
                of which each (molecular) ion is composed. These values are stored for each ion.
                
                Container file formats like HDF5, such as NeXus/HDF5 files using :ref:`NXapm`,
                can store multiple ranging definitions.
                
                Indices of ions start from 1. The value 0 is reserved for the null model of unranged positions
                whose iontype is referred to as the unknown_type. The value 0 is also reserved for voxels
                that lie outside the dataset.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-ranging-group"/>
        <rdfs:label>NXapm_compositionspace_config/ENTRY/ranging</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_compositionspace_config.html#nxapm-compositionspace-config-entry-ranging-group"/>
    </owl:Class>
    


