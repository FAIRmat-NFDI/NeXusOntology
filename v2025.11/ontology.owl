                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Pixel center coordinate calibrated for step size along the x axis of the map.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-map-axis-x-field"/>
        <rdfs:label>NXmicrostructure_ipf/map/axis_x</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-map-axis-x-field"/>
    </owl:Class>
    


