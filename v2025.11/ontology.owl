                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-instrument-source-radiation-x-ray-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Name of the radiation used.
            Note that this is **not** the name of the facility!

            This field contains a value from either the 
            ``probe`` or ``type`` fields in :ref:`NXsource`. Thus, 
            it is redundant with existing NeXus structure.
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-source-radiation-field"/>
        <rdfs:label>NXcanSAS/ENTRY/INSTRUMENT/SOURCE/radiation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-instrument-source-radiation-field"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


