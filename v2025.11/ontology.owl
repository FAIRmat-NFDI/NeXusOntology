    <!-- https://w3id.org/PaN/NeXus/definitions#NXdelocalization -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXdelocalization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXobject"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusBaseClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-grid-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxdelocalization-weighting-model-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
         Base class of the configuration and results of a delocalization algorithm.
         
         Delocalization is used to distribute point-like objects on a grid to obtain
         e.g. smoother count, composition, or concentration values of scalar fields
         and compute gradients of these fields.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXdelocalization.html"/>
