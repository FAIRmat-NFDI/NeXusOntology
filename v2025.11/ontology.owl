        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-instrument-beam-pump-incident-energy-spread-field"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-instrument-beam-type-incident-energy-spread-field"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
