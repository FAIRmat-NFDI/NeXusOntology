                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                            Potential difference :math:`V` at which mrp_value was specified.
                        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-ranging-background-quantification-mrp-voltage-field"/>
        <rdfs:label>NXapm/ENTRY/atom_probeID/ranging/background_quantification/mrp_voltage</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-ranging-background-quantification-mrp-voltage-field"/>
    </owl:Class>
    


