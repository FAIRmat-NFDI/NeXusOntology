                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_INT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
              The area detector data, the first dimension is always the
              number of scan points, the second and third are the number
              of pixels in x and y. The origin is always assumed to be
              in the center of the detector. maxOccurs is limited to the
              the number of detectors on your instrument.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXxbase.html#nxxbase-entry-instrument-detector-data-field"/>
