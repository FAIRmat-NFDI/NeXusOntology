    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-beam-type-linear-beam-sample-polarization-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-beam-type-linear-beam-sample-polarization-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANGLE"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Angle of the linear polarized light, with respect to a fixed arbitrary
                        defined 0° position. Note that the zero reference should be a direction vector for a
                        :ref:`reference_plane &lt;/NXbeam/TRANSFORMATIONS/reference_plane-field&gt;`
                        normal in an :ref:`NXtransformations` group within :ref:`NXbeam`.
                        This can be used if no definition of respective
                        coordinate systems for beam and sample normal is done. If coordinate systems
                        are defined, refer to beam &quot;incident_polarization&quot;.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-beam-type-linear-beam-sample-polarization-field"/>
        <rdfs:label>NXoptical_spectroscopy/ENTRY/INSTRUMENT/beam_TYPE/linear_beam_sample_polarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXoptical_spectroscopy.html#nxoptical-spectroscopy-entry-instrument-beam-type-linear-beam-sample-polarization-field"/>
    </owl:Class>
    


