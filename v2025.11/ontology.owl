                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxem-calorimetry-entry-synchronization-sequence-index-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxem-calorimetry-entry-synchronization-start-time-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Assumptions and computations whereby timestamping data from
                the detector and actuator (e.g. heating chip) were synchronized.
