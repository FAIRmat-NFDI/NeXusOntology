            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-coating-index-of-refraction-coating-field"/>
        <rdfs:label>NXoptical_lens/COATING/index_of_refraction_coating</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-coating-index-of-refraction-coating-field"/>
    </owl:Class>
    


