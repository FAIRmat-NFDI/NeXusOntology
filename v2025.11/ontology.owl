        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-field-of-view-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-reconstruction-naive-discretization-data-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-reconstruction-naive-discretization-data-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxprocess-data-group"/>
        <rdfs:comment>
                Visual overview of the reconstructed dataset via a three-dimensional
                histogram of ion counts. Ion counts are characterized using one nanometer
                cubic bins without applying any smoothening of reconstructed positions
                during the histogram computation.
                
                Such preview is useful to get an impression of the macroscopic shape of the
                reconstructed volume. Visualizing by ion counts highlights density variations
                the reconstructed volume that are signatures of features such as poles,
                interfaces or irregularities of the specimen shape.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-naive-discretization-data-group"/>
        <rdfs:label>NXapm_reconstruction/naive_discretization/DATA</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_reconstruction.html#nxapm-reconstruction-naive-discretization-data-group"/>
    </owl:Class>
    


