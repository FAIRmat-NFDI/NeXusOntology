                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                            True when the angular calibration has been applied in the
                            electronics, false otherwise.
                        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-angular-calibration-applied-field"/>
        <rdfs:label>NXmx/ENTRY/INSTRUMENT/DETECTOR/angular_calibration_applied</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-detector-angular-calibration-applied-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmx-entry-instrument-detector-angular-calibration-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmx-entry-instrument-detector-angular-calibration-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
