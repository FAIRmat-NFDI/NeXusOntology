    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-rotation-handedness-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-rotation-handedness-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-rotation-handedness-clockwise-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-rotation-handedness-counter-clockwise-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Convention how a positive rotation angle is defined when viewing
                    from the end of the rotation unit vector towards its origin.
                    This is in accordance with convention 2 of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                    
                    Counter_clockwise is equivalent to a right-handed choice.
                    Clockwise is equivalent to a left-handed choice.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-rotation-handedness-field"/>
        <rdfs:label>NXem/ENTRY/consistent_rotations/rotation_handedness</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-rotation-handedness-field"/>
    </owl:Class>
    


