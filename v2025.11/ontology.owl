                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                The unique identifier for the collection. The identifier is used to group a
                number of the experiments run upon the same setup and/or same sample.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-identifier-collection-field"/>
        <rdfs:label>NXsensor_scan/ENTRY/identifier_collection</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-identifier-collection-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-identifier-experiment-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-identifier-experiment-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxobject-identifiername-field"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                The unique identifier for the entry. The identifier is mainly lab-defined and
                can be a combination of the sample name, date and time, experiment condition
                (such as temperature) or instrument-generated unique identifier.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-identifier-experiment-field"/>
        <rdfs:label>NXsensor_scan/ENTRY/identifier_experiment</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-identifier-experiment-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXenvironment"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-independent-controllers-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-measurement-sensors-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-pid-controller-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-instrument-environment-sensor-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Describes an environment setup for the experiment.
                    
                    All the setting values of the independently scanned controllers are listed under corresponding
                    NXsensor groups. Similarly, separate NXsensor groups are used to store the readings from each
                    measurement sensor.
                    
                    For example, in a temperature-dependent IV measurement, the temperature and voltage must be
                    present as independently scanned controllers and the current sensor must also be present with
                    its readings.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-environment-group"/>
        <rdfs:label>NXsensor_scan/ENTRY/INSTRUMENT/ENVIRONMENT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsensor_scan.html#nxsensor-scan-entry-instrument-environment-group"/>
    </owl:Class>
    


