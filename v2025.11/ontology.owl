    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-ipf-interpolation-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-ipf-interpolation-nearest-neighbour-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            How where orientation values at positions of input_grid computed to values on output_grid.
            
            Nearest neighbour means the orientation of the closed (Euclidean distance) grid point of the input_grid was taken.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_ipf.html#nxmicrostructure-ipf-interpolation-field"/>
