    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Specifies if the tool evaluates, provided that all (preprocessing tasks were successful), how intersecting
                    or proximity related objects build sub-graphs. This is the feature that was used in `M. Kühbach et al. &lt;https://arxiv.org/abs/2205.13510&gt;`_
                    for the high-throughput analyses of how many objects are coprecipitates in the sense that they are single,
                    duplet, triplet, or high-order local groups.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field"/>
        <rdfs:label>NXapm_paraprobe_intersector_config/ENTRY/v_v_spatial_correlationID/analyze_coprecipitation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-analyze-coprecipitation-field"/>
    </owl:Class>
    


