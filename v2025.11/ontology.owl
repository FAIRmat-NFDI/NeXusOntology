                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxbeam-stop-y-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
        A device that blocks the beam completely, usually to protect a detector. 
    
        Beamstops and their positions are important for SANS
        and SAXS experiments.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam_stop.html"/>
        <rdfs:label>NXbeam_stop</rdfs:label>
