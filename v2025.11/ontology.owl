        <rdfs:label>NXmicrostructure/interfaces/surface_energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-interfaces-surface-energy-field"/>
    </owl:Class>
    


