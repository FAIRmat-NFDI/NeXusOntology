            etc.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-function-group"/>
        <rdfs:label>NXpeak/function</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXpeak.html#nxpeak-function-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxpeak-label-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxpeak-label-field">
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxxps-entry-fit-backgroundbackground-label-field"/>
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxxps-entry-fit-peakpeak-label-field"/>
