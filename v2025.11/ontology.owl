        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-local-electrode-aperture-type-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-instrument-local-electrode-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-instrument-local-electrode-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXcomponent"/>
