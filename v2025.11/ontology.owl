    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-axis-angle-convention-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-axis-angle-convention-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-axis-angle-convention-rotation-angle-on-interval-zero-to-pi-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    To which angular range is the rotation angle argument of an
                    axis-angle pair parameterization constrained according to
                    convention 5 of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-axis-angle-convention-field"/>
        <rdfs:label>NXem/ENTRY/consistent_rotations/axis_angle_convention</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-axis-angle-convention-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-axis-angle-convention-rotation-angle-on-interval-zero-to-pi-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-axis-angle-convention-rotation-angle-on-interval-zero-to-pi-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>rotation_angle_on_interval_zero_to_pi</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXem/ENTRY/consistent_rotations/axis_angle_convention: rotation_angle_on_interval_zero_to_pi</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-axis-angle-convention-field"/>
        <rdfs:label>NXem/ENTRY/consistent_rotations/axis_angle_convention/rotation_angle_on_interval_zero_to_pi</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-axis-angle-convention-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xyx-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xyz-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xzx-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xzy-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-yxy-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-yxz-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-yzx-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-yzy-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-zxy-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-zxz-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-zyx-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-zyz-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    How are Euler angles interpreted given that there are several choices (e.g. zxz, xyz)
                    according to convention 4 of reference `&lt;https://doi.org/10.1088/0965-0393/23/8/083501&gt;`_.
                    
                    The most frequently used convention in Materials Science is zxz, which is based on the work
                    of H.-J. Bunge but using other conventions is possible. Proper Euler angles are distinguished
                    from (improper) Tait-Bryan angles.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-euler-angle-convention-field"/>
        <rdfs:label>NXem/ENTRY/consistent_rotations/euler_angle_convention</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXem.html#nxem-entry-consistent-rotations-euler-angle-convention-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xyx-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-entry-consistent-rotations-euler-angle-convention-xyx-enum">
