    <!-- https://w3id.org/PaN/NeXus/definitions#nxiv-temp-entry-data-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxiv-temp-entry-data-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-data-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxiv-temp-entry-data-current-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxiv-temp-entry-data-temperature-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxiv-temp-entry-data-voltage-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                 This NXdata should contain separate fields for the current values at different temperature setpoints, for example current_at_100C.
                 There should also be two more fields called temperature and voltage containing the setpoint values.
                 There should also be a field with an array of rank equal to the number of different temperature setpoints and each child&apos;s dimension
                 equal to the number of voltage setpoints.
            </rdfs:comment>
