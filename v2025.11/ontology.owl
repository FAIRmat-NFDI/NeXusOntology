        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-pattern-center-x-boundary-convention-field"/>
        <rdfs:label>NXem_ebsd/pattern_center/x_boundary_convention/bottom</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_ebsd.html#nxem-ebsd-pattern-center-x-boundary-convention-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-ebsd-pattern-center-x-boundary-convention-field -->


