                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-sample-flood-gun-current-env-flood-gun-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-sample-flood-gun-current-env-value-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Current of low-energy electrons to the sample (for charge neutralization) and
                    actuators/sensors controlling/measuring it.
                </rdfs:comment>
