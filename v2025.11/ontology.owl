                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcsg-operation-union-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
      One of the standard construction solid geometry set operations,
      or statement IS_QUADRIC or IS_MESH if the CSG is a pointer to an
      instance of a geometry class. Takes values:
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-operation-field"/>
        <rdfs:label>NXcsg/operation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcsg.html#nxcsg-operation-field"/>
    </owl:Class>
    


