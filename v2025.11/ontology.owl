    <!-- https://w3id.org/PaN/NeXus/definitions#nxcxi-ptycho-data-1-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcxi-ptycho-data-1-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxobject-collection-group"/>
        <rdfs:comment>
				To ensure CXI compatibility the data in this group must always have shape that is
				(npts_x*npts_y, frame_size_x, frame_size_y). For nexus-style raster scans it is proposed that
				hdf5 virtual dataset is used.
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-data-1-group"/>
        <rdfs:label>NXcxi_ptycho/data_1</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-data-1-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcxi-ptycho-data-axes-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcxi-ptycho-data-axes-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxdata-axes-attribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
					This should be &quot;[x,.]&quot; for arbitrary scanning patterns, and &quot;[x,.,.]&quot; for raster
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-data-axes-attribute"/>
        <rdfs:label>NXcxi_ptycho/DATA/axes</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcxi_ptycho.html#nxcxi-ptycho-data-axes-attribute"/>
