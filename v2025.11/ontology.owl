    <!-- https://w3id.org/PaN/NeXus/definitions#NXxeuler -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXxeuler">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXxbase"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusApplicationClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxxeuler-entry-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
      raw data from a :index:`four-circle diffractometer` with an :index:`eulerian cradle`, extends :ref:`NXxbase`
      
      It extends :ref:`NXxbase`, so the full definition is the content 
      of :ref:`NXxbase` plus the data defined here. All four angles are 
      logged in order to support arbitrary scans in reciprocal space.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXxeuler.html"/>
        <rdfs:label>NXxeuler</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXxeuler.html"/>
        <extends>NXxbase</extends>
    </owl:Class>
    


