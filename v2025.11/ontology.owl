                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-face-area-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-number-of-edges-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-number-of-faces-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-polyhedra-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-polyhedron-half-edgeid-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcg-polyhedron-polyhedronid-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
        Computational geometry description of a set of polyhedra in Euclidean space.
        
        Polyhedra or so-called cells (especially in the convex of tessellations) are
        constructed from polygon meshes. Polyhedra may make contact to allow a usage
        of this base class for a description of tessellations.
        
        For the description of more complicated manifolds and especially for polyhedra
        with holes, users are advised to check if their particular needs are described
        by creating customized instances of an :ref:`NXcg_polygon`.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_polyhedron.html"/>
        <rdfs:label>NXcg_polyhedron</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_polyhedron.html"/>
        <extends>NXcg_primitive</extends>
    </owl:Class>
    


