        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_profiling.html#nxcs-profiling-end-time-field"/>
        <rdfs:label>NXcs_profiling/end_time</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcs_profiling.html#nxcs-profiling-end-time-field"/>
    </owl:Class>
    


