        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-cross-section"/>
        <rdfs:label>NX_CROSS_SECTION</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-cross-section"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_CURRENT -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_CURRENT">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units of electrical current
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-current"/>
        <rdfs:label>NX_CURRENT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-current"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_DATE_TIME -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_DATE_TIME">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:comment>
			Alias for the ``ISO8601`` date/time stamp.
			It is recommended to add an explicit time zone,
			otherwise the local time zone is assumed per ISO8601.
			</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-date-time"/>
        <rdfs:label>NX_DATE_TIME</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-date-time"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_DIMENSIONLESS -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NX_DIMENSIONLESS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusUnitCategory"/>
        <rdfs:comment>
				units for fields where the units cancel out
				(NOTE: not the same as NX_UNITLESS)
				</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-dimensionless"/>
        <rdfs:label>NX_DIMENSIONLESS</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-dimensionless"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_EMITTANCE -->


