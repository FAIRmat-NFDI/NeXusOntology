    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-instrument-source-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxsource-type-field"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-instrument-source-type-fixed-tube-x-ray-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstress-entry-instrument-source-type-metal-jet-x-ray-enum"/>
