        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_optical_system.html#nxem-optical-system-dynamic-focus-correction-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-optical-system-dynamic-refocusing-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-optical-system-dynamic-refocusing-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
