    <!-- https://w3id.org/PaN/NeXus/definitions#nxxpcs-entry-twotime-two-time-corr-func-baseline-reference-attribute -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxxpcs-entry-twotime-two-time-corr-func-baseline-reference-attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
