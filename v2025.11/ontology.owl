                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    The iontype (identifier) for each ion that was best matching,
                    stored in the order of the evaporation sequence ID.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_ranger_results.html#nxapm-paraprobe-ranger-results-entry-iontypesid-iontypes-field"/>
