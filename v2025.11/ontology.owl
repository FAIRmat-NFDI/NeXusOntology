                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXstxm/ENTRY/DATA/stxm_scan_type: detector image</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXstxm.html#nxstxm-entry-data-stxm-scan-type-field"/>
        <rdfs:label>NXstxm/ENTRY/DATA/stxm_scan_type/detector image</rdfs:label>
