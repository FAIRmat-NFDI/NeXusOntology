    <!-- https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-results-entry-spatiotemporalid-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-results-entry-spatiotemporalid-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxentry-process-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-results-entry-spatiotemporalid-microstructureid-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-results-entry-spatiotemporalid-summary-statistics-group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Documentation of the spatiotemporal evolution for each CA domain.
                
                SCORE is a hybrid parallelized code that can evolve multiple replicas
                in parallel. The set of replicas is distributed across MPI processes.
                Each such replica is then evolved via OpenMP multi-threading.
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_results.html#nxmicrostructure-score-results-entry-spatiotemporalid-group"/>
        <rdfs:label>NXmicrostructure_score_results/ENTRY/spatiotemporalID</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_results.html#nxmicrostructure-score-results-entry-spatiotemporalid-group"/>
    </owl:Class>
    


