        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsimilarity_grouping.html#nxsimilarity-grouping-cardinality-field"/>
        <rdfs:label>NXsimilarity_grouping/cardinality</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXsimilarity_grouping.html#nxsimilarity-grouping-cardinality-field"/>
    </owl:Class>
    


