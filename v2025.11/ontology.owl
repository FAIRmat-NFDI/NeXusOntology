                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmpes-arpes-entry-data-axes-angular0-angular1-energy-enum"/>
                        </owl:unionOf>
