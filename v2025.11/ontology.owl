                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-config-entry-delocalizationid-kernel-variance-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-config-entry-delocalizationid-method-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
