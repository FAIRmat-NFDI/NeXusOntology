    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcs-profiling-event-max-virtual-memory-snapshot-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
