    <!-- https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-identifier-collection-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxsensor-scan-entry-identifier-collection-field">
