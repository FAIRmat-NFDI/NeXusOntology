        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-reflectron-voltage-field"/>
        <rdfs:label>NXapm_instrument/reflectron/voltage</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_instrument.html#nxapm-instrument-reflectron-voltage-field"/>
    </owl:Class>
    


