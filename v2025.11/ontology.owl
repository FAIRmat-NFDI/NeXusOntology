                                        primitive each normal represents.
                                        
                                        * 0 - undefined
                                        * 1 - outer
                                        * 2 - inner
                                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-iso-surfaceid-triangle-soup-triangles-face-normal-orientation-field"/>
