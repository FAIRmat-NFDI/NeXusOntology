                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            baseline is the expected value of a full decorrelation

            The baseline is a constant value added to the functional form of the auto-correlation
            function. This value is required.
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXxpcs.html#nxxpcs-entry-twotime-two-time-corr-func-baseline-reference-attribute"/>
