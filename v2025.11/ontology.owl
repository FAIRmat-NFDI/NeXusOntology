        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXcg_primitive.html#nxcg-primitive-cardinality-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcg-primitive-center-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcg-primitive-center-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
