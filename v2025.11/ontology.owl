                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
			Effective distance to the origin.
			Note, it is recommended to use NXtransformations instead.
		</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdisk_chopper.html#nxdisk-chopper-distance-field"/>
        <rdfs:label>NXdisk_chopper/distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXdisk_chopper.html#nxdisk-chopper-distance-field"/>
    </owl:Class>
    


