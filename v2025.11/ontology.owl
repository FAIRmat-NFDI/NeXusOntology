                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-atom-probeid-hit-finding-hit-positions-depends-on-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Evaluated ion impact coordinates on the detector.
                        Use the depends_on field to specify which reference
                        frame the positions are defined in.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-positions-field"/>
        <rdfs:label>NXapm/ENTRY/atom_probeID/hit_finding/hit_positions</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-positions-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-entry-atom-probeid-hit-finding-hit-quality-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-atom-probeid-hit-finding-hit-quality-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Hit quality identifier for each pulse.
                        Identifier has to be within hit_quality_type.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-quality-field"/>
        <rdfs:label>NXapm/ENTRY/atom_probeID/hit_finding/hit_quality</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-quality-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-entry-atom-probeid-hit-finding-hit-quality-type-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-entry-atom-probeid-hit-finding-hit-quality-type-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Hit quality is an integer that specifies which category/type a hit was assigned to.
                        This field lists the human-readable, possibly though proprietary types distinguished.
                        The indices of this array are used in hit_quality to encode hit_quality for each
                        pulse in a more efficient way than by repeating the string that is used for each
                        type as it is provided in this field.
                        
                        As an example, assume two types, &quot;golden&quot; and &quot;partial&quot;, are distinguished.
                        If hit_quality_type stores the array &quot;golden&quot;, &quot;partial&quot;, the index 0
                        in hit_quality identifies all those pulses of category &quot;golden&quot;,
                        while the index 1 in hit_quality identifies all of category &quot;partial&quot;.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-quality-type-field"/>
        <rdfs:label>NXapm/ENTRY/atom_probeID/hit_finding/hit_quality_type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXapm.html#nxapm-entry-atom-probeid-hit-finding-hit-quality-type-field"/>
    </owl:Class>
    


