                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
          is a normalization correction applied or not.

          It indicates that integrated intensities and their errors were already divided by the appropriate normalization factors accounting
          for the effective number or weighted contribution of detector pixels to each integration bin.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXazint2d.html#nxazint2d-entry-normalization-applied-field"/>
