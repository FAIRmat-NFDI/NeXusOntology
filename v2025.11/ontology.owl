        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusDataType"/>
        <rdfs:comment>any representation of an unsigned integer number (includes zero)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-uint"/>
        <rdfs:label>NX_UINT</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-uint"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS -->


