                                                                                <owl:unionOf rdf:parseType="Collection">
                                                                                    <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-spectroscopy-entry-instrument-generic-beam-sample-angle-type-polar-transformation-type-attribute"/>
                                                                                    <owl:Class>
