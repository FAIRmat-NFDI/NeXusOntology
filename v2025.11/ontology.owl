    <!-- https://w3id.org/PaN/NeXus/definitions#nxebeam-column-operation-mode-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxebeam-column-operation-mode-field">
        <owl:equivalentClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxem-entry-measurement-eventid-instrument-ebeam-column-operation-mode-field"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Tech-partner, microscope-, and control-software-specific name of the
            specific operation mode how the ebeam_column and its components are
            controlled to achieve specific illumination conditions.
            
            In many cases the users of an instrument do not or can not be expected to know
            all intricate spatiotemporal dynamics of their hardware. Instead, they rely on
            assumptions that the instrument, its control software, and components work as
            expected to focus on their research questions.
            
            For these cases, having a place for documenting the operation_mode is useful
            in as much as at least some constraints on how the illumination conditions were
            is documented.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-operation-mode-field"/>
        <rdfs:label>NXebeam_column/operation_mode</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXebeam_column.html#nxebeam-column-operation-mode-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxebeam-column-phaseplateid-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxebeam-column-phaseplateid-group">
