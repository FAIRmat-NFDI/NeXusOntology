    <!-- https://w3id.org/PaN/NeXus/definitions#nxstxm-entry-data-stxm-scan-type-detector-image-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxstxm-entry-data-stxm-scan-type-detector-image-enum">
