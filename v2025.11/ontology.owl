    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-instrument-name-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-instrument-name-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxinstrument-name-field"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Given name of the microscope at the hosting institution.
            This is an alias. Examples could be NionHermes, Titan, JEOL,
            Gemini, etc.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-name-field"/>
        <rdfs:label>NXem_instrument/name</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-name-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxem-instrument-nanoprobeid-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxem-instrument-nanoprobeid-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXmanipulator"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:comment>
            In contrast to the stage, the nanoprobe is an additional manipulator that is a specifically
            frequently found component of FIB/SEM instruments. A nanoprobe is used to pick up and
            relocated portions of the specimen that have been cut off during site-specific lift-outs
            and specimen preparation.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-nanoprobeid-group"/>
        <rdfs:label>NXem_instrument/nanoprobeID</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXem_instrument.html#nxem-instrument-nanoprobeid-group"/>
    </owl:Class>
    


