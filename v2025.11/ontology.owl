        <rdfs:comment>
            Curvature radius of the lens.
            Instead of &apos;FACE&apos; in the name of this field, the user is advised to
            specify for which surface (e.g. front or back) the curvature is provided:
            e.g. curvature_radius_front or curvature_radius_back. The front face is the surface on
            which the light beam is incident, while the back face is the one from
            which the light beam exits the lens.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-curvature-radius-face-field"/>
        <rdfs:label>NXoptical_lens/curvature_radius_FACE</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-curvature-radius-face-field"/>
    </owl:Class>
    


