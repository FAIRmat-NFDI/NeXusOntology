    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-surface-distance-edge-distance-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-surface-distance-edge-distance-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_LENGTH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_FLOAT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Threshold to define how far an ion has to lay at least from the edge
                        of the dataset so that the ion can act as a source. This means that
                        an ROI is placed at the location of the ion and its neighbors are
                        analyzed how they contribute to the computed statistics.
                        
                        The edge_distance threshold can be combined with the feature_distance threshold. This threshold defines defines up to which distance to a
                        microstructural feature an ROI is placed.
                        
                        The threshold is useful to process the dataset such that ROIs do
                        not protrude out of the dataset as this would add bias.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_spatstat_config.html#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-surface-distance-edge-distance-field"/>
        <rdfs:label>NXapm_paraprobe_spatstat_config/ENTRY/spatial_statisticsID/surface_distance/edge_distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_spatstat_config.html#nxapm-paraprobe-spatstat-config-entry-spatial-statisticsid-surface-distance-edge-distance-field"/>
    </owl:Class>
    


