    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXsample"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-coating-material-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-coating-thickness-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-coating-type-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxoptical-lens-coating-index-of-refraction-coating-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            If the lens has a coating describe the material and its properties.
            Some basic information can be found e.g. [here]
            (https://www.opto-e.com/basics/reflection-transmission-and-coatings).
            If the back and front side of the lens are coated with different
            materials, use separate COATING(NXsample) fields to describe the coatings
            on the front and back side, respectively. For example:
            coating_front(NXsample) and coating_back(NXsample).
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-coating-group"/>
        <rdfs:label>NXoptical_lens/COATING</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXoptical_lens.html#nxoptical-lens-coating-group"/>
    </owl:Class>
    


