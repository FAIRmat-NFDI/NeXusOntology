    <!-- https://w3id.org/PaN/NeXus/definitions#nxcontainer-orientation-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcontainer-orientation-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcomponent-transformations-group"/>
        <rdfs:comment>
			The angle the container makes to the beam and how it may change 
			during the experiment.In combination with shape this should allow 
			the beampath through the container to be modelled to allow the 
			adsorption of the container to be calculated.
		</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-orientation-group"/>
        <rdfs:label>NXcontainer/orientation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXcontainer.html#nxcontainer-orientation-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxcontainer-packing-fraction-field -->


