                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                            In the case of an experiment in which the gas pressure changes and is recorded,
                            this is an array of length m of gas pressures.
                        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-instrument-pressure-gauge-value-log-value-field"/>
