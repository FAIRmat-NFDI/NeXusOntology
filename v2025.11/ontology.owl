        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmx.html#nxmx-entry-instrument-beam-profile-field"/>
        <rdfs:label>NXmx/ENTRY/INSTRUMENT/BEAM/profile/Airy</rdfs:label>
