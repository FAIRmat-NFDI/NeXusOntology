        <extends>NXcomponent</extends>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#NXbeam_transfer_matrix_table -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#NXbeam_transfer_matrix_table">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NXobject"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusBaseClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxbeam-transfer-matrix-table-datatype-n-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxbeam-transfer-matrix-table-matrix-elements-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxbeam-transfer-matrix-table-transfer-matrix-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
        Contains data structures of an experimental optical setup (i.e., multiple
        transfer matrix tables).   These data structures are used to relate physical
        properties of two beams (NXbeam) which have one common optical component
        (NXcomponent) (one specific transfer matrix).
        One of these beams is an input beam and the other one is an output beam.
        
        The data describes the change of beam properties, e.g. the intensity of a
        beam is reduced because the transmission coefficient of the beam device is
        lower than 1.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam_transfer_matrix_table.html"/>
        <rdfs:label>NXbeam_transfer_matrix_table</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXbeam_transfer_matrix_table.html"/>
        <extends>NXobject</extends>
    </owl:Class>
    


