        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-any"/>
        <rdfs:label>NX_ANY</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/nxdl-types.html#nx-any"/>
    </owl:Class>
    


