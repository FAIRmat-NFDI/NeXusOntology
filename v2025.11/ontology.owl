    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-qdev-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_PER_LENGTH"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-qdev-units-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
          .. index:: NXcanSAS (applications); Qdev
          
          Estimated :math:`Q` **resolution** (usually standard deviation).  
          Must have the same units as :math:`Q`.
          
          When present, the name of this field is also 
          recorded in the *resolutions* attribute of *Q*, 
          as in::
          
              Q/@resolutions=&quot;Qdev&quot;

          or::

              Q/@resolutions=&quot;dQw&quot;, &quot;dQl&quot;

        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-data-qdev-field"/>
        <rdfs:label>NXcanSAS/ENTRY/DATA/Qdev</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-data-qdev-field"/>
    </owl:Class>
    


