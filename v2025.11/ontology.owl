    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-candidates-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-composition-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-concentration-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-total-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        How were results of the kernel-density estimation normalized:
                        
                        * total, the total number (intensity) of ions or elements.
                        * candidates, the total number (intensity) of ions matching weighting_model
                        * composition, the value for candidates divided by the value for total,
                        * concentration, the value for candidates divided by the volume of the cell.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-field"/>
        <rdfs:label>NXapm_paraprobe_nanochem_results/ENTRY/delocalizationID/grid/normalization</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-normalization-field"/>
    </owl:Class>
    


