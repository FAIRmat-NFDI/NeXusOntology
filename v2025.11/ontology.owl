                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_NUMBER"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        Confidence interval from which the background counts are integrated.
                        For example *0.95* means that the background is integrated over the range in
                        which the integrated peak area is 95% of the total peak area.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-background-parameters-background-area-interval-field"/>
        <rdfs:label>NXstress/ENTRY/FIT/background_parameters/background_area_interval</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-background-parameters-background-area-interval-field"/>
    </owl:Class>
    


