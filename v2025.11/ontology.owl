                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
			The type of hardware used for the measurement.  
			Examples (suggestions but not restrictions):
			
			:Temperature:
			  J | K | T | E | R | S | Pt100 | Rh/Fe
			:pH:
			  Hg/Hg2Cl2 | Ag/AgCl | ISFET
			:Ion selective electrode:
			  specify species; e.g. Ca2+
			:Magnetic field:
			  Hall
			:Surface pressure:
			  wilhelmy plate
		</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-type-field"/>
        <rdfs:label>NXsensor/type</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXsensor.html#nxsensor-type-field"/>
    </owl:Class>
    


