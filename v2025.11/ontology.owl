                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXellipsometry.html#nxellipsometry-entry-data-collection-measured-data-errors-units-attribute"/>
