                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_CHAR"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Path to an instance of :ref:`NXcoordinate_system` to document
                the reference frame in which the positions are defined.
                
                This resolves ambiguity when the reference frame is different
                to the NeXus default reference frame (McStas).
            </rdfs:comment>
