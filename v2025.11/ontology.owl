    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-edge-detection-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-edge-detection-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_ANY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_BOOLEAN"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Specifies if the tool should report for each cell if it makes contact with
                    the tight axis-aligned bounding box about the point cloud.
                    This can be used to identify if the shape of the cell is likely affected
                    by the edge of the dataset or if cells are deeply enough embedded
                    into the point cloud so that the shape of their cells are not affected
                    anymore by the boundary. This is valuable information to judge
                    about the significance of finite size effects.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tessellator_config.html#nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-edge-detection-field"/>
        <rdfs:label>NXapm_paraprobe_tessellator_config/ENTRY/tessellateID/has_cell_edge_detection</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_tessellator_config.html#nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-edge-detection-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-tessellator-config-entry-tessellateid-has-cell-geometry-field -->


