        <rdfs:label>NXapm_paraprobe_intersector_config/ENTRY/v_v_spatial_correlationID/has_current_to_next_links</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_intersector_config.html#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-has-current-to-next-links-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-intersector-config-entry-v-v-spatial-correlationid-has-next-to-current-links-field -->


