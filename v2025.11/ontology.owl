    <!-- https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-cuboidal-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-damask-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-ebsd-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-score-config-entry-deformation-model-poisson-voronoi-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Which model should be used to generate a starting microstructure.
                    
                    * cuboidal, a regular array of equally-shaped cuboidal grains
                    * poisson_voronoi, a discretized Poisson Voronoi tessellation
                    * ebsd, a microstructure synthesized based on a simulated or a measured EBSD orientation map
                    * damask, the result of a simulation from `DAMASK &lt;https://damask-multiphysics.org&gt;`_.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-deformation-model-field"/>
        <rdfs:label>NXmicrostructure_score_config/ENTRY/deformation/model</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure_score_config.html#nxmicrostructure-score-config-entry-deformation-model-field"/>
    </owl:Class>
    


