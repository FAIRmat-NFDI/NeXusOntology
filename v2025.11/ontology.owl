                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Describes the type of binning used during data reduction.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXstress.html#nxstress-entry-fit-bins-field"/>
        <rdfs:label>NXstress/ENTRY/FIT/bins</rdfs:label>
