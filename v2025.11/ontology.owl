        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_charge_state_analysis.html#nxapm-charge-state-analysis-natural-abundance-product-field"/>
        <rdfs:label>NXapm_charge_state_analysis/natural_abundance_product</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_charge_state_analysis.html#nxapm-charge-state-analysis-natural-abundance-product-field"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-charge-state-analysis-nuclide-hash-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-charge-state-analysis-nuclide-hash-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasUnitContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UNITLESS"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Table of nuclide instances of which each candidate is composed.
            Each row vector is sorted in descending order.
            Unused entries in the matrix should be set to 0.
            Use the hashing rule that is defined in nuclide_hash of :ref:`NXatom`.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_charge_state_analysis.html#nxapm-charge-state-analysis-nuclide-hash-field"/>
        <rdfs:label>NXapm_charge_state_analysis/nuclide_hash</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXapm_charge_state_analysis.html#nxapm-charge-state-analysis-nuclide-hash-field"/>
    </owl:Class>
    


