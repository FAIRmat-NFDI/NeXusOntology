                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            The minimum pressure achievable in a chamber after
            it has been pumped down for an extended period.
        </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/base_classes/NXpump.html#nxpump-base-pressure-field"/>
        <rdfs:label>NXpump/base_pressure</rdfs:label>
