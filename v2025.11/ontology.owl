    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-intersector-results-entry-v-v-spatial-correlationid-current-to-next-link-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxapm-paraprobe-intersector-results-entry-v-v-spatial-correlationid-current-to-next-link-field">
