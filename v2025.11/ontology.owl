            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasValueContainer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                                        Qualifier how which specifically oriented normal to its
                                        primitive each normal represents.
                                        
                                        * 0 - undefined
                                        * 1 - outer
                                        * 2 - inner
                                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_nanochem_results.html#nxapm-paraprobe-nanochem-results-entry-delocalizationid-grid-iso-surfaceid-triangle-soup-triangles-vertex-normal-orientation-field"/>
