                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NX_UINT"/>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                        The number of solutions found for each target. Typically,
                        this value is 1 in which case the field can be omitted.
                        Otherwise, this array is the concatenated set of values of solution
                        tuples for each target that can be used to decode model_labels,
                        core_sample_indices, and weight.
                    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXapm_paraprobe_clusterer_results.html#nxapm-paraprobe-clusterer-results-entry-cluster-analysisid-dbscanid-number-of-solutions-field"/>
