                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-axes-attribute"/>
        <rdfs:label>NXmpes/ENTRY/transmission_correction/transmission_function/axes</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-axes-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-axes-kinetic-energy-enum -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-axes-kinetic-energy-enum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusEnumerations"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#actualValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>[&apos;kinetic_energy&apos;]</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Enumeration item for NXmpes/ENTRY/transmission_correction/transmission_function/axes: [&apos;kinetic_energy&apos;]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-axes-attribute"/>
        <rdfs:label>NXmpes/ENTRY/transmission_correction/transmission_function/axes/[&apos;kinetic_energy&apos;]</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-axes-attribute"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-group -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxcalibration-data-group"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-axes-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-kinetic-energy-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-relative-intensity-field"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#has"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-signal-attribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                    Transmission function of the electron analyzer.
                    
                    The transmission function (TF) specifies the detection efficiency for electrons of
                    different kinetic energy passing through the electron analyzer.
                    
                    This can be a link to /entry/instrument/electronanalyzer/transmission_function.
                </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-group"/>
        <rdfs:label>NXmpes/ENTRY/transmission_correction/transmission_function</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXmpes.html#nxmpes-entry-transmission-correction-transmission-function-group"/>
    </owl:Class>
    


    <!-- https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-kinetic-energy-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmpes-entry-transmission-correction-transmission-function-kinetic-energy-field">
