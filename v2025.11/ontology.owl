    <!-- https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-field -->


    <owl:Class rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-field">
        <rdfs:subClassOf rdf:resource="https://w3id.org/PaN/NeXus/definitions#NeXusField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-disorientation-clustering-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-fast-multiscale-clustering-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-markov-chain-clustering-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxmicrostructure-configuration-algorithm-unknown-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
                Algorithm whereby interfaces between crystals were reconstructed.
                
                * Disorientation clustering groups nearby material points based on their crystallographic disorientation
                * Fast multiscale clustering based on `D. Kushnir et al. &lt;https://doi.org/10.1016/j.patcog.2006.04.007&gt;`_
                * Markov chain clustering `F. Niessen et al. &lt;https://doi.org/10.1107/S1600576721011560&gt;`_
            </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-configuration-algorithm-field"/>
        <rdfs:label>NXmicrostructure/configuration/algorithm</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/contributed_definitions/NXmicrostructure.html#nxmicrostructure-configuration-algorithm-field"/>
    </owl:Class>
    


