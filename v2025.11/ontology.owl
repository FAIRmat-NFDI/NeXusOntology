        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/PaN/NeXus/definitions#hasEnumContainer"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-dqw-units-1-angstrom-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-dqw-units-1-m-enum"/>
                            <rdf:Description rdf:about="https://w3id.org/PaN/NeXus/definitions#nxcansas-entry-data-dqw-units-1-nm-enum"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>
            Engineering units to use when expressing
            :math:`Q` and related terms.
            
            Data expressed in other units may not be processed by some 
            software packages.
          </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-data-dqw-units-attribute"/>
        <rdfs:label>NXcanSAS/ENTRY/DATA/dQw/units</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://manual.nexusformat.org/classes/applications/NXcanSAS.html#nxcansas-entry-data-dqw-units-attribute"/>
    </owl:Class>
    


